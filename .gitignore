.codex/
.vix/
loadout_backups/
.loadout-bootstrap/
__pycache__/
*.log
!envs/bash/global/grc/share/grc/conf.log
.claude/
envs/bash/corp
vendor/fonts.scale
resume_claude.sh

# /dev/null char-device shadows the command sandbox plants over sensitive
# dotfiles when cwd is the repo (they show up as untracked, are not real files).
.bash_profile
.bashrc
.profile
.zprofile
.zshrc
.gitconfig
.gitmodules
.ripgreprc
.mcp.json
.idea
.vscode

# Generated release artifact (attached to GitHub releases, not committed)
/sha256sums.txt

# The assurance download log must stay tracked despite the *.log ignore.
!assurance/downloads.log

# The nvim plugin stash is a RELEASE ASSET, not a git payload. It is 328 MB of bz2'd
# git packfiles -- binary, no delta reuse -- so committing it added ~328 MB to history
# on every refresh, permanently. Get it with ./tools/fetch-stash (or refresh it in place in a
# shared tree with ./tools/refresh-stash). See docs/superpowers/specs/2026-07-14-stash-as-release-asset-design.md
envs/nvim/vendor/plugins/nvim-plugin-stash.tar.bz2
envs/nvim/vendor/plugins/nvim-plugin-stash.tar.bz2.part-*
.content-manifest.fetched
