    install_path(os.path.join(repo_dir, "bash", "README.md"), os.path.join(bash_config, "README.md"), links_mode)
    install_path(os.path.join(repo_dir, "bash", "bashrc"), os.path.join(bash_config, "bashrc"), links_mode)
