#!/bin/bash
# Pre-commit hook (hooks/README.md documents each step):
#   1. Remove .git from embedded repositories THIS COMMIT STAGES, so vendored
#      copies commit as plain files. Nothing else in the worktree is touched.
#   2. Strip repo ELF payloads when staged binary/archive candidates change.
#   3. Syntax-check (bundled interpreter) and ruff-format staged Python files
#      (.py and extensionless python shebangs).
#   4. Chunk staged payload/ files over 40 MiB; a failure blocks the commit.
#
# Never `git add -A`: every re-stage names the paths it means.

set -euo pipefail

script_dir=$(git rev-parse --show-toplevel)

# The bundled interpreter, found the way the ./loadout shim finds it: the
# default install root, the legacy HOME-mode ~/.local/bin, then this clone's
# bootstrap cache. The minor version comes from loadout_main.py's
# _BUNDLED_PY, the one place it is spelled.
_bundled_minor=$(sed -n 's/^_BUNDLED_PY = "\(.*\)"$/\1/p' "$script_dir/loadout_main.py")
_bundled_py() {
    local _cand
    for _cand in "${XDG_DATA_HOME:-$HOME/.local/share}/loadout/bin/python${_bundled_minor}" \
        "$HOME/.local/bin/python${_bundled_minor}" \
        "$script_dir/.loadout-bootstrap/bin/python${_bundled_minor}"; do
        if [[ -x "$_cand" ]]; then
            echo "$_cand"
            return 0
        fi
    done
    return 1
}

# --- 1. Embedded git repository cleanup ---

echo "Pre-commit: Checking for embedded git repositories..."

# Only paths this commit stages: a staged embedded repo shows up as a gitlink
# entry naming its directory. The old `find .` walked the whole worktree --
# ignored dirs too, deleting local clones kept there -- and then `git add -A`
# swept every untracked file into the commit.
_embedded=()
while IFS= read -r _p; do
    [[ -z "$_p" ]] && continue
    if [[ -d "$_p" && -e "$_p/.git" ]]; then
        _embedded+=("$_p")
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [[ ${#_embedded[@]} -gt 0 ]]; then
    echo "Found embedded git repositories in this commit, removing their .git:"
    for _p in "${_embedded[@]}"; do
        echo "  Removing: $_p/.git"
        rm -rf "${_p:?}/.git"
        # Replace the gitlink entry with the directory's files.
        git rm --cached -q -r -f -- "$_p" >/dev/null
        git add -- "$_p"
    done
    echo "OK Cleaned up embedded git repositories"
else
    echo "OK No embedded git repositories found"
fi

# Untracked (not ignored) repositories are not part of this commit: say so,
# leave them alone. `git add` on one later would record a gitlink.
while IFS= read -r _u; do
    [[ -z "$_u" ]] && continue
    _u=${_u%/}
    if [[ -e "$_u/.git" ]]; then
        echo "  NOTE: untracked $_u is a git repository; not touched (not in this commit)"
    fi
done < <(git ls-files --others --exclude-standard --directory)

# --- 2. Strip repo binaries and binary archives ---

staged_strip_candidates=$(
    git diff --cached --name-only --diff-filter=ACM |
        grep -E '(^|/)([^/]+)$' |
        grep -E '\.(gz|so|tar|tgz|tbz2|txz|tar\.bz2|tar\.gz|tar\.xz)$|(^|/)(bin|lib64|grammars|parser)/' || true
)

if [[ -n "$staged_strip_candidates" ]]; then
    echo "Pre-commit: Stripping repo binaries and archives..."

    if ! command -v strip >/dev/null; then
        echo "  WARNING: 'strip' not found in PATH -- skipping ELF stripping." >&2
        echo "  Run ./build/strip-all-elf-binaries manually before committing binary/archive changes." >&2
    else
        # build/strip-all-elf-binaries is `#!/usr/bin/env python3.15`, and the
        # bundle's interpreter is not necessarily on PATH (it may live only in
        # ~/.local/bin or the repo's own bootstrap tree). Put it on PATH for
        # this call, or the shebang fails with "env: 'python3.15': No such
        # file or directory" and the commit is blocked for a reason that has
        # nothing to do with the change.
        _strip_py=$(_bundled_py || true)
        if [[ -n "$_strip_py" ]]; then
            PATH="$(dirname "$_strip_py"):$PATH" "$script_dir/build/strip-all-elf-binaries"
        else
            "$script_dir/build/strip-all-elf-binaries"
        fi
        # Re-stage candidate files, converted tar.bz2 names, removals, and updated manifests
        # without sweeping unrelated untracked files into the commit.
        git add -u
        while IFS= read -r candidate; do
            [[ -z "$candidate" ]] && continue
            [[ -e "$candidate" ]] && git add -- "$candidate"
            case "$candidate" in
            *.tar.gz) converted="${candidate%.tar.gz}.tar.bz2" ;;
            *.tgz) converted="${candidate%.tgz}.tar.bz2" ;;
            *.tar.xz) converted="${candidate%.tar.xz}.tar.bz2" ;;
            *.txz) converted="${candidate%.txz}.tar.bz2" ;;
            *.tbz2) converted="${candidate%.tbz2}.tar.bz2" ;;
            *.tar) converted="${candidate%.tar}.tar.bz2" ;;
            *) converted="" ;;
            esac
            [[ -n "$converted" && -e "$converted" ]] && git add -- "$converted"
        done <<< "$staged_strip_candidates"
        [[ -f .strip-manifest ]] && git add .strip-manifest
        echo "OK Repo binaries and archives stripped and staged"
    fi
fi

# --- 3. Ruff formatting ---

_staged_all=$(git diff --cached --name-only --diff-filter=ACM)
_staged_py_files=()
while IFS= read -r _f; do
    [[ -z "$_f" ]] && continue
    # Skip vendored third-party Python so ruff doesn't lint/format their code.
    # The vendor tree is treated as upstream-controlled byte-identical drop-in.
    if [[ "$_f" == installer_vendor/* ]]; then
        continue
    fi
    if [[ "$_f" == *.py ]]; then
        _staged_py_files+=("$_f")
    elif [[ -f "$_f" ]] && head -1 "$_f" 2>/dev/null | grep -qE '^\s*#!.*python'; then
        _staged_py_files+=("$_f")
    fi
done <<< "$_staged_all"

if [[ ${#_staged_py_files[@]} -gt 0 ]]; then
    # Syntax check under the bundled interpreter -- the installer body and all
    # post-install scripts run under it (PEP 758 forms older parsers reject).
    _syntax_py=$(_bundled_py || true)
    if [[ -n "$_syntax_py" ]]; then
        _syntax_ver=$("$_syntax_py" -c 'import sys; print("%d.%d" % sys.version_info[:2])')
        _syntax_err=$(mktemp "${TMPDIR:-/tmp}/loadout-precommit.XXXXXX")
        trap 'rm -f "$_syntax_err"' EXIT
        echo "Pre-commit: Checking Python $_syntax_ver syntax ($_syntax_py)..."
        _syntax_ok=1
        for _f in "${_staged_py_files[@]}"; do
            if ! "$_syntax_py" -m py_compile "$_f" 2>"$_syntax_err"; then
                echo "  SYNTAX ERROR under $_syntax_py: $_f" >&2
                cat "$_syntax_err" >&2
                _syntax_ok=0
            fi
        done
        if [[ "$_syntax_ok" == "1" ]]; then
            echo "OK Python $_syntax_ver syntax OK"
        else
            echo "ERROR: Fix syntax errors above before committing." >&2
            exit 1
        fi
    else
        echo "Pre-commit: skipping the syntax check (no bundled python${_bundled_minor} found)"
    fi

    echo "Pre-commit: Formatting Python files with ruff..."
    if ! command -v ruff >/dev/null; then
        echo "  WARNING: 'ruff' not found in PATH -- skipping format." >&2
        echo "  Run 'ruff format <files>' && 'ruff check --fix <files>' manually before committing Python changes." >&2
    else
        ruff format "${_staged_py_files[@]}"
        ruff check --fix "${_staged_py_files[@]}"
        git add -- "${_staged_py_files[@]}"
        echo "OK Python files formatted and imports sorted"
    fi
fi

# --- 4. Auto-chunk large staged files in payload/ ---

_staged_large_prebuilt=$(
    git diff --cached --name-only --diff-filter=ACM |
        grep "^payload/" |
        while IFS= read -r _f; do
            [[ -z "$_f" ]] && continue
            [[ "$_f" == *".part-"* ]] && continue  # already a chunk
            [[ -f "$_f" ]] || continue
            _sz=$(stat -c%s "$_f" 2>/dev/null || echo 0)
            [[ "$_sz" -gt $((40 * 1024 * 1024)) ]] && echo "$_f"
        done || true
)

if [[ -n "$_staged_large_prebuilt" ]]; then
    echo "Pre-commit: Chunking large payload/ files (>40 MiB)..."
    while IFS= read -r _lf; do
        [[ -n "$_lf" ]] && echo "  Chunking: $_lf"
    done <<< "$_staged_large_prebuilt"
    # Same interpreter PATH fix as step 2 (the script is `env python3.15`), and
    # no `2>/dev/null || true`: a failure here used to be silent and the large
    # file was committed unchunked. --chunk-only processes all of payload/.
    _chunk_py=$(_bundled_py || true)
    _chunk_path=$PATH
    [[ -n "$_chunk_py" ]] && _chunk_path="$(dirname "$_chunk_py"):$PATH"
    if ! PATH="$_chunk_path" "$script_dir/build/strip-all-elf-binaries" --chunk-only; then
        echo "ERROR: build/strip-all-elf-binaries --chunk-only failed; payload files over 40 MiB were not chunked." >&2
        exit 1
    fi
    # Re-stage: remove original large files, add new chunk files.
    while IFS= read -r _lf; do
        [[ -z "$_lf" ]] && continue
        if [[ ! -f "$_lf" && -f "${_lf}.part-000" ]]; then
            git rm --cached -- "$_lf" 2>/dev/null || true
            git add -- "${_lf}.part-"* 2>/dev/null || true
        fi
    done <<< "$_staged_large_prebuilt"
    _still_large=0
    while IFS= read -r _lf; do
        [[ -z "$_lf" || ! -f "$_lf" ]] && continue
        if [[ "$(stat -c%s "$_lf")" -gt $((40 * 1024 * 1024)) ]]; then
            echo "ERROR: $_lf is still over 40 MiB and unchunked (GitHub warns at 50 MB)." >&2
            _still_large=1
        fi
    done <<< "$_staged_large_prebuilt"
    [[ "$_still_large" == "0" ]] || exit 1
    echo "OK Large files chunked and re-staged"
fi

exit 0
