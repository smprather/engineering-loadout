# loadout zsh config (MVP). Companion to bash/bashrc.
#
# Strategy: REUSE the portable bash layers (functions.sh, config.sh, aliases.sh)
# and add only zsh-specific adapters here. This is NOT a bash file -- do not
# `bash -n` or shellcheck it; validate by running zsh.
#
# Deferred (bash-only for now): completion parity (the bash-completion bundle),
# full keybinding set, and the startup-trace / icecream debug machinery.

# --- zsh compat: make the shared (bash-written) logic behave bash-like --------
# SH_WORD_SPLIT: split unquoted $var on IFS, like bash (the path_* helpers and
# various `for x in $list` rely on it). INTERACTIVE_COMMENTS: allow `#` comments.
setopt SH_WORD_SPLIT INTERACTIVE_COMMENTS 2>/dev/null

# --- config root (mirror the bash dispatcher's default) -----------------------
BASH_CONFIG_ROOT_DIR="${BASH_CONFIG_ROOT_DIR:-$HOME/.config/bash}"

# --- shared helpers + config (portable; verified to source under zsh) ---------
# functions.sh defines source_if_exists / path_* / is_truthy / join_by.
[[ -r "$BASH_CONFIG_ROOT_DIR/functions.sh" ]] && source "$BASH_CONFIG_ROOT_DIR/functions.sh"
source_if_exists "$BASH_CONFIG_ROOT_DIR/global/config.sh"
for _layer in corp site team project user; do
    source_if_exists "$BASH_CONFIG_ROOT_DIR/$_layer/config.sh"
done

# --- PATH + terminfo (ported from global/bashrc; nvm is bash-gated) -----------
# nvm.sh hangs when sourced under zsh via its auto-use path -- load it in bash
# only. (Not yet ported to a zsh-safe lazy loader.)
if [[ -n "${BASH_VERSION:-}" && -r "$HOME/.nvm/nvm.sh" ]]; then
    export NVM_DIR="$HOME/.nvm"
    source "$NVM_DIR/nvm.sh"
fi
for _bin_dir in \
    /usr/local/bin \
    $NVM_BIN \
    ~/.cargo/bin \
    ~/.venv/bin \
    ~/.opencode/bin \
    ~/node_modules/.bin \
    ~/go/bin \
    "${LOADOUT_CFG_SHARED_PREFIX:+$LOADOUT_CFG_SHARED_PREFIX/bin}" \
    ~/.local/bin; do
    path_prepend_if_dir "$_bin_dir"
done
# terminfo: zsh-native prepend. (functions.sh path_prepend on a NAMED var is
# bash-only -- it uses printf -v, which zsh lacks; path_prepend_if_dir above is
# PATH-only POSIX and works fine.)
typeset -gx TERMINFO_DIRS
for _ti in "$HOME/.local/share/terminfo" "${LOADOUT_CFG_SHARED_PREFIX:+$LOADOUT_CFG_SHARED_PREFIX/share/terminfo}"; do
    [[ -n "$_ti" && -d "$_ti" && ":$TERMINFO_DIRS:" != *":$_ti:"* ]] && \
        TERMINFO_DIRS="$_ti${TERMINFO_DIRS:+:$TERMINFO_DIRS}"
done

# Non-interactive shells need PATH but nothing below.
[[ -o interactive ]] || return 0

# --- history (zsh-native) -----------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_SPACE HIST_IGNORE_ALL_DUPS SHARE_HISTORY INC_APPEND_HISTORY

# --- completion: DEFERRED -----------------------------------------------------
# compinit is intentionally NOT run: the bundled zsh was built with a /tmp build
# prefix, so its $fpath points at a gone /tmp/zsh-install-*/share/zsh/... dir and
# compinit hangs. Fix the zsh binary to be relocatable (bundle its functions dir
# + correct fpath, like the fish/vim launchers) before enabling completion.

# --- key bindings (built-in zle widgets only; no autoload -> no fpath need) ---
# prefix history search on arrows (bash history-search-* analog), Shift-Tab back.
bindkey '^[[A' history-beginning-search-backward
bindkey '^[[B' history-beginning-search-forward
bindkey '^[[Z' reverse-menu-complete

# --- ls (minimal; the full env-var-driven bash ls() is deferred) --------------
# aliases.sh chains ll/lr/lh/... onto `ls`; give it the preferred backend so the
# common cases work (human_readable=1 etc. degrade silently to a plain listing).
if command -v "${LOADOUT_CFG_PREFERRED_LS:-eza}" >/dev/null; then
    alias ls="${LOADOUT_CFG_PREFERRED_LS:-eza}"
fi

# --- tool integrations (zsh init variants) -- GATED OFF for the MVP -----------
# BLOCKED, opt-in only (LOADOUT_CFG_ZSH_ENABLE_PROMPT=1) until two things are
# fixed + verified:
#   1. The bundled zsh ships NO function library -- its $fpath points at a gone
#      /tmp/zsh-install-*/share/zsh/... build prefix, so add-zsh-hook/compinit
#      are unavailable. Repackage zsh relocatably (bundle share/zsh/<ver>/functions
#      + correct fpath, like the fish/vim launchers).
#   2. Even with add-zsh-hook present, `eval "$(starship init zsh)"` HANGS at
#      startup here -- needs debugging before it can be trusted in a login shell.
# Until then this block is off so the rc can never hang a shell. PATH, aliases,
# history, and built-in keybinds above all work today.
if is_truthy "${LOADOUT_CFG_ZSH_ENABLE_PROMPT:-0}"; then
    if is_truthy "${LOADOUT_CFG_ENABLE_STARSHIP}" && command -v starship >/dev/null; then
        export STARSHIP_CONFIG="$BASH_CONFIG_ROOT_DIR/../starship/starship.toml"
        eval "$(starship init zsh)"
    fi
    is_truthy "${LOADOUT_CFG_ENABLE_ZOXIDE}" && command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
    is_truthy "${LOADOUT_CFG_ENABLE_FZF}" && command -v fzf >/dev/null && eval "$(fzf --zsh)"
fi

# --- shared aliases + command-shortcut functions (zsh-compatible) -------------
source_if_exists "$BASH_CONFIG_ROOT_DIR/global/aliases.sh"

# --- zsh layer overrides (corp/site/team/project/user), if present ------------
ZSH_CONFIG_ROOT_DIR="${ZSH_CONFIG_ROOT_DIR:-$HOME/.config/zsh}"
for _layer in corp site team project user; do
    source_if_exists "$ZSH_CONFIG_ROOT_DIR/$_layer/zshrc"
done
