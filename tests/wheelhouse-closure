#!/usr/bin/env python3.15
"""
wheelhouse-closure -- every python-tool in the registry must be installable
OFFLINE from the bundled wheelhouse, under the interpreter the payload ships.

The 2026-10-10 Python 3.15 sweep replaced the payload interpreter and the
wheelhouse only partially caught up: 17 wheels became cp315, 29 stayed cp314.
A cp314 wheel is ABI-LOCKED to CPython 3.14 -- it cannot be installed by a
3.15 interpreter at all. `uv tool install` then fails at install time:

    error: No solution found when resolving dependencies
      cause: Because numpy==2.4.6 has no wheels with a matching Python ABI
             tag (e.g., `cp315`) ...

which is a FAILED row in the install results -- seven of them
(liberty-tools, librelane, jupyterlab, time-plot, cicwave, parity-plot,
pygwalker). The install reported the failure, but nothing STOPPED the bad
wheelhouse from being committed, so the next install failed the same way.

This gate is the pre-commit check: every wheel in the wheelhouse must be
installable by the shipped interpreter (a wheel nothing can install is dead
weight shipped in every release), and it walks each enabled python-tool's
dependency closure over the bundled wheelhouse, so the closure resolves.
Installable means:

  * an ABI tag of cp3XY where XY == the shipped interpreter's version, or
  * abi3 (stable ABI, forward compatible), or
  * py3-none-any (pure python)

A closure that needs a cp314 wheel, or a wheel that is not in the wheelhouse
at all, FAILS here with the exact tool and the exact missing/incompatible
wheel named.

Read-only: it never installs anything and never touches the network.
"""

import glob
import os
import re
import sys
import tempfile
import zipfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PLATFORM_DIR = os.path.join(REPO, "payload", "el8.x86_64.glibc2p28")
WHEELS_DIR = os.path.join(PLATFORM_DIR, "wheels")
PAYLOADS_JSON = os.path.join(REPO, "payload", "packages.json")

FAILURES = []


def fail(msg):
    FAILURES.append(msg)
    print(f"  FAIL  {msg}")


def ok(msg):
    print(f"  OK    {msg}")


def shipped_python_version():
    """The interpreter version the payload ships (e.g. '3.15')."""
    archives = [f for f in os.listdir(PLATFORM_DIR) if f.startswith("portable-python-") and f.endswith(".tar.bz2")]
    if not archives:
        return None
    m = re.search(r"portable-python-(\d+)\.(\d+)\.", archives[0])
    return f"{m.group(1)}.{m.group(2)}" if m else None


def normalize(name):
    return re.sub(r"[-_.]+", "-", name).lower()


def wheel_tags(filename):
    """The (python, abi, platform) tag triple a wheel filename declares.

    A wheel filename is {name}-{version}(-{build})?-{py}-{abi}-{plat}.whl, so
    the tag triple is the LAST three dash-separated fields -- for a pure
    python wheel that is (py3, none, any), not just (py3).
    """
    parts = filename[: -len(".whl")].split("-")
    if len(parts) < 5:
        return ()
    return tuple(parts[-3:])


def platform_is_el8(plat_tag):
    """True if any compressed platform tag is installable on EL8 x86_64.

    `any` works everywhere. manylinux_N_M must be glibc <= 2.28; the legacy
    aliases (manylinux1/2010/2014) map to 2.5/2.12/2.17. musllinux and
    windows/macos tags never match.
    """
    for tag in plat_tag.split("."):
        if tag == "any":
            return True
        match = re.fullmatch(r"manylinux_(\d+)_(\d+)_x86_64", tag)
        if match and (int(match.group(1)), int(match.group(2))) <= (2, 28):
            return True
        if re.fullmatch(r"manylinux1_x86_64", tag):
            return True
        if re.fullmatch(r"manylinux2010_x86_64", tag):
            return True
        if re.fullmatch(r"manylinux2014_x86_64", tag):
            return True
    return False


def wheel_is_abi_compatible(filename, shipped):
    """True if a wheel can be installed by the shipped interpreter ON EL8.

    A cpXY tag is ABI-locked: only an exact py/abi pair works (a cp315-cp315t
    free-threaded wheel does not). abi3 (including compressed `abi3.abi3t`)
    and a pure-python tag (py3, or the dotted py2.py3) work for any CPython 3.
    """
    tags = wheel_tags(filename)
    if len(tags) != 3:
        return False
    py_tag, abi_tag, plat_tag = tags
    if not platform_is_el8(plat_tag):
        return False
    if abi_tag == "none":
        return "py3" in py_tag.split(".")
    if "abi3" in abi_tag.split("."):
        return True
    if re.fullmatch(r"cp3\d+", py_tag):
        return py_tag[2:] == shipped.replace(".", "") and abi_tag == py_tag
    return False


# The environment a bundled wheel is resolved against: the shipped
# interpreter on the EL8 target.
MARKER_VALUES = {
    "python_version": None,  # filled in per run
    "python_full_version": None,
    "os_name": "posix",
    "sys_platform": "linux",
    "platform_system": "Linux",
    "platform_machine": "x86_64",
    "platform_python_implementation": "CPython",
    "implementation_name": "cpython",
    "implementation_version": None,
}


def _version_tuple(text):
    parts = re.findall(r"\d+", text or "")
    return tuple(int(p) for p in parts[:3])


def _compare(left, op, right):
    """Compare two marker operands, numerically when both look like versions."""
    if op in ("==", "!="):
        same = left == right
        if op == "!=":
            return not same
        return same
    lv, rv = _version_tuple(left), _version_tuple(right)
    if lv and rv:
        a = (lv + (0, 0, 0))[:3]
        b = (rv + (0, 0, 0))[:3]
    else:
        a, b = left, right
    if op == "<":
        return a < b
    if op == "<=":
        return a <= b
    if op == ">":
        return a > b
    if op == ">=":
        return a >= b
    return False


def marker_applies(marker):
    """Evaluate a PEP 508 environment marker for the shipped target.

    Only the forms that appear in the bundled wheels are supported; an
    unrecognised marker is treated as NOT applying (so the requirement is
    skipped) rather than inventing a dependency that may not exist.
    """
    if not marker:
        return True
    marker = marker.strip()
    if "extra ==" in marker or "extra==" in marker:
        return False  # an opt-in extra: the base install does not pull it
    for clause in re.split(r"\s+or\s+", marker):
        if all(_clause_applies(part) for part in re.split(r"\s+and\s+", clause)):
            return True
    return False


def _clause_applies(clause):
    clause = clause.strip().strip("()").strip()
    match = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)\s*(==|!=|<=|>=|<|>)\s*(.+)$", clause)
    if not match:
        return False
    var, op, raw = match.group(1), match.group(2), match.group(3).strip()
    if raw.startswith(("'", '"')):
        raw = raw[1:-1]
    value = MARKER_VALUES.get(var)
    if value is None:
        return False
    return _compare(value, op, raw)


def wheel_metadata(path):
    """(name, version, [requirement strings]) from a wheel's METADATA."""
    with zipfile.ZipFile(path) as z:
        for member in z.namelist():
            if member.endswith(".dist-info/METADATA"):
                text = z.read(member).decode("utf-8", "replace")
                break
        else:
            return None
    name = version = None
    requires = []
    for line in text.splitlines():
        if line.startswith("Name: ") and name is None:
            name = line[6:].strip()
        elif line.startswith("Version: ") and version is None:
            version = line[9:].strip()
        elif line.startswith("Requires-Dist: "):
            requires.append(line[15:].strip())
    return name, version, requires


def requirement_name(req):
    """The distribution name a Requires-Dist line names."""
    # Strip the marker/extras tail, then take the leading name.
    base = req.split(";")[0].split("[")[0].strip()
    match = re.match(r"^([A-Za-z0-9._-]+)", base)
    return match.group(1) if match else None


SUITE_LOCK = os.path.join(REPO, "payload", "python-loaded", "requirements.lock.txt")
SUITE_WHEELS = os.path.join(REPO, "payload", "python-loaded", "wheels")


def suite_lock():
    """(abi, [(normalized_name, version, sha256)]) from the suite lock."""
    abi = None
    pins = []
    pinned = re.compile(r"^([A-Za-z0-9][A-Za-z0-9._-]*)==([^\s]+)\s+--hash=sha256:([0-9a-f]{64})$")
    with open(SUITE_LOCK, encoding="utf-8") as fh:
        for raw in fh:
            line = raw.strip()
            if line.startswith("# abi: "):
                abi = line[len("# abi: ") :].strip()
            elif line and not line.startswith("#"):
                match = pinned.match(line)
                if not match:
                    return abi, None
                pins.append((normalize(match.group(1)), match.group(2), match.group(3)))
    return abi, pins


def suite_wheel(wheels_dir, dist, version):
    for name in sorted(os.listdir(wheels_dir)):
        if name.endswith(".whl"):
            logical, path = name, os.path.join(wheels_dir, name)
        elif name.endswith(".whl.part-000"):
            logical = name[: -len(".part-000")]
            path = os.path.join(wheels_dir, name)
        else:
            continue
        fields = logical[: -len(".whl")].split("-")
        if len(fields) >= 2 and normalize(fields[0]) == dist and fields[1] == version:
            return logical, path
    return None


def suite_wheel_path(path):
    """A readable whole-wheel path, reassembling `.part-NNN` chunks."""
    if not path.endswith(".part-000"):
        return path, None
    import tempfile

    out = tempfile.NamedTemporaryFile(prefix=".wheelhouse-suite-", suffix=".whl", delete=False)
    with out:
        for part in sorted(p for p in (path[: -len("-000")] + f"-{i:03d}" for i in range(1000)) if os.path.exists(p)):
            with open(part, "rb") as src:
                out.write(src.read())
    return out.name, out.name


def audit_suite(shipped):
    import hashlib

    if not os.path.isdir(SUITE_WHEELS):
        fail("python-loaded: private wheelhouse is missing")
        return
    abi, pins = suite_lock()
    expected_abi = f"cpython-{shipped.replace('.', '')}"
    if abi != expected_abi:
        fail(f"python-loaded: lock abi {abi!r} != interpreter {expected_abi!r}")
    if pins is None:
        fail("python-loaded: lock has a malformed pin line")
        return
    missing = 0
    for dist, version, sha in pins:
        found = suite_wheel(SUITE_WHEELS, dist, version)
        if not found:
            fail(f"python-loaded: {dist}=={version} has no wheel")
            missing += 1
            continue
        logical, path = found
        if not wheel_is_abi_compatible(logical, shipped):
            fail(f"python-loaded: {logical} is not EL8/cp{shipped.replace('.', '')}-compatible")
        whole, temp = suite_wheel_path(path)
        try:
            digest = hashlib.sha256()
            with open(whole, "rb") as fh:
                for chunk in iter(lambda: fh.read(1 << 20), b""):
                    digest.update(chunk)
        finally:
            if temp:
                os.unlink(temp)
        if digest.hexdigest() != sha:
            fail(f"python-loaded: {logical} hash does not match the lock")
    if not missing:
        ok(f"python-loaded: {len(pins)} pinned wheels match the lock, hashes and EL8 ABI")


def materialized_wheel(path):
    """(whole-wheel path, temp path or None) for a wheel or its `.part-NNN` set."""
    if not path.endswith(".part-000"):
        return path, None
    out = tempfile.NamedTemporaryFile(prefix=".wheelhouse-", suffix=".whl", delete=False)
    with out:
        with open(path, "rb") as first:
            out.write(first.read())
        base = path[: -len("-000")]
        index = 1
        while os.path.exists(f"{base}-{index:03d}"):
            with open(f"{base}-{index:03d}", "rb") as part:
                out.write(part.read())
            index += 1
    return out.name, out.name


def main():
    version = shipped_python_version()
    if not version:
        fail("no portable-python archive in payload/ -- cannot audit the wheelhouse")
        return 1
    ok(f"payload ships portable-python {version} (ABI tag cp{version.replace('.', '')})")
    MARKER_VALUES["python_version"] = version
    MARKER_VALUES["python_full_version"] = version + ".0"
    MARKER_VALUES["implementation_version"] = version + ".0"

    if not os.path.isdir(WHEELS_DIR):
        fail(f"no wheelhouse at {WHEELS_DIR}")
        return 1

    # Index the wheelhouse: normalized name -> [(filename, path, meta)].
    # Chunked wheels are indexed by their logical name; metadata needs a
    # seekable whole wheel, so the parts are rejoined to a temp file.
    index = {}
    paths = sorted(glob.glob(os.path.join(WHEELS_DIR, "*.whl"))) + sorted(
        glob.glob(os.path.join(WHEELS_DIR, "*.whl.part-000"))
    )
    for path in paths:
        if path.endswith(".part-000"):
            filename = os.path.basename(path)[: -len(".part-000")]
        else:
            filename = os.path.basename(path)
        whole, temp = materialized_wheel(path)
        try:
            meta = wheel_metadata(whole)
        finally:
            if temp:
                os.unlink(temp)
        if meta is None:
            continue
        name, _ver, _req = meta
        index.setdefault(normalize(name), []).append((filename, path, meta))

    ok(f"wheelhouse: {sum(len(v) for v in index.values())} wheels, {len(index)} distributions")

    # A wheel the shipped interpreter cannot install is dead weight in every
    # release: no closure can use it. The 3.15 sweep left 30 cp314 wheels
    # (238 MB) that nothing could install; pruned 2026-10-28 (DEBT-1).
    dead = sorted(
        fn for entries in index.values() for fn, _p, _m in entries if not wheel_is_abi_compatible(fn, version)
    )
    if dead:
        fail(
            f"{len(dead)} wheel(s) the shipped cp{version.replace('.', '')} interpreter cannot install "
            f"(prune them, or fetch the cp{version.replace('.', '')}/abi3 build): " + ", ".join(dead)
        )
    else:
        ok(f"every bundled wheel installs under cp{version.replace('.', '')} on EL8")

    try:
        import json

        with open(PAYLOADS_JSON) as fh:
            packages = json.load(fh)["packages"]
    except OSError, KeyError, ValueError:
        fail("cannot read payload/packages.json")
        return 1

    tools = {n: e for n, e in packages.items() if e.get("kind") == "python-tool"}
    if not tools:
        ok("no python-tools in the registry")
        return 0

    bad = []
    for tool_name, entry in sorted(tools.items()):
        if entry.get("disabled"):
            continue  # out of service: it is not installed, so it cannot fail
        spec = entry.get("uv_tool", "")
        root = normalize(spec)
        candidates = index.get(root, [])
        if not candidates:
            bad.append(f"{tool_name}: no wheel for '{spec}' in the wheelhouse")
            continue
        # Walk the closure over the wheelhouse, ABI-compatibility first.
        seen = set()
        queue = [root]
        problems = []
        while queue:
            current = queue.pop()
            if current in seen:
                continue
            seen.add(current)
            entries = index.get(current, [])
            usable = [e for e in entries if wheel_is_abi_compatible(e[0], version)]
            if not usable:
                if entries:
                    problems.append(
                        f"{current} (bundled only as {', '.join(e[0] for e in entries)} -- "
                        f"no cp{version.replace('.', '')}/abi3/py3-none-any wheel)"
                    )
                else:
                    problems.append(f"{current} (no wheel in the wheelhouse)")
                continue
            _fn, _p, (_n, _v, requires) = usable[0]
            for req in requires:
                dep = requirement_name(req)
                if not dep:
                    continue
                # A requirement guarded by an environment marker only applies on
                # the target: "tomli; python_version < '3.11'" is not a
                # dependency of a 3.15 install.
                marker = req.split(";", 1)[1].strip() if ";" in req else ""
                if not marker_applies(marker):
                    continue
                queue.append(normalize(dep))
        if problems:
            bad.append(f"{tool_name}: " + "; ".join(sorted(set(problems))))

    for problem in bad:
        fail(problem)
    if not bad:
        ok(f"all {len(tools)} python-tools resolve offline under cp{version.replace('.', '')}")

    if os.path.isfile(SUITE_LOCK):
        audit_suite(version)
    else:
        ok("no python-loaded lock in the payload")

    print()
    if FAILURES:
        print(f"wheelhouse-closure: {len(FAILURES)} failure(s)")
        return 1
    print("wheelhouse-closure: OK")
    return 0


def self_test():
    """Pin the predicate's EL8/ABI rules independently of the payload."""
    cases = [
        ("x-1-py3-none-any.whl", True),
        ("x-1-py2.py3-none-any.whl", True),
        ("x-1-py3-none-manylinux_2_28_x86_64.whl", True),
        ("x-1-py3-none-manylinux2014_x86_64.whl", True),
        ("x-1-cp36-abi3-manylinux_2_17_x86_64.whl", True),
        ("x-1-cp315-abi3.abi3t-manylinux_2_28_x86_64.whl", True),
        ("x-1-cp315-cp315-manylinux_2_28_x86_64.whl", True),
        ("x-1-cp315-cp315-manylinux_2_39_x86_64.whl", False),
        ("x-1-cp315-cp315-musllinux_1_2_x86_64.whl", False),
        ("x-1-cp314-cp314-manylinux_2_28_x86_64.whl", False),
        ("x-1-py3-none-win_amd64.whl", False),
    ]
    failed = 0
    for filename, expected in cases:
        got = wheel_is_abi_compatible(filename, "3.15")
        if got == expected:
            print(f"  OK    {filename} -> {got}")
        else:
            print(f"  FAIL  {filename} -> {got}, expected {expected}")
            failed += 1
    print()
    if failed:
        print(f"wheelhouse-closure self-test: {failed} failure(s)")
        return 1
    print("wheelhouse-closure self-test: OK")
    return 0


if __name__ == "__main__":
    if "--self-test" in sys.argv[1:]:
        sys.exit(self_test())
    sys.exit(main())
