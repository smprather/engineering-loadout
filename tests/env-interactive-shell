#!/bin/sh
# env-interactive-shell: LOADOUT_CFG_INTERACTIVE_SHELL switches the interactive
# shell with a one-shot exec near the top of the rc, and only there.
#
# Design: docs/superpowers/specs/2026-11-05-interactive-shell-design.md (D1-D4,
# D9). The bracketed numbers after each case letter are its Verification items.
# bash and zsh share one implementation, loadout_exec_interactive_shell in
# envs/bash/functions.sh. tcsh and csh have their own block in
# envs/tcsh/global/tcshrc plus helpers/resolve-shell (the tc-* cases).
#
# HARNESS TRAPS (as in tests/install-env-zsh), each of which gives a green run
# that proves nothing:
#
#   1. `SHELL -i -c CMD` does not drive the line editor, and it is exactly the
#      case the exec must NOT fire for, so commands are typed on stdin.
#   2. a piped stdin with no controlling terminal is not a real session, so a
#      PTY is required -- hence `script -qec`.
#   3. under `script` the child's diagnostics come back on STDOUT, so the
#      output is scanned for noise (assert_quiet), not just stderr.
#
# Every shell runs under `env -i`: the developer's own exported LOADOUT_CFG_*,
# LOADOUT_SHELL_EXEC and SHELL would otherwise decide the result. `script -c`
# runs its command through "$SHELL -c"; with SHELL=zsh that outer zsh reads
# ~/.zshenv non-interactively first, which never execs and only adds PATH rows.
set -eu

REPO="$(cd "$(dirname "$0")/.." && pwd)"

if ! command -v zsh >/dev/null 2>&1; then
    echo "SKIP: env-interactive-shell (no zsh interpreter)"
    exit 77
fi
if ! command -v script >/dev/null 2>&1; then
    echo "SKIP: env-interactive-shell (no 'script' for a PTY)"
    exit 77
fi

# Resolved here, before any `env -i` leaves PATH=/usr/bin:/bin.
BASH_BIN=$(command -v bash)
ZSH_BIN=$(command -v zsh)
TCSH_BIN=$(command -v tcsh || true) # the tcsh cases
TMUX_BIN=$(command -v tmux || true)

T="$(mktemp -d "${TMPDIR:-/tmp}/loadout-env-ishell.XXXXXX")"
H="$T/home"
mkdir -p "$H"
TMUX_SOCKETS=""
cleanup() {
    # Only the private servers this test started; never the default socket.
    # tmux leaves its socket file behind when a server exits, so remove it too.
    # The servers run under env -i, so TMUX_TMPDIR is unset and the socket dir
    # is tmux's default.
    for _s in $TMUX_SOCKETS; do
        env -i PATH=/usr/bin:/bin "$TMUX_BIN" -L "$_s" kill-server >/dev/null 2>&1 || true
        rm -f "/tmp/tmux-$(id -u)/$_s"
    done
    chmod -R u+w "$T" 2>/dev/null || true
    rm -rf "$T"
}
trap cleanup EXIT
fail() { echo "FAIL: $*" >&2; exit 1; }

# Strip OSC sequences BEFORE CSI ones (see tests/install-env-zsh): command
# output arrives glued to OSC 133/7 markers.
strip_escapes() {
    sed -e 's/\x1b\][^\x1b\x07]*\(\x07\|\x1b\\\)//g' \
        -e 's/\x1b\[[0-9;?]*[a-zA-Z]//g' \
        -e 's/\x1b[()][A-Za-z0-9]//g'
}

# pty ORIGIN_CMD CMDS [VAR=value ...]: start ORIGIN_CMD under a PTY in a clean
# environment plus the given assignments, type CMDS, then `exit`.
pty() {
    _origin=$1
    _cmds=$2
    shift 2
    printf '%s\nexit\n' "$_cmds" \
        | env -i HOME="$H" TERM=xterm PATH=/usr/bin:/bin "$@" \
              timeout 20 script -qec "$_origin" /dev/null 2>&1 \
        | tr -d '\r' \
        | strip_escapes
}

# set_pref VALUE [EXTRA_BASH_LINE] [EXTRA_CSH_LINE]: the documented user-layer
# line, for both login-shell families (zsh reads the bash layers).
set_pref() {
    mkdir -p "$H/.config/bash/user" "$H/.config/tcsh/user"
    printf 'export LOADOUT_CFG_INTERACTIVE_SHELL="%s"\n%s\n' "$1" "${2:-}" \
        > "$H/.config/bash/user/config.sh"
    printf 'setenv LOADOUT_CFG_INTERACTIVE_SHELL "%s"\n%s\n' "$1" "${3:-}" \
        > "$H/.config/tcsh/user/config.csh"
}

# Backticks and $$ work in all three shells. The echoed input line never holds
# `PROBE_comm=<name>`: its fields are the backtick commands themselves.
PROBE='echo PROBE_comm=`ps -o comm= -p $$` PROBE_marker=`printenv LOADOUT_SHELL_EXEC` PROBE_shell=`printenv SHELL`'
LOGIN_BASH='shopt -q login_shell && echo PROBE_login=yes || echo PROBE_login=no'
LOGIN_ZSH='[[ -o login ]] && echo PROBE_login=yes || echo PROBE_login=no'
LOGIN_TCSH='echo PROBE_loginsh=$?loginsh'

# expect_probe OUT COMM MARKER SHELL LABEL: the line PROBE printed.
expect_probe() {
    _got=$(printf '%s\n' "$1" \
        | grep -o 'PROBE_comm=[^ ]* PROBE_marker=[^ ]* PROBE_shell=[^ ]*' \
        | tail -n 1) || true
    [ "$_got" = "PROBE_comm=$2 PROBE_marker=$3 PROBE_shell=$4" ] \
        || fail "$5: expected [PROBE_comm=$2 PROBE_marker=$3 PROBE_shell=$4], got [$_got]
$1"
}

# expect_probe_csh_login OUT COMM MARKER LABEL: expect_probe without the SHELL
# field, for a tcsh/csh LOGIN shell that PROBE runs in: its system login file
# may set SHELL itself (Arch's /etc/csh.login runs `setenv SHELL /bin/tcsh`).
expect_probe_csh_login() {
    _got=$(printf '%s\n' "$1" \
        | grep -o 'PROBE_comm=[^ ]* PROBE_marker=[^ ]*' \
        | tail -n 1) || true
    [ "$_got" = "PROBE_comm=$2 PROBE_marker=$3" ] \
        || fail "$4: expected [PROBE_comm=$2 PROBE_marker=$3], got [$_got]
$1"
}

# has_line OUT TEXT: a whole output line equals TEXT. The typed lines carry
# these strings too, but never alone on a line.
has_line() { printf '%s\n' "$1" | grep -qxF "$2"; }

# assert_quiet OUT LABEL: startup stays silent whatever the value is.
assert_quiet() {
    # zsh spells it 'no such file', bash 'No such file'. The second row is
    # tcsh's own vocabulary (tests/install-env-tcsh, assert_no_csh_noise).
    for _pat in 'No such file' 'no such file' 'not found' 'Permission denied' 'command not found' \
                'bad substitution' \
                'Undefined variable' 'Badly placed' 'Expression Syntax' 'Variable syntax' \
                'Unmatched' 'Too many arguments'; do
        case $1 in
            *"$_pat"*) fail "$2: the shell printed '$_pat':
$1" ;;
        esac
    done
}

HOME="$H" "$REPO/loadout" install -y env-bash env-zsh env-tcsh --no-backup >/dev/null

# --- fixtures ----------------------------------------------------------------
mkdir -p "$T/bin" "$T/prefix/bin" "$T/emptyprefix/bin" "$T/wrap"
ln -s "$BASH_BIN" "$T/bin/mybash"
printf '#!/bin/sh\nexec "%s" "$@"\n' "$ZSH_BIN" > "$T/bin/zshwrap"
cp "$T/bin/zshwrap" "$T/wrap/zsh"
printf '#!/bin/sh\necho "PROBE_oddsh_args=[$*]"\nexec "%s"\n' "$ZSH_BIN" > "$T/bin/oddsh"
chmod 755 "$T/bin/zshwrap" "$T/bin/oddsh" "$T/wrap/zsh"
ln -s "$ZSH_BIN" "$T/prefix/bin/zsh"
: > "$T/notexec"
chmod 644 "$T/notexec"
# Executable files that cannot run as a shell. brokensh stands in for a target
# whose loader fails (missing library): it dies after execve succeeds.
printf '#!/no/such/interp\necho x\n' > "$T/bin/badshebang"
printf '#!/bin/sh\nexit 127\n' > "$T/bin/brokensh"
printf '#!/bin/sh\nexec "%s" "$@"\n' "$ZSH_BIN" > "$T/bin/relsh"
chmod 755 "$T/bin/badshebang" "$T/bin/brokensh" "$T/bin/relsh"

# --- a [1]: bash login -> zsh, login preserved ----------------------------------
set_pref "$ZSH_BIN"
out=$(pty "$BASH_BIN -l" "$PROBE
$LOGIN_ZSH" SHELL="$BASH_BIN")
assert_quiet "$out" "a"
expect_probe "$out" zsh "$ZSH_BIN" "$ZSH_BIN" "a: bash login with a zsh preference"
has_line "$out" PROBE_login=yes || fail "a: the zsh target is not a login shell:
$out"

# --- b [2]: zsh login -> bash, login preserved ----------------------------------
set_pref "$BASH_BIN"
out=$(pty "$ZSH_BIN -l" "$PROBE
$LOGIN_BASH" SHELL="$ZSH_BIN")
assert_quiet "$out" "b"
expect_probe "$out" bash "$BASH_BIN" "$BASH_BIN" "b: zsh login with a bash preference"
has_line "$out" PROBE_login=yes || fail "b: the bash target is not a login shell:
$out"

# --- c [3,9]: a typed bash inside the switched zsh stays bash ------------------
set_pref "$ZSH_BIN"
out=$(pty "$BASH_BIN -l" "bash
$PROBE
printenv LOADOUT_CFG_INTERACTIVE_SHELL
exit" SHELL="$BASH_BIN")
assert_quiet "$out" "c"
expect_probe "$out" bash "$ZSH_BIN" "$ZSH_BIN" "c: bash typed inside the switched zsh"
has_line "$out" "$ZSH_BIN" || fail "c: the child does not see the preference:
$out"

# --- d [4]: non-interactive shells never exec (no PTY) ------------------------
# `-l -c` is what makes the bash half real: plain `bash -c` reads no rc at all.
for _flags in "-c" "-l -c"; do
    # shellcheck disable=SC2086
    out=$(env -i HOME="$H" TERM=xterm PATH=/usr/bin:/bin SHELL="$BASH_BIN" \
        timeout 20 "$BASH_BIN" $_flags 'echo PROBE_c=$BASH_VERSION' </dev/null 2>&1) || true
    printf '%s\n' "$out" | grep -q '^PROBE_c=[0-9]' \
        || fail "d: bash $_flags did not run its command in bash: [$out]"
    assert_quiet "$out" "d: bash $_flags"
done
set_pref "$BASH_BIN"
for _flags in "-c" "-l -c"; do
    # shellcheck disable=SC2086
    out=$(env -i HOME="$H" TERM=xterm PATH=/usr/bin:/bin SHELL="$ZSH_BIN" \
        timeout 20 "$ZSH_BIN" $_flags 'echo PROBE_c=$ZSH_VERSION' </dev/null 2>&1) || true
    printf '%s\n' "$out" | grep -q '^PROBE_c=[0-9]' \
        || fail "d: zsh $_flags did not run its command in zsh: [$out]"
    assert_quiet "$out" "d: zsh $_flags"
done

# --- e [5]: empty, then no line at all -> today's behaviour ---------------------
set_pref ""
out=$(pty "$BASH_BIN -l" "$PROBE" SHELL="$BASH_BIN")
assert_quiet "$out" "e"
expect_probe "$out" bash "" "$BASH_BIN" "e: empty preference"
rm -f "$H/.config/bash/user/config.sh" "$H/.config/tcsh/user/config.csh"
out=$(pty "$BASH_BIN -l" "$PROBE" SHELL="$BASH_BIN")
assert_quiet "$out" "e"
expect_probe "$out" bash "" "$BASH_BIN" "e: no preference line"

# --- f [6], k: missing, not executable, typo -> no exec, no output ------------
for _v in /nonexistent/zsh "$T/notexec" zhs no-such-shell; do
    set_pref "$_v"
    out=$(pty "$BASH_BIN -l" "$PROBE" SHELL="$BASH_BIN")
    assert_quiet "$out" "f/k: $_v"
    expect_probe "$out" bash "" "$BASH_BIN" "f/k: unusable preference $_v"
done

# --- g [7]: a symlink to the running shell -> no exec -------------------------
set_pref "$T/bin/mybash"
out=$(pty "$BASH_BIN -l" "$PROBE" SHELL="$BASH_BIN")
assert_quiet "$out" "g"
expect_probe "$out" bash "" "$BASH_BIN" "g: symlink to the running bash"

# --- h [7]: a wrapper script -> exactly one exec, no loop (the marker) --------
# $T/wrap/zsh is the load-bearing one: a login-capable name gets -l, so the
# login condition holds again in the target, and its realpath never equals
# the running zsh -- only the marker stops it (loadout's own fish is this shape).
for _v in "$T/bin/zshwrap" "$T/wrap/zsh"; do
    set_pref "$_v"
    _t0=$(date +%s)
    out=$(pty "$BASH_BIN -l" "$PROBE" SHELL="$BASH_BIN")
    [ $(($(date +%s) - _t0)) -lt 15 ] || fail "h: the wrapper target $_v ran into the timeout:
$out"
    assert_quiet "$out" "h: $_v"
    expect_probe "$out" zsh "$_v" "$_v" "h: wrapper around zsh at $_v"
done

# --- i [8]: a bare name resolves through the shared prefix first --------------
set_pref zsh "export LOADOUT_CFG_SHARED_PREFIX=$T/prefix"
out=$(pty "$BASH_BIN -l" "$PROBE" SHELL="$BASH_BIN")
assert_quiet "$out" "i"
expect_probe "$out" zsh "$T/prefix/bin/zsh" "$T/prefix/bin/zsh" "i: bare name via the shared prefix"

# --- j: ... and falls back to the inherited PATH -----------------------------
PATH_ZSH=""
for _d in /usr/bin /bin; do
    if [ -f "$_d/zsh" ] && [ -x "$_d/zsh" ]; then
        PATH_ZSH="$_d/zsh"
        break
    fi
done
if [ -n "$PATH_ZSH" ]; then
    set_pref zsh "export LOADOUT_CFG_SHARED_PREFIX=$T/emptyprefix"
    out=$(pty "$BASH_BIN -l" "$PROBE" SHELL="$BASH_BIN")
    assert_quiet "$out" "j"
    expect_probe "$out" zsh "$PATH_ZSH" "$PATH_ZSH" "j: bare name via PATH"
else
    echo "SKIP: case j (no zsh in /usr/bin or /bin)"
fi

# --- l [10]: an interactive shell given a command runs it, never execs --------
set_pref "$ZSH_BIN"
_t0=$(date +%s)
out=$(pty "$BASH_BIN -i -l -c 'echo PROBE_cmd=ran'" "" SHELL="$BASH_BIN")
[ $(($(date +%s) - _t0)) -lt 15 ] || fail "l: bash -i -l -c ran into the timeout:
$out"
assert_quiet "$out" "l: bash"
has_line "$out" PROBE_cmd=ran || fail "l: bash -i -l -c did not run its command:
$out"
set_pref "$BASH_BIN"
_t0=$(date +%s)
out=$(pty "$ZSH_BIN -i -l -c 'echo PROBE_cmd=ran'" "" SHELL="$ZSH_BIN")
[ $(($(date +%s) - _t0)) -lt 15 ] || fail "l: zsh -i -l -c ran into the timeout:
$out"
assert_quiet "$out" "l: zsh"
has_line "$out" PROBE_cmd=ran || fail "l: zsh -i -l -c did not run its command:
$out"

# --- m [11]: a non-login origin gives a non-login target ----------------------
set_pref "$ZSH_BIN"
out=$(pty "$BASH_BIN -i" "$PROBE
$LOGIN_ZSH" SHELL="$BASH_BIN")
assert_quiet "$out" "m"
expect_probe "$out" zsh "$ZSH_BIN" "$ZSH_BIN" "m: non-login bash with a zsh preference"
has_line "$out" PROBE_login=no || fail "m: the target of a non-login origin is a login shell:
$out"

# --- n [11]: an unknown target basename gets no -l ----------------------------
set_pref "$T/bin/oddsh"
out=$(pty "$BASH_BIN -l" "$PROBE" SHELL="$BASH_BIN")
assert_quiet "$out" "n"
has_line "$out" "PROBE_oddsh_args=[]" || fail "n: oddsh was not exec'd without arguments:
$out"
expect_probe "$out" zsh "$T/bin/oddsh" "$T/bin/oddsh" "n: unknown target basename"

# --- o [12]: a relative path or a value with arguments -> no exec, no output --
for _v in bin/zsh "zsh -l"; do
    set_pref "$_v"
    out=$(pty "$BASH_BIN -l" "$PROBE" SHELL="$BASH_BIN")
    assert_quiet "$out" "o: $_v"
    expect_probe "$out" bash "" "$BASH_BIN" "o: rejected preference [$_v]"
done

# --- p [13]: SHELL=/bin/sh (cron) is not a top-level spawn ---------------------
set_pref "$ZSH_BIN"
case $(readlink -f /bin/sh) in
    */bash)
        out=$(pty "$BASH_BIN -i" "$PROBE" SHELL=/bin/sh)
        assert_quiet "$out" "p"
        expect_probe "$out" bash "" /bin/sh "p: SHELL=/bin/sh"
        ;;
    *) echo "SKIP: case p (/bin/sh is not bash on this host)" ;;
esac

# --- q: no inherited SHELL, or one that does not exist -> no exec -------------
# With SHELL unset, `script` itself falls back to /bin/sh. bash then fills in
# its own (unexported) SHELL from passwd, which must not count as inherited.
out=$(pty "$BASH_BIN -i" "$PROBE")
assert_quiet "$out" "q: SHELL unset"
expect_probe "$out" bash "" "" "q: SHELL unset"
out=$(pty "env SHELL=/nonexistent/bash $BASH_BIN -i" "$PROBE")
assert_quiet "$out" "q: SHELL=/nonexistent/bash"
expect_probe "$out" bash "" /nonexistent/bash "q: SHELL=/nonexistent/bash"

# --- r: the preference is the running shell -> no exec, no marker -------------
set_pref "$BASH_BIN"
out=$(pty "$BASH_BIN -l" "$PROBE" SHELL="$BASH_BIN")
assert_quiet "$out" "r"
expect_probe "$out" bash "" "$BASH_BIN" "r: preference is the running bash"

# --- s: resolution never consults functions or aliases ------------------------
set_pref zsh "export LOADOUT_CFG_SHARED_PREFIX=$T/prefix
zsh() { echo PROBE_hijack; }"
out=$(pty "$BASH_BIN -l" "$PROBE" SHELL="$BASH_BIN")
assert_quiet "$out" "s"
expect_probe "$out" zsh "$T/prefix/bin/zsh" "$T/prefix/bin/zsh" "s: a zsh() function in the user layer"
case $out in
    *PROBE_hijack*) fail "s: the resolver ran the zsh() function:
$out" ;;
esac

# --- u: an executable that cannot run here -> no exec, the origin survives ---
# The target is probed with `-c :` first; a bad interpreter (or exec format)
# error would otherwise kill the login shell, and a loader failure would kill
# the already-replaced process. The PROBE line printing proves the origin lived.
set_pref "$T/bin/badshebang"
out=$(pty "$BASH_BIN -l" "$PROBE" SHELL="$BASH_BIN")
assert_quiet "$out" "u: bad interpreter, bash origin"
expect_probe "$out" bash "" "$BASH_BIN" "u: bad interpreter, bash origin"
out=$(pty "$ZSH_BIN -l" "$PROBE" SHELL="$ZSH_BIN")
assert_quiet "$out" "u: bad interpreter, zsh origin"
expect_probe "$out" zsh "" "$ZSH_BIN" "u: bad interpreter, zsh origin"
set_pref "$T/bin/brokensh"
out=$(pty "$BASH_BIN -l" "$PROBE" SHELL="$BASH_BIN")
assert_quiet "$out" "u: target that fails to start"
expect_probe "$out" bash "" "$BASH_BIN" "u: target that fails to start"

# --- v: a bare name only a RELATIVE PATH entry reaches -> no exec -------------
# SHELL and the marker must be absolute, so relative PATH entries are skipped.
set_pref relsh
out=$(pty "cd '$T' && PATH=bin:/usr/bin:/bin exec $BASH_BIN -l" "$PROBE" SHELL="$BASH_BIN")
assert_quiet "$out" "v"
expect_probe "$out" bash "" "$BASH_BIN" "v: bare name on a relative PATH entry"

# --- w: an interactive shell given a SCRIPT runs it, never execs --------------
# `bash -i FILE`, `zsh -i FILE` and a `#!/bin/bash -i` script read the rc and
# then run FILE. Desktop launchers and systemd user services export the passwd
# SHELL, so with no marker the rest of the top-level-spawn test holds; only the
# script-operand guard keeps the script alive (an exec would drop FILE).
printf 'echo PROBE_script=ran\n' > "$T/s.sh"
printf '#!%s -i\necho PROBE_script=ran\n' "$BASH_BIN" > "$T/shebang.sh"
chmod 755 "$T/shebang.sh"
# w_case ORIGIN_CMD SHELL TARGET_COMM
w_case() {
    _t0=$(date +%s)
    out=$(pty "$1" "$PROBE" SHELL="$2")
    [ $(($(date +%s) - _t0)) -lt 15 ] || fail "w: [$1] ran into the timeout:
$out"
    assert_quiet "$out" "w: $1"
    has_line "$out" PROBE_script=ran || fail "w: [$1] did not run its script:
$out"
    case $out in
        *"PROBE_comm=$3 "*) fail "w: [$1] switched to $3:
$out" ;;
    esac
}
set_pref "$ZSH_BIN"
for _origin in "$BASH_BIN -i $T/s.sh" "$BASH_BIN -i -l $T/s.sh" "$T/shebang.sh"; do
    w_case "$_origin" "$BASH_BIN" zsh
done
set_pref "$BASH_BIN"
for _origin in "$ZSH_BIN -i $T/s.sh" "$ZSH_BIN -i -l $T/s.sh"; do
    w_case "$_origin" "$ZSH_BIN" bash
done

# --- w-argv: the bash < 5.2 half of that guard, on any bash -------------------
# Before 5.2, bash still says $0=bash while the rc runs, so the guard reads the
# script operand off /proc/$$/cmdline (loadout_bash_argv_has_script). The PTY
# cases above take the $0 branch on a newer bash, so the parser is pinned here
# on fixture argv files: each line is the answer, then one argv, `|`-separated
# (written NUL-terminated, as /proc/PID/cmdline is).
_argv_rc() {
    printf '%s|' "$1" | tr '|' '\0' > "$T/argv"
    "$BASH_BIN" -c '. "$0"; loadout_bash_argv_has_script "$1"' \
        "$REPO/envs/bash/functions.sh" "$T/argv" && echo script || echo none
}
while IFS=' ' read -r _want _argv; do
    _got=$(_argv_rc "$_argv")
    [ "$_got" = "$_want" ] || fail "w-argv: [$_argv] gave $_got, expected $_want"
done <<'EOF'
none -bash
none bash
none /usr/bin/bash|-l
none bash|-i
none bash|--login
none bash|--login|-i
none bash|--noprofile|--norc|-i
none bash|--rcfile|/x/rc|-i
none bash|--init-file|/x/rc
none bash|-o|vi|-i
none bash|+O|extglob|-i
none bash|-io|vi
none bash|-i|-s|x|y
none bash|-is|x
none bash|-i|--
none bash|-i|-c|echo x
script bash|-i|/t/s.sh
script bash|-i|-l|/t/s.sh
script bash|-il|/t/s.sh|a|b
script bash|-i|--|/t/s.sh
script bash|-i|-|/t/s.sh
script bash|--norc|-i|/t/s.sh
script bash|--rcfile|/x/rc|-i|/t/s.sh
script bash|-o|vi|/t/s.sh
script bash|-oO|vi|extglob|/t/s.sh
script /usr/bin/bash|-i|/t/shebang.sh
EOF
_got=$(_argv_rc "bash|-i"; "$BASH_BIN" -c '. "$0"; loadout_bash_argv_has_script /nonexistent/cmdline' \
    "$REPO/envs/bash/functions.sh" 2>&1 && echo script || echo none)
[ "$_got" = "none
none" ] || fail "w-argv: an unreadable argv file is not 'no script', silently: [$_got]"

# --- t [14]: tmux panes -------------------------------------------------------
if [ -n "$TMUX_BIN" ]; then
    set_pref "$ZSH_BIN"
    for _case in a b; do
        _sock="el-ishell-$$-$_case"
        if [ "$_case" = a ]; then
            _marker="" _want=zsh
        else
            _marker="LOADOUT_SHELL_EXEC=$ZSH_BIN" _want=bash
        fi
        TMUX_SOCKETS="$TMUX_SOCKETS $_sock"
        env -i HOME="$H" SHELL="$BASH_BIN" TERM=xterm-256color PATH=/usr/bin:/bin ${_marker:+"$_marker"} \
            "$TMUX_BIN" -L "$_sock" -f /dev/null new-session -d -s t -x 200 -y 50
        env -i PATH=/usr/bin:/bin "$TMUX_BIN" -L "$_sock" \
            send-keys -t t 'echo PROBE_pane=$(ps -o comm= -p $$)' Enter
        _i=0 _cap=""
        while [ "$_i" -lt 50 ]; do
            _cap=$(env -i PATH=/usr/bin:/bin "$TMUX_BIN" -L "$_sock" capture-pane -p -t t)
            case $_cap in *"PROBE_pane=$_want"*) break ;; esac
            sleep 0.2
            _i=$((_i + 1))
        done
        case $_cap in
            *"PROBE_pane=$_want"*) ;;
            *) fail "t$_case: expected PROBE_pane=$_want in the pane:
$_cap" ;;
        esac
        assert_quiet "$_cap" "t$_case"
        env -i PATH=/usr/bin:/bin "$TMUX_BIN" -L "$_sock" kill-server >/dev/null 2>&1 || true
    done
else
    echo "SKIP: case t (no tmux)"
fi

# --- tcsh and csh origins: the block in envs/tcsh/global/tcshrc ----------------
# The same conditions as bash/zsh, written in csh, with helpers/resolve-shell
# for the value. A case whose PROBE runs in a tcsh/csh LOGIN shell checks the
# comm and the marker only: the system csh.login may set SHELL itself.
if [ -n "$TCSH_BIN" ]; then
    # --- tc-u [2,11]: tcsh login -> zsh, login preserved ------------------------
    set_pref "$ZSH_BIN"
    out=$(pty "$TCSH_BIN -l" "$PROBE
$LOGIN_ZSH" SHELL="$TCSH_BIN")
    assert_quiet "$out" "tc-u"
    expect_probe "$out" zsh "$ZSH_BIN" "$ZSH_BIN" "tc-u: tcsh login with a zsh preference"
    has_line "$out" PROBE_login=yes || fail "tc-u: the zsh target is not a login shell:
$out"

    # --- tc-v [2,11]: tcsh login -> bash, login preserved -----------------------
    set_pref "$BASH_BIN"
    out=$(pty "$TCSH_BIN -l" "$PROBE
$LOGIN_BASH")
    assert_quiet "$out" "tc-v"
    expect_probe "$out" bash "$BASH_BIN" "$BASH_BIN" "tc-v: tcsh login with a bash preference"
    has_line "$out" PROBE_login=yes || fail "tc-v: the bash target is not a login shell:
$out"

    # --- tc-w [11]: non-login tcsh, inherited SHELL=tcsh -> non-login zsh -------
    set_pref "$ZSH_BIN"
    out=$(pty "$TCSH_BIN -i" "$PROBE
$LOGIN_ZSH" SHELL="$TCSH_BIN")
    assert_quiet "$out" "tc-w"
    expect_probe "$out" zsh "$ZSH_BIN" "$ZSH_BIN" "tc-w: non-login tcsh with a zsh preference"
    has_line "$out" PROBE_login=no || fail "tc-w: the target of a non-login origin is a login shell:
$out"

    # --- tc-x [2,11]: zsh login -> tcsh, login preserved ------------------------
    set_pref "$TCSH_BIN"
    out=$(pty "$ZSH_BIN -l" "$PROBE
$LOGIN_TCSH" SHELL="$ZSH_BIN")
    assert_quiet "$out" "tc-x"
    expect_probe_csh_login "$out" tcsh "$TCSH_BIN" "tc-x: zsh login with a tcsh preference"
    has_line "$out" PROBE_loginsh=1 || fail "tc-x: the tcsh target is not a login shell:
$out"

    # --- tc-y [10]: tcsh -i -c runs its command and never switches --------------
    # SHELL is tcsh, so every other condition holds and $?prompt is the only
    # guard: tcsh leaves it unset under -c (the IDE environment-read shape).
    # SHELL is set by `env`, not passed to pty, so `script` itself runs /bin/sh
    # and this case alone decides whether the guard holds.
    set_pref "$ZSH_BIN"
    _t0=$(date +%s)
    out=$(pty "env SHELL=$TCSH_BIN $TCSH_BIN -i -c 'echo PROBE_cmd=ran'" "")
    [ $(($(date +%s) - _t0)) -lt 15 ] || fail "tc-y: tcsh -i -c ran into the timeout:
$out"
    assert_quiet "$out" "tc-y"
    has_line "$out" PROBE_cmd=ran || fail "tc-y: tcsh -i -c did not run its command:
$out"

    # --- tc-z [3,9]: a tcsh typed inside the switched zsh stays tcsh ------------
    set_pref "$ZSH_BIN"
    out=$(pty "$TCSH_BIN -l" "tcsh
$PROBE
exit")
    assert_quiet "$out" "tc-z"
    expect_probe "$out" tcsh "$ZSH_BIN" "$ZSH_BIN" "tc-z: tcsh typed inside the switched zsh"

    # --- tc-aa [8]: a bare name resolves through the shared prefix, not an alias
    # tcsh's own `which` answers with aliases first; the helper never sees one.
    set_pref zsh "" "setenv LOADOUT_CFG_SHARED_PREFIX $T/prefix
alias zsh 'echo PROBE_hijack'"
    out=$(pty "$TCSH_BIN -l" "$PROBE")
    assert_quiet "$out" "tc-aa"
    expect_probe "$out" zsh "$T/prefix/bin/zsh" "$T/prefix/bin/zsh" "tc-aa: bare name via the shared prefix"
    case $out in
        *PROBE_hijack*) fail "tc-aa: the resolver ran the zsh alias:
$out" ;;
    esac

    # --- tc-ab [6]: a missing target -> no switch, no output --------------------
    set_pref /nonexistent/zsh
    out=$(pty "$TCSH_BIN -l" "$PROBE")
    assert_quiet "$out" "tc-ab"
    expect_probe_csh_login "$out" tcsh "" "tc-ab: missing target"

    # --- tc-ac: csh is tcsh on EL8/EL9, and it reads ~/.tcshrc ------------------
    case $(readlink -f /bin/csh 2>/dev/null) in
        */tcsh)
            set_pref "$ZSH_BIN"
            out=$(pty "/bin/csh -l" "$PROBE
$LOGIN_ZSH")
            assert_quiet "$out" "tc-ac"
            expect_probe "$out" zsh "$ZSH_BIN" "$ZSH_BIN" "tc-ac: csh login with a zsh preference"
            has_line "$out" PROBE_login=yes || fail "tc-ac: the zsh target is not a login shell:
$out"
            ;;
        *) echo "SKIP: case tc-ac (/bin/csh is not tcsh on this host)" ;;
    esac

    # --- tc-q: no inherited SHELL, or one that does not exist -> no switch ------
    # The twin of q. tcsh never fills in SHELL itself (it sets only the lowercase
    # $shell, which always names the running tcsh), so with SHELL absent from
    # the environment a non-login tcsh is not a top-level spawn.
    set_pref "$ZSH_BIN"
    out=$(pty "$TCSH_BIN -i" "$PROBE")
    assert_quiet "$out" "tc-q: SHELL unset"
    expect_probe "$out" tcsh "" "" "tc-q: SHELL unset"
    out=$(pty "env SHELL=/nonexistent/tcsh $TCSH_BIN -i" "$PROBE")
    assert_quiet "$out" "tc-q: SHELL=/nonexistent/tcsh"
    expect_probe "$out" tcsh "" /nonexistent/tcsh "tc-q: SHELL=/nonexistent/tcsh"

    # --- tc-ad: an executable that cannot run here -> no switch (twin of u) -----
    # Without the `-c :` probe, the bad interpreter leaves a marker behind for a
    # switch that never happened, and brokensh ends the login.
    for _v in "$T/bin/badshebang" "$T/bin/brokensh"; do
        set_pref "$_v"
        out=$(pty "$TCSH_BIN -l" "$PROBE")
        assert_quiet "$out" "tc-ad: $_v"
        expect_probe_csh_login "$out" tcsh "" "tc-ad: target $_v cannot run"
    done

    # --- tc-af [6,12]: values csh would re-parse -> no switch, no output --------
    # Inside "`...`" csh substitutes and then re-parses the command, so a quote,
    # `$` or backquote in the preference, or a blank in the resolved path (here
    # a shared prefix with a space), used to print a csh error at every login.
    # Single quotes keep the csh config line itself from expanding them.
    mkdir -p "$T/sp ace/bin"
    ln -s "$ZSH_BIN" "$T/sp ace/bin/zsh"
    for _line in "setenv LOADOUT_CFG_INTERACTIVE_SHELL 'zsh\"x'" \
                 "setenv LOADOUT_CFG_INTERACTIVE_SHELL 'zs\$h'" \
                 "setenv LOADOUT_CFG_INTERACTIVE_SHELL 'zsh\`x'" \
                 "setenv LOADOUT_CFG_INTERACTIVE_SHELL zsh
setenv LOADOUT_CFG_SHARED_PREFIX '$T/sp ace'"; do
        set_pref ""
        printf '%s\n' "$_line" > "$H/.config/tcsh/user/config.csh"
        out=$(pty "$TCSH_BIN -l" "$PROBE")
        assert_quiet "$out" "tc-af: [$_line]"
        expect_probe_csh_login "$out" tcsh "" "tc-af: [$_line]"
    done

    # --- tc-ae [1,8,12]: helpers/resolve-shell agrees with the bash resolver ----
    # One contract, two implementations (D5). Run from $T, so a relative PATH
    # entry (`bin`, or an empty one) would find $T/bin's shells if either looked.
    RESOLVE="$H/.config/tcsh/global/helpers/resolve-shell"
    [ -x "$RESOLVE" ] || fail "tc-ae: helpers/resolve-shell is not installed executable"
    sh -n "$RESOLVE" || fail "tc-ae: helpers/resolve-shell has a POSIX sh syntax error"
    if command -v dash >/dev/null 2>&1; then
        dash -n "$RESOLVE" || fail "tc-ae: helpers/resolve-shell is not POSIX (dash rejected it)"
    fi
    mkdir -p "$T/rshome/.local/share/loadout/bin"
    ln -s "$ZSH_BIN" "$T/rshome/.local/share/loadout/bin/zsh"
    # rs_run PATH PREFIX VALUE [CMD...]: the answer and status of CMD (default:
    # the helper) for VALUE. PREFIX `-` leaves LOADOUT_CFG_SHARED_PREFIX unset.
    rs_run() {
        _rpath=$1 _rpre=$2 _rv=$3
        shift 3
        [ $# -gt 0 ] || set -- "$RESOLVE"
        _rpv=""
        [ "$_rpre" = - ] || _rpv="LOADOUT_CFG_SHARED_PREFIX=$_rpre"
        (cd "$T" && env -i HOME="$T/rshome" PATH="$_rpath" ${_rpv:+"$_rpv"} "$@" "$_rv") \
            && echo rc=0 || echo "rc=$?"
    }
    BASH_RESOLVE='. "$0"; loadout_resolve_interactive_shell "$1"'
    for _combo in "/usr/bin:/bin|-" "/usr/bin:/bin|" "/usr/bin:/bin|$T/prefix" \
                  "bin::$T/wrap:/usr/bin:/bin|$T/emptyprefix"; do
        _cpath=${_combo%|*} _cpre=${_combo##*|}
        for _v in "" " zsh" "zsh -l" "$(printf 'zsh\tx')" bin/zsh ./zsh /nonexistent/zsh \
                  "$T/notexec" "$T/bin" "$ZSH_BIN" "$T/bin/zshwrap" zsh relsh zshwrap no-such-shell; do
            _a=$(rs_run "$_cpath" "$_cpre" "$_v")
            _b=$(rs_run "$_cpath" "$_cpre" "$_v" "$BASH_BIN" -c "$BASH_RESOLVE" "$REPO/envs/bash/functions.sh")
            [ "$_a" = "$_b" ] || fail "tc-ae: [$_v] with PATH=$_cpath prefix=$_cpre: resolve-shell gave [$_a], the bash resolver [$_b]"
        done
    done
    # Pinned answers, so the two cannot agree on being wrong.
    [ "$(rs_run /usr/bin:/bin - zsh)" = "$T/rshome/.local/share/loadout/bin/zsh
rc=0" ] || fail "tc-ae: an unset prefix does not default to ~/.local/share/loadout"
    [ "$(rs_run "bin::$T/wrap:/usr/bin:/bin" "$T/emptyprefix" zsh)" = "$T/wrap/zsh
rc=0" ] || fail "tc-ae: the PATH walk does not skip relative entries"
    [ "$(rs_run "bin::/usr/bin:/bin" "$T/emptyprefix" relsh)" = "rc=1" ] \
        || fail "tc-ae: a name only a relative PATH entry reaches resolved"
else
    echo "SKIP: tcsh cases tc-* (no tcsh interpreter)"
fi

echo "env-interactive-shell: all cases passed"
