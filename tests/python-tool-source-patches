#!/usr/bin/env python3
"""
python-tool-source-patches -- drift guard for the installer's source patches.

loadout_main._UV_TOOL_SOURCE_PATCHES rewrites a small piece of an installed
uv_tool's own source to work around an upstream/toolchain incompatibility (see
the table's comment for the current entry and why). The shipped WHEEL BYTES
stay pristine -- the patch only touches the installed copy -- so the trust chain
over what we ship is untouched.

That design has one failure mode worth a gate: the patch is anchored on exact
upstream text, so if the pinned wheel is ever bumped and upstream moves the
code, the anchor stops matching. The installer already refuses to blind-write
in that case (it warns and leaves the file alone), but a silent no-op patch is
exactly the kind of thing that ships unnoticed. This test makes the anchor
load-bearing: every patch's `old` text must appear EXACTLY ONCE in the file it
targets inside the real payload wheel.

Asserts:
  1. The patch table is non-empty (a silently-emptied table is a no-op).
  2. Every patch's target file exists in the payload wheel.
  3. Every patch's `old` anchor occurs exactly once in that file.
  4. Every patch's `new` text is valid Python and actually contains the
     normalization it claims (so a future edit cannot turn it into a no-op).
  5. The patched result, applied to the real upstream file, is valid Python.

Must run under the bundled Python 3.14. Exits 0 if all cases pass, 1 otherwise.
"""

import importlib.util
import os
import sys
import zipfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
WHEELS = os.path.join(REPO, "payload", "el8.x86_64.glibc2p28", "wheels")

PASSED = 0
FAILED = 0


def check(condition, label):
    global PASSED, FAILED
    if condition:
        PASSED += 1
        print(f"  PASS  {label}")
    else:
        FAILED += 1
        print(f"  FAIL  {label}")


def load_installer():
    path = os.path.join(REPO, "loadout_main.py")
    spec = importlib.util.spec_from_file_location("loadout_main_under_test", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def wheel_for(dist):
    """Return (wheel_path, member_name) for a dist's sdist/wheel in the payload."""
    matches = [name for name in os.listdir(WHEELS) if name.startswith(dist + "-") and name.endswith(".whl")]
    if not matches:
        return None, None
    # Prefer the exact version the registry pins, else the newest present.
    import re

    def version_of(name):
        m = re.search(re.escape(dist) + r"-(\d[^-]*)-", name)
        return m.group(1) if m else ""

    matches.sort(key=version_of, reverse=True)
    return os.path.join(WHEELS, matches[0]), matches[0]


def main():
    print("python-tool-source-patches:")
    lm = load_installer()
    patches = lm._UV_TOOL_SOURCE_PATCHES

    check(bool(patches), "patch table is non-empty (a silent no-op is a bug)")

    # Group patches by target file so each wheel member is read once.
    by_file = {}
    for pkg, entries in patches.items():
        for entry in entries:
            by_file.setdefault((pkg, entry["path"]), []).append(entry)

    for (pkg, rel), entries in sorted(by_file.items()):
        # The patch path is relative to the tool venv root; the wheel member is
        # the same path relative to the wheel's top level.
        member_suffix = rel.split("site-packages/", 1)[-1]
        wheel_path, wheel_name = wheel_for(pkg)
        if not wheel_path:
            check(False, f"{pkg}: no wheel in payload to anchor against")
            continue
        with zipfile.ZipFile(wheel_path) as zf:
            members = [n for n in zf.namelist() if n.endswith(member_suffix)]
            if not members:
                check(False, f"{pkg}: {member_suffix} not in {wheel_name}")
                continue
            upstream = zf.read(members[0]).decode("utf-8")

        for i, entry in enumerate(entries):
            label = f"{pkg}[{i}] {member_suffix}"
            count = upstream.count(entry["old"])
            check(count == 1, f"{label}: anchor occurs exactly once (found {count})")
            if count != 1:
                continue
            new = entry["new"]
            # The replacement is a CONTEXT fragment: it is indented to match the
            # anchor and may begin with a compound-statement keyword (`else:`),
            # so it is not expected to compile on its own. The assertion that
            # matters is the patched upstream file compiling, below.
            check(
                new.strip() != entry["old"].strip(),
                f"{label}: replacement is not identical to the anchor",
            )
            patched = upstream.replace(entry["old"], new)
            try:
                compile(patched, "<patched>", "exec")
                check(True, f"{label}: patched upstream file compiles")
            except SyntaxError as exc:
                check(False, f"{label}: patched upstream file does not compile ({exc})")

    print(f"\n{PASSED} passed, {FAILED} failed")
    return 1 if FAILED else 0


if __name__ == "__main__":
    sys.exit(main())
