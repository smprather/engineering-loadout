#!/usr/bin/env python3.15
"""
payload-interpreter-abi -- the shipped payloads must agree with the shipped
interpreter.

The 2026-10-10 Python 3.15 sweep updated the interpreter in the payload
(portable-python 3.14.7 -> 3.15.0) and swept every REFERENCE to the new
version across build scripts and docs -- but it did not REBUILD the payloads
that embed or invoke that interpreter. Four shipped artifacts were left on
3.14 and broke on every host that does not happen to have a system
python3.14:

  * klayout  -- the runtime tarball's ELFs NEED libpython3.14.so.1.0, which
                no longer exists in the tree (portable-python ships 3.15).
                Every KLayout launcher died with "error while loading shared
                libraries: libpython3.14.so.1.0".
  * openroad -- the binary NEEDs libpython3.14.so.1.0 (same failure).
  * sby      -- the launcher script ran $prefix/bin/python3.14, then fell back
                to `command -v python3.14`, which resolved to a HOST
                python3.14 on the dev box and masked the defect.
  * yosys    -- the launcher script ran $prefix/bin/python3.14 with no
                fallback, so `yosys -y script.py` was dead everywhere.

This test audits the PAYLOAD (not the repo templates) for stale interpreter
references, so the class cannot ship again silently:

  1. No ELF in the payload links a libpython3.X other than the version the
     payload's portable-python provides.
  2. No interpreter version is referenced by name in a payload that does not
     match the shipped portable-python version.
  3. The payload's Python extension modules are built for the shipped ABI
     (the cpython-3XX tag on a .so must match).

Cost: findings (ELF DT_NEEDED, shebang interpreter picks) are computed per
payload ARTIFACT and cached on its (mtime_ns, size) under
${XDG_CACHE_HOME:-~/.cache}/engineering-loadout/payload-abi-scan-v1.json;
artifacts are decompressed and analysed in parallel, and only findings stay in
memory. A registry edit (packages.json) re-runs the gate but re-reads nothing
(~0.3 s); a rebuilt artifact is always re-read. Bump ANALYSE_VERSION when the
derivation changes, so stale findings are discarded.

Exits 0 when the payload is consistent, 1 otherwise.
"""

import bz2
import concurrent.futures
import glob
import io
import json
import os
import re
import subprocess
import sys
import tarfile
import tempfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PLATFORM_DIR = os.path.join(REPO, "payload", "el8.x86_64.glibc2p28")
PAYLOADS_JSON = os.path.join(REPO, "payload", "packages.json")

# Only LOAD-BEARING references count: a reference that PICKS a specific
# interpreter version to execute. Three shapes qualify:
#
#   .../bin/python3.X        a path to an interpreter in the install tree
#   command -v python3.X     an explicit version lookup on PATH
#   #!/usr/bin/env python3.X a shebang
#
# A mere mention is NOT a dependency and must not fail the gate: cloc ships a
# table of every language it knows ("'python3.10' => 'Python'"), which names
# versions without ever running one.
PICK = re.compile(
    r"bin/python3\.(\d+)"  # a path to an interpreter
    r"|(?:command -v|which)\s+python3\.(\d+)"  # an explicit version lookup
    r"|env\s+python3\.(\d+)"  # a shebang / env exec
)

# Findings are cached per payload ARTIFACT, keyed on its (mtime_ns, size):
# decompressing ~3 GB and spawning readelf per ELF is what made this gate cost
# 70 s, and a registry edit changes no artifact. The cache is derived data
# outside the repo; the payload stays the source of truth. Bump
# ANALYSE_VERSION when the derivation itself changes, so old findings are
# discarded rather than trusted.
ANALYSE_VERSION = 1
SCAN_CACHE = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "engineering-loadout",
    "payload-abi-scan-v1.json",
)

FAILURES = []


def fail(msg):
    FAILURES.append(msg)
    print(f"  FAIL  {msg}")


def ok(msg):
    print(f"  OK    {msg}")


def shipped_python_version():
    """The interpreter version the payload ships, from the archive name."""
    archives = [f for f in os.listdir(PLATFORM_DIR) if f.startswith("portable-python-") and f.endswith(".tar.bz2")]
    if not archives:
        return None
    m = re.search(r"portable-python-(\d+\.\d+\.\d+)", archives[0])
    return m.group(1) if m else None


def python_base_archives():
    """Map runtime/<archive_name> -> the CPython minor its registry entry declares.

    A `python-base` entry with `python_version` (python-3.12, python-3.13) owns a
    whole archive of artifacts built FOR that interpreter: its ELF, its scripts
    and its extension modules all legitimately name that minor, not the
    portable-python minor. Files outside such an archive stay on the shipped
    portable-python minor.
    """
    try:
        with open(PAYLOADS_JSON) as fh:
            packages = json.load(fh)["packages"]
    except OSError, KeyError, json.JSONDecodeError:
        return {}
    owned = {}
    for entry in packages.values():
        if entry.get("kind") != "python-base":
            continue
        minor = entry.get("python_version")
        if not minor:
            continue
        archive = entry.get("archive_name") or os.path.basename(entry.get("archive", ""))
        if archive:
            owned[f"runtime/{archive}"] = minor
    return owned


def python_base_minors():
    """The set of declared python-base minors (e.g. {'3.12', '3.13'})."""
    return set(python_base_archives().values())


def payload_sources():
    """(cache key, absolute path) for every top-level payload artifact."""
    out = []
    for sub in ("bin", "lib64", "runtime"):
        base = os.path.join(PLATFORM_DIR, sub)
        for name in sorted(os.listdir(base)):
            path = os.path.join(base, name)
            if os.path.isfile(path):
                out.append((f"{sub}/{name}", path))
    return out


def artifact_members(key, path):
    """[(relpath, bytes)] for one artifact, without extracting to disk."""
    if key.startswith("runtime/") and path.endswith(".tar.bz2"):
        with bz2.open(path, "rb") as fh:
            data = fh.read()
        out = []
        with tarfile.open(fileobj=io.BytesIO(data)) as tf:
            for member in tf.getmembers():
                if not member.isfile():
                    continue
                fobj = tf.extractfile(member)
                if fobj is None:
                    continue
                out.append((f"{key}:{member.name}", fobj.read()))
        return out
    if path.endswith(".bz2"):
        with bz2.open(path, "rb") as fh:
            return [(key, fh.read())]
    with open(path, "rb") as fh:
        return [(key, fh.read())]


def analyse(data):
    """Everything the gate needs from one member's BYTES.

    Findings only -- the bytes are released afterwards, so a full scan no
    longer holds every decompressed payload file in memory at once.
    """
    if data.startswith(b"\x7fELF"):
        with tempfile.NamedTemporaryFile(suffix=".elf", delete=True) as fh:
            fh.write(data)
            fh.flush()
            try:
                proc = subprocess.run(["readelf", "-d", fh.name], capture_output=True, timeout=30)
            except OSError, subprocess.TimeoutExpired:
                return {"elf": True, "needed": [], "picks": []}
        text = proc.stdout.decode("utf-8", "replace")
        return {"elf": True, "needed": re.findall(r"\(NEEDED\).*?\[([^\]]+)\]", text), "picks": []}

    empty = {"elf": False, "needed": [], "picks": []}
    if b"\x00" in data[:4096]:
        return empty  # not text
    # Only EXECUTABLE SCRIPTS can pick an interpreter. A data file that
    # merely mentions one (taplo's uv.json schema catalog lists
    # "bin/python3.10" among the interpreters uv can install) is not a
    # dependency. The marker is the shebang: a shipped launcher is a
    # script, a data file is not.
    if not data.startswith(b"#!"):
        return empty
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        return empty
    picks = []
    for m in PICK.finditer(text):
        found = next(g for g in m.groups() if g)
        picks.append([text.count("\n", 0, m.start()) + 1, m.group(0), found])
    return {"elf": False, "needed": [], "picks": picks}


def _stamp(path):
    try:
        st = os.stat(path)
    except OSError:
        return None
    return f"{st.st_mtime_ns}:{st.st_size}"


def _load_scan_cache():
    try:
        with open(SCAN_CACHE) as fh:
            data = json.load(fh)
    except OSError, ValueError:
        return {}
    if data.get("schema") != ANALYSE_VERSION:
        return {}
    return data.get("artifacts") or {}


def _save_scan_cache(entries):
    try:
        os.makedirs(os.path.dirname(SCAN_CACHE), exist_ok=True)
        tmp = f"{SCAN_CACHE}.{os.getpid()}"
        with open(tmp, "w") as fh:
            json.dump({"schema": ANALYSE_VERSION, "artifacts": entries}, fh)
        os.replace(tmp, SCAN_CACHE)
    except OSError:
        pass


def payload_members():
    """Every shipped payload member and its findings: [(rel, findings)].

    Artifacts are decompressed and analysed in parallel; an artifact whose
    (mtime_ns, size) matches the cache is replayed instead. A registry edit
    therefore costs no scan at all, and a payload rebuild only re-reads the
    artifacts that actually changed.
    """
    sources = payload_sources()
    cache = _load_scan_cache()
    results = {}
    todo = []
    for key, path in sources:
        stamp = _stamp(path)
        entry = cache.get(key)
        if stamp is not None and entry and entry.get("stamp") == stamp:
            results[key] = entry.get("members") or []
        else:
            todo.append((key, path))

    def scan(item):
        key, path = item
        try:
            members = artifact_members(key, path)
        except OSError, tarfile.TarError:
            return key, []
        return key, [[rel, analyse(data)] for rel, data in members]

    if todo:
        workers = min(8, os.cpu_count() or 4)
        with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as ex:
            for key, members in ex.map(scan, todo):
                results[key] = members

    entries = {}
    for key, path in sources:
        stamp = _stamp(path)
        if stamp is None:
            continue
        entries[key] = {"stamp": stamp, "members": results.get(key, [])}
    _save_scan_cache(entries)

    out = []
    for key, _path in sources:
        out.extend((rel, findings) for rel, findings in results.get(key, []))
    return out


def disabled_packages():
    """Packages marked disabled in the registry.

    A disabled package is excluded from every install sweep, so its payload is
    NOT part of any deployment -- a stale artifact there cannot break a user.
    It is still reported (so the debt stays visible) but it does not fail the
    gate.
    """
    try:
        with open(PAYLOADS_JSON) as fh:
            packages = json.load(fh)["packages"]
    except OSError, KeyError, json.JSONDecodeError:
        return set()
    return {name for name, entry in packages.items() if entry.get("disabled")}


def disabled_artifacts(disabled):
    """Map payload file paths -> the disabled package that owns them.

    A payload file belongs to a package through the registry's "archive"
    (a runtime tarball), "bins" (bin/ stems) and "libs" (lib64/ stems).
    """
    if not disabled:
        return {}
    try:
        with open(PAYLOADS_JSON) as fh:
            packages = json.load(fh)["packages"]
    except OSError, KeyError, json.JSONDecodeError:
        return {}
    owned = {}
    for name in disabled:
        entry = packages.get(name, {})
        for key in ("archive", "archive_name"):
            archive = entry.get(key)
            if archive:
                owned[f"runtime/{os.path.basename(archive)}"] = name
        for stem in entry.get("bins", []):
            owned[f"bin/{stem}.bz2"] = name
        for stem in entry.get("libs", []):
            owned[f"lib64/{stem}.bz2"] = name
    return owned


def test_bundled_py_matches_archive(short):
    """loadout_main.py's one Python-minor constant must name the shipped
    interpreter. It was three separate "3.15" literals (python3.15, the tool
    venvs' lib/python3.15/site-packages), so the next minor bump would have
    silently FAILed the Python-tools phase."""
    import importlib.machinery
    import importlib.util

    loader = importlib.machinery.SourceFileLoader("loadout_mod", os.path.join(REPO, "loadout_main.py"))
    spec = importlib.util.spec_from_loader("loadout_mod", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    bundled = getattr(mod, "_BUNDLED_PY", None)
    if bundled != short:
        fail(f"loadout_main._BUNDLED_PY is {bundled!r}, but the payload archive ships Python {short}")
    else:
        ok(f"loadout_main._BUNDLED_PY matches the archive ({short})")


def test_build_scripts_target_bundled_minor(short):
    """A build script that picks wheels for an interpreter must pick the
    shipped one. build-cicwave.sh and build-parity-plot.sh still ran pip3.14
    with PYVER="3.14" / --abi cp314 a fortnight after the 3.15 sweep, so a
    rebuild would have re-bundled wheels the payload interpreter cannot
    install (DEBT-1). Checked: `pip3.NN` invocations, PYVER="3.NN", and
    `--abi cp3NN` in build/*.sh. (python3.NN is not checked: the build image's
    system pythons and meld's python3.6 are legitimate.)"""
    want = short.split(".")[1]
    pattern = re.compile(r"\bpip3\.(\d+)\b|PYVER=\"3\.(\d+)\"|--abi\s+\"?cp3(\d+)")
    stale = []
    for path in sorted(glob.glob(os.path.join(REPO, "build", "*.sh"))):
        with open(path, encoding="utf-8", errors="replace") as fh:
            for lineno, line in enumerate(fh, 1):
                if line.lstrip().startswith("#"):
                    continue
                for m in pattern.finditer(line):
                    minor = next(g for g in m.groups() if g)
                    if minor != want:
                        stale.append(f"{os.path.relpath(path, REPO)}:{lineno}: {m.group(0)}")
    if stale:
        fail(f"build scripts target a Python other than {short}: " + "; ".join(stale))
    else:
        ok(f"build scripts pick wheels for the shipped Python {short} (pip3.NN / PYVER / --abi)")


def main():
    version = shipped_python_version()
    if not version:
        fail("no portable-python archive in payload/ -- cannot audit the ABI")
        return 1
    short = ".".join(version.split(".")[:2])  # 3.15
    ok(f"payload ships portable-python {version} (expecting libpython{short}.so)")

    disabled = disabled_packages()
    disabled_owned = disabled_artifacts(disabled)
    if disabled:
        ok(f"disabled (excluded from every sweep): {', '.join(sorted(disabled))}")

    base_archives = python_base_archives()
    declared_minors = sorted(python_base_minors())
    if declared_minors:
        ok(f"declared python-base minors: {', '.join(declared_minors)}")

    def owner_minor(rel):
        """The CPython minor the artifact's own archive declares; otherwise the
        portable-python minor, which owns every non-python-base artifact."""
        for prefix, minor in base_archives.items():
            if rel.startswith(prefix + ":"):
                return minor
        return short

    files = payload_members()
    ok(f"scanned {len(files)} shipped payload files")

    # An artifact owned by a disabled package is not part of any deployment,
    # so it cannot break a user -- it is reported, not failed.
    def owner(rel):
        """The disabled package owning this payload file, if any."""
        for path, pkg in disabled_owned.items():
            if rel == path or rel.startswith(path + ":"):
                return pkg
        return None

    # --- 1. ELF DT_NEEDED against the shipped libpython ----------------------
    stale_needed = {}
    disabled_stale = []
    for rel, findings in files:
        if not findings["elf"]:
            continue
        for soname in findings["needed"]:
            m = re.match(r"libpython(\d+\.\d+)\.so", soname)
            if not m:
                continue
            allowed = owner_minor(rel)
            if m.group(1) == allowed:
                continue
            pkg = owner(rel)
            if pkg:
                disabled_stale.append(f"{pkg}: {rel} -> {soname}")
                continue
            stale_needed.setdefault((allowed, m.group(1)), []).append(f"{rel} -> {soname}")
    for (allowed, found), users in sorted(stale_needed.items()):
        fail(
            f"payload ELF links libpython{found}.so but expects "
            f"libpython{allowed}.so -- {len(users)} file(s), e.g. {users[0]}"
        )
    if not stale_needed:
        ok("no payload ELF links a libpython other than its archive's minor")
    for note in sorted(set(disabled_stale)):
        ok(f"disabled package, not installed: {note}")

    # --- 2. interpreter references by name in payload scripts/strings -------
    # (PICK and the script-detection rules live next to `analyse`, which is
    # what caches them.)
    stale_ref = {}
    disabled_refs = []
    for rel, findings in files:
        if findings["elf"]:
            continue
        allowed = owner_minor(rel)
        for line_no, match_text, found in findings["picks"]:
            if found == allowed.split(".")[1]:
                continue
            if not re.fullmatch(r"1[0-9]", found):
                continue
            pkg = owner(rel)
            if pkg:
                disabled_refs.append(f"{pkg}: {rel}:{line_no}: {match_text}")
                continue
            stale_ref.setdefault((allowed, f"3.{found}"), []).append(f"{rel}:{line_no}: {match_text}")
    for (allowed, found), users in sorted(stale_ref.items()):
        fail(
            f"payload picks python{found} but its archive expects python{allowed} -- {len(users)} site(s), e.g. {users[0]}"
        )
    if not stale_ref:
        ok("no payload script picks an interpreter other than its archive's minor")
    for note in sorted(set(disabled_refs)):
        ok(f"disabled package, not installed: {note}")

    # --- 3. extension modules built for the shipped ABI ---------------------
    stale_ext = {}
    for rel, _findings in files:
        if not rel.startswith("runtime/"):
            continue
        allowed = owner_minor(rel)
        for m in re.finditer(r"cpython-(\d)(\d+)[-.]", rel):
            abi = f"{m.group(1)}.{m.group(2)}"
            if abi != allowed:
                stale_ext.setdefault((allowed, abi), []).append(rel)
    for (allowed, abi), users in sorted(stale_ext.items()):
        fail(
            f"payload ships cpython-{abi} extension modules but its archive "
            f"expects cpython-{allowed} -- {len(users)} file(s), e.g. {users[0]}"
        )
    if not stale_ext:
        ok("no payload extension module is built for an ABI other than its archive's minor")

    # --- 4. the registry's portable-python version must match ---------------
    try:
        with open(PAYLOADS_JSON) as fh:
            packages = json.load(fh)["packages"]
        reg_version = packages.get("portable-python", {}).get("version", "")
    except OSError, KeyError, json.JSONDecodeError:
        reg_version = ""
    if reg_version and not reg_version.startswith(short):
        fail(f"registry says portable-python {reg_version}, but the payload archive ships {version}")
    else:
        ok(f"registry portable-python version matches the archive ({reg_version})")

    test_bundled_py_matches_archive(short)
    test_build_scripts_target_bundled_minor(short)

    print()
    if FAILURES:
        print(f"payload-interpreter-abi: {len(FAILURES)} failure(s)")
        return 1
    print("payload-interpreter-abi: OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
