#!/bin/sh
# shim-bootstrap: ./loadout finds the right interpreter and bootstraps atomically.
#
# Order: the installed interpreter at the default install root
# (${XDG_DATA_HOME:-~/.local/share}/loadout/bin), then the legacy HOME-mode
# ~/.local/bin, then the per-clone warm cache -- accepted only when its
# .complete stamp names the current archive -- then a cold bootstrap into a
# temp dir that is moved into place only after the interpreter runs.
#
# The old shim probed only ~/.local/bin (so a default install's interpreter was
# never used), and accepted any cache that had bin/python3.15 -- including one
# left half-extracted by an interrupted bzip2|tar, or one from an older archive.
#
# Uses a copy of the shim with a stub interpreter; nothing real is extracted.
set -eu

REPO="$(cd "$(dirname "$0")/.." && pwd)"
T="$(mktemp -d "${TMPDIR:-/tmp}/loadout-shim.XXXXXX")"
trap 'rm -rf "$T"' EXIT

fail() { echo "FAIL: $*" >&2; exit 1; }

R="$T/repo"
H="$T/home"
mkdir -p "$R/payload/x" "$H"
cp "$REPO/loadout" "$R/loadout"
echo '# stub' >"$R/loadout_main.py"

stage="$T/stage/portable-python-T/local/bin"
mkdir -p "$stage"
printf '#!/bin/sh\necho STUB "$0" "$@"\n' >"$stage/python3.15"
chmod 755 "$stage/python3.15"
(cd "$T/stage" && tar cf - portable-python-T | bzip2 >"$R/payload/x/portable-python-T.tar.bz2")

shim() { env -i HOME="$H" PATH=/usr/bin:/bin "$R/loadout" "$@" 2>"$T/stderr"; }
boot="$R/.loadout-bootstrap"

# cold: extract, stamp, no temp left behind
out=$(shim hello)
case $out in STUB*) ;; *) fail "cold: did not run the bootstrapped interpreter: $out" ;; esac
[ "$(cat "$boot/.complete" 2>/dev/null)" = "portable-python-T.tar.bz2" ] \
    || fail "cold: .complete stamp is '$(cat "$boot/.complete" 2>/dev/null)'"
if ls -d "$R"/.loadout-bootstrap.tmp.* >/dev/null 2>&1; then
    fail "cold: a .loadout-bootstrap.tmp.* dir was left behind"
fi
[ ! -e "$R/.loadout-bootstrap.lock" ] || fail "cold: the bootstrap lock was left behind"
echo "  PASS  cold bootstrap stamps the cache and leaves no temp dir"

host=$(hostname 2>/dev/null || uname -n)
other_host=loadout-other-host
# concurrent: this host's live bootstrap temp survives; this host's dead one is
# cleaned. A temp named for another host is never kill-checked -- its PID space
# is not ours, and killing it would delete a live bootstrap on an NFS clone.
rm -rf "$boot"
sleep 30 &
live=$!
mkdir -p "$R/.loadout-bootstrap.tmp.$host.$live" \
    "$R/.loadout-bootstrap.tmp.$host.999999999" \
    "$R/.loadout-bootstrap.tmp.$other_host.$live" \
    "$R/.loadout-bootstrap.tmp.$other_host.999999999" \
    "$R/.loadout-bootstrap.tmp.$host.lab.999999999" \
    "$R/.loadout-bootstrap.tmp.999999999"
out=$(shim)
kill "$live" 2>/dev/null || true
case $out in STUB*) ;; *) fail "concurrent: cold bootstrap did not run: $out" ;; esac
[ -d "$R/.loadout-bootstrap.tmp.$host.$live" ] || fail "concurrent: deleted this host's live temp dir"
[ ! -e "$R/.loadout-bootstrap.tmp.$host.999999999" ] || fail "concurrent: left this host's dead temp dir"
[ -d "$R/.loadout-bootstrap.tmp.$other_host.$live" ] || fail "concurrent: deleted another host's live temp dir"
[ -d "$R/.loadout-bootstrap.tmp.$other_host.999999999" ] \
    || fail "concurrent: deleted another host's temp dir on a local PID check"
[ -d "$R/.loadout-bootstrap.tmp.999999999" ] || fail "concurrent: deleted a temp dir with no host identity"
# A host whose name extends ours ("$host.lab") is another host, not ours.
[ -d "$R/.loadout-bootstrap.tmp.$host.lab.999999999" ] \
    || fail "concurrent: deleted the temp dir of host $host.lab as if it were this host's"
rm -rf "$R/.loadout-bootstrap.tmp.$host.$live" "$R/.loadout-bootstrap.tmp.$other_host.$live" \
    "$R/.loadout-bootstrap.tmp.$other_host.999999999" "$R/.loadout-bootstrap.tmp.999999999" \
    "$R/.loadout-bootstrap.tmp.$host.lab.999999999"
echo "  PASS  live temps survive; dead ones are only cleaned when the PID is ours"

# claim: a held bootstrap lock makes a second first run wait for the published
# stamp instead of extracting and replacing the tree the first run is using.
rm -rf "$boot"
mkdir -p "$R/.loadout-bootstrap.lock"
printf '%s\n%s\n' "$host" "$$" >"$R/.loadout-bootstrap.lock/owner"
rc=0
shim >"$T/waiter.out" 2>"$T/waiter.err" &
waiter=$!
sleep 1
if ls -d "$R"/.loadout-bootstrap.tmp.* >/dev/null 2>&1; then
    fail "claim: a waiter extracted while another run held the claim"
fi
mkdir -p "$boot/bin"
printf '#!/bin/sh\necho WINNER\n' >"$boot/bin/python3.15"
chmod 755 "$boot/bin/python3.15"
echo portable-python-T.tar.bz2 >"$boot/.complete"
wait "$waiter" || rc=$?
[ "$rc" = 0 ] || fail "claim: the waiter exited $rc: $(cat "$T/waiter.err")"
[ "$(cat "$T/waiter.out")" = WINNER ] || fail "claim: the waiter did not exec the published cache: $(cat "$T/waiter.out")"
rm -rf "$R/.loadout-bootstrap.lock"
echo "  PASS  a held claim makes a concurrent first run wait for the stamp"

# stale claim: an owner on this host whose PID is gone is reclaimed
rm -rf "$boot"
mkdir -p "$R/.loadout-bootstrap.lock"
false &
dead=$!
wait "$dead" 2>/dev/null || true
printf '%s\n%s\n' "$host" "$dead" >"$R/.loadout-bootstrap.lock/owner"
out=$(shim)
case $out in STUB*) ;; *) fail "stale claim: cold bootstrap did not run: $out" ;; esac
[ ! -e "$R/.loadout-bootstrap.lock" ] || fail "stale claim: the lock was not reclaimed"
echo "  PASS  a stale same-host claim is reclaimed"

# two waiters, one stale claim: reclamation must be serialized. Without a
# recovery claim, both read the dead owner, A removes it and re-acquires, and
# B's delayed rm deletes A's fresh lock -- both then extract and can repeat the
# delete-the-running-tree race. Slow this exact window: the slow rm holds one
# waiter between read and delete, and the slow tar keeps the first winner's
# claim live while the second waiter wakes.
rm -rf "$boot" "$R/.loadout-bootstrap.lock" "$R/.loadout-bootstrap.lock.reclaim"
mkdir -p "$R/.loadout-bootstrap.lock"
false &
dead=$!
wait "$dead" 2>/dev/null || true
printf '%s\n%s\n' "$host" "$dead" >"$R/.loadout-bootstrap.lock/owner"
mkdir -p "$T/slowbin"
cat >"$T/slowbin/rm" <<EOF
#!/bin/sh
case "\$*" in
    *loadout-bootstrap.lock*) if [ \$(( \$\$ % 2 )) -eq 0 ]; then sleep 3; else sleep 0.2; fi ;;
esac
exec /bin/rm "\$@"
EOF
cat >"$T/slowbin/tar" <<EOF
#!/bin/sh
echo "\$\$" >>"$T/tar.log"
sleep 5
exec /usr/bin/tar "\$@"
EOF
chmod 755 "$T/slowbin/rm" "$T/slowbin/tar"
: >"$T/tar.log"
slow_shim() {
    env -i HOME="$H" PATH="$T/slowbin:/usr/bin:/bin" "$R/loadout" "$@" 2>"$T/slow.err"
}
rc_a=0 rc_b=0
slow_shim >"$T/slow.a" 2>/dev/null & pa=$!
slow_shim >"$T/slow.b" 2>/dev/null & pb=$!
wait "$pa" || rc_a=$?
wait "$pb" || rc_b=$?
[ "$rc_a" = 0 ] && [ "$rc_b" = 0 ] || fail "stale-race: waiters exited $rc_a/$rc_b: $(cat "$T/slow.err")"
case $(cat "$T/slow.a") in STUB*) ;; *) fail "stale-race: waiter A did not exec the cache: $(cat "$T/slow.a")" ;; esac
case $(cat "$T/slow.b") in STUB*) ;; *) fail "stale-race: waiter B did not exec the cache: $(cat "$T/slow.b")" ;; esac
extractions=$(wc -l <"$T/tar.log")
[ "$extractions" = 1 ] || fail "stale-race: $extractions extractions, want exactly 1"
[ ! -e "$R/.loadout-bootstrap.lock" ] || fail "stale-race: a lock was left behind"
[ ! -e "$R/.loadout-bootstrap.lock.reclaim" ] || fail "stale-race: a recovery claim was left behind"
if ls -d "$R"/.loadout-bootstrap.tmp.* >/dev/null 2>&1; then
    fail "stale-race: a temp dir was left behind"
fi
echo "  PASS  two waiters reclaim a stale claim only once"

# xdg: the installed interpreter at the default root wins
mkdir -p "$H/.local/share/loadout/bin"
printf '#!/bin/sh\necho XDG\n' >"$H/.local/share/loadout/bin/python3.15"
chmod 755 "$H/.local/share/loadout/bin/python3.15"
out=$(shim)
case $out in XDG*) ;; *) fail "xdg: the default-root interpreter was not used: $out" ;; esac
rm -rf "$H/.local"
echo "  PASS  the default install root's interpreter is used first"

# interrupted: a cache with bin/python3.15 but no stamp is not trusted
rm -rf "$boot"
mkdir -p "$boot/bin"
printf '#!/bin/sh\necho BROKEN\n' >"$boot/bin/python3.15"
chmod 755 "$boot/bin/python3.15"
out=$(shim)
case $out in STUB*) ;; *) fail "interrupted: ran an unstamped cache: $out" ;; esac
echo "  PASS  an unstamped (interrupted) cache is re-extracted"

# stale: a stamp naming another archive is not trusted
printf '#!/bin/sh\necho OLDCACHE\n' >"$boot/bin/python3.15"
echo "portable-python-OLD.tar.bz2" >"$boot/.complete"
out=$(shim)
case $out in STUB*) ;; *) fail "stale: ran a cache stamped for another archive: $out" ;; esac
[ "$(cat "$boot/.complete")" = "portable-python-T.tar.bz2" ] || fail "stale: stamp not refreshed"
echo "  PASS  a cache stamped for another archive is re-extracted"

# no-home: no HOME and nothing to extract -> clean error, not a set -u crash
rm -rf "$boot" "$R/payload"
rc=0
env -i PATH=/usr/bin:/bin "$R/loadout" >/dev/null 2>"$T/stderr" || rc=$?
[ "$rc" = 1 ] || fail "no-home: exit $rc, want 1"
if grep -q 'parameter not set' "$T/stderr"; then
    fail "no-home: crashed on an unset HOME: $(cat "$T/stderr")"
fi
echo "  PASS  no HOME and no archive: a clean error"

echo "shim-bootstrap: OK"
