    case_nfs_remote,
]
# tcsh cannot hold an fd open on a file of its choosing (no `exec 3<`).
SHELL_ONLY = {case_nfs_this_shell: ("bash", "zsh")}


def main():
    missing = [s for s in ("bash", "zsh", "tcsh") if shutil.which(s) is None]
    if missing:
        print(f"FAIL: env-delete needs {', '.join(missing)} on PATH")
        return 1
    root = tempfile.mkdtemp(prefix="loadout-env-delete.", dir=os.environ.get("TMPDIR", "/tmp"))
    try:
        env = install_envs(root)
        bash_copy = os.path.join(env["BASH_CONFIG_ROOT_DIR"], "global", "helpers", "delete")
        tcsh_copy = os.path.join(env["TCSH_CONFIG_ROOT_DIR"], "global", "helpers", "delete")
        check("install: the bash env ships helpers/delete, executable", os.access(bash_copy, os.X_OK))
        check(
            "install: the tcsh env gets its own copy, executable (not a link)",
            os.access(tcsh_copy, os.X_OK) and not os.path.islink(tcsh_copy),
        )
        if os.path.isfile(bash_copy) and os.path.isfile(tcsh_copy):
            with open(bash_copy, "rb") as a, open(tcsh_copy, "rb") as b:
                check("install: the two copies are the same script", a.read() == b.read())
        for shell in ("bash", "zsh", "tcsh"):
            print(f"--- {shell}")
            for case in CASES + list(SHELL_ONLY):
                if shell not in SHELL_ONLY.get(case, (shell,)):
                    continue
                t = scratch(root)
                try:
                    case(shell, t, env)
                except Exception as e:  # a broken case is a failure, not a crash
                    check(f"{shell}: {case.__name__} ran", False, repr(e))
                finally:
                    heal_rmtree(t)
    finally:
        heal_rmtree(root)
    print(f"env-delete: {PASSED} passed, {len(FAILURES)} failed")
    return 1 if FAILURES else 0


if __name__ == "__main__":
    sys.exit(main())
