#!/usr/bin/env bash
# env-tmux/env-nvim: two-layer global -> user configuration, with user state
# preserved across reinstall and safe migration from the old tmux local file.
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PY=${LOADOUT_TEST_PY:-}
if [ -z "$PY" ]; then
    for candidate in "$HOME/.local/bin/python3.15" "$REPO/.loadout-bootstrap/bin/python3.15" python3.15; do
        if command -v "$candidate" >/dev/null 2>&1; then
            PY=$candidate
            break
        fi
    done
fi
[ -n "$PY" ] || { echo "ERROR: python3.15 not found" >&2; exit 1; }
tmp_root=${TMPDIR:-/tmp}
TEST_ROOT=$(mktemp -d "$tmp_root/loadout-env-two-layers.XXXXXX")
TEST_TMUX_SOCK="loadout-ffm-test-$$"
cleanup() {
    tmux -L "$TEST_TMUX_SOCK" kill-server 2>/dev/null || true
    # Managed trees are installed read-only (and backups copy those modes);
    # re-open them so rm -rf can remove the test root.
    chmod -R u+w "$TEST_ROOT" 2>/dev/null || true
    rm -rf "$TEST_ROOT"
}
trap cleanup EXIT

fail() { echo "FAIL: $*" >&2; exit 1; }
mode_of() { stat -c %a "$1"; }
assert_readonly() {
    [ "$(mode_of "$1")" = "$2" ] || fail "$1 must be mode $2 (got $(mode_of "$1"))"
}
assert_writable() {
    case $(mode_of "$1") in
        [2367]*) ;;
        *) fail "$1 must stay owner-writable (got $(mode_of "$1"))" ;;
    esac
}

fresh_home="$TEST_ROOT/fresh"
mkdir -p "$fresh_home"
HOME="$fresh_home" "$REPO/loadout" install -y env-tmux env-nvim --no-backup >"$TEST_ROOT/fresh.log" 2>&1

tmux_dir="$fresh_home/.config/tmux"
[ ! -e "$fresh_home/.tmux.conf" ] || fail "legacy ~/.tmux.conf must not be created"
grep -qF 'source-file ~/.config/tmux/tmux.conf' "$tmux_dir/tmux-global.conf" \
    || fail "Prefix+r does not source the XDG dispatcher"
[ ! -e "$fresh_home/.tmux" ] || fail "legacy ~/.tmux must not be created"
[ ! -e "$tmux_dir/tmux" ] || fail "legacy nested ~/.config/tmux/tmux must not be created"
[ -x "$tmux_dir/plugins/tpm/tpm" ] || fail "TPM not installed at the XDG plugin path"
[ -f "$tmux_dir/tmux.conf" ] || fail "tmux dispatcher not installed"
[ -f "$tmux_dir/tmux-global.conf" ] || fail "tmux global layer not installed"
[ -f "$tmux_dir/tmux-user.conf" ] || fail "tmux user layer not seeded"
[ -f "$tmux_dir/tmux-settings-global.conf" ] || fail "tmux managed settings not installed"
[ -f "$tmux_dir/tmux-settings-user.conf" ] || fail "tmux settings user layer not seeded"
[ -f "$tmux_dir/word-separators.conf" ] || fail "tmux generated word separators not installed"
for theme in tmux-theme-loadout1.conf tmux-theme-loadout2.conf; do
    [ -f "$tmux_dir/themes/$theme" ] || fail "tmux theme $theme not installed"
done
# loadout2 must not delegate any paintable option to the terminal: `default`
# means "paint nothing" for these, so the value is then the terminal's -- which
# is how the pane-fill cue came to invert on terminals whose background is
# lighter than #090909 (observed on Windows Terminal).  Every entry in this
# list must be a literal hex, or a tmux 3.8 theme name whose palette slot is a
# literal hex (`theme dark` forces the palette).
pinned_colour='(#[0-9a-fA-F]{6}|themeblack|themewhite|themelightgrey|themedarkgrey|themegreen|themeyellow|themered|themeblue|themecyan|thememagenta)'
for opt in window-style window-active-style pane-border-style pane-active-border-style \
           mode-style copy-mode-match-style copy-mode-current-match-style copy-mode-mark-style \
           copy-mode-line-number-style copy-mode-current-line-number-style \
           message-style message-command-style menu-style menu-selected-style menu-border-style \
           popup-style popup-border-style pane-scrollbars-style cursor-colour \
           clock-mode-colour display-panes-colour display-panes-active-colour \
           status-style status-left-style window-status-style window-status-current-style \
           window-status-bell-style; do
    grep -qE "^set -g ${opt} +\"[^\"]*${pinned_colour}" "$tmux_dir/themes/tmux-theme-loadout2.conf" \
        || fail "loadout2 theme leaves $opt to the terminal"
done
for helper in shell-state-export.sh tmux-3col-layout.sh tmux-popin.sh tmux-popout.sh tmux-word-separators; do
    [ -f "$tmux_dir/scripts/$helper" ] || fail "tmux helper scripts/$helper not installed"
done
# Permission contract: managed files and vendored trees are read-only; only
# the two user layers (and the top-level dir holding them) stay writable.
for managed_file in tmux.conf tmux-global.conf tmux-settings-global.conf word-separators.conf; do
    assert_readonly "$tmux_dir/$managed_file" 444
done
for managed_dir in plugins scripts themes; do
    assert_readonly "$tmux_dir/$managed_dir" 555
done
assert_readonly "$tmux_dir/scripts/tmux-3col-layout.sh" 555
assert_readonly "$tmux_dir/plugins/tpm/tpm" 555
for user_file in tmux-user.conf tmux-settings-user.conf; do
    assert_writable "$tmux_dir/$user_file"
done
# The operator's user-layer defaults were merged into the MANAGED global layer
# (2026-10-12).  A fresh install must carry them, or the out-of-box behaviour
# silently regresses: key 7 and the --left-last mode it calls, the cursor pin,
# and the copy-mode / mouse-wheel handling.
grep -qE '^bind-key +7 +run-shell .*--left-last' "$tmux_dir/tmux-global.conf" \
    || fail "global layer does not bind key 7 to the 3col --left-last layout"
grep -qF 'left-last' "$tmux_dir/scripts/tmux-3col-layout.sh" \
    || fail "3col layout script lacks the --left-last mode key 7 calls"
grep -qF 'set -g -w cursor-style block' "$tmux_dir/tmux-global.conf" \
    || fail "global layer does not pin the cursor style (window option)"
grep -qF 'bind -n WheelUpPane' "$tmux_dir/tmux-global.conf" \
    || fail "global layer lacks the merged root-wheel handling"
grep -qF 'bind -T copy-mode-vi j' "$tmux_dir/tmux-global.conf" \
    || fail "global layer lacks the copy-mode cursor-down exit handling"
# Shipped default: loadout2 in both settings layers -- the fully pinned,
# terminal-independent theme.  loadout1 is the rollback.
grep -qF 'set -g @theme "loadout2"' "$tmux_dir/tmux-settings-global.conf" \
    || fail "managed tmux settings do not default to loadout2"
# Settings merged from the operator's home layer (2026-10-20).
grep -qxF 'set -s default-terminal "tmux-256color"' "$tmux_dir/tmux-global.conf" \
    || fail "default-terminal is not the merged tmux-256color"
grep -qxF 'set -g allow-passthrough on' "$tmux_dir/tmux-global.conf" \
    || fail "allow-passthrough was not merged into the managed layer"
grep -qF "set -as terminal-features 'xterm-256color:sync'" "$tmux_dir/tmux-global.conf" \
    || fail "terminal-features sync guard is missing"
grep -qF '@terminal-features-sync' "$tmux_dir/tmux-global.conf" \
    || fail "terminal-features sync marker guard is missing"
! grep -qE "^[[:space:]]*set -g @plugin 'nhdaly/tmux-better-mouse-mode'" "$tmux_dir/tmux-global.conf" \
    || fail "shadowing mouse plugin is still declared"
grep -qF 'set -g @theme "loadout2"' "$tmux_dir/tmux-settings-user.conf" \
    || fail "seeded tmux settings user layer does not default to loadout2"
# The theme file the default selects must be the one the global layer loads.
grep -qF 'source-file -F "~/.config/tmux/themes/tmux-theme-#{@theme}.conf"' "$tmux_dir/tmux-global.conf" \
    || fail "global layer does not load the theme selected by @theme"
grep -qF 'set -g focus-follows-mouse on' "$tmux_dir/tmux-settings-global.conf" \
    || fail "managed tmux settings do not default focus-follows-mouse on"
! grep -qE '^[[:space:]]*set -g focus-follows-mouse off' "$tmux_dir/tmux-settings-global.conf" \
    || fail "managed tmux settings still disable focus-follows-mouse"
grep -qF '# set -g focus-follows-mouse off' "$tmux_dir/tmux-settings-user.conf" \
    || fail "seeded tmux settings user layer lacks the FFM opt-out hint"
! grep -qE '^[[:space:]]*set -g focus-follows-mouse (on|off)' "$tmux_dir/tmux-settings-user.conf" \
    || fail "seeded tmux settings user layer forces FFM either way"

settings_global_line=$(grep -nF 'tmux-settings-global.conf' "$tmux_dir/tmux.conf" | head -1 | cut -d: -f1)
settings_user_line=$(grep -nF 'tmux-settings-user.conf' "$tmux_dir/tmux.conf" | head -1 | cut -d: -f1)
global_line=$(grep -nF '~/.config/tmux/tmux-global.conf' "$tmux_dir/tmux.conf" | cut -d: -f1)
user_line=$(grep -nF 'tmux-user.conf' "$tmux_dir/tmux.conf" | head -1 | cut -d: -f1)
tpm_line=$(grep -nF "run '~/.config/tmux/plugins/tpm/tpm'" "$tmux_dir/tmux.conf" | cut -d: -f1)
[ -n "$settings_global_line" ] || fail "dispatcher does not source the managed settings"
[ -n "$settings_user_line" ] || fail "dispatcher does not source the settings user layer"
[ -n "$global_line" ] || fail "dispatcher does not source the global layer"
[ -n "$user_line" ] || fail "dispatcher does not source the user layer"
[ -n "$tpm_line" ] || fail "dispatcher does not initialize TPM"
((settings_global_line < settings_user_line && settings_user_line < global_line && global_line < user_line && user_line < tpm_line)) \
    || fail "dispatcher order is not settings-global -> settings-user -> global -> user -> TPM"
! grep -qF "run '~/.config/tmux/plugins/tpm/tpm'" "$tmux_dir/tmux-global.conf" \
    || fail "global layer initializes TPM before user plugin declarations"
grep -qF 'set-environment -g TMUX_PLUGIN_MANAGER_PATH "~/.config/tmux/plugins/"' "$tmux_dir/tmux-global.conf" \
    || fail "global layer does not pin the XDG plugin path"

# FFM layering on a real server: the managed baseline turns it ON and the
# user layer (sourced after it) can opt out.  Themes require tmux 3.8, and the
# block also sources both theme files, so skip older servers entirely.
tmux_bin=$(command -v tmux || true)
tmux_ver=$("$tmux_bin" -V 2>/dev/null | awk '{print $2}')
case "$tmux_ver" in
    3.8* | 3.9* | 3.[1-9][0-9]* | [4-9]*) ;;
    *) tmux_bin="" ;;
esac
if [ -n "$tmux_bin" ]; then
    tm() { HOME="$fresh_home" TERM=xterm "$tmux_bin" -L "$TEST_TMUX_SOCK" "$@"; }
    tm -f /dev/null new-session -d 'sleep 30'
    # The dispatcher sources settings before global (global interpolates @theme).
    tm source-file "$tmux_dir/tmux-settings-global.conf"
    tm source-file "$tmux_dir/tmux-global.conf"
    got=$(tm show-options -s default-terminal)
    [ "$got" = "default-terminal tmux-256color" ] \
        || fail "merged default-terminal did not take effect (got: $got)"
    got=$(tm show-options -g allow-passthrough)
    [ "$got" = "allow-passthrough on" ] \
        || fail "merged allow-passthrough did not take effect (got: $got)"
    tm show-options -g terminal-features | grep -q 'xterm-256color:sync' \
        || fail "merged terminal-features sync did not take effect"
    tm source-file "$tmux_dir/tmux-settings-global.conf"
    got=$(tm show-options -g focus-follows-mouse)
    [ "$got" = "focus-follows-mouse on" ] \
        || fail "managed baseline did not default focus-follows-mouse on (got: $got)"
    printf '%s\n' 'set -g focus-follows-mouse off' >> "$tmux_dir/tmux-settings-user.conf"
    tm source-file "$tmux_dir/tmux-settings-user.conf"
    got=$(tm show-options -g focus-follows-mouse)
    [ "$got" = "focus-follows-mouse off" ] \
        || fail "user layer did not override focus-follows-mouse (got: $got)"
    # Pane fills must be pinned, not delegated to the terminal.  window-style is
    # the fill of every pane that is NOT active; left at tmux's default it paints
    # nothing, and the active/inactive cue becomes whatever background the
    # terminal paints (see the file-level pin list above).
    tm source-file "$tmux_dir/themes/tmux-theme-loadout2.conf"
    got=$(tm show-options -s theme)
    [ "$got" = "theme dark" ] \
        || fail "loadout2 did not force the dark theme (got: $got)"
    got=$(tm show-options -s dark-theme-blue)
    case "$got" in
        *'#89b4fa'*) ;;
        *) fail "loadout2 palette did not set dark-theme-blue (got: $got)" ;;
    esac
    got=$(tm show-options -g status-style)
    case "$got" in
        *'fg=themewhite bg=themedarkgrey'*) ;;
        *) fail "loadout2 status-style does not use the palette (got: $got)" ;;
    esac
    got=$(tm show-options -g -w window-style)
    case "$got" in
        *'fg=themewhite bg=#000000'*|*'fg=#cdd6f4 bg=#000000'*) ;;
        *) fail "loadout2 leaves the inactive pane fill to the terminal (window-style: $got)" ;;
    esac
    got=$(tm show-options -g monitor-activity)
    [ "$got" = "monitor-activity off" ] \
        || fail "window-status-activity-style is unpinned but monitor-activity is on (got: $got)"
    got=$(tm show-options -g -w window-active-style)
    case "$got" in
        *'bg=#090909'*) ;;
        *) fail "loadout2 does not pin the active pane fill (window-active-style: $got)" ;;
    esac
    # loadout1 is the rollback theme: same file contract, ANSI palette mode.
    tm source-file "$tmux_dir/themes/tmux-theme-loadout1.conf"
    got=$(tm show-options -s theme)
    [ "$got" = "theme terminal" ] \
        || fail "loadout1 did not select the terminal palette (got: $got)"
    got=$(tm show-options -g window-status-current-style)
    case "$got" in
        *'fg=themewhite bg=themeblue'*) ;;
        *) fail "loadout1 does not use the ANSI palette names (got: $got)" ;;
    esac
else
    echo "SKIP: tmux theme/FFM server check (no tmux >= 3.8)"
fi

nvim_lua="$fresh_home/.config/nvim/lua"
[ -d "$nvim_lua/global" ] || fail "Neovim global layer not installed"
[ -d "$nvim_lua/user" ] || fail "Neovim user layer not created"
for retired in corp site team project; do
    [ ! -e "$nvim_lua/$retired" ] || fail "retired Neovim $retired layer created on fresh install"
done
grep -qF 'local LAYERS = { "global", "user" }' "$fresh_home/.config/nvim/init.lua" \
    || fail "Neovim dispatcher is not limited to global and user"

# Reinstall refreshes managed files, preserves user files, and warns about
# populated retired Neovim layers without deleting them.
printf '%s\n' 'set -g status-left "USER-KEPT"' >> "$tmux_dir/tmux-user.conf"
# Managed files are read-only now; simulate drift by re-opening them first.
chmod u+w "$tmux_dir/tmux-global.conf" "$tmux_dir/tmux-settings-global.conf"
printf '%s\n' '# GLOBAL-STALE' >> "$tmux_dir/tmux-global.conf"
printf '%s\n' 'set -g @theme "loadout1"' >> "$tmux_dir/tmux-settings-user.conf"
printf '%s\n' '# SETTINGS-GLOBAL-STALE' >> "$tmux_dir/tmux-settings-global.conf"
printf '%s\n' 'vim.g.user_layer_kept = true' > "$nvim_lua/user/config.lua"
mkdir -p "$nvim_lua/corp" "$nvim_lua/site"
printf '%s\n' 'vim.g.retired_layer_must_not_load = true' > "$nvim_lua/corp/config.lua"

HOME="$fresh_home" "$REPO/loadout" install -y env-tmux env-nvim --no-backup >"$TEST_ROOT/reinstall.log" 2>&1

grep -qF 'USER-KEPT' "$tmux_dir/tmux-user.conf" || fail "reinstall overwrote the tmux user layer"
! grep -qF 'GLOBAL-STALE' "$tmux_dir/tmux-global.conf" || fail "reinstall did not refresh the tmux global layer"
grep -qF 'set -g @theme "loadout1"' "$tmux_dir/tmux-settings-user.conf" \
    || fail "reinstall overwrote the tmux settings user layer"
! grep -qF 'SETTINGS-GLOBAL-STALE' "$tmux_dir/tmux-settings-global.conf" \
    || fail "reinstall did not refresh the managed tmux settings"
# Reinstall heals the chmod u+w drift above and re-applies the read-only
# contract, while the user layers stay writable.
for managed_file in tmux.conf tmux-global.conf tmux-settings-global.conf word-separators.conf; do
    assert_readonly "$tmux_dir/$managed_file" 444
done
for managed_dir in plugins scripts themes; do
    assert_readonly "$tmux_dir/$managed_dir" 555
done
for user_file in tmux-user.conf tmux-settings-user.conf; do
    assert_writable "$tmux_dir/$user_file"
done
grep -qF 'user_layer_kept' "$nvim_lua/user/config.lua" || fail "reinstall overwrote the Neovim user layer"
grep -qF 'retired_layer_must_not_load' "$nvim_lua/corp/config.lua" \
    || fail "reinstall deleted a retired Neovim layer"
grep -qF 'Neovim no longer loads the retired layer(s) corp;' "$TEST_ROOT/reinstall.log" \
    || fail "populated retired Neovim layer was not reported"
grep -qF 'lua/user' "$TEST_ROOT/reinstall.log" || fail "retired-layer warning does not name the replacement"
! grep -qF 'retired layer(s) corp, site;' "$TEST_ROOT/reinstall.log" \
    || fail "empty retired Neovim layer produced a warning"

# Legacy ~/.tmux.local.conf migration. The prompt must be tested under a PTY;
# a pipe alone is deliberately non-interactive to the installer.
if command -v script >/dev/null 2>&1; then
    migrate_yes="$TEST_ROOT/migrate-yes"
    mkdir -p "$migrate_yes"
    printf '%s\n' 'set -g status-left "MIGRATED"' > "$migrate_yes/.tmux.local.conf"
    printf '\n' | env HOME="$migrate_yes" TERM=xterm \
        script -qec "$REPO/loadout install -y env-tmux --no-backup" /dev/null \
        >"$TEST_ROOT/migrate-yes.log" 2>&1
    [ ! -e "$migrate_yes/.tmux.local.conf" ] || fail "accepted migration left the legacy file behind"
    grep -qF 'MIGRATED' "$migrate_yes/.config/tmux/tmux-user.conf" \
        || fail "accepted migration did not preserve legacy content"
    grep -qF 'Move it now [Y/n]' "$TEST_ROOT/migrate-yes.log" \
        || fail "interactive migration offer was not shown"

    migrate_no="$TEST_ROOT/migrate-no"
    mkdir -p "$migrate_no"
    printf '%s\n' 'set -g status-left "LEGACY-KEPT"' > "$migrate_no/.tmux.local.conf"
    printf 'n\n' | env HOME="$migrate_no" TERM=xterm \
        script -qec "$REPO/loadout install -y env-tmux --no-backup" /dev/null \
        >"$TEST_ROOT/migrate-no.log" 2>&1
    [ -f "$migrate_no/.tmux.local.conf" ] || fail "declined migration removed the legacy file"
    [ ! -e "$migrate_no/.config/tmux/tmux-user.conf" ] \
        || fail "declined migration created a user layer"
    grep -qF 'is no longer loaded' "$TEST_ROOT/migrate-no.log" \
        || fail "declined migration did not explain the legacy file is no longer loaded"
else
    echo "SKIP: interactive tmux migration cases (no 'script' PTY helper)"
fi

migrate_unattended="$TEST_ROOT/migrate-unattended"
mkdir -p "$migrate_unattended"
printf '%s\n' 'set -g status-left "UNATTENDED"' > "$migrate_unattended/.tmux.local.conf"
HOME="$migrate_unattended" "$REPO/loadout" install -y env-tmux --no-backup \
    >"$TEST_ROOT/migrate-unattended.log" 2>&1 </dev/null
[ -f "$migrate_unattended/.tmux.local.conf" ] || fail "unattended install moved the legacy file"
[ ! -e "$migrate_unattended/.config/tmux/tmux-user.conf" ] \
    || fail "unattended install created a user layer from nothing"
grep -qF 'is no longer loaded' "$TEST_ROOT/migrate-unattended.log" \
    || fail "unattended migration warning missing"

migrate_conflict="$TEST_ROOT/migrate-conflict"
mkdir -p "$migrate_conflict/.config/tmux"
printf '%s\n' 'set -g status-left "OLD"' > "$migrate_conflict/.tmux.local.conf"
printf '%s\n' 'set -g status-left "NEW"' > "$migrate_conflict/.config/tmux/tmux-user.conf"
HOME="$migrate_conflict" "$REPO/loadout" install -y env-tmux --no-backup \
    >"$TEST_ROOT/migrate-conflict.log" 2>&1
grep -qF 'OLD' "$migrate_conflict/.tmux.local.conf" || fail "conflict changed the legacy file"
grep -qF 'NEW' "$migrate_conflict/.config/tmux/tmux-user.conf" || fail "conflict changed the user layer"
grep -qF 'Both ~/.tmux.local.conf and ~/.config/tmux/tmux-user.conf exist' \
    "$TEST_ROOT/migrate-conflict.log" || fail "tmux migration conflict warning missing"

migrate_symlink="$TEST_ROOT/migrate-symlink"
mkdir -p "$migrate_symlink"
printf '%s\n' 'set -g status-left "LINKED"' > "$migrate_symlink/linked.conf"
ln -s "$migrate_symlink/linked.conf" "$migrate_symlink/.tmux.local.conf"
HOME="$migrate_symlink" "$REPO/loadout" install -y env-tmux --no-backup \
    >"$TEST_ROOT/migrate-symlink.log" 2>&1
[ -L "$migrate_symlink/.tmux.local.conf" ] || fail "legacy symlink was moved automatically"
[ ! -e "$migrate_symlink/.config/tmux/tmux-user.conf" ] \
    || fail "legacy symlink seeded a user layer"
grep -qF 'is a symlink' "$TEST_ROOT/migrate-symlink.log" || fail "legacy symlink warning missing"

migrate_nonfile="$TEST_ROOT/migrate-nonfile"
mkdir -p "$migrate_nonfile/.tmux.local.conf"
HOME="$migrate_nonfile" "$REPO/loadout" install -y env-tmux --no-backup \
    >"$TEST_ROOT/migrate-nonfile.log" 2>&1
[ -d "$migrate_nonfile/.tmux.local.conf" ] || fail "non-file legacy path was changed"
[ ! -e "$migrate_nonfile/.config/tmux/tmux-user.conf" ] \
    || fail "non-file legacy seeded a user layer"
grep -qF 'is not a regular file' "$TEST_ROOT/migrate-nonfile.log" \
    || fail "non-file legacy warning missing"

canonical_nonfile="$TEST_ROOT/canonical-nonfile"
mkdir -p "$canonical_nonfile/.config/tmux/tmux-user.conf"
HOME="$canonical_nonfile" "$REPO/loadout" install -y env-tmux --no-backup \
    >"$TEST_ROOT/canonical-nonfile.log" 2>&1 </dev/null
[ -d "$canonical_nonfile/.config/tmux/tmux-user.conf" ] \
    || fail "non-file canonical user path was changed"
grep -qF 'tmux-user.conf exists but is not a regular file tmux can load' \
    "$TEST_ROOT/canonical-nonfile.log" || fail "non-file canonical user warning missing"

canonical_dangling="$TEST_ROOT/canonical-dangling"
mkdir -p "$canonical_dangling/.config/tmux"
ln -s "$canonical_dangling/missing.conf" "$canonical_dangling/.config/tmux/tmux-user.conf"
HOME="$canonical_dangling" "$REPO/loadout" install -y env-tmux --no-backup \
    >"$TEST_ROOT/canonical-dangling.log" 2>&1 </dev/null
[ -L "$canonical_dangling/.config/tmux/tmux-user.conf" ] \
    || fail "dangling canonical user symlink was changed"
grep -qF 'tmux-user.conf exists but is not a regular file tmux can load' \
    "$TEST_ROOT/canonical-dangling.log" || fail "dangling canonical user warning missing"

# Pre-rename dotted user layer migrates forward so user content survives.
dotted_home="$TEST_ROOT/dotted-user"
mkdir -p "$dotted_home/.config/tmux"
printf '%s\n' 'set -g status-left "DOTTED-KEPT"' > "$dotted_home/.config/tmux/tmux.user.conf"
HOME="$dotted_home" "$REPO/loadout" install -y env-tmux --no-backup \
    >"$TEST_ROOT/dotted-user.log" 2>&1 </dev/null
[ ! -e "$dotted_home/.config/tmux/tmux.user.conf" ] \
    || fail "pre-rename dotted user layer was left behind"
grep -qF 'DOTTED-KEPT' "$dotted_home/.config/tmux/tmux-user.conf" \
    || fail "pre-rename dotted user content did not migrate to tmux-user.conf"

# Superseded pre-rename managed files are pruned from the config top level.
stale_home="$TEST_ROOT/stale-managed"
mkdir -p "$stale_home/.config/tmux"
for stale in tmux.global.conf tmux-word-separators tmux-3col-layout.sh \
    shell-state-export.sh tmux-popin.sh tmux-popout.sh; do
    printf '%s\n' '# STALE' > "$stale_home/.config/tmux/$stale"
done
HOME="$stale_home" "$REPO/loadout" install -y env-tmux --no-backup \
    >"$TEST_ROOT/stale-managed.log" 2>&1 </dev/null
for stale in tmux.global.conf tmux-word-separators tmux-3col-layout.sh \
    shell-state-export.sh tmux-popin.sh tmux-popout.sh; do
    [ ! -e "$stale_home/.config/tmux/$stale" ] \
        || fail "superseded managed file $stale was not pruned"
done
[ -f "$stale_home/.config/tmux/scripts/tmux-3col-layout.sh" ] \
    || fail "pruning run did not install the scripts/ layout"

# Normal backups must capture the legacy user file before migration logic runs.
backup_home="$TEST_ROOT/backup"
mkdir -p "$backup_home"
printf '%s\n' 'set -g status-left "BACKED-UP"' > "$backup_home/.tmux.local.conf"
HOME="$backup_home" "$REPO/loadout" install -y env-tmux >"$TEST_ROOT/backup.log" 2>&1 </dev/null
backup_archive="$backup_home/loadout_backups/backup.1.tar.bz2"
[ -f "$backup_archive" ] || fail "normal env-tmux install did not create a backup archive"
tar -tjf "$backup_archive" | grep -q '/\.tmux\.local\.conf$' \
    || fail "backup archive omitted the legacy tmux user config"

# Restoring a snapshot from before tmux layering must not delete a current
# legacy file the old snapshot format never captured. New snapshots that do
# carry the file must still replace it normally, including from an archive.
restore_home="$TEST_ROOT/restore-home"
old_snapshot="$TEST_ROOT/backup.old"
mkdir -p "$restore_home" "$old_snapshot"
printf '%s\n' 'set -g status-left "CURRENT-LEGACY"' > "$restore_home/.tmux.local.conf"
printf '%s\n' 'root = true' > "$old_snapshot/.editorconfig"
HOME="$restore_home" "$REPO/loadout" snapshot restore "$old_snapshot" \
    >"$TEST_ROOT/restore-old.log" 2>&1
grep -qF 'CURRENT-LEGACY' "$restore_home/.tmux.local.conf" \
    || fail "restoring an old snapshot deleted current legacy tmux config"

new_snapshot="$TEST_ROOT/backup.new"
mkdir -p "$new_snapshot"
printf '%s\n' 'set -g status-left "SNAPSHOT-LEGACY"' > "$new_snapshot/.tmux.local.conf"
tar -cjf "$TEST_ROOT/backup.new.tar.bz2" -C "$TEST_ROOT" backup.new
printf '%s\n' 'set -g status-left "CURRENT-REPLACED"' > "$restore_home/.tmux.local.conf"
HOME="$restore_home" "$REPO/loadout" snapshot restore "$TEST_ROOT/backup.new.tar.bz2" \
    >"$TEST_ROOT/restore-new.log" 2>&1
grep -qF 'SNAPSHOT-LEGACY' "$restore_home/.tmux.local.conf" \
    || fail "restoring a new snapshot did not restore legacy tmux config"

# Layer support is not registry metadata: that field was deleted in W4 (it was
# cosmetic and had already drifted -- env-bash was missing global/team).
# The behavior that matters is the dispatcher sourcing global before user, which
# is asserted above (tmux dispatcher order, nvim layer layout).

tmux_update_dry=$("$PY" "$REPO/build/update" tmux-plugins --dry-run)
printf '%s\n' "$tmux_update_dry" | grep -qF 'tmux-plugins/tpm' \
    || fail "tmux plugin updater no longer discovers declarations in the global layer"
if printf '%s\n' "$tmux_update_dry" | grep -qF 'No @plugin entries found'; then
    fail "tmux plugin updater parsed the dispatcher instead of the global layer"
fi

echo "install-env-tmux-nvim-layers: OK"
