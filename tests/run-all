#!/usr/bin/env bash
# run-all -- single entry point for the loadout test suite.
#
# Default: Tier 1 (fast checks + unit tests) then Tier 2 (integration installs
# into temp roots). --fast stops after Tier 1. --container additionally runs
# the Tier 3 clean-container smoke (stock AlmaLinux 8.10 via Docker) -- the
# only verification baseline that counts for install behavior; the dev box is
# not stock and must not be trusted for that.
#
# Usage:
#   ./tests/run-all             # Tier 1 + Tier 2
#   ./tests/run-all --fast      # Tier 1 only
#   ./tests/run-all --container # Tier 1 + Tier 2 + Tier 3 (Docker)
#   ./tests/run-all --no-cache  # ignore the result cache (see below)
#   ./tests/run-all --serial    # one test at a time (LOADOUT_TEST_JOBS=N too)
#
# Tier 1 runs min(4, nproc) tests at a time. Installer-driven (`--deps auto`)
# tests get their own limit -- LOADOUT_TEST_T2_JOBS (default 4) -- because they
# are disk/IO-bound installs rather than CPU-bound gates. They can overlap
# safely: each job gets a private TMPDIR, the installer records the inputs of
# each INSTALL ROOT under `<repo>/.loadout-deps.d/`, and a record belongs to the
# job whose TMPDIR prefixes its install root.
#
# Results are cached, `--fast` included: when the inputs a test actually
# depends on are unchanged since its last green run, the cached PASS is
# reused instead of re-installing ~8 GB or re-walking the payload. Three
# dependency keys:
#
#   --deps auto       installer-captured: the exact payload files the test
#                     touched (Tier 2 installs).
#   --deps envs       an explicit dependency group (see DEP_GROUP): an env
#                     edit re-runs the env tests and leaves payload tests
#                     alone, and a payload edit does the reverse.
#                     Composable: `--deps payload+loader`. Undeclared tests
#                     keep the conservative `all` key -- a group that names
#                     too little is a stale green, so opt in per test.
#   (default) all     one sidecar over payload+envs+installer+tests, computed
#                     ONCE per run; used by sync gates that must see any drift.
#
# Fingerprints are mtime+size (fast); a touched-but-identical file costs one
# needless re-run, never a false green. Failed and skipped tests have no
# cache entry and always re-run. Cache lives in
# ${XDG_CACHE_HOME:-~/.cache}/engineering-loadout/test-cache-v1; delete it (or
# pass --no-cache) to force a full re-run. Sidecars record absolute paths, so a
# second checkout of the same commit (git worktree) starts cold once and then
# keeps its own verdicts.
#
# Do NOT pipe this run through an early-closing consumer (`| head`): the
# closed stdout kills the suite mid-flight before the verdict sidecars and
# the test:total row are written, and the next run re-does the killed work.
# Every COMPLETED test still records its own verdict and ci-runtimes row, so
# nothing verified is lost. Use a file redirect or a consumer that reads to
# EOF (grep, tail).

set -euo pipefail

REPO_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$REPO_DIR"

# --- scratch root -----------------------------------------------------------
# The Tier 2 tests install whole shared trees (a full @shared is ~8 GB
# installed, plus extraction transients) into $TMPDIR. On a host where /tmp is
# a small tmpfs (CachyOS: 16 GB) that does not fit, and the failure is
# ENOSPC part-way through an install -- which the installer WARNs-and-skips
# past, so the missing files surface later as unrelated, run-varying test
# failures, and the LEAKED tree (the installed tree is sealed read-only, so
# the test's cleanup `rm -rf` cannot remove it) fills /tmp for every test
# after it. One undersized scratch dir turned into six red tests.
#
# So: if TMPDIR is already set, use it. Otherwise pick a disk-backed scratch
# when /tmp is a tmpfs with less than 12 GB free (AGENTS.md, Build Machine
# Mandate, says the same thing). Explicit TMPDIR always wins.
if [ -z "${TMPDIR:-}" ]; then
    _tmp_free_kb=$(df -Pk /tmp 2>/dev/null | awk 'NR==2 {print $4}')
    _tmp_type=$(df -Pk /tmp 2>/dev/null | awk 'NR==2 {print $2}')
    if [ -n "${_tmp_free_kb:-}" ] && [ "$_tmp_free_kb" -lt 12582912 ] \
        && [ "${_tmp_type:-}" = "tmpfs" ] && [ -d /var/tmp ] && [ -w /var/tmp ]; then
        export TMPDIR=/var/tmp
        echo "scratch: /tmp is a ${_tmp_type} with $((_tmp_free_kb / 1024 / 1024)) GB free -- using /var/tmp for the test scratch"
    fi
fi

FAST=0
CONTAINER=0
NO_CACHE=0
SERIAL=0
for arg in "$@"; do
    case "$arg" in
        --fast) FAST=1 ;;
        --container) CONTAINER=1 ;;
        --no-cache) NO_CACHE=1 ;;
        --serial) SERIAL=1 ;;
        -h|--help)
            sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "unknown option: $arg" >&2
            exit 2
            ;;
    esac
done

# Concurrency limits. Tier 1 tests are CPU-bound gates: JOBS at a time
# (default min(4, nproc); LOADOUT_TEST_JOBS overrides, --serial forces 1).
# Installer-driven (`--deps auto`) tests do multi-gigabyte installs, so they are
# bounded by disk/IO instead: their own limit, T2_JOBS (LOADOUT_TEST_T2_JOBS,
# default 4). Their dependency capture is per install root, so overlapping
# installs cannot interleave records (see _dep_capture_add).
JOBS=${LOADOUT_TEST_JOBS:-0}
if [ "$SERIAL" -eq 1 ]; then
    JOBS=1
fi
if [ "$JOBS" -le 0 ]; then
    JOBS=$(nproc 2>/dev/null || echo 4)
    [ "$JOBS" -gt 4 ] && JOBS=4
fi
T2_JOBS=${LOADOUT_TEST_T2_JOBS:-4}
if [ "$SERIAL" -eq 1 ] || [ "$JOBS" -le 1 ]; then
    T2_JOBS=1
fi
case "$T2_JOBS" in
    '' | *[!0-9]*)
        echo "LOADOUT_TEST_T2_JOBS must be a positive integer (got '$T2_JOBS')" >&2
        exit 2
        ;;
esac
if [ "$T2_JOBS" -lt 1 ]; then
    T2_JOBS=1
fi

PY=""
for cand in "${XDG_DATA_HOME:-$HOME/.local/share}/loadout/bin/python3.15" "$HOME/.local/bin/python3.15" "$REPO_DIR/.loadout-bootstrap/bin/python3.15" python3.15; do
    if command -v "$cand" > /dev/null 2>&1; then
        PY=$cand
        break
    fi
done
[ -n "$PY" ] || { echo "ERROR: python3.15 not found (loadout_main.py needs >= 3.14)" >&2; exit 1; }

FAILURES=0
SKIPPED=0
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/engineering-loadout/test-cache-v1"
CACHE_SIDECAR="$CACHE_DIR/fingerprint.json"
# Container tests get their own sidecar. A plain (non---container) run must not
# bless the tree for them: it writes CACHE_SIDECAR, and sharing that sidecar
# let a later --container run CACHED-PASS the container smoke on a stale .pass
# from a previous container run (observed 2026-09-23: Tier 2's sidecar rewrite
# made the Tier 3 smoke skip against a payload it had never seen). Only
# --container runs write CACHE_SIDECAR_CONTAINER.
CACHE_SIDECAR_CONTAINER="$CACHE_DIR/fingerprint-container.json"
FP_SCRIPT="$REPO_DIR/build/fingerprint.py"
# The manifest tooling is part of the cache key even though it lives outside
# payload/envs: the shipped-set regression test exercises both scripts, and a
# script edit must not leave a cached PASS standing on the old behavior.
FP_ROOTS=("$REPO_DIR/payload" "$REPO_DIR/loadout" "$REPO_DIR/loadout_main.py" "$REPO_DIR/envs" "$REPO_DIR/tests" \
    "$REPO_DIR/build/gen-content-manifest" "$REPO_DIR/build/verify-manifest-export")
# Container tests additionally depend on the smoke harness baked into their
# image. Without it in the key, editing the entrypoint leaves a stale .pass
# blessing the old behavior (2026-10-08: a pre-XDG bindir bug in the dynamic
# smoke kept a cached PASS while the test itself was failing).
FP_ROOTS_CONTAINER=("${FP_ROOTS[@]}" \
    "$REPO_DIR/build/docker/almalinux8.10-smoke.Dockerfile" \
    "$REPO_DIR/build/docker/almalinux8.10-smoke-entrypoint")

# CI runtime log (see build/ci-runtimes): every test and the suite total is
# timed and appended, so slowdowns are visible instead of anecdotal. CACHED
# runs are logged as CACHED (near-zero seconds) and never averaged with real
# runs. Best-effort: logging must never fail the suite.
CI_LOG="${XDG_CACHE_HOME:-$HOME/.cache}/engineering-loadout/ci-runtimes.tsv"

# The TRACKED timing dataset (assurance/release-timings.tsv, in the repo).
#
# This is the sink that must ALWAYS be current: the project is a moving target
# (payloads get rebuilt, gates get added, tools get faster), so a timing
# snapshot that only exists in a cache -- or that is only written at release
# time -- is stale the moment it is written. Every test, every release gate
# and every payload rebuild appends a row here, so the file in git is the
# live picture, and the diff of a change shows how the timings MOVED.
#
# Same rule as the local log: best-effort, never fails the suite.
TRACKED_TIMINGS="$REPO_DIR/assurance/release-timings.tsv"

_log_runtime() {  # suite test seconds status detail
    mkdir -p "$(dirname "$CI_LOG")" 2>/dev/null || return 0
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "$3" "$4" "$5" \
        >> "$CI_LOG" 2>/dev/null || true
    # ... and the tracked, always-current dataset (scope "test:<name>").
    mkdir -p "$(dirname "$TRACKED_TIMINGS")" 2>/dev/null || return 0
    [ -f "$TRACKED_TIMINGS" ] || \
        printf '# utc-timestamp\tgate\tseconds\tstatus\tdetail\n' > "$TRACKED_TIMINGS" 2>/dev/null || true
    printf '%s\t%s\t%s\t%s\t%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "test:$2" "$3" "$4" "$5" \
        >> "$TRACKED_TIMINGS" 2>/dev/null || true
}

# Two cache modes:
#
#  all  -- one global fingerprint over payload+envs+installer+tests. Used by
#          the Tier 1 sync gates (which MUST see any payload drift) and by
#          tests that are not installer-driven. Any one byte of payload
#          invalidates every `all` test.
#  auto -- per-test dependency fingerprint. The installer records the exact
#          payload/installer files a test touched (see _record_install_deps in
#          loadout_main.py, armed by the repo-local .loadout-dep-capture
#          marker -- env vars do not survive the tests' `env -i`). The test's
#          PASS is then keyed on the fingerprint of exactly those files, so
#          rebuilding one artifact re-runs only the tests that use it. Records
#          are written PER INSTALL ROOT under .loadout-deps.d/, keyed on the
#          root's real path, and each job runs with a private TMPDIR: that is
#          how a record is attributed to one test while installer tests
#          overlap (see T2_JOBS).
#
# The `all` sidecar is written ONCE at the end of a run (not per test): writing
# it mid-run would make remaining tests cache against a state the run itself
# is still verifying. `auto` sidecars are written per test, after it passes.
CACHE_ACTIVE=0
if [ "$NO_CACHE" -eq 0 ]; then
    CACHE_ACTIVE=1
fi

# Safety net: never leave the dependency-capture marker armed, nor the per-run
# capture/scratch dirs, behind. The marker stays armed for the WHOLE run now
# that installer tests overlap -- individual tests no longer arm/truncate it,
# and the records they produce are per install root (see .loadout-deps.d).
DEP_MARKER="$REPO_DIR/.loadout-dep-capture"
DEP_LOG="$REPO_DIR/.loadout-deps.log"
DEP_DIR="$REPO_DIR/.loadout-deps.d"
RUN_TMP=""
ensure_run_tmp() {
    if [ -z "$RUN_TMP" ]; then
        # SHORT on purpose. Every auto test's TMPDIR becomes the head of its
        # install roots, and two shipped limits are length-based: zsh's build
        # placeholder is 97 bytes, and a console-script shebang over the kernel
        # limit makes uv/pip fall back to a `#!/bin/sh` trampoline. A verbose
        # `tmp-<test name>/` prefix pushed real installs over both
        # (install-linux-tmp-home failed relocation; python-suite-install saw a
        # `#!/bin/sh` pylint). `lr.<rand>/<job id>` costs ~13 bytes.
        RUN_TMP=$(mktemp -d "${TMPDIR:-/tmp}/lr.XXXXXX")
    fi
}
cleanup_run_state() {
    rm -f "$DEP_MARKER"
    rm -rf "$DEP_DIR"
    if [ -n "$RUN_TMP" ]; then
        chmod -R u+w "$RUN_TMP" 2>/dev/null || true
        rm -rf "$RUN_TMP"
    fi
    return 0
}
trap cleanup_run_state EXIT INT TERM
rm -rf "$DEP_DIR"

# Files every `auto` test always depends on: the harness itself, the
# fingerprint tool, the installer, and the registry. Kept in the dep list so
# editing any of them invalidates every auto cache (a bug in the harness or
# fingerprint must not be masked by a stale green).
AUTO_BASE_DEPS=(tests/run-all build/fingerprint.py loadout loadout_main.py payload/packages.json)

# --- dependency groups ------------------------------------------------------
# `run_test NAME --deps <group>[+<group>...] ...` keys that test's PASS on the
# named roots instead of the whole tree, so an env edit re-runs the env tests
# and leaves the payload tests alone (and the reverse). Opt-in on purpose: an
# undeclared test keeps the conservative `all` key, because a group that names
# too little is a stale green. Add a test to a group only after reading what
# it actually opens -- build/, assurance/ and docs/ count too.
#
# Each GROUP gets its OWN sidecar and is verified once per run, so a spec is
# just a combination: `payload+loader` costs nothing extra over `payload`.
declare -A DEP_GROUP=(
    [envs]="envs"
    [payload]="payload"
    [loader]="loadout loadout_main.py installer_vendor"
    [build]="build"
    [sonames]="assurance/el8-stock-sonames.txt"
    [locks]="payload assurance/treesitter-parser-locks.json"
    [readme]="README.md payload/packages.json"
    [stfonts]="payload/fonts envs/st"
    [docs]="docs README.md AGENTS.md .github loadout_main.py payload/packages.json envs build tools tests loadout"
    [export]=".content-manifest .git/HEAD .git/refs"
    [harness]="tests/run-all build/fingerprint.py"
    [smoke]="build/scan-for-malware tests/prebuilt-binaries"
)

group_sidecar() { printf '%s/group-%s.json' "$CACHE_DIR" "$1"; }

group_roots() {  # group name -> its roots, one per line
    local _saved_ifs=$IFS
    local -a roots=()
    IFS=' '
    # shellcheck disable=SC2206  # deliberate split of the group's root list
    roots=(${DEP_GROUP[$1]})
    IFS=$_saved_ifs
    printf '%s\n' "${roots[@]}"
}

sidecar_matches() {  # sidecar roots...
    local sidecar=$1
    shift
    [ -f "$sidecar" ] || return 1
    "$PY" "$FP_SCRIPT" --fast --check "$sidecar" --roots "$@" >/dev/null 2>&1
}

write_sidecar() {  # sidecar roots...
    local sidecar=$1
    shift
    "$PY" "$FP_SCRIPT" --fast --write "$sidecar" --roots "$@" >/dev/null 2>&1 || true
}

declare -A GROUP_OK=()
GROUP_NAMES_USED=" harness"

split_spec() {  # spec -> one group name per line
    local spec=$1
    while [ -n "$spec" ]; do
        if [ "${spec%%+*}" = "$spec" ]; then
            printf '%s\n' "$spec"
            spec=""
        else
            printf '%s\n' "${spec%%+*}"
            spec=${spec#*+}
        fi
    done
}

group_one_unchanged() {  # group name -> 0 when unchanged
    local g=$1
    if [ -n "${GROUP_OK[$g]:-}" ]; then
        [ "${GROUP_OK[$g]}" = 1 ]
        return
    fi
    # A precomputed verdict (parallel mode) wins: the parent verified each
    # group once, and a subshell re-walking the payload would defeat that.
    if [ -n "${GROUP_STATE:-}" ]; then
        case " $GROUP_STATE " in
            *" $g=1 "*) return 0 ;;
            *" $g=0 "*) return 1 ;;
        esac
    fi
    local ok=0
    local -a roots=()
    mapfile -t roots < <(group_roots "$g")
    if [ "${#roots[@]}" -gt 0 ] && sidecar_matches "$(group_sidecar "$g")" "${roots[@]}"; then
        ok=1
    fi
    GROUP_OK[$g]=$ok
    [ "$ok" -eq 1 ]
}

group_unchanged() {  # spec -> 0 when every constituent group is unchanged
    local g
    # The harness itself (this script, the fingerprint tool) is an input to
    # every grouped test: a change there must invalidate the cached verdicts.
    group_one_unchanged harness || return 1
    while IFS= read -r g; do
        group_one_unchanged "$g" || return 1
    done < <(split_spec "$1")
    return 0
}

groups_used() {  # spec -> remember each group so its sidecar is written
    local g
    while IFS= read -r g; do
        # `container` is not a dependency group: its verdicts come from
        # CACHE_SIDECAR_CONTAINER, and DEP_GROUP has no entry for it (which
        # used to print `DEP_GROUP[container]: unbound variable` from
        # write_cache_sidecars after every --container run).
        [ "$g" = "container" ] && continue
        case " $GROUP_NAMES_USED " in
            *" $g "*) ;;
            *) GROUP_NAMES_USED="$GROUP_NAMES_USED $g" ;;
        esac
    done < <(split_spec "$1")
}

test_script_hash() { sha256sum "$1" | cut -d' ' -f1; }

# The `all`, `container` and per-group verdicts are computed ONCE per run, in
# PARALLEL: every test shares those inputs, and re-walking payload+envs+tests
# per test (or per group, serially) was most of a cached run. Subshells read
# the verdicts from GROUP_STATE/SIDECAR_OK instead of re-checking.
SIDECAR_OK=0
SIDECAR_CONTAINER_OK=0
GROUP_STATE=""

precompute_verdicts() {
    [ "$CACHE_ACTIVE" -eq 1 ] || return 0
    local dir g
    dir=$(mktemp -d "${TMPDIR:-/tmp}/loadout-verdict.XXXXXX") || return 0
    (
        if sidecar_matches "$CACHE_SIDECAR" "${FP_ROOTS[@]}"; then echo 1; else echo 0; fi
    ) >"$dir/all" &
    if [ "$CONTAINER" -eq 1 ]; then
        (
            if sidecar_matches "$CACHE_SIDECAR_CONTAINER" "${FP_ROOTS_CONTAINER[@]}"; then echo 1; else echo 0; fi
        ) >"$dir/container" &
    fi
    for g in "${!DEP_GROUP[@]}"; do
        (
            local -a roots=()
            mapfile -t roots < <(group_roots "$g")
            if sidecar_matches "$(group_sidecar "$g")" "${roots[@]}"; then echo 1; else echo 0; fi
        ) >"$dir/g-$g" &
    done
    wait
    SIDECAR_OK=$(cat "$dir/all" 2>/dev/null || echo 0)
    if [ "$CONTAINER" -eq 1 ]; then
        SIDECAR_CONTAINER_OK=$(cat "$dir/container" 2>/dev/null || echo 0)
    fi
    GROUP_STATE=""
    for g in "${!DEP_GROUP[@]}"; do
        GROUP_STATE="$GROUP_STATE $g=$(cat "$dir/g-$g" 2>/dev/null || echo 0)"
    done
    rm -rf "$dir"
    export SIDECAR_OK SIDECAR_CONTAINER_OK GROUP_STATE
}


# One test, end to end. Called directly by the scheduler (inline) or in a
# subshell; global counters are only authoritative in the inline case, which is
# why the parallel scheduler counts from the exit status instead.
_run_test() {
    local name=$1
    shift
    local deps_mode=all deps_key=""
    if [ "$1" = "--deps" ]; then
        deps_mode=$2
        shift 2
    fi
    if [ "$1" = "--deps-key" ]; then
        deps_key=$2
        shift 2
    fi
    echo
    echo "=== $name"

    local test_script=""
    for f in "$@"; do
        case "$f" in
            tests/*) test_script=$f; break ;;
        esac
    done

    # `auto` = installer-captured deps; `all`/`container` = one shared sidecar;
    # anything else names dependency groups (`envs`, `payload+loader`, ...).
    local deps_kind=all
    case "$deps_mode" in
        auto) deps_kind=auto ;;
        all | container) deps_kind=$deps_mode ;;
        *)
            deps_kind=group
            local _g
            while IFS= read -r _g; do
                if [ -z "${DEP_GROUP[$_g]:-}" ]; then
                    echo "ERROR: $name: unknown --deps group '$_g' (known: ${!DEP_GROUP[*]})" >&2
                    exit 2
                fi
            done < <(split_spec "$deps_mode")
            ;;
    esac

    # A gate whose "script" lives outside tests/ (build/gen-*) names it here so
    # edits to the generator still invalidate the cached PASS.
    [ -n "$deps_key" ] && test_script=$deps_key

    local deps_file="$CACHE_DIR/$name.deps"
    local fp_file="$CACHE_DIR/$name.fp.json"
    local t0=$SECONDS

    # --- cache check ---
    if [ "$CACHE_ACTIVE" -eq 1 ] && [ -n "$test_script" ]; then
        case "$deps_kind" in
        auto)
            if [ -f "$deps_file" ] && [ -f "$fp_file" ] \
                && "$PY" "$FP_SCRIPT" --fast --check "$fp_file" --roots-from-file "$deps_file" >/dev/null 2>&1; then
                echo "=== $name: CACHED PASS (deps unchanged)"
                _log_runtime "run-all" "$name" "$((SECONDS - t0))" "CACHED" "mode=$deps_mode"
                return 0
            fi
            ;;
        group)
            groups_used "$deps_mode"
            if group_unchanged "$deps_mode" && [ -f "$CACHE_DIR/$name.pass" ] \
                && [ "$(cat "$CACHE_DIR/$name.pass")" = "$(test_script_hash "$test_script")" ]; then
                echo "=== $name: CACHED PASS (group inputs unchanged: $deps_mode)"
                _log_runtime "run-all" "$name" "$((SECONDS - t0))" "CACHED" "mode=$deps_mode"
                return 0
            fi
            ;;
        all | container)
            local verdict=$SIDECAR_OK
            [ "$deps_kind" = container ] && verdict=$SIDECAR_CONTAINER_OK
            if [ "$verdict" -eq 1 ] && [ -f "$CACHE_DIR/$name.pass" ] \
                && [ "$(cat "$CACHE_DIR/$name.pass")" = "$(test_script_hash "$test_script")" ]; then
                echo "=== $name: CACHED PASS (inputs unchanged)"
                _log_runtime "run-all" "$name" "$((SECONDS - t0))" "CACHED" "mode=$deps_mode"
                return 0
            fi
            ;;
        esac
    fi

    # --- run ---
    # An installer-driven test gets a PRIVATE TMPDIR. Everything it creates
    # (temp HOME, temp dest roots) then lives under that path, the installer
    # records each install root's inputs under .loadout-deps.d/, and a record
    # belongs to this test iff its install root is prefixed by this TMPDIR.
    # That is what makes concurrent installer tests attributable -- the old
    # shared .loadout-deps.log had to be sliced by offset, which only worked
    # while exactly one test ran.
    local armed=0 job_tmp="" saved_tmpdir="${TMPDIR:-}"
    if [ "$CACHE_ACTIVE" -eq 1 ] && [ "$deps_mode" = auto ] && [ -n "$test_script" ]; then
        mkdir -p "$CACHE_DIR"
        ensure_run_tmp
        # 2-3 bytes of job identity, not the test name: see ensure_run_tmp.
        job_tmp="$RUN_TMP/${_JOB_TMP_ID:-0}"
        mkdir -p "$job_tmp"
        touch "$DEP_MARKER"
        TMPDIR=$job_tmp
        export TMPDIR
        armed=1
    fi
    local rc=0
    "$@" || rc=$?
    if [ "$armed" -eq 1 ]; then
        local job_real captures=0
        job_real=$(realpath "$job_tmp" 2>/dev/null || printf '%s' "$job_tmp")
        # The installer records REAL install roots, so match on the real path.
        captures=$(awk -F'\t' -v p="$job_real/" 'index($1, p) == 1 {n++} END {print n+0}' \
            "$DEP_DIR"/*.log 2>/dev/null) || captures=0
        if [ "$rc" -eq 0 ] && [ "${captures:-0}" -gt 0 ]; then
            {
                printf '%s\n' "$test_script"
                printf '%s\n' "${AUTO_BASE_DEPS[@]}"
                awk -F'\t' -v p="$job_real/" 'index($1, p) == 1 {print $2}' "$DEP_DIR"/*.log
            } | sort -u > "$deps_file"
            if ! "$PY" "$FP_SCRIPT" --fast --write "$fp_file" --roots-from-file "$deps_file" >/dev/null 2>&1; then
                rm -f "$deps_file" "$fp_file"
            fi
        else
            # FAIL CLOSED. A PASS with no captured inputs would cache against
            # an almost-empty dep list and go green on ANY payload change, so
            # such a verdict is simply not cached: the test re-runs next time.
            rm -f "$deps_file" "$fp_file"
            if [ "$rc" -eq 0 ]; then
                echo "  note: $name captured no inputs under its TMPDIR -- PASS not cached"
            fi
        fi
        TMPDIR=$saved_tmpdir
        export TMPDIR
        chmod -R u+w "$job_tmp" 2>/dev/null || true
        rm -rf "$job_tmp"
    fi
    if [ "$rc" -eq 77 ]; then
        # A whole-run skip (exit 77) is not a PASS: it proves nothing about the
        # behavior the test would have exercised, so it must never be cached
        # green. Drop any older .pass for this test as well.
        rm -f "$CACHE_DIR/$name.pass"
        echo "=== $name: SKIP"
        _log_runtime "run-all" "$name" "$((SECONDS - t0))" "SKIP" "mode=$deps_mode"
        SKIPPED=$((SKIPPED + 1))
        return 77
    fi
    if [ "$rc" -eq 0 ]; then
        if [ "$CACHE_ACTIVE" -eq 1 ] && [ -n "$test_script" ] \
            && { [ "$deps_kind" = all ] || [ "$deps_kind" = container ] || [ "$deps_kind" = group ]; }; then
            mkdir -p "$CACHE_DIR"
            test_script_hash "$test_script" > "$CACHE_DIR/$name.pass"
        fi
        echo "=== $name: PASS"
        _log_runtime "run-all" "$name" "$((SECONDS - t0))" "PASS" "mode=$deps_mode"
        return 0
    else
        # A failed run proves nothing: drop every cached green for it, so the
        # next run cannot report a stale PASS on unchanged inputs.
        rm -f "$CACHE_DIR/$name.pass" "$deps_file" "$fp_file"
        echo "=== $name: FAIL" >&2
        _log_runtime "run-all" "$name" "$((SECONDS - t0))" "FAIL" "mode=$deps_mode"
        FAILURES=$((FAILURES + 1))
        return 1
    fi
}

# --- scheduler --------------------------------------------------------------
# Tier 1 tests are independent, so they run JOBS at a time (default: min(4,
# nproc); LOADOUT_TEST_JOBS overrides, --serial forces 1). `auto` tests never
# overlap: they arm a repo-global dependency-capture marker and truncate its
# log. Each job writes its own log + status file, and the parent replays them,
# so output stays per-test instead of interleaved.
declare -a _JOB_PIDS=() _JOB_IDS=() _JOB_AUTO=()
_JOB_SEQ=0

_reap_one() {
    local pid=${_JOB_PIDS[0]} id=${_JOB_IDS[0]} rc=1
    wait "$pid" || true
    _JOB_PIDS=("${_JOB_PIDS[@]:1}")
    _JOB_IDS=("${_JOB_IDS[@]:1}")
    _JOB_AUTO=("${_JOB_AUTO[@]:1}")
    if [ -f "$RUN_TMP/$id.rc" ]; then
        rc=$(cat "$RUN_TMP/$id.rc")
    fi
    cat "$RUN_TMP/$id.log" 2>/dev/null || true
    rm -f "$RUN_TMP/$id.log" "$RUN_TMP/$id.rc"
    case "$rc" in
        0) ;;
        77) SKIPPED=$((SKIPPED + 1)) ;;
        *) FAILURES=$((FAILURES + 1)) ;;
    esac
}

drain_jobs() {
    while [ "${#_JOB_PIDS[@]}" -gt 0 ]; do
        _reap_one
    done
}

_AUTO_N=0
count_auto_running() {
    local f
    _AUTO_N=0
    for f in "${_JOB_AUTO[@]}"; do
        if [ "$f" = 1 ]; then
            _AUTO_N=$((_AUTO_N + 1))
        fi
    done
}

run_test() {
    local _is_auto=0
    if [ "${2:-}" = "--deps" ] && [ "${3:-}" = auto ]; then
        _is_auto=1
    fi
    # Installer-driven tests are bounded by T2_JOBS, CPU-bound gates by JOBS.
    local _limit=$JOBS
    if [ "$_is_auto" -eq 1 ]; then
        _limit=$T2_JOBS
    fi
    if [ "$_limit" -le 1 ]; then
        drain_jobs
        # Counters are updated in-process here; the status must not reach
        # `set -e` at the call site.
        _run_test "$@" || true
        return 0
    fi
    ensure_run_tmp
    # Only real group specs need a sidecar: `auto`/`all`/`container` have their
    # own cache modes, and DEP_GROUP has no entry for them (recording "auto"
    # here made write_cache_sidecars die on `DEP_GROUP[auto]: unbound variable`
    # as soon as installer tests took this code path).
    case "${3:-}" in
        auto | all | container | "") ;;
        *)
            if [ "${2:-}" = "--deps" ]; then
                groups_used "${3:-}"
            fi
            ;;
    esac
    local id=$_JOB_SEQ
    _JOB_SEQ=$((_JOB_SEQ + 1))
    # Wait for BOTH limits: total jobs, and this test's class (so a burst of
    # cheap gates cannot starve the installers, and vice versa).
    while :; do
        if [ "${#_JOB_PIDS[@]}" -lt "$JOBS" ]; then
            count_auto_running
            if [ "$_is_auto" -eq 0 ] || [ "$_AUTO_N" -lt "$_limit" ]; then
                break
            fi
        fi
        _reap_one
    done
    ( _JOB_TMP_ID=$id; _run_test "$@" >"$RUN_TMP/$id.log" 2>&1; echo $? >"$RUN_TMP/$id.rc" ) &
    _JOB_PIDS+=($!)
    _JOB_IDS+=("$id")
    _JOB_AUTO+=("$_is_auto")
    return 0
}

is_first_party_python_path() {
    case "$1" in
        installer_vendor/*|payload/*) return 1 ;;
        envs/bash/global/github.scop.bash-completion/*) return 1 ;;
        envs/nvim/vendor/*|envs/tmux/vendor/*) return 1 ;;
    esac
    return 0
}

collect_python_files() {
    local file first_line
    PYTHON_FILES=()
    while IFS= read -r -d '' file; do
        is_first_party_python_path "$file" || continue
        if [[ "$file" == *.py ]]; then
            PYTHON_FILES+=("$file")
            continue
        fi
        [[ "$(basename "$file")" != *.* ]] || continue
        if [ -f "$file" ] && IFS= read -r first_line < "$file" && [[ "$first_line" == '#!'*python* ]]; then
            PYTHON_FILES+=("$file")
        fi
    done < <(git ls-files -z)
}

lint_python_files() {
    if ! command -v ruff > /dev/null 2>&1; then
        echo "ERROR: ruff not found" >&2
        return 1
    fi
    ruff check --force-exclude "$@"
}

check_python_format() {
    if ! command -v ruff > /dev/null 2>&1; then
        echo "ERROR: ruff not found" >&2
        return 1
    fi
    # py314 in ruff.toml: the formatter strips multi-except parentheses, so a
    # parenthesized form is a gate failure, not a style preference. Keep this
    # paired with the pre-commit hook, which cannot format when ruff is off PATH.
    ruff format --check --force-exclude "$@"
}

collect_python_files

precompute_verdicts

