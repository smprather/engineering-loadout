# The sidecars are written even when some tests failed: they only record
# "inputs unchanged", and the per-test .pass files are the actual cache
# entries -- a failed test has no .pass file, so it always re-runs. Writing
# them at the end (not per test) keeps the remaining tests from caching
# against a state the run itself is still verifying. `--fast` calls this too,
# before its early exit: a Tier 1 run has to be reusable by the next one.
write_cache_sidecars() {
    if [ "$CACHE_ACTIVE" -eq 0 ]; then
        return 0
    fi
    drain_jobs
    mkdir -p "$CACHE_DIR"
    write_sidecar "$CACHE_SIDECAR" "${FP_ROOTS[@]}" &
    if [ "$CONTAINER" -eq 1 ]; then
        write_sidecar "$CACHE_SIDECAR_CONTAINER" "${FP_ROOTS_CONTAINER[@]}" &
    fi
    # One sidecar per dependency group any test used this run, computed in
    # parallel: the walks are independent and each one is a full tree pass.
    local _g
    for _g in $GROUP_NAMES_USED; do
        (
            local -a _roots=()
            mapfile -t _roots < <(group_roots "$_g")
            write_sidecar "$(group_sidecar "$_g")" "${_roots[@]}"
        ) &
    done
    wait
}

if [ "$FAST" -eq 1 ]; then
    drain_jobs
    write_cache_sidecars
    echo
    if [ "$FAILURES" -eq 0 ]; then
        if [ "$SKIPPED" -gt 0 ]; then
            echo "Tier 1 passed ($SKIPPED skipped)."
        else
            echo "Tier 1 passed."
        fi
        _log_runtime "run-all" "total" "$SECONDS" "PASS" "flags=--fast skipped=$SKIPPED"
    else
        echo "$FAILURES test(s) FAILED." >&2
        _log_runtime "run-all" "total" "$SECONDS" "FAIL" "flags=--fast"
    fi
    exit "$((FAILURES > 0 ? 1 : 0))"
fi

