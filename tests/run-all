#!/usr/bin/env bash
# run-all -- single entry point for the loadout test suite.
#
# Default: Tier 1 (fast checks + unit tests) then Tier 2 (integration installs
# into temp roots). --fast stops after Tier 1. --container additionally runs
# the Tier 3 clean-container smoke (stock AlmaLinux 8.10 via Docker) -- the
# only verification baseline that counts for install behavior; the dev box is
# not stock and must not be trusted for that.
#
# Usage:
#   ./tests/run-all             # Tier 1 + Tier 2
#   ./tests/run-all --fast      # Tier 1 only
#   ./tests/run-all --container # Tier 1 + Tier 2 + Tier 3 (Docker)
#   ./tests/run-all --no-cache  # ignore the Tier 2 result cache (see below)
#
# Tier 2 integration tests are cached: when the payload/envs/installer
# fingerprint and the test script are unchanged since the last green run,
# the cached PASS is reused instead of re-installing ~8 GB. The fingerprint
# is mtime+size (fast); a touched-but-identical file costs one needless
# re-run, never a false green. Failed tests have no cache entry and always
# re-run. Cache lives in ${XDG_CACHE_HOME:-~/.cache}/engineering-loadout/
# test-cache-v1; delete it to force a full re-run.

set -euo pipefail

REPO_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$REPO_DIR"

FAST=0
CONTAINER=0
NO_CACHE=0
for arg in "$@"; do
    case "$arg" in
        --fast) FAST=1 ;;
        --container) CONTAINER=1 ;;
        --no-cache) NO_CACHE=1 ;;
        -h|--help)
            sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "unknown option: $arg" >&2
            exit 2
            ;;
    esac
done

PY=""
for cand in "$HOME/.local/bin/python3.14" "$REPO_DIR/.loadout-bootstrap/bin/python3.14" python3.14; do
    if command -v "$cand" > /dev/null 2>&1; then
        PY=$cand
        break
    fi
done
[ -n "$PY" ] || { echo "ERROR: python3.14 not found (loadout_main.py needs >= 3.14)" >&2; exit 1; }

FAILURES=0
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/engineering-loadout/test-cache-v1"
CACHE_SIDECAR="$CACHE_DIR/fingerprint.json"
FP_SCRIPT="$REPO_DIR/build/fingerprint.py"
FP_ROOTS=("$REPO_DIR/payload" "$REPO_DIR/loadout" "$REPO_DIR/loadout_main.py" "$REPO_DIR/envs" "$REPO_DIR/tests")

# Tier 2 integration tests install payloads into temp roots and are pure
# functions of (payload + envs + installer + the test script itself +
# platform). When nothing changed since the last green run, the cached PASS
# is reused instead of re-installing ~8 GB. The fingerprint is mtime+size
# (fast, ~2 s); a touched-but-identical file costs one needless re-run,
# never a false green. --no-cache forces every test to run.
#
# The sidecar is written ONCE at the end of a run, not per test: writing it
# mid-run would make the remaining tests see "unchanged" and cache against
# a state the run itself is still verifying.
CACHE_ACTIVE=0
if [ "$NO_CACHE" -eq 0 ] && [ "$FAST" -eq 0 ]; then
    CACHE_ACTIVE=1
fi

run_test() {
    local name=$1
    shift
    echo
    echo "=== $name"
    if [ "$CACHE_ACTIVE" -eq 1 ] && [ -f "$CACHE_SIDECAR" ] \
        && "$PY" "$FP_SCRIPT" --fast --check "$CACHE_SIDECAR" --roots "${FP_ROOTS[@]}" >/dev/null 2>&1; then
        local test_script=""
        for f in "$@"; do
            case "$f" in
                tests/*) test_script=$f; break ;;
            esac
        done
        if [ -n "$test_script" ] && [ -f "$CACHE_DIR/$name.pass" ] \
            && [ "$(cat "$CACHE_DIR/$name.pass")" = "$(sha256sum "$test_script" | cut -d' ' -f1)" ]; then
            echo "=== $name: CACHED PASS (inputs unchanged)"
            return 0
        fi
    fi
    if "$@"; then
        if [ "$CACHE_ACTIVE" -eq 1 ]; then
            mkdir -p "$CACHE_DIR"
            local test_script=""
            for f in "$@"; do
                case "$f" in
                    tests/*) test_script=$f; break ;;
                esac
            done
            if [ -n "$test_script" ]; then
                sha256sum "$test_script" | cut -d' ' -f1 > "$CACHE_DIR/$name.pass"
            fi
        fi
        echo "=== $name: PASS"
    else
        echo "=== $name: FAIL" >&2
        FAILURES=$((FAILURES + 1))
    fi
}

is_first_party_python_path() {
    case "$1" in
        installer_vendor/*|payload/*) return 1 ;;
        envs/bash/global/github.scop.bash-completion/*) return 1 ;;
        envs/nvim/vendor/*|envs/tmux/vendor/*) return 1 ;;
    esac
    return 0
}

collect_python_files() {
    local file first_line
    PYTHON_FILES=()
    while IFS= read -r -d '' file; do
        is_first_party_python_path "$file" || continue
        if [[ "$file" == *.py ]]; then
            PYTHON_FILES+=("$file")
            continue
        fi
        [[ "$(basename "$file")" != *.* ]] || continue
        if [ -f "$file" ] && IFS= read -r first_line < "$file" && [[ "$first_line" == '#!'*python* ]]; then
            PYTHON_FILES+=("$file")
        fi
    done < <(git ls-files -z)
}

lint_python_files() {
    if ! command -v ruff > /dev/null 2>&1; then
        echo "ERROR: ruff not found" >&2
        return 1
    fi
    ruff check --force-exclude "$@"
}

collect_python_files

# --- Tier 1: fast, no temp HOME -------------------------------------------
run_test "py_compile" "$PY" -m py_compile "${PYTHON_FILES[@]}"
run_test "ruff check" lint_python_files "${PYTHON_FILES[@]}"
run_test "unit-resolver" "$PY" tests/unit-resolver
run_test "registry-integrity" "$PY" tests/registry-integrity
run_test "tar-safety" "$PY" tests/tar-safety
run_test "content-verify" "$PY" tests/content-verify
run_test "content-manifest in sync" "$PY" build/gen-content-manifest --check
run_test "installed-sizes in sync" "$PY" build/gen-installed-sizes --check
run_test "parser-locks in sync" "$PY" build/gen-parser-locks --check
run_test "st font list in sync" "$PY" build/gen-st-font-comments --check
run_test "README table in sync" "$PY" build/gen-readme-table --check
run_test "assurance-check" "$PY" tests/assurance-check
run_test "env-shell-parity" "$PY" tests/env-shell-parity
run_test "cargo-offline-fallback" "$PY" tests/cargo-offline-fallback
run_test "shell-typeahead" tests/shell-typeahead
run_test "check-installer" tests/check-installer
run_test "st-wrapper" tests/st-wrapper
run_test "env-helix-config" tests/env-helix-config
run_test "update-cadence" "$PY" tests/update-cadence

if [ "$FAST" -eq 1 ]; then
    echo
    [ "$FAILURES" -eq 0 ] && echo "Tier 1 passed." || echo "$FAILURES test(s) FAILED." >&2
    exit "$((FAILURES > 0 ? 1 : 0))"
fi

# --- Tier 2: integration installs into temp roots --------------------------
run_test "install-fonts-rejoin" "$PY" tests/install-fonts-rejoin
run_test "install-modules" tests/install-modules
run_test "valgrind-smoke" tests/valgrind-smoke
run_test "install-env-st" tests/install-env-st
run_test "install-env-tcsh" tests/install-env-tcsh
run_test "install-env-zsh" tests/install-env-zsh
run_test "install-env-tmux-nvim-layers" env LOADOUT_TEST_PY="$PY" tests/install-env-tmux-nvim-layers
run_test "install-readonly-source" "$PY" tests/install-readonly-source
run_test "install-readonly-tree" tests/install-readonly-tree
run_test "optional-packages" tests/optional-packages
run_test "install-parity-plot" tests/install-parity-plot
run_test "install-python-tool-upgrade" tests/install-python-tool-upgrade
run_test "install-typescript-language-server" tests/install-typescript-language-server
run_test "install-linux-tmp-home" tests/install-linux-tmp-home
run_test "install-split-shared-envs" tests/install-split-shared-envs
run_test "install-nvim-deployments" tests/install-nvim-deployments
run_test "install-xdesk" tests/install-xdesk
run_test "completion in sync" bash -c './loadout completion bash | diff - envs/bash/global/completions/loadout.bash'
run_test "crate-store integrity" "$PY" build/verify-crate-store --check-lock
run_test "crate-store policy" "$PY" build/verify-crate-store --check-policy

# --- Tier 3: clean-container smoke (stock AlmaLinux 8.10) -------------------
if [ "$CONTAINER" -eq 1 ]; then
    run_test "almalinux8.10 container smoke (--full)" \
        tests/prebuilt-binaries-almalinux8 --full
    run_test "almalinux8.10 dynamic analysis (--dynamic, network isolated)" \
        tests/prebuilt-binaries-almalinux8 --no-build --dynamic
    # The crate store's whole reason to exist is `cargo build --offline` on a
    # farm node, and NOTHING in this suite exercised it -- so when the tool
    # locks moved ripgrep to 15.2.0 on 2026-08-04 and the container kept
    # cloning 15.1.0, the offline rebuild broke and stayed broken for 13 days.
    # verify-crate-store checks hashes and coverage; only this proves the
    # closure actually resolves.
    run_test "rust offline rebuild from the crate store (network isolated)" \
        tests/rust-offline-almalinux8
fi

echo
# The sidecar is written even when some tests failed: it only records "inputs
# unchanged", and the per-test .pass files are the actual cache entries -- a
# failed test has no .pass file, so it always re-runs. Writing it here (not
# per test) keeps the remaining tests from caching against a state the run
# itself is still verifying.
if [ "$CACHE_ACTIVE" -eq 1 ]; then
    mkdir -p "$CACHE_DIR"
    "$PY" "$FP_SCRIPT" --fast --write "$CACHE_SIDECAR" --roots "${FP_ROOTS[@]}" >/dev/null 2>&1
fi
if [ "$FAILURES" -eq 0 ]; then
    echo "All tests passed."
else
    echo "$FAILURES test(s) FAILED." >&2
fi
exit "$((FAILURES > 0 ? 1 : 0))"
