#!/usr/bin/env python3.15
"""
env-tcsh-starship -- the tcsh prompt is starship-driven, from ONE shared config.

History matters here, because two earlier designs were wrong in ways that are
easy to reintroduce:

  1. "Starship has no tcsh support upstream" -- true when the tcsh env was
     written, false for the shipped starship (1.26.0 has a tcsh target:
     `starship init tcsh`). The tcsh prompt is starship-driven, like bash and
     zsh, so the env must not claim otherwise.

  2. There used to be TWO configs -- the shared one and a tcsh twin that
     differed only in the `[directory]` style, kept identical by this gate.
     Starship has NO config-time env-var substitution (measured:
     `style = "$VAR"` is emitted verbatim), so a config value cannot be
     parameterised per shell. The twin solved that by duplication; it is now
     gone. All three envs read the SAME file, and the tcsh-only path colour is
     applied by `global/helpers/prompt-markers`, which starship's output
     already passes through.

So this gate now pins the shape of that arrangement:

  * the one shared config exists, and NO second starship config exists in the
    tcsh env (reintroducing one is the drift this gate exists to catch);
  * the tcshrc points STARSHIP_CONFIG at the shared file;
  * the helper's directory-colour rewrite matches the config's
    `[directory] style` -- parsed and mapped here, so changing the style
    without updating the helper FAILS instead of silently going cyan;
  * the shared config honors LOADOUT_CFG_PROMPT_INCLUDE_HOST and every
    custom module pins shell=/bin/bash (no prompt render may invoke an rc);
  * STARSHIP_SHELL=sh is pinned, and pinned AFTER starship's init.

Exits 0 if all cases pass, 1 otherwise.
"""

import os
import re
import sys
import time

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SHARED = os.path.join(REPO, "envs", "starship", "starship.toml")
TCSH_GLOBAL = os.path.join(REPO, "envs", "tcsh", "global")
TCSHRC = os.path.join(TCSH_GLOBAL, "tcshrc")
CONFIG_CSH = os.path.join(TCSH_GLOBAL, "config.csh")
HELPER = os.path.join(TCSH_GLOBAL, "helpers", "prompt-markers")
README = os.path.join(REPO, "envs", "tcsh", "README.md")

# Where the tcsh env must point STARSHIP_CONFIG: the SHARED config, resolved
# relative to the tcsh config root the same way the bash env does it.
SHARED_FROM_TCSH_ROOT = "${TCSH_CONFIG_ROOT_DIR}/../starship/starship.toml"

# starship style -> the SGR pair it emits. Only the styles this repo actually
# uses as the directory colour need to be here; an unknown style fails the gate
# on purpose, so a colour change is a conscious edit rather than a silent no-op.
STYLE_SGR = {
    "bold cyan": ("1;36", "1;33"),  # shared config -> tcsh helper rewrite
}

# The colour tcsh must end up with (the shell cue).
TCSH_PATH_STYLE = "bold yellow"

PASSED = 0
FAILED = 0


def check(name, cond, detail=""):
    global PASSED, FAILED
    if cond:
        PASSED += 1
        print(f"  PASS  {name}")
    else:
        FAILED += 1
        print(f"  FAIL  {name}  {detail}")


def read(path):
    with open(path, encoding="utf-8") as fh:
        return fh.read()


def directory_style(text):
    """The `style = "..."` inside the [directory] section."""
    m = re.search(r"\[directory\](.*?)(?=\n\[|\Z)", text, re.S)
    if not m:
        return None
    s = re.search(r'style\s*=\s*"([^"]*)"', m.group(1))
    return s.group(1) if s else None


def main():
    print("-- one starship config, shared by bash / zsh / tcsh")
    check("the shared starship config exists", os.path.isfile(SHARED), SHARED)
    if not os.path.isfile(SHARED):
        return 1

    # A second config in the tcsh env is the duplication this arrangement
    # removed; a file left behind would be read by nobody and drift silently.
    strays = sorted(n for n in os.listdir(TCSH_GLOBAL) if re.search(r"starship.*\.toml$", n))
    check(
        "the tcsh env ships no second starship config",
        not strays,
        f"found {strays} -- the tcsh env must use {os.path.relpath(SHARED, REPO)};"
        " the path colour is applied by helpers/prompt-markers",
    )

    shared = read(SHARED)
    shared_style = directory_style(shared)
    check("the shared config has a [directory] style", shared_style is not None, str(shared_style))
    check(
        "the shared path colour is unchanged",
        shared_style == "bold cyan",
        f"shared directory style={shared_style!r} -- update STYLE_SGR here if this is an intentional change",
    )

    print("-- the tcsh env uses the shared config")
    rc = read(TCSHRC)
    check(
        "the tcshrc points STARSHIP_CONFIG at the shared config",
        SHARED_FROM_TCSH_ROOT in rc,
        f"expected STARSHIP_CONFIG={SHARED_FROM_TCSH_ROOT}",
    )
    check("the tcshrc no longer names a tcsh-specific config", "starship-tcsh.toml" not in rc)
    check("the tcshrc runs starship's tcsh init", "init tcsh" in rc)
    check("the tcshrc does not use bash's `command -v`", "command -v starship" not in rc)
    check("the hand-rolled prompt is the fallback only", "loadout_prompt_starship" in rc)

    print("-- the path colour is applied by the helper")
    # The colour cannot live in the config (no substitution), so the helper
    # rewrites the directory's SGR. Pin the two together: parse the config's
    # style, map it to the SGR starship emits, and require the helper to carry
    # exactly that rewrite, ending at the tcsh colour.
    check("the marker/colour helper exists", os.path.isfile(HELPER), HELPER)
    if os.path.isfile(HELPER):
        helper_src = read(HELPER)
        pair = STYLE_SGR.get(shared_style)
        if pair is None:
            check(
                "the directory style is one this gate knows how to map",
                False,
                f"{shared_style!r} is not in STYLE_SGR -- add it (and the helper rewrite)",
            )
        else:
            src_sgr, dst_sgr = pair
            # sed: the SEARCH side escapes `[`, the REPLACEMENT side does not.
            want = f"s/\\x1b\\[{src_sgr}m/\\x1b[{dst_sgr}m/g"
            check(
                "the helper rewrites the directory colour to the tcsh colour",
                want in helper_src,
                f"helper must contain {want} (config style {shared_style!r} -> tcsh {TCSH_PATH_STYLE!r})",
            )
        check(
            "the helper still converts bash's zero-width markers",
            "\\\\\\[" in helper_src and "%{" in helper_src,
        )
        # REQUIRED, not cosmetic: with STARSHIP_SHELL=sh starship emits no
        # markers, and tcsh CARET-ESCAPES every unmarked control character --
        # a raw ESC[1;33m renders as the literal text `^[[1;33m`. Wrapping the
        # SGR sequences in %{ %} is what makes the prompt readable AND keeps
        # those bytes out of tcsh's prompt-width count.
        check(
            "the helper wraps SGR sequences in tcsh's zero-width markers",
            "s/\\x1b\\[[0-9;]*m/%{&%}/g" in helper_src,
            "missing `s/\\x1b\\[[0-9;]*m/%{&%}/g` -- without it tcsh displays the colour bytes as literal ^[ text",
        )
        check(
            "the helper is executable",
            os.access(HELPER, os.X_OK),
            "prompt-markers must be executable -- precmd runs it directly",
        )

    print("-- the helper splits the prompt: upper lines printed, last line is $prompt")
    # tcsh renders a `\n` inside $prompt by padding the row until the terminal
    # autowraps -- a SOFT wrap. tmux zoom/resize (and every terminal that
    # reflows on resize) then re-wraps those rows, merging the prompt lines.
    # So the helper prints every line but the last as real output on STDERR
    # (a hard newline), caches them for the Ctrl-L redraw, and hands tcsh only
    # the last line.
    if os.path.isfile(HELPER):
        import subprocess
        import tempfile

        esc = "\x1b"
        three = f"{esc}[1;35mL1{esc}[0m \n{esc}[1;36m~/proj{esc}[0m \n{esc}[1;32m\u276f{esc}[0m "
        with tempfile.TemporaryDirectory() as tmp:
            cache = os.path.join(tmp, "prompt-cache")
            with open(cache, "w") as fh:
                fh.write("stale\n")
            env = {"PATH": "/usr/bin:/bin", "LOADOUT_TCSH_PROMPT_CACHE": cache}
            res = subprocess.run([HELPER], input=three.encode(), capture_output=True, env=env)
            out, err = res.stdout.decode(), res.stderr.decode()
            upper = f"{esc}[1;35mL1{esc}[0m \n{esc}[1;33m~/proj{esc}[0m \n"
            check(
                "only the last line reaches $prompt, with markers and no newline",
                out == f"%{{{esc}[1;32m%}}\u276f%{{{esc}[0m%}} ",
                repr(out),
            )
            check("the upper lines are printed on stderr, recoloured, without markers", err == upper, repr(err))
            with open(cache) as fh:
                cached = fh.read()
            check("the upper lines are cached for the Ctrl-L redraw", cached == upper, repr(cached))
            res = subprocess.run([HELPER], input=b"X ", capture_output=True, env=env)
            with open(cache) as fh:
                cached = fh.read()
            check(
                "a one-line prompt prints nothing above and empties the cache",
                res.stdout == b"X " and res.stderr == b"" and cached == "",
                repr((res.stdout, res.stderr, cached)),
            )
            res = subprocess.run([HELPER], input=three.encode(), capture_output=True, env={"PATH": "/usr/bin:/bin"})
            check(
                "without a cache path the helper still splits (and writes no file)",
                res.returncode == 0 and res.stderr.decode() == upper and sorted(os.listdir(tmp)) == ["prompt-cache"],
                repr((res.returncode, res.stderr)),
            )

    print("-- the prompt honors the host switch")
    # LOADOUT_CFG_PROMPT_INCLUDE_HOST is exported by every shell env and
    # honored by the hand-rolled prompts. The STARSHIP prompt is the default
    # in bash and tcsh, so without a module gated on the switch the
    # preference was silently ignored in exactly the shells that show a
    # prompt by default.
    try:
        import tomllib

        with open(SHARED, "rb") as fh:
            cfg = tomllib.load(fh)
    except Exception as exc:  # noqa: BLE001 -- a broken config must fail the gate
        check("the shared starship config parses", False, str(exc))
        return 1
    fmt = cfg.get("format", "")
    custom = cfg.get("custom", {})
    # BOTH forms: `${custom.x}` (correct) and `$custom.x` (leaks literal text --
    # checked separately above). A regex that only knew one form silently found
    # nothing after the format was braced, turning this check into a no-op.
    refs = set(re.findall(r"\$\{?custom\.([A-Za-z0-9_]+)\}?", fmt))
    honoring = sorted(
        n for n in refs if "LOADOUT_CFG_PROMPT_INCLUDE_HOST" in str((custom.get(n) or {}).get("when", ""))
    )
    # An UNBRACED `$custom.x` reference in the format string both renders the
    # module AND leaks the literal `.x` into the prompt: `format = "A
    # $custom.host B"` renders `A H .host B`. That leaked text sat in the
    # shipped prompt as `.host` (visually `.hoston`, blending into git_branch's
    # default `on ` prefix) until it was spotted by eye. Braces are mandatory.
    unbraced = sorted(set(re.findall(r"\$custom\.[A-Za-z0-9_]+", fmt)))
    check(
        "every custom module reference in the format string is braced",
        not unbraced,
        f"unbraced: {unbraced} -- use ${{custom.name}}; the bare form leaks the literal '.name' text into the prompt",
    )

    check(
        "the config honors LOADOUT_CFG_PROMPT_INCLUDE_HOST",
        bool(honoring),
        f"no module in the format string is gated on the switch (referenced custom modules: {sorted(refs) or 'none'})",
    )
    # tcsh DROPS astral (4-byte) characters when rendering a prompt in a UTF-8
    # locale, so `$python`'s snake cannot be shown -- it would leave a bare
    # `vX.Y.Z`, which tells a new user nothing. The helper substitutes a BMP
    # label instead, and this check ties that substitution to the configured
    # symbol: change `[python] symbol` and the gate fails until the helper is
    # updated, rather than silently dropping the label.
    py_symbol = str(cfg.get("python", {}).get("symbol", ""))
    if py_symbol:
        py_sed = "s/" + "".join(f"\\x{b:02x}" for b in py_symbol.encode()) + "/python /g"
        check(
            "the helper replaces the python symbol with a BMP label",
            py_sed in read(HELPER),
            f"expected {py_sed} in helpers/prompt-markers -- tcsh cannot render"
            f" {py_symbol!r} (astral), so it needs a text label",
        )
    else:
        check("the config has a [python] symbol", False, "no symbol to substitute")

    # Every custom module must pin its own shell-out to bash. This is the
    # structural guarantee behind "a prompt render never invokes a shell rc":
    # starship runs `when` and `command` as subprocesses of STARSHIP_SHELL (or
    # of the module's `shell`, when set), and a module whose shell falls back
    # to tcsh/zsh re-enters ~/.tcshrc / ~/.zshenv on EVERY prompt -- measured
    # at 3.8s vs 1.5s with a 1s rc. A module added without `shell` silently
    # reintroduces that. See docs/STARSHIP.md sections 1b/1c.
    unpinned = sorted(n for n, mod in custom.items() if not (mod or {}).get("shell"))
    check(
        "every custom module pins shell=/bin/bash",
        not unpinned,
        "no explicit shell on: "
        + ", ".join(unpinned)
        + '\n        Add shell = ["/bin/bash"] -- otherwise the module runs under'
        "\n        STARSHIP_SHELL, which can be a shell that sources an rc.",
    )

    print("-- STARSHIP_SHELL")
    # `sh` on purpose, and it has to be set AFTER the init, which exports
    # STARSHIP_SHELL=tcsh itself. `sh` is POSIX, so the shared config's `when`
    # expressions run (under `tcsh` custom.username's `for` loop cannot parse
    # and the module silently never appears), and it emits NO zero-width
    # markers (`bash` emits readline's `\[ \]`, which tcsh prints literally).
    check(
        "the tcsh env pins STARSHIP_SHELL=sh",
        "setenv STARSHIP_SHELL sh" in rc,
        "the tcshrc does not set STARSHIP_SHELL=sh -- starship's own tcsh init"
        " exports STARSHIP_SHELL=tcsh, under which custom.username's `for` loop"
        " cannot parse and the module silently never appears",
    )
    pin_at = rc.find("setenv STARSHIP_SHELL sh")
    init_at = rc.find("init tcsh --print-full-init")
    check(
        "the pin comes after starship's init (which exports STARSHIP_SHELL=tcsh)",
        pin_at > init_at >= 0,
        f"pin at {pin_at}, init at {init_at} -- the pin must be later, or the init overwrites it back to tcsh",
    )

    print("-- the stale claims are gone")
    cfg_csh = read(CONFIG_CSH)
    check(
        "the tcsh config defines LOADOUT_CFG_ENABLE_STARSHIP",
        "LOADOUT_CFG_ENABLE_STARSHIP" in cfg_csh and "setenv LOADOUT_CFG_ENABLE_STARSHIP 1" in cfg_csh,
    )
    readme = read(README)
    # The claim that is now FALSE is specifically about starship. fzf and
    # zoxide still genuinely have no tcsh target, so their lines stay.
    stale = [
        ln
        for ln in readme.splitlines()
        if "starship" in ln.lower()
        and ("no tcsh target" in ln or "no tcsh support" in ln)
        # A line that says the claim USED to hold is the fix, not the bug.
        and not re.search(r"\b(used to|had no|stopped being|not any more|no longer)\b", ln)
    ]
    check(
        "the tcsh README no longer claims starship has no tcsh target",
        not stale,
        "; ".join(stale[:2]),
    )
    check(
        "the tcsh README mentions the starship prompt",
        "starship" in readme.lower(),
    )
    # The README described the OLD arrangement (a tcsh twin); a leftover
    # mention of it points a reader at a file that no longer exists.
    check(
        "the tcsh README no longer describes a tcsh-specific starship config",
        "starship-tcsh.toml" not in readme,
        "the README still names starship-tcsh.toml, which no longer exists",
    )

    print("-- the EXACT prompt")
    # Intentional knowledge of what the prompt must look like, asserted as an
    # exact byte-for-byte match. Anything less ("contains the path", "no
    # literal markers", "the cursor column matches") has already let two
    # real bugs through: a leaked `.host` literal that read as `.hoston`, and
    # tcsh caret-escaping the colour bytes.
    #
    # Controlled environment: HOME=<tmp>, cwd=<tmp>/proj (no git repo, no
    # venv), so only $directory and $character can render unless a custom
    # module is switched on.
    import shutil
    import subprocess
    import tempfile

    ESC = "\x1b"
    EXPECTED_OFF = f"{ESC}[1;36m~/proj{ESC}[0m \n{ESC}[1;32m❯{ESC}[0m "

    starship_bin = shutil.which("starship")
    if not starship_bin:
        print("  SKIP  starship not on PATH -- exact-prompt cases not rendered")
    else:
        host = subprocess.run(["hostname", "-s"], capture_output=True, text=True, check=True).stdout.strip()
        expected_on = f"{ESC}[1;2;37m{host}{ESC}[0m \n" + EXPECTED_OFF
        expected_lsf = f"{ESC}[1;31mLSF:{host}{ESC}[0m \n" + EXPECTED_OFF

        def render(extra_env):
            home = tempfile.mkdtemp(prefix="starship-expect-")
            try:
                os.makedirs(os.path.join(home, "proj"))
                env = {
                    "HOME": home,
                    "PATH": "/usr/bin:/bin",
                    "TERM": "xterm-256color",
                    "STARSHIP_SHELL": "sh",
                    "STARSHIP_CONFIG": SHARED,
                }
                env.update(extra_env)
                return subprocess.run(
                    [starship_bin, "prompt"],
                    cwd=os.path.join(home, "proj"),
                    env=env,
                    capture_output=True,
                    check=True,
                ).stdout.decode()
            finally:
                shutil.rmtree(home, ignore_errors=True)

        cases = [
            ("switch off", {"LOADOUT_CFG_PROMPT_INCLUDE_HOST": "0"}, EXPECTED_OFF),
            ("switch on", {"LOADOUT_CFG_PROMPT_INCLUDE_HOST": "1"}, expected_on),
            (
                "LSF + switch on",
                {"LOADOUT_CFG_PROMPT_INCLUDE_HOST": "1", "LSB_JOBID": "9"},
                expected_lsf,
            ),
        ]
        for label, extra, want in cases:
            got = render(extra)
            check(f"prompt renders exactly: {label}", got == want, f"\n        want {want!r}\n        got  {got!r}")

        # The tcsh path, asserted on what tcsh DISPLAYS -- not on the helper's
        # stdout. The earlier version compared the helper's output, which is
        # one stage before `set prompt = "`...`"`, and csh collapses newlines
        # right there: the prompt rendered with the path on the branch's line
        # while the test passed. The upper lines must arrive as HARD line ends
        # (the helper prints them; the PTY turns LF into CRLF). tcsh's own `\n`
        # in $prompt was ESC[80G<2 spaces>CR -- padding to a soft wrap, which
        # tmux zoom and resize reflowed into one merged, scrambled row.
        import fcntl
        import pty
        import select
        import struct
        import termios

        # Without a UTF-8 locale tcsh drops the first byte of each multi-byte
        # glyph (observed: \xee\x82\xa0 -> \x82\xa0). Not a config bug, but it
        # makes the capture environment-dependent, so pin it.
        lang = os.environ.get("LANG", "C.UTF-8")

        def tcsh_prompt(extra_env, with_python=False):
            home = tempfile.mkdtemp(prefix="tcsh-expect-")
            try:
                os.makedirs(os.path.join(home, ".config", "tcsh"))
                os.makedirs(os.path.join(home, ".config", "starship"))
                subprocess.run(
                    ["cp", "-r", os.path.join(REPO, "envs", "tcsh", "."), os.path.join(home, ".config", "tcsh") + "/"],
                    check=True,
                )
                shutil.copy(SHARED, os.path.join(home, ".config", "starship", "starship.toml"))
                # the ENTRY point (sources config.csh + the layer chain),
                # not global/tcshrc -- without config.csh the LOADOUT_CFG_*
                # variables are undefined and the prompt errors out.
                shutil.copy(os.path.join(REPO, "envs", "tcsh", "tcshrc"), os.path.join(home, ".tcshrc"))
                proj = os.path.join(home, "proj")
                os.makedirs(proj)
                subprocess.run(["git", "init", "-q", "-b", "main", proj], check=True)
                if with_python:
                    # committed, so git_status renders nothing: only $python
                    # differs from the plain fixture.
                    with open(os.path.join(proj, "x.py"), "w") as fh:
                        fh.write("print(1)\n")
                    subprocess.run(["git", "-C", proj, "add", "x.py"], check=True)
                    subprocess.run(
                        ["git", "-C", proj, "-c", "user.name=t", "-c", "user.email=t@t", "commit", "-q", "-m", "x"],
                        check=True,
                    )
                env = {
                    "HOME": home,
                    "PATH": "/usr/bin:/bin",
                    "TERM": "xterm-256color",
                    "LANG": lang,
                }
                env.update(extra_env)
                pid, fd = pty.fork()
                if pid == 0:
                    os.chdir(proj)
                    os.environ.clear()
                    os.environ.update(env)
                    fcntl.ioctl(0, termios.TIOCSWINSZ, struct.pack("HHHH", 24, 80, 0, 0))
                    os.execv("/usr/bin/tcsh", ["tcsh", "-i"])
                fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", 24, 80, 0, 0))
                buf = b""
                deadline = time.time() + 5.0
                while time.time() < deadline:
                    r, _, _ = select.select([fd], [], [], 0.2)
                    if not r:
                        if buf.endswith(b"\x1b[0m "):
                            break
                        continue
                    try:
                        data = os.read(fd, 65536)
                    except OSError:
                        break
                    if not data:
                        break
                    buf += data
                os.close(fd)
                try:
                    os.waitpid(pid, 0)
                except Exception:  # noqa: BLE001 -- the child is gone either way
                    pass
                # The extended-keys Secondary-DA query is written to the tty and
                # consumed by a real terminal emulator; script(1) has none, so
                # the raw query lands in the capture. Strip it before comparing
                # what the user would see.
                return buf.decode().replace("\x1b[>c", "")
            finally:
                shutil.rmtree(home, ignore_errors=True)

        # Exact expectation, stated as what the TERMINAL receives:
        #   line 1  git_branch's default "on " prefix + styled branch (bold blue)
        #   break   a hard line end (CRLF), printed by the helper
        #   line 2  the path, CYAN in the config, recoloured to YELLOW by the helper
        #   break   again
        #   line 3  the character prompt (bold green)
        branch = "\x1b[1;34m\ue0a0 main\x1b[0m "
        brk = "\r\n"
        path = "\x1b[1;33m~/proj\x1b[0m "
        char = "\x1b[1;32m\u276f\x1b[0m "
        body = "on " + branch + brk + path + brk + char
        # tcsh DROPS the astral python snake, so the helper substitutes a BMP
        # label; without it the module reads as a bare `v3.14.8`.
        py_seg = "\x1b[1;33mpython v3.14.8\x1b[0m "
        body_py = "on " + branch + py_seg + brk + path + brk + char
        expected_tcsh = {
            "off": body,
            "on": f"\x1b[1;2;37m{host}\x1b[0m " + body,
            "lsf": f"\x1b[1;31mLSF:{host}\x1b[0m " + body,
            "python": body_py,
        }
        for label, extra, with_py in (
            ("off", {"LOADOUT_CFG_PROMPT_INCLUDE_HOST": "0"}, False),
            ("on", {"LOADOUT_CFG_PROMPT_INCLUDE_HOST": "1"}, False),
            ("lsf", {"LOADOUT_CFG_PROMPT_INCLUDE_HOST": "1", "LSB_JOBID": "9"}, False),
            ("python", {"LOADOUT_CFG_PROMPT_INCLUDE_HOST": "0"}, True),
        ):
            got = tcsh_prompt(extra, with_python=with_py)
            check(
                f"tcsh DISPLAYS exactly: {label}",
                got == expected_tcsh[label],
                f"\n        want {expected_tcsh[label]!r}\n        got  {got!r}",
            )

    print()
    if FAILED:
        print(f"{PASSED} passed, {FAILED} failed")
        return 1
    print(f"{PASSED} passed, 0 failed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
