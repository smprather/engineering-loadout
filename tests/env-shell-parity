#!/usr/bin/env python3.15
"""env-shell-parity: the tcsh env must track the bash env.

Policy, set 2026-08-08 (docs/HANDOFF.md -> "POLICY REVERSAL: tcsh now tracks
bash/zsh"): `envs/tcsh/` is a first-class tracked environment, because the EE
community this project serves is ~90% tcsh. A bash-env change is not finished
until the tcsh form lands.

That policy needs a gate or it decays into a comment nobody reads. This is the
gate. It checks three mechanical things:

  1. every user-facing alias/function the bash env defines has a tcsh alias of
     the same name, and
  2. every LOADOUT_CFG_* the bash env defines is either DEFINED in the tcsh
     config or explicitly recorded as inapplicable, and
  3. every LOADOUT_CFG_* either env READS is DEFINED by that env's own config
     -- a switch nobody defines is a dead switch, and reading it is not
     coverage (that conflation is what let LOADOUT_CFG_ENABLE_SSH_AGENT sit
     unreachable behind a passing gate).

Anything genuinely impossible in csh goes in the EXPECTED_* tables below WITH A
REASON. That is the point: the exception is cheap to add but has to be written
down, so "csh can't do that" stops being an unexamined reflex. The previous
policy refused this gate on the grounds that tcsh had ~zero users; that premise
was wrong, and so was the conclusion.

Deliberately NOT checked: that the two implementations behave identically. They
cannot -- one is a function calling `builtin cd`, the other an alias calling a
helper script. Behaviour is covered by tests/install-env-tcsh, which drives a
real PTY. This gate only answers "does the tcsh env know this name exists".
"""

import os
import re
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

BASH_ALIASES = os.path.join(REPO, "envs", "bash", "global", "aliases.sh")
BASH_BASHRC = os.path.join(REPO, "envs", "bash", "global", "bashrc")
BASH_CONFIG = os.path.join(REPO, "envs", "bash", "global", "config.sh")
BASH_FUNCTIONS = os.path.join(REPO, "envs", "bash", "functions.sh")
BASH_KEYBINDS = os.path.join(REPO, "envs", "bash", "global", "keybinds.sh")
BASH_ICECREAM = os.path.join(REPO, "envs", "bash", "global", "icecream-ext.sh")
BASH_MODULES_INIT = os.path.join(REPO, "envs", "bash", "global", "modules-init.bash")
TCSH_GLOBAL = os.path.join(REPO, "envs", "tcsh", "global")
TCSH_ENTRY = os.path.join(REPO, "envs", "tcsh", "tcshrc")
TCSH_HELPERS = os.path.join(TCSH_GLOBAL, "helpers")
TCSH_ALIASES = os.path.join(TCSH_GLOBAL, "aliases.csh")
TCSH_TCSHRC = os.path.join(TCSH_GLOBAL, "tcshrc")
TCSH_CONFIG = os.path.join(TCSH_GLOBAL, "config.csh")
ZSH_ENTRY = os.path.join(REPO, "envs", "zsh", "zshrc")
ZSH_ZSHRC = os.path.join(REPO, "envs", "zsh", "global", "zshrc")
ZSH_COMPLETIONS = os.path.join(REPO, "envs", "zsh", "global", "completions.zsh")

# The zsh env tracks bash by a DIFFERENT mechanism than tcsh. zsh has functions,
# arrays and `local`, so instead of reimplementing the bash env it SOURCES it:
# functions.sh, global/config.sh and global/aliases.sh are read as-is. That is
# what makes its alias surface track automatically rather than by discipline --
# and it means those three files are shared code, where a bashism is a zsh bug.
#
# So the zsh checks below are shaped differently from the tcsh ones: rather than
# comparing alias lists (which are the same list by construction), they assert
# that the reuse is still wired up, and compare the bashrc-level env surface
# that zsh does have to reimplement.
ZSH_REQUIRED_SOURCES = {
    "functions.sh": (ZSH_ENTRY, "the shared function library (path_*, is_truthy, vercomp, ...)"),
    "global/config.sh": (ZSH_ENTRY, "the shared LOADOUT_CFG_* defaults -- one home for the values"),
    "global/aliases.sh": (ZSH_ZSHRC, "the shared alias set -- this is what makes aliases track automatically"),
}

# Environment variables exported by envs/bash/global/bashrc that global/zshrc
# does not export, with the reason.
EXPECTED_MISSING_ZSH_EXPORTS = {
    "HISTCONTROL": "bash-only variable; zsh spells it setopt HIST_IGNORE_SPACE + HIST_IGNORE_ALL_DUPS",
    "HISTFILESIZE": "bash-only variable; zsh's equivalent is SAVEHIST, which global/zshrc does set",
}

# Bash command names with no tcsh alias of the same name, each with the reason.
# A reason of the form "upstream ships no tcsh target" is the only kind that
# should be common; anything else deserves a second look before it is added.
EXPECTED_MISSING_COMMANDS = {
    # --- internal implementation detail, not a command a user types -----------
    "loadout_cd_recent_dir": "internal helper behind cdd/cddd/...; tcsh uses helpers/recent-dir",
    "set_prompt": "internal; tcsh's equivalent is the loadout_prompt_lead variables + sp1/sp2",
    "get_prompt_uid": "internal to set_prompt; tcsh builds the uid into the prompt directly",
    "loadout_restore_echo": "bash-preexec/PROMPT_COMMAND hook; tcsh's precmd has no $? to preserve "
    "and tcsh restores echo itself between commands",
    "loadout_add_precmd": "registers into bash's precmd_functions array; tcsh has one precmd alias",
    "nvim_wrapper": "bash-only wrapper name referenced by test_nvim; the tcsh alias calls nvim directly",
    # --- upstream ships no tcsh target ---------------------------------------
    "__fzf_cd__": "fzf generates bash/zsh/fish only; the tcsh fcd alias calls fzf --walker=dir instead",
    "__zoxide_cd": "zoxide's generated internal; zoxide init has no tcsh target at all",
}

# LOADOUT_CFG_* variables the bash env defines that the tcsh config does not.
#
# LOADOUT_CFG_ENABLE_STARSHIP is NOT here any more: the payload's starship
# (1.26.0) ships a tcsh target, so the tcsh env defines it and drives the
# prompt with starship like the bash env does.
EXPECTED_MISSING_CONFIG = {
    "LOADOUT_CFG_PREFERRED_BASH": "shell-specific; the tcsh analogue is LOADOUT_CFG_PREFERRED_TCSH",
    "LOADOUT_CFG_ENABLE_FZF": "fzf --bash/--zsh/--fish only; no tcsh keybinding script exists",
    "LOADOUT_CFG_ENABLE_ZOXIDE": "zoxide init has no tcsh target",
    "LOADOUT_CFG_ENABLE_ICECREAM": "IceCream-Bash needs ${!var} indirection and export -f",
    "LOADOUT_CFG_ENABLE_WEZTERM_SHELL_INTEGRATION": "OSC 133 zones need bash-preexec; tcsh carries "
    "OSC 7 via cwdcmd instead",
    "LOADOUT_CFG_WEZTERM_SHELL_INTEGRATION": "path to the bash-preexec integration script",
    "LOADOUT_CFG_PRESERVE_FUNCTIONS": "csh has no functions to preserve",
}

FAILURES = []
PASSED = 0


def check(label, ok, detail=""):
    global PASSED
    if ok:
        PASSED += 1
        print(f"  PASS  {label}")
    else:
        print(f"  FAIL  {label}  {detail}")
        FAILURES.append((label, detail))


def read(path):
    """Return the file with comment lines removed.

    Stripping comments is load-bearing in both directions. The tcsh config's
    header LISTS the LOADOUT_CFG_* variables it deliberately omits, and the
    alias files discuss `alias foo` in prose -- so a scanner that reads comments
    reports those as implemented and the gate passes on documentation rather
    than on code.
    """
    with open(path, encoding="utf-8") as fh:
        lines = [ln for ln in fh.read().splitlines() if not ln.lstrip().startswith("#")]
    return "\n".join(lines)


def bash_command_names(text):
    """alias NAME=... and NAME() { ... }, at any indentation.

    Indentation matters: several are defined inside `if command -v ...` blocks,
    and an anchored ^ pattern silently misses every one of them -- which would
    make this gate pass by looking at a third of the real surface.
    """
    names = set(re.findall(r"^[ \t]*alias[ \t]+([A-Za-z_][A-Za-z0-9_+-]*)=", text, re.M))
    names |= set(re.findall(r"^[ \t]*([A-Za-z_][A-Za-z0-9_]*)\(\)[ \t]*\{", text, re.M))
    return names


def tcsh_alias_names(text):
    """`alias NAME ...`, anywhere on the line -- NOT anchored to line start.

    csh's one-line `if` puts the alias mid-line, e.g.
        if ( -X bat ) alias catp 'bat'
    (the file does not use that form today, but an anchored pattern would
    silently miss it if it came back, and then report the alias as an
    unimplemented gap). Comments are already stripped by read(), so matching
    anywhere cannot pick up prose.
    """
    return set(re.findall(r"\balias[ \t]+([A-Za-z_][A-Za-z0-9_+-]*)[ \t]", text))


def config_names(text):
    return set(re.findall(r"(LOADOUT_CFG_[A-Za-z0-9_]+)", text))


def setenv_names(text):
    """Names the tcsh config DEFINES (`setenv NAME ...`).

    A definition is not a mention. This gate used to count a READ of a variable
    (`$?NAME` in the rc) as coverage, which is exactly how
    LOADOUT_CFG_ENABLE_SSH_AGENT passed for months while the ssh-agent block it
    gates stayed unreachable: the rc read it, but NOTHING ever defined it, so
    the switch could never be turned on.
    """
    return set(re.findall(r"\bsetenv\s+([A-Z_][A-Z0-9_]*)", text))


def tcsh_env_files():
    """Every file in the tcsh env that can READ a LOADOUT_CFG_* variable.

    The rc, the aliases, the completions, the keybinds, the modules init and
    the POSIX-sh helpers -- a helper is a separate process and sees only the
    ENVIRONMENT, so a variable it reads must be exported by config.csh.
    """
    files = [TCSH_TCSHRC, TCSH_ALIASES, TCSH_CONFIG]
    files += [os.path.join(TCSH_GLOBAL, n) for n in sorted(os.listdir(TCSH_GLOBAL)) if n.endswith(".csh")]
    if os.path.isdir(TCSH_HELPERS):
        files += [
            os.path.join(TCSH_HELPERS, n)
            for n in sorted(os.listdir(TCSH_HELPERS))
            if os.path.isfile(os.path.join(TCSH_HELPERS, n))
        ]
    return files


def bash_env_files():
    """Every file in the bash env that can READ a LOADOUT_CFG_* variable."""
    return [
        BASH_BASHRC,
        BASH_ALIASES,
        BASH_FUNCTIONS,
        BASH_KEYBINDS,
        BASH_ICECREAM,
        BASH_MODULES_INIT,
    ]


def exported_names(text):
    """Environment variables the file exports.

    `typeset -gx` counts: it is how zsh exports a variable it also needs to
    declare global, and TERMINFO_DIRS is set that way -- an `export`-only
    pattern reports it as an unimplemented gap that is actually implemented.
    """
    names = set(re.findall(r"^[ \t]*export[ \t]+([A-Z_][A-Z0-9_]*)", text, re.M))
    names |= set(re.findall(r"^[ \t]*typeset[ \t]+-g?x[ \t]+([A-Z_][A-Z0-9_]*)", text, re.M))
    return names


def main():
    for path in (BASH_ALIASES, BASH_BASHRC, BASH_CONFIG, TCSH_ALIASES, TCSH_TCSHRC, TCSH_CONFIG):
        if not os.path.isfile(path):
            print(f"  FAIL  missing input file: {path}")
            return 1

    bash_cmds = bash_command_names(read(BASH_ALIASES)) | bash_command_names(read(BASH_BASHRC))
    tcsh_cmds = tcsh_alias_names(read(TCSH_ALIASES))

    # Sanity-check the extractors themselves. A regex that quietly matches
    # nothing turns this whole gate into a no-op that always passes -- the exact
    # failure family this repo keeps hitting. Bounds are loose on purpose; they
    # only have to catch "the pattern broke", not track the real counts.
    check(
        "bash extractor found a plausible command set",
        len(bash_cmds) > 80,
        f"only found {len(bash_cmds)} -- did the alias/function regex break?",
    )
    check(
        "tcsh extractor found a plausible command set",
        len(tcsh_cmds) > 80,
        f"only found {len(tcsh_cmds)} -- did the alias regex break?",
    )

    missing = sorted(bash_cmds - tcsh_cmds - set(EXPECTED_MISSING_COMMANDS))
    check(
        "every bash command has a tcsh alias",
        not missing,
        "no tcsh form for: "
        + ", ".join(missing)
        + "\n        Add the alias to envs/tcsh/global/aliases.csh (helpers/ for anything"
        "\n        needing loops or locals), or add it to EXPECTED_MISSING_COMMANDS with"
        "\n        a reason. See docs/HANDOFF.md -> POLICY REVERSAL.",
    )

    # A stale exception is worse than none: it documents a gap that no longer
    # exists and trains the next reader to skim the table.
    stale = sorted(n for n in EXPECTED_MISSING_COMMANDS if n in tcsh_cmds)
    check(
        "no stale command exceptions",
        not stale,
        "these now EXIST in tcsh; drop them from EXPECTED_MISSING_COMMANDS: " + ", ".join(stale),
    )

    # ---- LOADOUT_CFG_* definitions -------------------------------------------
    # A variable the env READS but never DEFINES is a DEAD SWITCH: the feature
    # it gates can never fire, and nothing says so. The tcsh env does not depend
    # on env-bash, so every switch it reads has to be defined by ITS OWN
    # config.csh -- the read alone is not coverage.
    bash_cfg = config_names(read(BASH_CONFIG))
    tcsh_defined = setenv_names(read(TCSH_CONFIG))
    bash_defined = exported_names(read(BASH_CONFIG))

    tcsh_used = set()
    for path in tcsh_env_files():
        tcsh_used |= config_names(read(path))
    # A name built at runtime ("$LOADOUT_CFG_PROMPT_COLOR_$kind") is a PREFIX,
    # not a variable; the concrete variants are checked on their own.
    tcsh_used = {n for n in tcsh_used if not n.endswith("_")}

    bash_used = set()
    for path in bash_env_files():
        bash_used |= config_names(read(path))
    bash_used = {n for n in bash_used if not n.endswith("_")}

    missing_cfg = sorted(bash_cfg - tcsh_defined - set(EXPECTED_MISSING_CONFIG))
    check(
        "every LOADOUT_CFG_* is defined in tcsh or excused",
        not missing_cfg,
        "not defined in tcsh: "
        + ", ".join(missing_cfg)
        + "\n        Add it to envs/tcsh/global/config.csh, or to EXPECTED_MISSING_CONFIG"
        "\n        with the reason tcsh cannot act on it.",
    )

    stale_cfg = sorted(n for n in EXPECTED_MISSING_CONFIG if n in tcsh_defined)
    check(
        "no stale config exceptions",
        not stale_cfg,
        "these are now defined in tcsh; drop them from EXPECTED_MISSING_CONFIG: " + ", ".join(stale_cfg),
    )

    dead_tcsh = sorted(tcsh_used - tcsh_defined)
    check(
        "no dead switches in the tcsh env (read but never defined)",
        not dead_tcsh,
        "the tcsh env reads these but config.csh never defines them: "
        + ", ".join(dead_tcsh)
        + "\n        A switch nobody defines can never fire. Define it in"
        "\n        envs/tcsh/global/config.csh (the env does not depend on env-bash),"
        "\n        or stop reading it.",
    )

    excused_but_read = sorted(tcsh_used & set(EXPECTED_MISSING_CONFIG))
    check(
        "no excused variable is still read by the tcsh env",
        not excused_but_read,
        "excused as inapplicable to tcsh, yet the tcsh env reads: "
        + ", ".join(excused_but_read)
        + "\n        Either the excuse is wrong (define it) or the read is dead code"
        "\n        (remove it).",
    )

    dead_bash = sorted(bash_used - bash_defined)
    check(
        "no dead switches in the bash env (read but never defined)",
        not dead_bash,
        "the bash env reads these but config.sh never exports them: "
        + ", ".join(dead_bash)
        + "\n        Export it from envs/bash/global/config.sh, or stop reading it.",
    )

    # ---- the built-in prompts honor the same switch -------------------------
    # LOADOUT_CFG_PROMPT_INCLUDE_HOST must mean the same thing in both envs:
    # the tcsh built-in prompt renders the host, so the bash one must too.
    # The bash prompt used to COMPUTE the farm tag and the host and then drop
    # the result on the floor (a dead variable), so the switch did nothing
    # there at all.
    bash_rc = read(BASH_BASHRC)
    ps1 = re.search(r"^[ \t]*PS1=.*$", bash_rc, re.M)
    check(
        "the bash built-in prompt renders the farm tag and the host",
        bool(ps1) and "prompt_joined" in ps1.group(0),
        "the PS1 assignment does not use prompt_joined -- the farm tag and the host"
        " are computed and then dropped" + ("" if ps1 else " (no PS1 assignment found)"),
    )
    tcsh_rc = read(TCSH_TCSHRC)
    check(
        "the tcsh built-in prompt renders the host",
        "_loadout_host" in tcsh_rc and "loadout_prompt_lead" in tcsh_rc,
        "the tcsh prompt no longer assembles _loadout_host",
    )

    # ---- STARSHIP_SHELL, one value per env ---------------------------------
    # It picks BOTH the shell each module's `when`/`command` runs under AND
    # the zero-width marker syntax starship emits (bash -> readline \[ \],
    # zsh -> %{ %}, sh -> none). No single value is right for every shell, so
    # each env pins its own: docs/STARSHIP.md has the measurements.
    #
    # tcsh's is `sh`, NOT `tcsh` and NOT `bash`: `starship init tcsh
    # --print-full-init` exports STARSHIP_SHELL=tcsh itself, under which
    # custom.username's `for u in $VAR; do ... done` cannot parse and that
    # module silently never appears; and `bash` emits readline's markers,
    # which tcsh prints literally.
    for env_name, path, expected, why in (
        ("bash", BASH_BASHRC, "bash", "PS1 needs readline's \\[ \\] for prompt width"),
        (
            "zsh",
            ZSH_ZSHRC,
            "sh",
            "zsh sources ~/.zshenv even non-interactively, so zsh re-enters the loadout config per module",
        ),
        ("tcsh", TCSH_TCSHRC, "sh", "POSIX for the snippets, and the only marker-free value"),
    ):
        text = read(path)
        check(
            f"the {env_name} env pins STARSHIP_SHELL={expected}",
            re.search(rf"(export|setenv)\s+STARSHIP_SHELL[=\s]+{expected}\b", text) is not None,
            f"expected STARSHIP_SHELL={expected} -- {why}. See docs/STARSHIP.md.",
        )

    # ---- zsh -----------------------------------------------------------------
    for path in (ZSH_ENTRY, ZSH_ZSHRC, ZSH_COMPLETIONS):
        if not os.path.isfile(path):
            check(f"zsh file present: {os.path.relpath(path, REPO)}", False, "missing")
            return 1

    # The reuse wiring IS the tracking mechanism. If someone "cleans up" one of
    # these source lines -- say by copying the aliases into a zsh-native file --
    # the zsh env silently stops following bash, and nothing else would notice.
    for needle, (path, why) in ZSH_REQUIRED_SOURCES.items():
        text = read(path)
        check(
            f"zsh still sources {needle}",
            needle in text and "source" in text,
            f"{os.path.relpath(path, REPO)} no longer sources it -- {why}",
        )

    bash_exports = exported_names(read(BASH_BASHRC))
    zsh_exports = exported_names(read(ZSH_ZSHRC)) | exported_names(read(ZSH_COMPLETIONS))

    missing_exports = sorted(bash_exports - zsh_exports - set(EXPECTED_MISSING_ZSH_EXPORTS))
    check(
        "every env var the bash rc exports is exported by zsh",
        not missing_exports,
        "not exported by zsh: "
        + ", ".join(missing_exports)
        + "\n        Add it to envs/zsh/global/zshrc, or to EXPECTED_MISSING_ZSH_EXPORTS"
        "\n        with the reason zsh does not need it.",
    )

    stale_exports = sorted(n for n in EXPECTED_MISSING_ZSH_EXPORTS if n in zsh_exports)
    check(
        "no stale zsh export exceptions",
        not stale_exports,
        "these are now exported by zsh; drop them from EXPECTED_MISSING_ZSH_EXPORTS: " + ", ".join(stale_exports),
    )

    # ---- PATH semantics (all three shells) -----------------------------------
    # The shared bin is APPENDED so a system copy keeps priority; the prefer/
    # dir is PREPENDED as the explicit per-tool exception; the fallback prefix
    # is the XDG root, not $HOME/.local.
    bash_rc = read(BASH_BASHRC)
    zsh_rc = read(ZSH_ZSHRC)
    tcsh_rc = read(TCSH_TCSHRC)

    for label, text in (("bash", bash_rc), ("zsh", zsh_rc), ("tcsh", tcsh_rc)):
        check(
            f"{label}: XDG-root fallback for the loadout prefix",
            "$HOME/.local/share/loadout" in text,
            f"{label} still falls back to $HOME/.local",
        )
    check(
        "bash appends the shared bin",
        'path_append_if_dir "$_loadout_prefix/bin"' in bash_rc
        and "${LOADOUT_CFG_SHARED_PREFIX:+$LOADOUT_CFG_SHARED_PREFIX/bin}" not in bash_rc,
        "shared bin still prepended (or append missing) in bashrc",
    )
    check(
        "bash prepends the prefer dir",
        'path_prepend_if_dir "$_loadout_prefix/prefer"' in bash_rc,
        "prefer dir not prepended in bashrc",
    )
    check(
        "zsh appends the shared bin and prepends prefer",
        'path_append_if_dir "$_loadout_prefix/bin"' in zsh_rc
        and 'path_prepend_if_dir "$_loadout_prefix/prefer"' in zsh_rc
        and "${LOADOUT_CFG_SHARED_PREFIX:+$LOADOUT_CFG_SHARED_PREFIX/bin}" not in zsh_rc,
        "zsh PATH block drifted from bash",
    )
    check(
        "tcsh appends the shared bin and prepends prefer",
        'set path = ( $path:q "$_loadout_dir" )' in tcsh_rc and "${_loadout_prefix}/prefer" in tcsh_rc,
        "tcsh PATH block drifted from bash",
    )
    tcsh_prepend_line = re.search(r"foreach _loadout_dir \( [^\n]*\)", tcsh_rc)
    check(
        "tcsh prepend list no longer carries the shared bin",
        bool(tcsh_prepend_line) and "${_loadout_prefix}/bin" not in tcsh_prepend_line.group(0),
        tcsh_prepend_line.group(0) if tcsh_prepend_line else "foreach line not found",
    )
    check(
        "tcsh prepend list resolves NVM_BIN and matches bash's order",
        bool(tcsh_prepend_line)
        and "$_loadout_nvm_bin" in tcsh_prepend_line.group(0)
        and "/usr/local/bin" in tcsh_prepend_line.group(0),
        tcsh_prepend_line.group(0) if tcsh_prepend_line else "foreach line not found",
    )
    check(
        "tcsh terminfo prepend order matches bash (prefix first)",
        re.search(
            r"foreach _loadout_ti \( \"\$HOME/\.local/share/terminfo\" \"\$\{_loadout_prefix\}/share/terminfo\" \)",
            tcsh_rc,
        )
        is not None,
        "tcsh prepends home terminfo last, visible order becomes home:prefix",
    )
    check(
        "tcsh listing/new/du aliases use helpers",
        all(name in read(TCSH_ALIASES) for name in ("ls-command", "new-file", "extract-rpm", "disk-usage")),
        "an inline csh alias cannot branch on arguments (ls -1, du DIR, arity)",
    )
    check(
        "tcsh extended-keys probe is the shared helper",
        "check-extended-keys" in read(TCSH_TCSHRC),
        "the cheap TERM/TMUX check leaves a bare xterm login unset",
    )
    retired_grc = ("ENABLE_GRC", "colourify", "grc -es", "grc.sh", "grc/bin", "grc-aliases")
    grc_left = [
        os.path.relpath(p, REPO)
        for p in sorted(set(tcsh_env_files() + bash_env_files() + [BASH_CONFIG, ZSH_ZSHRC]))
        if any(tok in read(p) for tok in retired_grc)
    ]
    grc_left += [
        os.path.relpath(p, REPO)
        for p in (os.path.join(REPO, "envs", "bash", "global", "grc"), os.path.join(TCSH_GLOBAL, "grc-aliases.csh"))
        if os.path.exists(p)
    ]
    check(
        "no GRC left in any shell env",
        not grc_left,
        "GRC is retired (linelight replaces it): " + ", ".join(grc_left),
    )
    check(
        "no shell defeats rmstar with an rm -f alias",
        "alias rm" not in read(TCSH_ALIASES) and "alias rm" not in read(BASH_ALIASES),
        "rm * must still ask for confirmation",
    )
    check(
        "sp1/sp2 export the host prompt switch",
        "setenv LOADOUT_CFG_PROMPT_INCLUDE_HOST" in read(TCSH_ALIASES)
        and "export LOADOUT_CFG_PROMPT_INCLUDE_HOST" in read(BASH_ALIASES),
        "a shell-local assignment is invisible to the starship module",
    )

    # ---- tcsh syntax traps ---------------------------------------------------
    # `2>/dev/null` and `2>&1` are POSIX-shell redirections, not csh ones. In csh
    # the leading 2 is an ARGUMENT and stdout is redirected; `2>&1 |` is an
    # "Ambiguous output redirect". This is checked only on files tcsh actually
    # parses -- the helpers under global/helpers are POSIX sh, where 2> is right.
    tcsh_syntax_files = [TCSH_ENTRY, TCSH_TCSHRC, TCSH_ALIASES, TCSH_CONFIG]
    tcsh_syntax_files += [os.path.join(TCSH_GLOBAL, n) for n in sorted(os.listdir(TCSH_GLOBAL)) if n.endswith(".csh")]
    bad_redirects = []
    for path in tcsh_syntax_files:
        with open(path, encoding="utf-8") as fh:
            for lineno, line in enumerate(fh, 1):
                if line.lstrip().startswith("#"):
                    continue
                if re.search(r"(?<![\w])2>", line):
                    bad_redirects.append(f"{os.path.relpath(path, REPO)}:{lineno}")
    check(
        "tcsh-syntax files never use POSIX fd redirection",
        not bad_redirects,
        "2> found in csh-syntax files: " + ", ".join(bad_redirects),
    )

    check(
        "tcsh entrypoint does not wipe every inherited alias",
        "unalias *" not in read(TCSH_ENTRY),
        "unalias * removes site aliases loaded by /etc/csh.cshrc (module, gawk, ...)",
    )
    check(
        "tcsh exports EXTENDED_KEYS_SUPPORTED for the tmux config",
        "EXTENDED_KEYS_SUPPORTED" in read(TCSH_TCSHRC),
        "tmux-global.conf turns extended-keys off when the variable is absent",
    )
    check(
        "tcsh starship switch is tested by value, not existence",
        "is-truthy" in tcsh_rc and "$?LOADOUT_CFG_ENABLE_STARSHIP &&" not in tcsh_rc,
        "LOADOUT_CFG_ENABLE_STARSHIP=0 is ignored by a $? test",
    )
    check(
        "tcsh rg aliases double-escape the literal !* glob",
        "\\\\!*.snapshot*" in read(TCSH_ALIASES),
        "stored !* is consumed as alias-argument substitution, so rg never gets a pattern",
    )
    check(
        "tcsh path_remove/path_trim use helpers, not one-line foreach aliases",
        "path-remove" in read(TCSH_ALIASES) and "path-trim" in read(TCSH_ALIASES) and "eval" in read(TCSH_ALIASES),
        "a csh alias executes only the first iteration of an inline foreach",
    )

    tmux_global = read(os.path.join(REPO, "envs", "tmux", "tmux-global.conf"))
    check(
        "tmux does not pin default-shell to bash",
        "set -g default-shell /bin/bash" not in tmux_global,
        "tcsh logins would get bash panes (SHELL rewritten by tmux)",
    )
    check(
        "tmux only disables extended-keys for an explicit 0",
        '%if "#{==:#{EXTENDED_KEYS_SUPPORTED},0}"' in tmux_global,
        "an unset variable (tcsh) must not force extended-keys off server-wide",
    )

    print()
    if FAILURES:
        print(f"{PASSED} passed, {len(FAILURES)} failed")
        return 1
    print(f"{PASSED} passed, 0 failed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
