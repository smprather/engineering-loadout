#!/usr/bin/env bash
# Shared-tree fonts: with a --dest-dir outside $HOME the ~2 GB of fonts are
# installed ONCE into the tree, a fontconfig snippet is generated, and the shell
# layer exports FONTCONFIG_FILE for it -- instead of writing fonts into every
# user's $HOME (which is what a disk-quota'd cluster account cannot afford).
#
# Four cases:
#   1. font-only install into a shared tree -> <tree>/share/fonts + snippet, HOME empty
#   2. @envs install against that tree      -> a real shell startup exports FONTCONFIG_FILE
#   3. default install (HOME-mode root)     -> fonts stay per-user, no snippet
#
# font-inconsolata is the smallest font archive, so this runs in seconds.
set -euo pipefail

repo_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
tmp_root=${TMPDIR:-/tmp}
work=$(mktemp -d "$tmp_root/loadout-fonts-shared.XXXXXX")
# The installed tree is SEALED read-only (0444 files, 0555 dirs) on purpose,
# so a plain `rm -rf` cannot remove it: the cleanup leaks the whole tree into
# /tmp, and the next test that installs a shared tree then dies with ENOSPC.
# Make it writable first, then remove it.
trap 'chmod -R u+w "$work" 2>/dev/null; rm -rf "$work"' EXIT
basic_path="/usr/bin:/bin:/usr/sbin:/sbin"

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

run_loadout() { # $1 = HOME, rest = loadout args
    local h=$1
    shift
    env -i \
        HOME="$h" \
        PATH="$basic_path" \
        LANG="${LANG:-C.UTF-8}" \
        TERM="xterm-256color" \
        "$repo_dir/loadout" "$@"
}

# ---- 1. font-only install into a shared tree ---------------------------------
home="$work/home"
tree="$work/tree"
mkdir -p "$home"
run_loadout "$home" install -y --no-backup font-inconsolata --dest-dir "$tree" >"$work/fonts.log" 2>&1 ||
    fail "font install failed:
$(cat "$work/fonts.log")"

fonts_dir="$tree/share/fonts"
[ -d "$fonts_dir" ] || fail "fonts not installed into the shared tree: $fonts_dir missing"
find "$fonts_dir" -maxdepth 1 -name '*.ttf' | grep -q . || fail "no .ttf files in $fonts_dir"

conf="$tree/etc/fonts/loadout-fonts.conf"
[ -f "$conf" ] || fail "fontconfig snippet missing: $conf"
grep -qF "<dir>$fonts_dir</dir>" "$conf" || fail "snippet does not point at the shared fonts dir:
$(cat "$conf")"
grep -qF "/etc/fonts/fonts.conf" "$conf" || fail "snippet does not re-include the system config"

# Another user of the tree must be able to read it: mkstemp used to leave 0600,
# which produced "Fontconfig error: Cannot load default config file" for them.
conf_mode=$(stat -c '%a' "$conf")
[ "$conf_mode" = 644 ] || fail "fontconfig snippet mode is $conf_mode, want 644 (world-readable)"

if [ -e "$home/.local" ]; then
    fail "shared font install wrote into HOME:
$(find "$home/.local" -maxdepth 4 | head -20)"
fi

# ---- 2. per-user env install against the shared tree -------------------------
# This is the documented split deployment: @envs with LOADOUT_CFG_SHARED_PREFIX
# baked into the installed shell config.
env -i \
    HOME="$home" \
    PATH="$basic_path" \
    LANG="${LANG:-C.UTF-8}" \
    TERM="xterm-256color" \
    LOADOUT_CFG_SHARED_PREFIX="$tree" \
    "$repo_dir/loadout" install -y --no-backup @envs env-zsh >"$work/envs.log" 2>&1 ||
    fail "@envs install failed:
$(cat "$work/envs.log")"

grep -qF "$tree" "$home/.config/bash/global/config.sh" || fail "shared prefix was not baked into config.sh"

# A real (non-interactive) shell startup must export FONTCONFIG_FILE. `env` is read
# through sed so any startup chatter cannot be mistaken for the value.
got=$(
    env -i HOME="$home" PATH="$basic_path" LANG="${LANG:-C.UTF-8}" TERM="dumb" \
        bash --noprofile --norc -c 'source "$HOME/.config/bash/bashrc"; env' |
        sed -n 's/^FONTCONFIG_FILE=//p' | head -n 1
)
[ "$got" = "$conf" ] || fail "shell startup exported FONTCONFIG_FILE='$got', want '$conf'"

# A stale inherited path (retired/moved tree) must be recomputed; a genuine
# override that names an existing file must be preserved. `exec bash` cannot
# repair a stale inherited value, so the guard itself has to.
stale="$work/stale-fonts.conf"
user_fc="$work/user-fonts.conf"
cp "$conf" "$user_fc"

bash_fc() {
    local fc_env=()
    [ "$1" = __unset ] || fc_env=(FONTCONFIG_FILE="$1")
    env -i HOME="$home" PATH="$basic_path" LANG="${LANG:-C.UTF-8}" TERM="dumb" \
        "${fc_env[@]}" \
        bash --noprofile --norc -c 'source "$HOME/.config/bash/bashrc"; printf "%s" "${FONTCONFIG_FILE:-}"'
}
[ "$(bash_fc __unset)" = "$conf" ] || fail "bash: unset FONTCONFIG_FILE was not defaulted"
[ "$(bash_fc "")" = "$conf" ] || fail "bash: empty FONTCONFIG_FILE was not defaulted"
[ "$(bash_fc "$stale")" = "$conf" ] || fail "bash: stale FONTCONFIG_FILE was kept: $(bash_fc "$stale")"
[ "$(bash_fc "$user_fc")" = "$user_fc" ] || fail "bash: existing user FONTCONFIG_FILE was overwritten"

if command -v zsh >/dev/null 2>&1; then
    zsh_fc() {
        local fc_env=()
        [ "$1" = __unset ] || fc_env=(FONTCONFIG_FILE="$1")
        env -i HOME="$home" PATH="$basic_path" LANG="${LANG:-C.UTF-8}" TERM="dumb" \
            "${fc_env[@]}" \
            zsh -f -c 'source "$HOME/.config/zsh/zshrc"; print -r -- "${FONTCONFIG_FILE:-}"'
    }
    [ "$(zsh_fc __unset)" = "$conf" ] || fail "zsh: unset FONTCONFIG_FILE was not defaulted"
    [ "$(zsh_fc "")" = "$conf" ] || fail "zsh: empty FONTCONFIG_FILE was not defaulted"
    [ "$(zsh_fc "$stale")" = "$conf" ] || fail "zsh: stale FONTCONFIG_FILE was kept: $(zsh_fc "$stale")"
    [ "$(zsh_fc "$user_fc")" = "$user_fc" ] || fail "zsh: existing user FONTCONFIG_FILE was overwritten"
fi

if command -v tcsh >/dev/null 2>&1; then
    tcsh_fc() {
        local fc_env=()
        [ "$1" = __unset ] || fc_env=(FONTCONFIG_FILE="$1")
        env -i HOME="$home" PATH="$basic_path" LANG="${LANG:-C.UTF-8}" TERM="dumb" \
            "${fc_env[@]}" \
            tcsh -f -c 'source "$HOME/.tcshrc"; echo "$FONTCONFIG_FILE"'
    }
    [ "$(tcsh_fc __unset)" = "$conf" ] || fail "tcsh: unset FONTCONFIG_FILE was not defaulted"
    [ "$(tcsh_fc "")" = "$conf" ] || fail "tcsh: empty FONTCONFIG_FILE was not defaulted"
    [ "$(tcsh_fc "$stale")" = "$conf" ] || fail "tcsh: stale FONTCONFIG_FILE was kept: $(tcsh_fc "$stale")"
    [ "$(tcsh_fc "$user_fc")" = "$user_fc" ] || fail "tcsh: existing user FONTCONFIG_FILE was overwritten"
fi

# ---- 3. default (HOME-mode) install stays per-user ---------------------------
h4="$work/home4"
mkdir -p "$h4"
run_loadout "$h4" install -y --no-backup font-inconsolata >"$work/home-fonts.log" 2>&1 ||
    fail "HOME-mode font install failed:
$(cat "$work/home-fonts.log")"
[ -d "$h4/.local/share/fonts" ] || fail "HOME-mode install did not put fonts in ~/.local/share/fonts"
[ ! -e "$h4/.local/share/loadout/etc/fonts/loadout-fonts.conf" ] ||
    fail "HOME-mode install generated a shared-tree fontconfig snippet"

echo "PASS: shared-tree fonts + fontconfig snippet + shell export (HOME untouched)"
