#!/bin/sh
# env-zsh: installs, links the entrypoints, preserves user layers, and starts
# SILENTLY.
#
# The same acceptance criterion as the tcsh env: a warning on startup is a bug.
# An env-only HOME -- config installed, no loadout tools at all -- is the farm
# node case and must produce empty stderr and no shell diagnostics.
#
# HARNESS TRAPS, all of which give a green run that proves nothing:
#
#   1. `zsh -i -c CMD` does not go through the interactive line editor, so
#      several code paths never run. Commands are fed on stdin.
#   2. zsh with a piped stdin and no controlling terminal behaves differently
#      from a real session, so a PTY is required -- hence `script -qec`.
#   3. `script` gives the child a PTY, which means zsh's OWN diagnostics come
#      back on STDOUT while stderr stays empty. A stderr-only assertion cannot
#      see a shell complaining on every startup. This is not hypothetical: the
#      zsh env shipped `no matches found: .../zsh_history.*`, a failed
#      zsh/mathfunc load, and background-job notices, all on stdout. So the
#      output is scanned too.
set -eu

REPO="$(cd "$(dirname "$0")/.." && pwd)"

if ! command -v zsh >/dev/null 2>&1; then
    echo "SKIP: native zsh smoke (no zsh interpreter)"
    exit 77
fi
if ! command -v script >/dev/null 2>&1; then
    echo "SKIP: native zsh smoke (no 'script' for a PTY; cannot test startup silence honestly)"
    exit 77
fi

ZSH_BIN="$(command -v zsh)"
tmp_root=${TMPDIR:-/tmp}
TMPHOME="$(mktemp -d "$tmp_root/loadout-env-zsh.XXXXXX")"
trap 'chmod -R u+w "$TMPHOME" 2>/dev/null; rm -rf "$TMPHOME"' EXIT
fail() { echo "FAIL: $*" >&2; exit 1; }

ERRFILE="$TMPHOME/stderr.txt"

# Run an interactive zsh under a real PTY with a CLEAN environment, feeding it
# CMDS on stdin. `env -i` matters: without it the surrounding loadout bash
# session's exported LOADOUT_CFG_*/PATH leak in and the test silently measures
# the developer's shell instead of a fresh farm HOME.
zsh_i() {
    : > "$ERRFILE"
    printf '%s\nexit\n' "$1" \
        | env -i HOME="$TMPHOME" TERM=xterm PATH=/usr/bin:/bin \
              script -qec "$ZSH_BIN -i" /dev/null 2>"$ERRFILE" \
        | tr -d '\r' \
        | strip_escapes
}

# zsh_i with extra `env -i` assignments (VAR=value...) after the command text.
zsh_i_env() {
    _cmds=$1; shift
    : > "$ERRFILE"
    printf '%s\nexit\n' "$_cmds" \
        | env -i HOME="$TMPHOME" TERM=xterm PATH=/usr/bin:/bin "$@" \
              script -qec "$ZSH_BIN -i" /dev/null 2>"$ERRFILE" \
        | tr -d '\r' \
        | strip_escapes
}

# Strip OSC sequences BEFORE CSI ones. The zsh env emits OSC 133 semantic zones
# and OSC 7 cwd, so command output arrives glued to a marker
# ("<ESC>]133;C<ESC>\alive") and a CSI-only filter leaves the marker text in
# place -- making an anchored ^alive$ assertion fail on a perfectly good run.
strip_escapes() {
    sed -e 's/\x1b\][^\x1b\x07]*\(\x07\|\x1b\\\)//g' \
        -e 's/\x1b\[[0-9;?]*[a-zA-Z]//g' \
        -e 's/\x1b[()][A-Za-z0-9]//g'
}

assert_no_zsh_noise() {
    _label=$1
    _text=$2
    for _pat in 'no matches found' 'failed to load module' 'unknown function' \
                'command not found' 'bad substitution' 'parse error' \
                'bad pattern' 'no such file or directory' 'not valid in this context'; do
        case $_text in
            *"$_pat"*) fail "$_label: zsh printed '$_pat':
$_text" ;;
        esac
    done
    # Background-job notices ("[9] 2825450", "[9]  + done ..."). The online probe
    # (loadout_detect_online, reached through the cached wrapper) backgrounds its
    # probes; zsh reports jobs it owns, so the fan-out has to stay inside a
    # subshell or every startup prints job control noise.
    if echo "$_text" | grep -qE '^\[[0-9]+\]'; then
        fail "$_label: zsh printed background-job notices:
$_text"
    fi
}

HOME="$TMPHOME" "$REPO/loadout" install -y env-zsh env-bash --no-backup >/dev/null

[ -e "$TMPHOME/.zshrc" ] || fail ".zshrc not linked"
[ -e "$TMPHOME/.zprofile" ] || fail ".zprofile not linked"
[ -f "$TMPHOME/.config/zsh/zshrc" ] || fail "entry point not installed"
[ -f "$TMPHOME/.config/zsh/global/zshrc" ] || fail "global layer not installed"
for f in config.zsh keybinds.zsh completions.zsh modules-init.zsh wezterm-integration.zsh; do
    [ -f "$TMPHOME/.config/zsh/global/$f" ] || fail "global/$f not installed"
done

# --- THE headline test: an env-only HOME must start clean, on both channels.
out=$(zsh_i 'echo alive')
[ ! -s "$ERRFILE" ] || fail "interactive zsh wrote to stderr:
$(cat "$ERRFILE")"
assert_no_zsh_noise "interactive startup" "$out"
echo "$out" | grep -q '^alive$' || fail "zsh did not run the command: [$out]"

# --- A non-interactive zsh must still get PATH and the exported environment,
# --- and must not run any of the interactive setup.
: > "$ERRFILE"
echo 'echo "script-ran PIP=$PIP_REQUIRE_VIRTUALENV"' > "$TMPHOME/s.zsh"
out=$(env -i HOME="$TMPHOME" PATH=/usr/bin:/bin "$ZSH_BIN" "$TMPHOME/s.zsh" 2>"$ERRFILE") \
    || fail "non-interactive zsh script exited non-zero"
echo "$out" | grep -q 'script-ran PIP=1' \
    || fail "non-interactive zsh did not get the exported env: [$out]"
[ ! -s "$ERRFILE" ] || fail "non-interactive zsh wrote to stderr:
$(cat "$ERRFILE")"

# --- The shared bash layers are reused. This is the whole tracking mechanism:
# --- aliases and LOADOUT_CFG_* come from envs/bash, not a zsh copy.
out=$(zsh_i 'echo "VI=$LOADOUT_CFG_PREFERRED_VI"; alias b')
assert_no_zsh_noise "shared layers" "$out"
echo "$out" | grep -q 'VI=nvim' || fail "shared LOADOUT_CFG_* not loaded: [$out]"
echo "$out" | grep -q 'cd \.\.'  || fail "shared aliases.sh not loaded: [$out]"

# --- The shared function library must WORK under zsh, not merely parse. The
# --- path_* family used bash's ${!var} indirection and 0-based indexing, so the
# --- documented two-arg form died with "bad substitution" under zsh while the
# --- one-arg PATH form appeared fine -- a partial failure that reads as working.
out=$(zsh_i 'FOO=/aaa:/bbb; path_append FOO /ccc; path_prepend FOO /zzz; path_remove FOO /bbb; echo "P=$FOO"')
assert_no_zsh_noise "shared path functions" "$out"
echo "$out" | grep -q 'P=/zzz:/aaa:/ccc' \
    || fail "path_* two-arg form is broken under zsh: [$out]"
out=$(zsh_i 'D=/a:/tmp:/a:/tmp; path_trim D; echo "T=$D"')
echo "$out" | grep -q 'T=/a:/tmp$' || fail "path_trim is broken under zsh: [$out]"

# --- `pl` uses ${var,,} in the shared aliases.sh, which is a bash-4-only
# --- expansion and a runtime parse error under zsh.
out=$(zsh_i 'pl usr')
assert_no_zsh_noise "pl" "$out"
echo "$out" | grep -q '/usr' || fail "pl produced no output under zsh: [$out]"

# --- Environment parity with the bash env.
out=$(zsh_i 'echo "O=$LOADOUT_ONLINE ED=$EDITOR PG=${PAGER%% *} CT=$COLORTERM"')
assert_no_zsh_noise "environment" "$out"
echo "$out" | grep -qE 'O=[01]'      || fail "LOADOUT_ONLINE not set: [$out]"
echo "$out" | grep -q  'ED=nvim'     || fail "EDITOR not derived from LOADOUT_CFG_PREFERRED_VI: [$out]"
echo "$out" | grep -q  'PG=less'     || fail "PAGER not set: [$out]"
echo "$out" | grep -q  'CT=truecolor' || fail "COLORTERM not set: [$out]"

# --- The auto verdict is read from the on-disk cache, as in bash and tcsh.
# --- The probe host is a closed port, so a live probe can only say 0; a seeded
# --- verdict of 1 therefore proves the cache was read. Regression guard for zsh
# --- calling loadout_detect_online directly, which made every new login pay the
# --- probe instead of reading the once-a-day verdict.
CACHE_RT="$TMPHOME/rt"
PROBE_HOSTS="127.0.0.1:9"
probe_key=$(printf '%s' "$PROBE_HOSTS" | md5sum | awk '{print $1}')
mkdir -p "$CACHE_RT/.loadout-net"
chmod 700 "$CACHE_RT" "$CACHE_RT/.loadout-net"
printf 'export LOADOUT_CFG_ONLINE_DETECT_HOSTS="%s"\n' "$PROBE_HOSTS" \
    >"$TMPHOME/.config/bash/user/config.sh"
printf '1\n' >"$CACHE_RT/.loadout-net/detect-$probe_key"
out=$(zsh_i_env 'print -r -- "OC=$LOADOUT_ONLINE"' XDG_RUNTIME_DIR="$CACHE_RT")
assert_no_zsh_noise "online cache" "$out"
echo "$out" | grep -q 'OC=1' || fail "seeded online verdict not read from the cache (a probe would say 0): [$out]"
printf '0\n' >"$CACHE_RT/.loadout-net/detect-$probe_key"
out=$(zsh_i_env 'print -r -- "OC=$LOADOUT_ONLINE"' XDG_RUNTIME_DIR="$CACHE_RT")
assert_no_zsh_noise "online cache" "$out"
echo "$out" | grep -q 'OC=0' || fail "seeded offline verdict not read from the cache: [$out]"
# No cache entry, unreachable host: the probe still runs and reports offline.
rm -f "$CACHE_RT/.loadout-net/detect-$probe_key"
out=$(zsh_i_env 'print -r -- "OC=$LOADOUT_ONLINE"' XDG_RUNTIME_DIR="$CACHE_RT")
assert_no_zsh_noise "online probe" "$out"
echo "$out" | grep -q 'OC=0' || fail "unreachable probe host did not report offline: [$out]"
rm -f "$TMPHOME/.config/bash/user/config.sh"

# --- Per-PID history, matching the bash env's model (and what `gah` searches).
out=$(zsh_i 'echo "HF=$HISTFILE"')
assert_no_zsh_noise "history" "$out"
echo "$out" | grep -q 'HF=.*zsh_history\.' || fail "per-PID histfile not set: [$out]"

# --- Every directory change lists, via zsh's native chpwd hook.
mkdir -p "$TMPHOME/probe/sub"
touch "$TMPHOME/probe/sub/CHPWD_MARKER"
out=$(zsh_i "cd $TMPHOME/probe/sub")
assert_no_zsh_noise "chpwd" "$out"
echo "$out" | grep -q 'CHPWD_MARKER' || fail "chpwd hook did not list after cd: [$out]"

# --- cd conveniences from the bash env: a FILE argument goes to its parent.
out=$(zsh_i "cd $TMPHOME/probe/sub/CHPWD_MARKER; pwd")
assert_no_zsh_noise "cd to a file" "$out"
echo "$out" | grep -q 'probe/sub$' || fail "cd FILE did not land in its parent: [$out]"

# --- Reinstall must not clobber a user-created layer. env-zsh used the GENERIC
# --- installer, whose install_path() syncs the whole tree with delete=True --
# --- so every reinstall deleted ~/.config/zsh/{corp,site,team,project,user}
# --- while the shipped zshrc went on sourcing them. Same failure the env-st and
# --- env-tcsh handlers exist to prevent.
echo 'export LOADOUT_TEST_KEEPME=1' > "$TMPHOME/.config/zsh/user/zshrc"
HOME="$TMPHOME" "$REPO/loadout" install -y env-zsh --no-backup >/dev/null
[ -f "$TMPHOME/.config/zsh/user/zshrc" ] || fail "reinstall deleted the user layer"
out=$(zsh_i 'echo "KEEP=$LOADOUT_TEST_KEEPME"')
echo "$out" | grep -q 'KEEP=1' || fail "user layer is not sourced: [$out]"

# --- A symlinked ~/.config/zsh must be materialized WITHOUT losing the layers
# --- stored at the link target (bash preserves them; zsh did not).
chmod -R u+w "$TMPHOME/.config/zsh"
mv "$TMPHOME/.config/zsh" "$TMPHOME/zsh-external"
mkdir -p "$TMPHOME/zsh-external/user"
echo 'export LOADOUT_TEST_ZSH_LAYER=1' > "$TMPHOME/zsh-external/user/zshrc"
ln -s ../zsh-external "$TMPHOME/.config/zsh"
HOME="$TMPHOME" "$REPO/loadout" install -y env-zsh --no-backup >/dev/null
[ ! -L "$TMPHOME/.config/zsh" ] || fail "symlinked ~/.config/zsh was not materialized"
[ -f "$TMPHOME/.config/zsh/user/zshrc" ] || fail "install lost layers from a symlinked ~/.config/zsh"
out=$(zsh_i 'echo "SYM=$LOADOUT_TEST_ZSH_LAYER"')
assert_no_zsh_noise "symlinked config layers" "$out"
echo "$out" | grep -q 'SYM=1' || fail "preserved layer was not sourced: [$out]"

# --- sp1/sp2 must EXPORT the host switch: starship's modules run in a child
# --- shell, so a shell-local assignment drives only the fallback prompt.
out=$(zsh_i 'sp2; print -r -- "H=$LOADOUT_CFG_PROMPT_INCLUDE_HOST"; sh -c "echo C=\$LOADOUT_CFG_PROMPT_INCLUDE_HOST"')
echo "$out" | grep -q 'H=1' || fail "sp2 did not set the host switch: [$out]"
echo "$out" | grep -q 'C=1' || fail "sp2 did not export the host switch: [$out]"
out=$(zsh_i 'sp2; sp1; print -r -- "H=$LOADOUT_CFG_PROMPT_INCLUDE_HOST"')
echo "$out" | grep -q 'H=0' || fail "sp1 did not clear the host switch: [$out]"

# --- `cd -- DIR` must land in DIR (`--` ends the options; a dash-led name
# --- after it is a path). cd() took `--` as the target and offered to create
# --- it, so tmux-path-store's cd0..cd9 hooks (`cd -- "$dir"`) went elsewhere.
mkdir -p "$TMPHOME/cdtest/-dash"
out=$(zsh_i "cd -- '$TMPHOME/cdtest'; print -r -- \"A=\$PWD\"; cd -- -dash; print -r -- \"B=\$PWD\"")
case $out in *'does not exist'*) fail "cd -- DIR offered to create a directory: [$out]" ;; esac
echo "$out" | grep -q "A=$TMPHOME/cdtest\$" || fail "cd -- DIR did not land in DIR: [$out]"
echo "$out" | grep -q "B=$TMPHOME/cdtest/-dash\$" || fail "cd -- -dash did not treat -dash as a path: [$out]"

# --- LOADOUT_CFG_ONLINE_DETECT forces the startup verdict. The probe host is a
# --- closed port, so an `auto` probe would say 0: seeing 1 proves the setting
# --- was read, not the network.
for want in 1 0; do
    printf 'export LOADOUT_CFG_ONLINE_DETECT=%s\nexport LOADOUT_CFG_ONLINE_DETECT_HOSTS="127.0.0.1:9"\n' "$want" \
        >"$TMPHOME/.config/bash/user/config.sh"
    out=$(zsh_i 'printenv LOADOUT_ONLINE')
    echo "$out" | grep -qx "$want" || fail "ONLINE_DETECT=$want did not give LOADOUT_ONLINE=$want: [$out]"
done

# --- A shared config root (BASH_CONFIG_DIR / ZSH_CONFIG_DIR outside
# --- HOME) must still get the HOME corp..user override layers afterwards, in all
# --- three passes -- as bash and tcsh do. Mirrors tests/install-env-tcsh.
rm -f "$TMPHOME/.config/bash/user/config.sh"
ALTB="$TMPHOME/shared-bash-root"
ALTZ="$TMPHOME/shared-zsh-root"
mkdir -p "$ALTB" "$ALTZ"
cp -a "$TMPHOME/.config/bash/global" "$ALTB/global"
cp -a "$TMPHOME/.config/bash/functions.sh" "$ALTB/functions.sh"
cp -a "$TMPHOME/.config/zsh/global" "$ALTZ/global"
for layer in corp site team project user; do
    mkdir -p "$ALTB/$layer" "$ALTZ/$layer"
done
mkdir -p "$TMPHOME/.config/bash/user" "$TMPHOME/.config/zsh/user"
echo 'export LOADOUT_TEST_OV_CFGSH=yes' > "$TMPHOME/.config/bash/user/config.sh"
echo 'export LOADOUT_TEST_OV_CFGZSH=yes' > "$TMPHOME/.config/zsh/user/config.zsh"
cat > "$TMPHOME/.config/zsh/user/zshrc" <<'RC'
export LOADOUT_TEST_OV_ZSHRC=yes
export LOADOUT_TEST_ZSHRC_COUNT=$(( ${LOADOUT_TEST_ZSHRC_COUNT:-0} + 1 ))
RC
out=$(zsh_i_env 'print -r -- "OV=$LOADOUT_TEST_OV_CFGSH,$LOADOUT_TEST_OV_CFGZSH,$LOADOUT_TEST_OV_ZSHRC"' \
    BASH_CONFIG_DIR="$ALTB" ZSH_CONFIG_DIR="$ALTZ")
assert_no_zsh_noise "shared-root overlay" "$out"
echo "$out" | grep -q 'OV=yes,yes,yes' || fail "home override layers not sourced under shared roots: [$out]"
# Negative control: default roots are the home layers themselves -- sourced once.
out=$(zsh_i 'print -r -- "N=$LOADOUT_TEST_ZSHRC_COUNT"')
echo "$out" | grep -q 'N=1' || fail "home zshrc layer not sourced exactly once under default roots: [$out]"
rm -f "$TMPHOME/.config/bash/user/config.sh" "$TMPHOME/.config/zsh/user/config.zsh" "$TMPHOME/.config/zsh/user/zshrc"

echo "install-env-zsh: OK"
