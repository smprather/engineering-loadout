#!/bin/sh
# env-bash: a fresh install creates the five override layer directories, and a
# reinstall preserves what the user put in them.
#
# The shipped bashrc sources corp/site/team/project/user unconditionally via
# source_if_exists, and downstream tooling (e.g. psg-env) locks ~/.config/bash
# read-only and re-opens only ~/.config/bash/user. If install_bash leaves that
# directory absent, the user cannot create it afterwards because the parent is
# already read-only. env-tcsh and env-zsh create the same five layers; env-bash
# must match.
set -eu

REPO="$(cd "$(dirname "$0")/.." && pwd)"

TMPHOME="$(mktemp -d "${TMPDIR:-/tmp}/loadout-env-bash.XXXXXX")"
trap 'chmod -R u+w "$TMPHOME" 2>/dev/null; rm -rf "$TMPHOME"' EXIT

fail() { echo "FAIL: $*" >&2; exit 1; }

ERRFILE="$TMPHOME/stderr.txt"
BASH_BIN="$(command -v bash)"

# bash_i CMDS [VAR=value ...] -- run CMDS in an interactive bash under a PTY with
# a CLEAN environment (env -i: the surrounding shell's exported LOADOUT_* must
# not leak) plus the given assignments.
bash_i() {
    _cmds=$1
    shift
    : > "$ERRFILE"
    printf '%s\nexit\n' "$_cmds" \
        | env -i HOME="$TMPHOME" TERM=xterm PATH=/usr/bin:/bin "$@" \
              script -qec "$BASH_BIN -i" /dev/null 2>"$ERRFILE" \
        | tr -d '\r' \
        | strip_escapes
}

strip_escapes() {
    sed -e 's/\x1b\][^\x1b\x07]*\(\x07\|\x1b\\\)//g' \
        -e 's/\x1b\[[0-9;?]*[a-zA-Z]//g' \
        -e 's/\x1b[()][A-Za-z0-9]//g'
}

HOME="$TMPHOME" "$REPO/loadout" install -y env-bash --no-backup >/dev/null

for layer in corp site team project user; do
    [ -d "$TMPHOME/.config/bash/$layer" ] || fail "fresh install did not create ~/.config/bash/$layer"
done

# Downstream hardening (psg-env) locks ~/.config/bash read-only and re-opens
# only the user layer. That must leave a writable place for overrides.
chmod -R a-w "$TMPHOME/.config/bash"
chmod -R u+w "$TMPHOME/.config/bash/user" 2>/dev/null \
    || fail "~/.config/bash/user is not re-openable after the tree is locked read-only"
: >"$TMPHOME/.config/bash/user/overlay.conf" \
    || fail "user cannot write an override after the tree is locked read-only"
chmod -R u+w "$TMPHOME/.config/bash" # let the EXIT trap remove the tree

# A reinstall must not delete a user-created layer (the same regression the
# env-st/env-tcsh/env-zsh handlers exist to prevent).
printf '%s\n' 'export LOADOUT_TEST_KEEPME=1' >"$TMPHOME/.config/bash/user/bashrc"
HOME="$TMPHOME" "$REPO/loadout" install -y env-bash --no-backup >/dev/null

[ -f "$TMPHOME/.config/bash/user/bashrc" ] || fail "reinstall deleted the user layer"
for layer in corp site team project user; do
    [ -d "$TMPHOME/.config/bash/$layer" ] || fail "reinstall deleted ~/.config/bash/$layer"
done

# An upgrade from a GRC-era tree must not leave GRC behind. global/ is sealed
# read-only after an install, so plant the retired tree the way an old install
# left it (sealed too) and require the reinstall to remove it.
g="$TMPHOME/.config/bash/global"
chmod u+w "$g"
chmod -R u+w "$g/grc" 2>/dev/null || true
rm -rf "$g/grc"
mkdir -p "$g/grc/bin"
printf '#!/bin/sh\nexit 0\n' >"$g/grc/bin/grc"
chmod 0555 "$g/grc/bin/grc" "$g/grc/bin" "$g/grc" "$g"
HOME="$TMPHOME" "$REPO/loadout" install -y env-bash --no-backup >/dev/null
[ ! -e "$g/grc" ] || fail "reinstall left the retired GRC tree at ~/.config/bash/global/grc"

# --- LOADOUT_CFG_ONLINE_DETECT forces the startup verdict. The probe host is a
# --- closed port, so an `auto` probe would say 0: seeing 1 proves the setting
# --- was read, not the network.
for want in 1 0; do
    printf 'export LOADOUT_CFG_ONLINE_DETECT=%s\nexport LOADOUT_CFG_ONLINE_DETECT_HOSTS="127.0.0.1:9"\n' "$want" \
        >"$TMPHOME/.config/bash/user/config.sh"
    out=$(bash_i 'printenv LOADOUT_ONLINE')
    echo "$out" | grep -qx "$want" || fail "ONLINE_DETECT=$want did not give LOADOUT_ONLINE=$want: [$out]"
done

# --- The start-of-source `unset -f` keeps LOADOUT_CFG_PRESERVE_FUNCTIONS' default
# --- even when nothing exported it yet. It runs before config.sh, so on a first
# --- login (sshd, or a tcsh origin switching to bash) the variable is unset, and
# --- Environment Modules' `module` -- defined by /etc/profile.d, or inherited
# --- through `export -f` as here -- was wiped. Unset = the documented default.
rm -f "$TMPHOME/.config/bash/user/config.sh"
MODULE_FN='BASH_FUNC_module%%=() {  echo MODULE_OK
}'
out=$(bash_i 'module 2>/dev/null || echo PROBE_nomodule' "$MODULE_FN")
echo "$out" | grep -qx MODULE_OK \
    || fail "an exported module() did not survive bashrc's reset with LOADOUT_CFG_PRESERVE_FUNCTIONS unset: [$out]"
# Control: config.sh documents "Empty = clear all", so an explicit empty value
# still wipes it (the default applies to unset only, not to empty).
out=$(bash_i 'module 2>/dev/null || echo PROBE_nomodule' "$MODULE_FN" LOADOUT_CFG_PRESERVE_FUNCTIONS=)
echo "$out" | grep -qx PROBE_nomodule \
    || fail "an exported module() survived bashrc's reset with LOADOUT_CFG_PRESERVE_FUNCTIONS empty: [$out]"
# The default is spelled twice (bashrc applies it before config.sh exists).
_cfg_default=$(sed -n 's/^export LOADOUT_CFG_PRESERVE_FUNCTIONS="\(.*\)"$/\1/p' "$REPO/envs/bash/global/config.sh")
grep -qF "\${LOADOUT_CFG_PRESERVE_FUNCTIONS-$_cfg_default}" "$REPO/envs/bash/bashrc" \
    || fail "envs/bash/bashrc's PRESERVE_FUNCTIONS fallback differs from config.sh's default [$_cfg_default]"

echo "install-env-bash: OK"
