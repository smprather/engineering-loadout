#!/bin/sh
# env-private-dirs: per-user runtime dirs in a shared scratch root must be
# private before the shells or nvim use them.
#
# bash/zsh/tcsh put the Python bytecode cache, the XDG_RUNTIME_DIR fallback and
# (bash) a copy of eza under /dev/shm at predictable names; nvim puts its swap
# dir, vitmp file and lua_ls logs there too. /dev/shm is world-writable, so a
# co-tenant can create those names first. A planted eza runs on every `ls`, and
# a planted pycache prefix serves .pyc files to every Python the user runs. So
# each use checks that the directory is a real dir (not a symlink) owned by the
# user that no one else could have written, and falls back to a HOME path
# otherwise.
#
# LOADOUT_CFG_SHM_DIR points the scratch root at a temp dir, so nothing here
# touches the real /dev/shm. A foreign OWNER needs a second account (the
# installer's check is unit-tested with a symlink); the shape one account can
# build is a symlink. The user's own group-writable dir (UPG umask 002 leaves
# 0775) is tightened, not refused, when its group is the user's private group;
# an other-writable dir, or a group-writable one whose group is shared, is
# refused and left alone -- tightening it would trust what is already inside.
#
# Harness rules (AGENTS.md "Shell-config test harness traps"): real PTY via
# script(1), env -i, and output scanned for shell error vocabulary (the PTY
# routes the shell's own diagnostics to stdout).
set -eu

REPO="$(cd "$(dirname "$0")/.." && pwd)"
T="$(mktemp -d "${TMPDIR:-/tmp}/loadout-env-private.XXXXXX")"
trap 'chmod -R u+w "$T" 2>/dev/null; rm -rf "$T"' EXIT

fail() { echo "FAIL: $*" >&2; exit 1; }

ME=$(id -un)
UID_NUM=$(id -u)
H="$T/home"
SHM="$T/shm"
mkdir -p "$H"

env -i HOME="$H" PATH=/usr/bin:/bin LANG="${LANG:-C.UTF-8}" TMPDIR="${TMPDIR:-/tmp}" \
    "$REPO/loadout" install -y --no-backup @envs env-zsh env-nvim >"$T/install.log" 2>&1 \
    || { tail -30 "$T/install.log" >&2; fail "install of @envs env-zsh env-nvim failed"; }

mkdir -p "$H/.config/bash/user" "$H/.config/tcsh/user"
printf 'export LOADOUT_CFG_SHM_DIR="%s"\n' "$SHM" >>"$H/.config/bash/user/config.sh"
printf 'setenv LOADOUT_CFG_SHM_DIR "%s"\n' "$SHM" >>"$H/.config/tcsh/user/config.csh"

# One clean environment for every shell: no XDG_RUNTIME_DIR, no TMPDIR, so the
# shm fallbacks are what gets exercised.
run_env() {
    env -i HOME="$H" USER="$ME" LOGNAME="$ME" PATH=/usr/bin:/bin TERM=xterm-256color \
        LANG="${LANG:-C.UTF-8}" LOADOUT_ONLINE=0 "$@"
}

strip_escapes() {
    sed -e 's/\x1b\][^\x1b\x07]*\(\x07\|\x1b\\\)//g' \
        -e 's/\x1b\[[0-9;?]*[a-zA-Z]//g' \
        -e 's/\x1b[()][A-Za-z0-9]//g' \
        | tr -d '\r'
}

shell_out() {
    case $1 in
        bash) run_env script -qec 'bash -i -c "ls >/dev/null; /usr/bin/env"' /dev/null </dev/null ;;
        zsh) printf '/usr/bin/env\nexit\n' | run_env script -qec 'zsh -i' /dev/null ;;
        tcsh) printf '/usr/bin/env\nexit\n' | run_env script -qec 'tcsh -i' /dev/null ;;
    esac 2>&1 | strip_escapes
}

assert_quiet() {
    for _pat in 'command not found' 'syntax error' 'No such file or directory' \
                'Permission denied' 'not a valid identifier' 'Faulty alias' \
                'Undefined variable' 'Unmatched' 'parse error' 'bad substitution'; do
        case $2 in
            *"$_pat"*) fail "$1: shell printed '$_pat':
$2" ;;
        esac
    done
}

envval() {
    printf '%s\n' "$2" | sed -n "s/^$1=//p" | tail -1
}

mode_of() { stat -c %a "$1"; }

have_eza=0
PATH=/usr/bin:/bin command -v eza >/dev/null 2>&1 && have_eza=1
have_nvim=0
PATH=/usr/bin:/bin command -v nvim >/dev/null 2>&1 && have_nvim=1

reset_shm() {
    chmod -R u+w "$SHM" "$T/elsewhere" "$T/elsewhere-uid" 2>/dev/null || true
    rm -rf "$SHM" "$T/elsewhere" "$T/elsewhere-uid" "$T/pwned"
    mkdir -p "$SHM"
}

plant_loose() {
    mkdir -p "$SHM/$ME/bin" "$SHM/$UID_NUM"
    chmod 775 "$SHM/$ME" "$SHM/$ME/bin" "$SHM/$UID_NUM"
}

plant_open() {
    mkdir -p "$SHM/$ME/bin" "$SHM/$UID_NUM"
    chmod 777 "$SHM/$ME" "$SHM/$ME/bin" "$SHM/$UID_NUM"
}

# A supplementary group that is not our private group: group members can write
# a dir chgrp'd to it. Empty when this account has none (the case then skips).
shared_grp=
for _g in $(id -G); do
    [ "$_g" = "$(id -g)" ] && continue
    _n=$(getent group "$_g" 2>/dev/null | cut -d: -f1)
    if [ -n "$_n" ] && [ "$_n" != "$ME" ]; then
        shared_grp=$_g
        break
    fi
done

plant_symlinks() {
    mkdir -m 700 "$T/elsewhere" "$T/elsewhere-uid"
    ln -s "$T/elsewhere" "$SHM/$ME"
    ln -s "$T/elsewhere-uid" "$SHM/$UID_NUM"
}

assert_refused() {
    _case=$1
    _sh=$2
    _out=$3
    assert_quiet "$_case/$_sh" "$_out"
    _pyc=$(envval PYTHONPYCACHEPREFIX "$_out")
    case $_pyc in
        "$SHM"/*) fail "$_case/$_sh: PYTHONPYCACHEPREFIX=$_pyc is under the untrusted scratch root" ;;
    esac
    _xdg=$(envval XDG_RUNTIME_DIR "$_out")
    [ -n "$_xdg" ] || fail "$_case/$_sh: XDG_RUNTIME_DIR not set:
$_out"
    case $_xdg in
        "$SHM"/*) fail "$_case/$_sh: XDG_RUNTIME_DIR=$_xdg is under the untrusted scratch root" ;;
    esac
    [ -d "$_xdg" ] && [ ! -L "$_xdg" ] && [ "$(mode_of "$_xdg")" = 700 ] \
        || fail "$_case/$_sh: fallback XDG_RUNTIME_DIR=$_xdg is not a private dir"
}

# ---- clean: the scratch root is empty, so the private dirs are created 0700 --
for sh in bash zsh tcsh; do
    reset_shm
    out=$(shell_out "$sh")
    assert_quiet "clean/$sh" "$out"
    [ -d "$SHM/$ME" ] && [ "$(mode_of "$SHM/$ME")" = 700 ] \
        || fail "clean/$sh: $SHM/$ME missing or not 0700:
$out"
    [ "$(envval PYTHONPYCACHEPREFIX "$out")" = "$SHM/$ME/pycache" ] \
        || fail "clean/$sh: PYTHONPYCACHEPREFIX=$(envval PYTHONPYCACHEPREFIX "$out"), want $SHM/$ME/pycache"
    [ "$(envval XDG_RUNTIME_DIR "$out")" = "$SHM/$UID_NUM" ] \
        || fail "clean/$sh: XDG_RUNTIME_DIR=$(envval XDG_RUNTIME_DIR "$out"), want $SHM/$UID_NUM"
    [ "$(mode_of "$SHM/$UID_NUM")" = 700 ] || fail "clean/$sh: $SHM/$UID_NUM is not 0700"
    if [ "$sh" = bash ] && [ "$have_eza" = 1 ]; then
        # Proves the eza branch runs against the scratch root at all, so the
        # hostile case below is not passing because the copy never happens.
        [ -x "$SHM/$ME/bin/eza" ] || fail "clean/bash: eza was not copied into $SHM/$ME/bin"
    fi
    echo "  PASS  clean/$sh"
done

# ---- non-interactive: every shell must export the same base environment -----
# bash used to set PYTHONPYCACHEPREFIX (and the other Python guards) after its
# non-interactive return, while zsh/tcsh set them on every startup. The tcsh
# comment asserts the bash env exports these before the return, so scripts get
# them from an `ssh host cmd`/`bash -l` job too.
for sh in bash zsh tcsh; do
    reset_shm
    case $sh in
        bash) out=$(run_env bash -l -c '/usr/bin/env' 2>&1) ;;
        zsh) out=$(run_env zsh -c '/usr/bin/env' 2>&1) ;;
        tcsh) out=$(run_env tcsh -c '/usr/bin/env' 2>&1) ;;
    esac
    assert_quiet "non-interactive/$sh" "$out"
    [ "$(envval PYTHONPYCACHEPREFIX "$out")" = "$SHM/$ME/pycache" ] \
        || fail "non-interactive/$sh: PYTHONPYCACHEPREFIX=$(envval PYTHONPYCACHEPREFIX "$out")"
    [ "$(envval PIP_REQUIRE_VIRTUALENV "$out")" = 1 ] \
        || fail "non-interactive/$sh: PIP_REQUIRE_VIRTUALENV missing"
    [ "$(envval PYTHON_KEYRING_BACKEND "$out")" = keyring.backends.null.Keyring ] \
        || fail "non-interactive/$sh: PYTHON_KEYRING_BACKEND missing"
    [ "$(envval EGL_LOG_LEVEL "$out")" = fatal ] \
        || fail "non-interactive/$sh: EGL_LOG_LEVEL=$(envval EGL_LOG_LEVEL "$out")"
    echo "  PASS  non-interactive/$sh"
done

# ---- loose-dir: the user's own dirs are 0775 (UPG umask 002) -> tighten -----
# The old code refused these, so every shell silently fell back and the
# installer refused to stage until reboot/tmp cleanup. Group write is ours to
# remove when the group is our private group: nobody else could have written.
for sh in bash zsh tcsh; do
    reset_shm
    plant_loose
    out=$(shell_out "$sh")
    assert_quiet "loose-dir/$sh" "$out"
    [ "$(mode_of "$SHM/$ME")" = 700 ] || fail "loose-dir/$sh: $SHM/$ME is $(mode_of "$SHM/$ME"), want 700"
    [ "$(mode_of "$SHM/$UID_NUM")" = 700 ] || fail "loose-dir/$sh: $SHM/$UID_NUM was not tightened"
    [ "$(envval PYTHONPYCACHEPREFIX "$out")" = "$SHM/$ME/pycache" ] \
        || fail "loose-dir/$sh: PYTHONPYCACHEPREFIX=$(envval PYTHONPYCACHEPREFIX "$out")"
    [ "$(envval XDG_RUNTIME_DIR "$out")" = "$SHM/$UID_NUM" ] \
        || fail "loose-dir/$sh: XDG_RUNTIME_DIR=$(envval XDG_RUNTIME_DIR "$out")"
    if [ "$sh" = bash ]; then
        [ "$(mode_of "$SHM/$ME/bin")" = 700 ] || fail "loose-dir/bash: $SHM/$ME/bin was not tightened"
        if [ "$have_eza" = 1 ]; then
            [ -x "$SHM/$ME/bin/eza" ] || fail "loose-dir/bash: eza was not copied into the tightened dir"
        fi
    fi
    echo "  PASS  loose-dir/$sh"
done

# ---- open-dir: our own dirs are other-writable -> refuse, leave alone -------
# Anyone could have planted content there (a newer bin/eza the bash wrapper
# keeps reusing, .pyc files); tightening afterwards would trust it.
for sh in bash zsh tcsh; do
    reset_shm
    plant_open
    out=$(shell_out "$sh")
    assert_refused open-dir "$sh" "$out"
    [ "$(mode_of "$SHM/$ME")" = 777 ] || fail "open-dir/$sh: $SHM/$ME was changed to $(mode_of "$SHM/$ME")"
    [ ! -e "$SHM/$ME/bin/eza" ] || fail "open-dir/$sh: eza was copied into an other-writable dir"
    echo "  PASS  open-dir/$sh"
done

# ---- shared-group: 0775 with a group other than ours -> refuse --------------
if [ -n "$shared_grp" ]; then
    for sh in bash zsh tcsh; do
        reset_shm
        plant_loose
        chgrp "$shared_grp" "$SHM/$ME" "$SHM/$ME/bin" "$SHM/$UID_NUM"
        out=$(shell_out "$sh")
        assert_refused shared-group "$sh" "$out"
        [ "$(mode_of "$SHM/$ME")" = 775 ] || fail "shared-group/$sh: $SHM/$ME was changed to $(mode_of "$SHM/$ME")"
        echo "  PASS  shared-group/$sh"
    done
else
    echo "  SKIP  shared-group: this account has no supplementary group to chgrp to"
fi

# ---- symlink-dir: the per-user names are symlinks to somewhere else ---------
for sh in bash zsh tcsh; do
    reset_shm
    plant_symlinks
    out=$(shell_out "$sh")
    assert_refused symlink-dir "$sh" "$out"
    [ -z "$(ls -A "$T/elsewhere")" ] || fail "symlink-dir/$sh: wrote through the symlink into $T/elsewhere"
    [ -z "$(ls -A "$T/elsewhere-uid")" ] || fail "symlink-dir/$sh: wrote through the symlink into $T/elsewhere-uid"
    echo "  PASS  symlink-dir/$sh"
done

# ---- nvim: swap dir follows the same rule ------------------------------------
if [ "$have_nvim" = 1 ]; then
    # PATH holds nvim alone: with no git, lazy.nvim's bootstrap fails fast and
    # offline instead of cloning plugins (this case is about config.lua only).
    mkdir -p "$T/nvim-bin"
    ln -sf "$(PATH=/usr/bin:/bin command -v nvim)" "$T/nvim-bin/nvim"
    nvim_swap() {
        rm -f "$T/nvim.out"
        env -i HOME="$H" USER="$ME" LOGNAME="$ME" PATH="$T/nvim-bin" TERM=xterm-256color \
            LANG="${LANG:-C.UTF-8}" LOADOUT_ONLINE=0 LOADOUT_CFG_SHM_DIR="$SHM" \
            "$T/nvim-bin/nvim" --headless -n \
            +"lua vim.fn.writefile({vim.g.cfg_swap_dir, vim.g.cfg_vitmp_file}, '$T/nvim.out')" \
            +qa >/dev/null 2>&1 </dev/null
        cat "$T/nvim.out" 2>/dev/null
    }
    reset_shm
    got=$(nvim_swap)
    swap=$(printf '%s\n' "$got" | sed -n 1p)
    [ "$swap" = "$SHM/$ME/vim" ] || fail "nvim clean: cfg_swap_dir=$swap, want $SHM/$ME/vim"
    reset_shm
    plant_loose
    got=$(nvim_swap)
    swap=$(printf '%s\n' "$got" | sed -n 1p)
    [ "$swap" = "$SHM/$ME/vim" ] || fail "nvim loose-dir: cfg_swap_dir=$swap, want $SHM/$ME/vim"
    [ "$(mode_of "$SHM/$ME")" = 700 ] || fail "nvim loose-dir: $SHM/$ME was not tightened"
    reset_shm
    plant_open
    got=$(nvim_swap)
    for p in $got; do
        case $p in
            "$SHM"/*) fail "nvim open-dir: $p is under an other-writable dir" ;;
        esac
    done
    [ "$(mode_of "$SHM/$ME")" = 777 ] || fail "nvim open-dir: $SHM/$ME was changed to $(mode_of "$SHM/$ME")"
    if [ -n "$shared_grp" ]; then
        reset_shm
        plant_loose
        chgrp "$shared_grp" "$SHM/$ME"
        got=$(nvim_swap)
        for p in $got; do
            case $p in
                "$SHM"/*) fail "nvim shared-group: $p is under a shared-group dir" ;;
            esac
        done
    fi
    reset_shm
    plant_symlinks
    got=$(nvim_swap)
    for p in $got; do
        case $p in
            "$SHM"/*) fail "nvim symlink-dir: $p is under the untrusted scratch root" ;;
        esac
    done
    [ -z "$(ls -A "$T/elsewhere")" ] || fail "nvim symlink-dir: wrote through the symlink"
    echo "  PASS  nvim"

    # The online probe must not build shell strings from env values: a host
    # list carrying shell syntax must not run it. PATH holds the probe tools and
    # touch (so a shell-built command WOULD succeed) but no git. An empty
    # XDG_RUNTIME_DIR means no cached verdict, so the live probe runs.
    mkdir -p "$T/probe-bin" "$T/rt"
    ln -sf "$(PATH=/usr/bin:/bin command -v nvim)" "$T/probe-bin/nvim"
    for tool in sh bash timeout nc curl touch findmnt; do
        p=$(PATH=/usr/bin:/bin command -v "$tool" 2>/dev/null) && ln -sf "$p" "$T/probe-bin/$tool"
    done
    rm -f "$T/pwned"
    env -i HOME="$H" USER="$ME" LOGNAME="$ME" PATH="$T/probe-bin" TERM=xterm-256color \
        LANG="${LANG:-C.UTF-8}" XDG_RUNTIME_DIR="$T/rt" \
        LOADOUT_CFG_ONLINE_DETECT_HOSTS="x;touch\${IFS}$T/pwned;x:443" \
        "$T/probe-bin/nvim" --headless -n +qa >/dev/null 2>&1 </dev/null || true
    [ ! -e "$T/pwned" ] || fail "nvim's online probe ran shell syntax from LOADOUT_CFG_ONLINE_DETECT_HOSTS"
    echo "  PASS  nvim online probe is shell-free"
else
    echo "  SKIP  nvim (no nvim on PATH)"
fi

# ---- online verdict cache: never the shared /tmp fallback --------------------
# With no XDG_RUNTIME_DIR, bash's loadout_detect_online_cached and tcsh's
# helpers/detect-online wrote the verdict under /tmp/.loadout-net -- a
# predictable shared dir whoever creates first owns, so a co-tenant could plant
# the verdict or a symlink at the temp name. No runtime dir means no cache.
# Unique host lists give unique cache keys, so only this run's files are checked.
had_net=0
[ -d /tmp/.loadout-net ] && had_net=1
bash_hosts="loadout-test-bash-$$.invalid:9"
tcsh_hosts="loadout-test-tcsh-$$.invalid:9"
bash_key=$(printf '%s' "$bash_hosts" | md5sum | awk '{print $1}')
tcsh_key=$(printf '%s' "$tcsh_hosts" | md5sum | awk '{print $1}')
env -i HOME="$H" PATH=/usr/bin:/bin LOADOUT_CFG_ONLINE_DETECT_HOSTS="$bash_hosts" \
    bash -c ". '$REPO/envs/bash/functions.sh'; loadout_detect_online() { return 0; }; loadout_detect_online_cached" \
    >/dev/null 2>&1 || true
env -i HOME="$H" PATH=/usr/bin:/bin LOADOUT_CFG_ONLINE_DETECT_HOSTS="$tcsh_hosts" \
    sh "$REPO/envs/tcsh/global/helpers/detect-online" 0.01 >/dev/null 2>&1 || true
leaked=""
for key in "$bash_key" "$tcsh_key"; do
    if [ -e "/tmp/.loadout-net/detect-$key" ]; then
        leaked="$leaked /tmp/.loadout-net/detect-$key"
        rm -f "/tmp/.loadout-net/detect-$key"
    fi
done
if [ "$had_net" = 0 ] && [ -d /tmp/.loadout-net ]; then
    # Nothing in this run may create the shared dir at all (any shell above, too).
    leaked="$leaked /tmp/.loadout-net (created; holds: $(ls -A /tmp/.loadout-net | tr '\n' ' '))"
    rm -rf /tmp/.loadout-net
fi
[ -z "$leaked" ] || fail "online verdict cached in the shared /tmp fallback:$leaked"
echo "  PASS  no XDG_RUNTIME_DIR: the online verdict is not cached in /tmp"

[ "$have_eza" = 1 ] || echo "  NOTE  no eza on PATH; the planted-eza assertion ran without the eza branch"
echo "env-private-dirs: OK"
