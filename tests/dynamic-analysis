#!/usr/bin/env python3.14
"""
dynamic-analysis -- behavioral "detonation" test for an installed tool.

Runs each invocation in a package's assurance profile inside a mock
chip-design HOME seeded with canary files, wrapped in strace, and fails if the
tool behaves like ransomware/a wiper: any canary file modified, an entropy
spike (encryption), a write/unlink/rename outside the profile's allowlist, a
network connect/socket while the profile forbids it, or a mass-unlink.

Intended to run inside the clean AlmaLinux 8.10 container under
`docker run --network none` (so a real connect() cannot succeed and the true
offline install path is what gets certified). strace must be present; the
container image installs it.

Usage:
  tests/dynamic-analysis --package nvim --bindir <dir> [--profile FILE]

Exits 0 if the tool stayed within its behavioral envelope, 1 otherwise.
"""

import argparse
import hashlib
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

PASSED = 0
FAILED = 0


def check(name, ok, detail=""):
    global PASSED, FAILED
    if ok:
        PASSED += 1
        print(f"  PASS  {name}")
    else:
        FAILED += 1
        print(f"  FAIL  {name}  {detail}")


def sha256_of(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def entropy(path):
    counts = [0] * 256
    n = 0
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            for b in chunk:
                counts[b] += 1
                n += 1
    if n == 0:
        return 0.0
    e = 0.0
    for c in counts:
        if c:
            p = c / n
            e -= p * math.log2(p)
    return e


CANARIES = {
    "proj/mock_design.v": "module top(input clk, output reg q);\n  always @(posedge clk) q <= ~q;\nendmodule\n",
    "proj/mock_timing.lib": "library(mock) {\n  cell(INV) { area: 1.0; pin(A){direction:input;} pin(Y){direction:output;} }\n}\n",
    "proj/constraints.sdc": "create_clock -name clk -period 2.0 [get_ports clk]\nset_input_delay 0.5 -clock clk [all_inputs]\n",
    "proj/docs/readme.txt": "Confidential design notes. Do not distribute.\n" * 20,
    "proj/netlist.bin": None,  # binary blob, filled below
}


def seed_home(home):
    for rel, content in CANARIES.items():
        full = os.path.join(home, rel)
        os.makedirs(os.path.dirname(full), exist_ok=True)
        if content is None:
            with open(full, "wb") as fh:
                fh.write(os.urandom(4096))
        else:
            with open(full, "w") as fh:
                fh.write(content)
    os.makedirs(os.path.join(home, ".config"), exist_ok=True)
    os.makedirs(os.path.join(home, ".local", "state"), exist_ok=True)
    os.makedirs("/tmp/scratch", exist_ok=True)


def canary_baseline(home):
    base = {}
    for rel in CANARIES:
        full = os.path.join(home, rel)
        base[rel] = (sha256_of(full), entropy(full))
    return base


WRITE_SYSCALLS = ("openat", "open", "creat", "write", "truncate", "ftruncate")
UNLINK_SYSCALLS = ("unlink", "unlinkat")
RENAME_SYSCALLS = ("rename", "renameat", "renameat2")
NET_SYSCALLS = ("connect", "socket")

_PATH_RE = re.compile(r'"((?:[^"\\]|\\.)*)"')


def parse_strace(log_path, home):
    """Return (writes, unlinks, renames, net_calls) of absolute-ish paths that
    look like real filesystem mutations, from an strace -f log."""
    writes, unlinks, renames, net = set(), set(), set(), []
    if not os.path.isfile(log_path):
        return writes, unlinks, renames, net
    for line in open(log_path, errors="replace"):
        # skip failed calls (return -1) -- an attempt that errored didn't mutate
        m = re.search(r"^\d*\s*(\w+)\(", line)
        if not m:
            m = re.search(r"\b(\w+)\(", line)
        if not m:
            continue
        call = m.group(1)
        failed = re.search(r"=\s*-1\s", line)
        paths = _PATH_RE.findall(line)
        if call in NET_SYSCALLS:
            # Only real network activity counts. AF_UNIX/AF_NETLINK/AF_LOCAL are
            # local IPC (nvim's own msgpack RPC server uses AF_UNIX) -- benign.
            # connect() to a unix path likewise carries no network risk.
            if "AF_INET" in line or "AF_INET6" in line or "sin_addr" in line or "sin6_addr" in line:
                net.append(line.strip())
            continue
        if failed:
            continue
        # only count openat/open with a write flag
        if call in ("openat", "open"):
            if not re.search(r"O_(WRONLY|RDWR|CREAT|TRUNC|APPEND)", line):
                continue
        target = paths[-1] if paths else None
        if not target:
            continue
        if call in UNLINK_SYSCALLS:
            unlinks.add(target)
        elif call in RENAME_SYSCALLS:
            renames.add(target)
        else:
            writes.add(target)
    return writes, unlinks, renames, net


def expand_allow(patterns, home):
    out = []
    for p in patterns:
        out.append(p.replace("$HOME", home))
    return out


def path_allowed(path, allow, home):
    # normalise relative paths against the mock HOME (cwd == home during runs)
    if not path.startswith("/"):
        path = os.path.join(home, path)
    for pat in allow:
        base = pat.rstrip("*").rstrip("/")
        if pat.endswith("**") or pat.endswith("*"):
            if path.startswith(base):
                return True
        elif path == pat or path.startswith(pat.rstrip("/") + "/"):
            return True
    return False


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--package", required=True)
    ap.add_argument("--bindir", required=True, help="dir containing the installed tool")
    ap.add_argument("--profile", default=None)
    args = ap.parse_args()

    profile = args.profile or os.path.join(REPO, "assurance", "profiles", f"{args.package}.toml")
    if not os.path.isfile(profile):
        print(f"no profile: {profile}", file=sys.stderr)
        return 1
    prof = tomllib.load(open(profile, "rb"))

    strace = shutil.which("strace")
    if not strace:
        print("strace not found -- dynamic analysis requires it (add to the smoke image)", file=sys.stderr)
        return 1

    max_unlinks = prof.get("fs", {}).get("max_unlinks", 50)
    net_allowed = prof.get("net", {}).get("allow", False)

    home = tempfile.mkdtemp(prefix="dyn-home-")
    seed_home(home)
    base = canary_baseline(home)
    write_allow_h = expand_allow(prof.get("fs", {}).get("write_allow", []), home)
    unlink_allow_h = expand_allow(prof.get("fs", {}).get("unlink_allow", []), home)

    env = dict(os.environ)
    env.update(
        HOME=home,
        XDG_CONFIG_HOME=os.path.join(home, ".config"),
        XDG_DATA_HOME=os.path.join(home, ".local", "share"),
        XDG_STATE_HOME=os.path.join(home, ".local", "state"),
        XDG_CACHE_HOME=os.path.join(home, ".cache"),
        PATH=args.bindir + ":/usr/bin:/bin",
    )

    for idx, inv in enumerate(prof.get("invocation", [])):
        argv = list(inv["argv"])
        tool = os.path.join(args.bindir, argv[0])
        if not os.path.isfile(tool):
            check(f"invocation {idx} tool present ({argv[0]})", False, tool)
            continue
        log = os.path.join(home, f".strace.{idx}.log")
        cmd = [
            strace,
            "-f",
            "-o",
            log,
            "-e",
            "trace=%file,write,truncate,ftruncate,connect,socket",
            tool,
            *argv[1:],
        ]
        try:
            subprocess.run(
                cmd,
                env=env,
                cwd=home,
                timeout=inv.get("timeout", 30),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except subprocess.TimeoutExpired:
            check(f"invocation {idx} finished within timeout", False, "timed out")
            continue

        writes, unlinks, renames, net = parse_strace(log, home)
        bad_writes = [
            p for p in (writes | renames) if not path_allowed(p, write_allow_h, home) and _is_project_path(p, home)
        ]
        bad_unlinks = [p for p in unlinks if not path_allowed(p, unlink_allow_h, home) and _is_project_path(p, home)]
        check(f"invocation {idx}: no writes outside allowlist", not bad_writes, ", ".join(sorted(bad_writes)[:5]))
        check(f"invocation {idx}: no unlinks outside allowlist", not bad_unlinks, ", ".join(sorted(bad_unlinks)[:5]))
        check(f"invocation {idx}: unlink count under {max_unlinks}", len(unlinks) <= max_unlinks, str(len(unlinks)))
        if not net_allowed:
            check(f"invocation {idx}: no network syscalls", not net, "; ".join(net[:3]))

    # canary integrity across the whole run
    changed = []
    entropy_spikes = []
    for rel, (h0, e0) in base.items():
        full = os.path.join(home, rel)
        if not os.path.isfile(full):
            changed.append(rel + " (deleted)")
            continue
        if sha256_of(full) != h0:
            changed.append(rel)
        if entropy(full) - e0 > 1.0:
            entropy_spikes.append(rel)
    check("all canary files unchanged", not changed, ", ".join(changed))
    check("no canary entropy spike (encryption)", not entropy_spikes, ", ".join(entropy_spikes))

    shutil.rmtree(home, ignore_errors=True)
    print(f"\n{PASSED} passed, {FAILED} failed")
    return 1 if FAILED else 0


def _is_project_path(path, home):
    """Only flag mutations to the mock project data / real HOME dirs, not the
    tool's own /tmp scratch or /proc,/sys,/dev noise."""
    if not path.startswith("/"):
        path = os.path.join(home, path)
    proj = os.path.join(home, "proj")
    return path.startswith(proj)


if __name__ == "__main__":
    sys.exit(main())
