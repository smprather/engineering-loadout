#!/usr/bin/env python3.15
"""
needed-closure -- every shipped ELF's DT_NEEDED sonames resolve somewhere.

The NEEDED audit used to be per-package and hand-rolled (AGENTS.md "Known
gap"), and the same class shipped again and again: a soname neither bundled
nor present on a stock EL8 host, invisible on the build box because the box
had its own copy. libatomic.so.1 (node, twice), libcups.so.2 (marktext),
libfontenc.so.1 (Xephyr), libjpeg.so.62 (xschem) all went out that way.

This walks EVERY ELF the payload ships -- bin/ and lib64/ bz2 blobs, every
runtime archive (chunked ones included), the portable-python archive and the
Tree-sitter parsers -- without extracting anything to disk, and classifies
each NEEDED soname:

  bundled        some payload ELF carries it (DT_SONAME or file name)
  EL8 floor      a stock almalinux:8.10 has it
                 (assurance/el8-stock-sonames.txt, from `ldconfig -p`)
  host contract  deliberately left to the host, listed in HOST_CONTRACT
                 below with the reason (host GLVND, ...)

Anything else FAILS, naming the soname and the ELFs that need it -- unless
every ELF needing it belongs to a disabled package (reported, not failed).

A bundled soname must also be INSTALLABLE with the package that needs it: the
provider is the same package, one in its default install closure (hard
`depends` and soft `recommends`, transitively -- dropping a recommend with
--skip is the user's explicit choice), or an unclaimed lib64 stem (installed
with every selection). Otherwise a minimal
install of that package cannot load -- the openroad/ICU and yosys `libs`
class, which @shared hid because it installs everything.

What this does NOT prove: that the RUNPATH actually reaches a bundled copy
(tests/prebuilt-binaries and Tier 3 run the binaries), or anything about
dlopen()ed libraries. A floor soname this host lacks is printed as a
CEILING note (newer distros drop EL8-era sonames); it does not fail.

Usage: tests/needed-closure                  (the gate)
       tests/needed-closure --who SONAME...      (which packages need / ship it)
       tests/needed-closure --refresh-el8-sonames
"""

import bz2
import concurrent.futures
import glob
import json
import os
import struct
import subprocess
import sys
import tarfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PLATFORM_DIR = os.path.join(REPO, "payload", "el8.x86_64.glibc2p28")
PAYLOADS_JSON = os.path.join(REPO, "payload", "packages.json")
EL8_SONAMES = os.path.join(REPO, "assurance", "el8-stock-sonames.txt")

# Sonames the payload deliberately leaves to the host although a stock
# almalinux:8.10 image lacks them. Each needs a reason; a new entry is a design
# decision (AGENTS.md "NEVER bundle" / host contracts), not a way to go green.
HOST_CONTRACT = {
    "libGL.so.1": "OpenGL dispatcher: host GLVND, display-driver-linked (never bundled)",
    "libGLX.so.0": "OpenGL dispatcher: host GLVND (never bundled)",
    "libGLdispatch.so.0": "OpenGL dispatcher: host GLVND (never bundled)",
    "libOpenGL.so.0": "OpenGL dispatcher: host GLVND (never bundled)",
    "libEGL.so.1": "host GLVND EGL dispatcher; the GUI wrappers probe for it",
    # firefox's libxul carries no RPATH and its launcher puts only lib/firefox
    # on LD_LIBRARY_PATH (never <prefix>/lib64), so a lib64 copy could not serve
    # it anyway; AGENTS.md lists libasound2 among firefox's assumed-present host
    # libs. Open item: co-locate it in the firefox archive (needs a rebuild).
    "libasound.so.2": "firefox: documented host assumption (libxul has no RPATH; a fix is a co-located copy)",
}


# EL8 floor sonames that newer distros do NOT ship (the ceiling): Arch/Debian
# name bzip2's library libbz2.so.1.0, carry libffi.so.8, OpenSSL 3, libjpeg 8,
# readline 8, libxcrypt's libcrypt.so.2, and libxml2.so.16. A host copy cannot
# be relied on for these, so like a non-floor soname they must be bundled and
# installable with the package that needs them. Observed missing on the
# CachyOS dev host 2026-10-28 (`--who` lists consumers and providers).
EL8_ONLY = {
    "libbz2.so.1": "EL/Fedora soname; Debian/Arch ship libbz2.so.1.0",
    "libffi.so.6": "newer hosts ship libffi.so.8",
    "libssl.so.1.1": "OpenSSL 1.1; newer hosts ship OpenSSL 3 (libssl.so.3)",
    "libcrypto.so.1.1": "OpenSSL 1.1; newer hosts ship OpenSSL 3 (libcrypto.so.3)",
    "libjpeg.so.62": "libjpeg-turbo 6.2 ABI; newer hosts ship libjpeg.so.8",
    "libreadline.so.7": "readline 7; newer hosts ship libreadline.so.8",
    "libcrypt.so.1": "glibc libcrypt; newer hosts ship libxcrypt's libcrypt.so.2",
    "libtinfo.so.6": "split ncurses tinfo; not every newer host carries it",
    "libxml2.so.2": "libxml2 2.14+ is libxml2.so.16",
    "libpython3.6m.so.1.0": "EL8 platform-python 3.6",
}

# (soname, package) pairs allowed to rely on the EL8 host anyway, with why.
EL8_ONLY_ACCEPTED = {
    ("libpython3.6m.so.1.0", "meld"): "meld runs on the host's EL8 platform-python 3.6 by design (AGENTS.md meld)",
    ("libxml2.so.2", "meld"): "meld is EL8-only through its python3.6 anyway",
}


# --- ELF ---------------------------------------------------------------------


def elf_dynamic(data):
    """(soname, [needed]) of an ELF64 little-endian blob, or None when it is
    not one or has no dynamic section (static, or not ELF)."""
    if len(data) < 64 or data[:4] != b"\x7fELF" or data[4] != 2 or data[5] != 1:
        return None
    phoff = struct.unpack_from("<Q", data, 32)[0]
    phentsize, phnum = struct.unpack_from("<HH", data, 54)
    loads, dyn = [], None
    for i in range(phnum):
        off = phoff + i * phentsize
        if off + 56 > len(data):
            return None
        p_type = struct.unpack_from("<I", data, off)[0]
        p_offset, p_vaddr = struct.unpack_from("<QQ", data, off + 8)
        p_filesz = struct.unpack_from("<Q", data, off + 32)[0]
        if p_type == 1:  # PT_LOAD
            loads.append((p_vaddr, p_offset, p_filesz))
        elif p_type == 2:  # PT_DYNAMIC
            dyn = (p_offset, p_filesz)
    if dyn is None:
        return None
    needed_offs, soname_off, strtab = [], None, None
    for off in range(dyn[0], min(dyn[0] + dyn[1], len(data) - 15), 16):
        tag, val = struct.unpack_from("<qQ", data, off)
        if tag == 0:
            break
        if tag == 1:
            needed_offs.append(val)
        elif tag == 14:
            soname_off = val
        elif tag == 5:
            strtab = val
    if strtab is None:
        return None
    base = next((o + strtab - v for v, o, sz in loads if v <= strtab < v + sz), None)
    if base is None:
        return None

    def cstr(rel):
        start = base + rel
        end = data.find(b"\0", start)
        return data[start:end].decode("utf-8", "replace") if start < len(data) and end != -1 else ""

    return (cstr(soname_off) if soname_off is not None else None), [cstr(o) for o in needed_offs]


# --- payload walk ------------------------------------------------------------


class _Chain:
    """Sequential read-only stream over chunk files (`.part-000`, `-001`, ...)."""

    def __init__(self, paths):
        self._paths = list(paths)
        self._fh = None

    def read(self, n=-1):
        out = b""
        while n < 0 or len(out) < n:
            if self._fh is None:
                if not self._paths:
                    break
                self._fh = open(self._paths.pop(0), "rb")
            chunk = self._fh.read(-1 if n < 0 else n - len(out))
            if not chunk:
                self._fh.close()
                self._fh = None
                continue
            out += chunk
        return out

    def close(self):
        if self._fh is not None:
            self._fh.close()


def _logical(paths):
    """Group payload files into logical artifacts: {logical_path: [source files]}."""
    groups = {}
    for p in sorted(paths):
        if ".part-" in os.path.basename(p):
            groups.setdefault(p.rsplit(".part-", 1)[0], []).append(p)
        else:
            groups.setdefault(p, []).append(p)
    return groups


def scan_artifact(logical, sources):
    """[(rel, soname, needed)] for every ELF in one logical payload artifact,
    plus (rel, name, None) for each symlink member (a .so link name such as
    libsqlite3.so is how a NEEDED reaches the real file)."""
    rel_base = (
        os.path.relpath(logical, PLATFORM_DIR) if logical.startswith(PLATFORM_DIR) else os.path.relpath(logical, REPO)
    )
    stream = _Chain(sources)
    out = []
    try:
        if logical.endswith(".tar.bz2"):
            with tarfile.open(fileobj=bz2.BZ2File(stream), mode="r|") as tf:
                for member in tf:
                    if member.issym():
                        out.append((f"{rel_base}:{member.name}", os.path.basename(member.name), None))
                        continue
                    if not member.isfile() or member.size < 64:
                        continue
                    fobj = tf.extractfile(member)
                    data = fobj.read() if fobj is not None else b""
                    info = elf_dynamic(data)
                    if info is not None:
                        out.append((f"{rel_base}:{member.name}", info[0], info[1]))
        elif logical.endswith(".bz2"):
            info = elf_dynamic(bz2.BZ2File(stream).read())
            if info is not None:
                out.append((rel_base, info[0], info[1]))
    except (OSError, EOFError, tarfile.TarError) as exc:
        out.append((rel_base, None, [f"!unreadable: {exc}"]))
    finally:
        stream.close()
    return out


def payload_artifacts():
    paths = []
    for sub in ("bin", "lib64", "runtime"):
        paths += glob.glob(os.path.join(PLATFORM_DIR, sub, "*"))
    paths += glob.glob(os.path.join(PLATFORM_DIR, "portable-python-*.tar.bz2*"))
    paths += glob.glob(os.path.join(REPO, "payload", "treesitter", "prebuilt", "*", "parser", "*.so.bz2"))
    return {k: v for k, v in _logical(p for p in paths if os.path.isfile(p)).items() if ".bz2" in k}


def package_owners():
    """({payload rel path or archive basename: {packages}}, disabled, depends)
    from the registry. A lib64 path can have several declarers."""
    with open(PAYLOADS_JSON) as fh:
        packages = json.load(fh)["packages"]
    owners, disabled, depends = {}, set(), {}  # depends: hard + soft (default closure)
    for name, entry in packages.items():
        if not isinstance(entry, dict):
            continue
        if entry.get("disabled"):
            disabled.add(name)
        depends[name] = list(entry.get("depends", []) or []) + list(entry.get("recommends", []) or [])
        if entry.get("archive"):
            owners.setdefault(os.path.basename(entry["archive"]).split(".part-")[0], set()).add(name)
        for stem in entry.get("bins", []) or []:
            owners.setdefault(f"bin/{stem}.bz2", set()).add(name)
        for stem in entry.get("libs", []) or []:
            owners.setdefault(f"lib64/{stem}.bz2", set()).add(name)
    return owners, disabled, depends


def owners_of(rel, owners):
    head = rel.split(":", 1)[0]
    return owners.get(head) or owners.get(os.path.basename(head)) or set()


def reach(pkg, depends, memo):
    """pkg plus its default install closure (depends + recommends), transitively."""
    if pkg not in memo:
        memo[pkg] = {pkg}
        for dep in depends.get(pkg, []):
            memo[pkg] |= reach(dep, depends, memo)
    return memo[pkg]


# --- main --------------------------------------------------------------------


def refresh_el8_sonames():
    cmd = [
        "docker",
        "run",
        "--rm",
        "--network=none",
        "almalinux:8.10",
        "sh",
        "-c",
        "ldconfig -p | sed -n 's/^\t\\([^ ]*\\) (libc6,x86-64.*/\\1/p' | sort -u",
    ]
    names = subprocess.run(cmd, capture_output=True, text=True, check=True).stdout.split()
    with open(EL8_SONAMES, "w") as fh:
        fh.write("# sonames in a stock almalinux:8.10 image (ldconfig -p, x86-64), the EL8 FLOOR\n")
        fh.write("# tests/needed-closure treats as host-provided. Regenerate with:\n")
        fh.write("#   tests/needed-closure --refresh-el8-sonames   (docker, --network=none)\n")
        fh.write("".join(n + "\n" for n in names))
    print(f"wrote {EL8_SONAMES} ({len(names)} sonames)")
    return 0


def host_sonames():
    try:
        text = subprocess.run(["/sbin/ldconfig", "-p"], capture_output=True, text=True).stdout
    except OSError:
        return None
    return {line.split()[0] for line in text.splitlines()[1:] if line.strip()}


def scan_payload():
    artifacts = payload_artifacts()
    with concurrent.futures.ProcessPoolExecutor(max_workers=min(16, os.cpu_count() or 4)) as pool:
        results = list(pool.map(scan_artifact, artifacts.keys(), artifacts.values()))
    return artifacts, [row for rows in results for row in rows]


def who(sonames):
    _artifacts, elfs = scan_payload()
    owners, _disabled, _depends = package_owners()
    host = host_sonames() or set()
    for so in sonames:
        need = {p for rel, _s, nd in elfs if nd and so in nd for p in (owners_of(rel, owners) or {"(unclaimed)"})}
        prov = {
            p
            for rel, sn, _nd in elfs
            if so in (sn, os.path.basename(rel.split(":")[-1]).removesuffix(".bz2"))
            for p in (owners_of(rel, owners) or {"(unclaimed)"})
        }
        print(f"{so}: this host {'has' if so in host else 'LACKS'} it")
        print(f"  needed by:   {', '.join(sorted(need)) or '-'}")
        print(f"  shipped by:  {', '.join(sorted(prov)) or '-'}")
    return 0


def main():
    with open(EL8_SONAMES) as fh:
        floor = {ln.strip() for ln in fh if ln.strip() and not ln.startswith("#")}
    artifacts, elfs = scan_payload()

    owners, disabled, depends = package_owners()
    providers = {}  # soname -> [artifact rel]
    for rel, soname, _needed in elfs:
        for name in {os.path.basename(rel.split(":")[-1]).removesuffix(".bz2"), soname}:
            if name:
                providers.setdefault(name, []).append(rel)
    elfs = [row for row in elfs if row[2] is not None]  # symlinks only provide

    memo = {}
    unresolved, ceiling_only, uninstallable = {}, {}, {}
    unreadable = [rel for rel, _s, needed in elfs if needed and needed[0].startswith("!unreadable")]
    for rel, _soname, needed in elfs:
        need_owners = owners_of(rel, owners)
        for so in needed:
            if so.startswith("!") or so in HOST_CONTRACT:
                continue
            if so in providers:
                prov_owners = [owners_of(p, owners) for p in providers[so]]
                if (
                    not need_owners  # an unclaimed artifact rides with every selection
                    or any(not po for po in prov_owners)  # so does an unclaimed provider
                    or any(po & reach(n, depends, memo) for n in need_owners for po in prov_owners)
                ):
                    continue
            if so in floor and (
                so not in EL8_ONLY or (need_owners and all((so, n) in EL8_ONLY_ACCEPTED for n in need_owners))
            ):
                ceiling_only.setdefault(so, set()).add(rel)  # the host copy serves it
                continue
            if so in providers:
                uninstallable.setdefault((so, frozenset(need_owners)), []).append(rel)
                continue
            unresolved.setdefault(so, []).append(rel)
    provided = providers

    print(f"  OK    scanned {len(artifacts)} payload artifacts, {len(elfs)} ELFs")
    print(
        f"  OK    {len(provided)} sonames bundled, {len(floor)} on the EL8 floor "
        f"({len(EL8_ONLY)} of them EL8-only), {len(HOST_CONTRACT)} host contracts"
    )
    failed = False
    for rel in unreadable:
        print(f"  FAIL  unreadable payload artifact: {rel}")
        failed = True
    for (so, need_owners), rels in sorted(uninstallable.items(), key=lambda kv: (kv[0][0], sorted(kv[0][1]))):
        prov = sorted({p for r in providers[so] for p in owners_of(r, owners)})
        pkgs = sorted(need_owners)
        shown = ", ".join(rels[:2]) + (f" (+{len(rels) - 2})" if len(rels) > 2 else "")
        if all(p in disabled for p in pkgs):
            print(f"  NOTE  {so}: only in {', '.join(prov)}, outside the closure of disabled {', '.join(pkgs)}")
            continue
        print(
            f"  FAIL  {so}: needed by [{', '.join(pkgs)}] ({shown}) but only {', '.join(prov)} ships it, "
            "and that is not in their install closure -- declare it in `libs` or add a depends/recommends"
        )
        failed = True
    for so, rels in sorted(unresolved.items()):
        pkgs = sorted({p for r in rels for p in owners_of(r, owners)} or {"?"})
        shown = ", ".join(rels[:3]) + (f" (+{len(rels) - 3})" if len(rels) > 3 else "")
        if all(p in disabled for p in pkgs):
            print(f"  NOTE  {so}: unresolved, but only disabled packages need it ({', '.join(pkgs)}): {shown}")
            continue
        print(
            f"  FAIL  {so}: not bundled, not on the EL8 floor, no host contract -- needed by {shown} [{', '.join(pkgs)}]"
        )
        failed = True

    host = host_sonames()
    if host:
        for so in sorted(s for s in ceiling_only if s not in host and s not in EL8_ONLY):
            rels = sorted(ceiling_only[so])
            print(
                f"  CEILING  {so}: assumed from the host (EL8 floor) but THIS host lacks it -- needed by {rels[0]}"
                + (f" (+{len(rels) - 1})" if len(rels) > 1 else "")
            )

    print()
    if failed:
        print("needed-closure: FAILED")
        return 1
    print("needed-closure: OK")
    return 0


if __name__ == "__main__":
    if "--refresh-el8-sonames" in sys.argv[1:]:
        sys.exit(refresh_el8_sonames())
    if sys.argv[1:2] == ["--who"]:
        sys.exit(who(sys.argv[2:]))
    sys.exit(main())
