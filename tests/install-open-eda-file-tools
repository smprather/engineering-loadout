#!/usr/bin/env bash
# install-open-eda-file-tools: ONE registry package, ONE uv distribution.
#
# Upstream consolidated its three self-contained projects into a single project,
# `open-eda-file-tools` (v2026.11.9.1: one pyproject, one wheel, one version).
# The four CLIs -- liberty-format, liberty-view, lef-tools, def-tools -- are
# console scripts of that ONE wheel; the old `liberty-tools` / `lef-tools` /
# `def-tools` distributions no longer exist, so a payload left behind by the old
# layout would either miss CLIs or install three venvs nothing imports.
#
# The registry therefore declares `uv_tool: open-eda-file-tools` (not `uv_tools`),
# and this test pins both halves: the single venv that must exist and the split
# distributions that must not.

set -euo pipefail

repo_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
tmp_root=${TMPDIR:-/tmp}
test_home=$(mktemp -d "$tmp_root/loadout-open-eda-home.XXXXXX")
dest_dir=$(mktemp -d "$tmp_root/loadout-open-eda-dest.XXXXXX")
local_prefix="$dest_dir"

cleanup() {
    # The installed tree is sealed read-only, so make it writable first or the
    # cleanup leaks into $TMPDIR.
    chmod -R u+w "$test_home" "$dest_dir" 2>/dev/null || true
    rm -rf "$test_home" "$dest_dir"
}
trap cleanup EXIT

fail() {
    echo "open-eda-file-tools smoke failed: $*" >&2
    exit 1
}

echo "Installing open-eda-file-tools into: $dest_dir"
env -i \
    HOME="$test_home" \
    PATH="/usr/bin:/bin:/usr/sbin:/sbin" \
    LANG="${LANG:-C.UTF-8}" \
    "$repo_dir/loadout" --verbose install -y open-eda-file-tools --dest-dir "$dest_dir" --no-backup \
    > "$test_home/install.log" 2>&1 || {
    tail -80 "$test_home/install.log" >&2
    fail "install exited non-zero"
}

# The install must have used the bundled wheelhouse, not the index.
grep -Fq -- "--no-index" "$test_home/install.log" || fail "uv tool install did not use --no-index"
grep -Fq -- "--find-links" "$test_home/install.log" || fail "uv tool install did not use --find-links"
grep -Fq "uv tool install open-eda-file-tools" "$test_home/install.log" \
    || fail "the installer did not install the consolidated distribution"
echo "  OK: installed offline from the payload wheelhouse as one distribution"

# PATH poison: a `python3` that is NOT the bundled minor, first on PATH. Every
# launcher uv wrote carries an absolute-interpreter shebang, so nothing here may
# depend on what `python3` resolves to (acceptance criterion of issue #16).
poison_dir="$test_home/poison-bin"
mkdir -p "$poison_dir"
for name in python python3; do
    printf '#!/bin/sh\nexit 99\n' > "$poison_dir/$name"
    chmod +x "$poison_dir/$name"
done
probe_env=(env -i HOME="$test_home" PATH="$poison_dir:$local_prefix/bin:/usr/bin:/bin" LANG="${LANG:-C.UTF-8}")

# Every CLI the registry claims. liberty-view is a server launcher, so it is only
# checked for presence; the rest print help and are executed.
for bin in liberty-format liberty-view lef-tools def-tools; do
    [[ -x "$local_prefix/bin/$bin" ]] || fail "$bin launcher not installed"
done
echo "  OK: all four launchers installed"

# ONE tool venv named after the distribution -- the consolidated project.
tool_python="$local_prefix/share/uv/tools/open-eda-file-tools/bin/python"
[[ -x $tool_python ]] || fail "open-eda-file-tools tool venv missing"
"${probe_env[@]}" "$tool_python" -c "
import importlib.metadata as m
print(m.version('open-eda-file-tools'))
" > "$test_home/version" 2>&1 || {
    cat "$test_home/version" >&2
    fail "open-eda-file-tools is not importable from its tool venv"
}
[[ -s "$test_home/version" ]] || fail "open-eda-file-tools reported no version"
echo "  OK: one tool venv, open-eda-file-tools $(cat "$test_home/version")"

# The split distributions are GONE. A stale payload would recreate their venvs,
# which is exactly the pre-consolidation shape this test exists to reject.
for dist in liberty-tools lef-tools def-tools; do
    [[ ! -e "$local_prefix/share/uv/tools/$dist" ]] \
        || fail "retired distribution '$dist' still has a tool venv"
done
echo "  OK: the retired split distributions have no tool venv"

for bin in liberty-format lef-tools def-tools; do
    "${probe_env[@]}" "$local_prefix/bin/$bin" --help > "$test_home/$bin.help" 2>&1 || {
        cat "$test_home/$bin.help" >&2
        fail "$bin --help"
    }
done
echo "  OK: liberty-format/lef-tools/def-tools --help (python3 poisoned on PATH)"

# --- bundled source: the install must be rebuildable, not just runnable ------
# open-eda-file-tools ships its COMPLETE committed tree -- vendored Rust crates
# included -- so the Rust extension can be rebuilt on the user's own machine,
# offline. `scripts/check_vendored_crates.py` is upstream's own gate: it hashes
# every file vendor/cargo/*/.cargo-checksum.json lists and fails on a single
# missing or altered one, so an archive that dropped part of the vendor tree
# (the historical `.gitignore:11` bug) cannot pass it here.
src_root="$local_prefix/share/loadout/src/open-eda-file-tools"
for f in Cargo.toml Cargo.lock uv.lock pyproject.toml BUILD.md .cargo/config.toml; do
    [[ -f "$src_root/$f" ]] || fail "bundled source is missing $f"
done
for d in def_tools lef_tools liberty_tools vendor/cargo; do
    [[ -d "$src_root/$d" ]] || fail "bundled source is missing $d/"
done
[[ -f "$src_root/.cargo/config.toml" ]] || fail "bundled source lost the vendored-source redirect"
echo "  OK: source tree installed at ${src_root#"$local_prefix/"}"

vendored=$("$local_prefix/bin/python3.15" "$src_root/scripts/check_vendored_crates.py" 2>/dev/null) || {
    fail "bundled vendor/cargo is incomplete or altered"
}
grep -q 'present and unchanged' <<<"$vendored" || fail "vendored crate check reported no clean tree: $vendored"
echo "  OK: $vendored"

# The registry must expose ONE package, not the retired split entries.
for old in lef-tools def-tools liberty-tools; do
    "$repo_dir/loadout" info "$old" > "$test_home/old-$old.log" 2>&1 && \
        fail "retired split entry '$old' is still a registry package"
done
echo "  OK: the split entries are gone from the registry"

echo "open-eda-file-tools smoke passed"
