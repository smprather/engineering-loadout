#!/usr/bin/env python3.15
"""update-cadence -- unit tests for ./build/update's auto-update throttle.

The cadence layer decides whether the no-argument `./build/update` sweep
rebuilds a package or leaves it alone. Two properties are worth pinning:

  1. A per-package `auto_update_interval` really overrides the 6mo default --
     not just in the display, but in the due/held decision.
  2. Every failure mode fails OPEN (package is DUE), never closed. A typo'd
     interval or a corrupt state file must not silently freeze a package at an
     old version forever, which is the exact silent-degrade this repo keeps
     designing against and is far worse than an unnecessary rebuild.
"""

import datetime
import importlib.machinery
import importlib.util
import json
import os
import sys
import tempfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

loader = importlib.machinery.SourceFileLoader("update_mod", os.path.join(REPO, "build", "update"))
spec = importlib.util.spec_from_loader("update_mod", loader)
upd = importlib.util.module_from_spec(spec)
loader.exec_module(upd)

FAILURES = []


def check(label, cond, detail=""):
    if cond:
        print(f"  PASS  {label}")
    else:
        print(f"  FAIL  {label}  {detail}")
        FAILURES.append(label)


def main():
    day = datetime.timedelta(days=1)

    print("python-loaded refresh")
    check("python-loaded is automated", "python-loaded" in upd.AUTOMATED)
    check("python-loaded has a runner", callable(getattr(upd, "_run_python_loaded", None)))
    check(
        "python-loaded declares a cadence",
        bool(upd.AUTOMATED.get("python-loaded", {}).get("auto_update_interval")),
    )
    paths = upd.AUTOMATED.get("python-loaded", {}).get("git_paths", [])
    for needed in ("payload/packages.json", ".content-manifest", ".strip-manifest"):
        check(f"python-loaded commit covers {needed}", needed in paths)

    print("interval parsing")
    check("default is 6mo", upd.DEFAULT_AUTO_UPDATE_INTERVAL == "6mo", upd.DEFAULT_AUTO_UPDATE_INTERVAL)
    check("6mo -> 180d", upd._parse_interval("6mo") == 180 * day)
    check("1y -> 365d", upd._parse_interval("1y") == 365 * day)
    check("90d -> 90d", upd._parse_interval("90d") == 90 * day)
    check("2w -> 14d", upd._parse_interval("2w") == 14 * day)
    check("case/space tolerant", upd._parse_interval("  1Y ") == 365 * day)
    check("never -> None", upd._parse_interval("never") is None)

    for bad in ("6months", "", "y", "-1y", "6 mo mo", "soon"):
        try:
            upd._parse_interval(bad)
        except ValueError:
            pass
        else:
            check(f"rejects {bad!r}", False, "accepted junk")
            break
    else:
        check("rejects malformed specs", True)

    print("due / held decision")
    today = datetime.date(2026, 8, 14)

    def state_with(days_ago):
        return {"pkg": {"last_auto_update": (today - days_ago * day).isoformat()}}

    orig_spec = upd._interval_spec
    try:
        upd._interval_spec = lambda name: "6mo"
        due, _ = upd._currency_status("pkg", state_with(179), today)
        check("179d < 6mo -> held", not due)
        due, _ = upd._currency_status("pkg", state_with(180), today)
        check("180d == 6mo -> due", due)
        due, _ = upd._currency_status("pkg", state_with(400), today)
        check("400d -> due", due)
        due, _ = upd._currency_status("pkg", {}, today)
        check("never recorded -> due", due)

        # The property the feature exists for: same date, different interval,
        # DIFFERENT decision.
        upd._interval_spec = lambda name: "1y"
        due_1y, _ = upd._currency_status("pkg", state_with(200), today)
        upd._interval_spec = lambda name: "6mo"
        due_6mo, _ = upd._currency_status("pkg", state_with(200), today)
        check("200d: held at 1y but due at 6mo", (not due_1y) and due_6mo, f"1y={due_1y} 6mo={due_6mo}")

        upd._interval_spec = lambda name: "never"
        due, detail = upd._currency_status("pkg", state_with(9999), today)
        check("never -> never auto-due", not due, detail)

        # Fail-open: a typo must not freeze the package.
        upd._interval_spec = lambda name: "6 months please"
        due, _ = upd._currency_status("pkg", state_with(1), today)
        check("bad interval fails OPEN (due)", due)

        # Corrupt timestamp must not freeze it either.
        upd._interval_spec = lambda name: "6mo"
        due, _ = upd._currency_status("pkg", {"pkg": {"last_auto_update": "not-a-date"}}, today)
        check("corrupt timestamp fails OPEN (due)", due)
    finally:
        upd._interval_spec = orig_spec

    print("state file")
    with tempfile.TemporaryDirectory() as tmp:
        orig = upd._CURRENCY_STATE
        try:
            upd._CURRENCY_STATE = os.path.join(tmp, "currency-state.json")
            check("missing state file -> empty, not a crash", upd._load_currency_state() == {})
            upd._save_currency_state({"a": {"last_auto_update": "2026-08-14"}})
            check("round-trips", upd._load_currency_state()["a"]["last_auto_update"] == "2026-08-14")
            with open(upd._CURRENCY_STATE) as fh:
                check("stores under 'packages'", "packages" in json.load(fh))
            with open(upd._CURRENCY_STATE, "w") as fh:
                fh.write("{ not json")
            check("corrupt state file -> empty, not a crash", upd._load_currency_state() == {})
        finally:
            upd._CURRENCY_STATE = orig

    print("declared intervals in packages.json are valid")
    bad = []
    for name, info in upd.PACKAGES.items():
        if not isinstance(info, dict):
            continue
        spec_val = info.get("auto_update_interval")
        if spec_val is None:
            continue
        try:
            upd._parse_interval(spec_val)
        except ValueError as exc:
            bad.append(f"{name}: {exc}")
    check("every declared auto_update_interval parses", not bad, "; ".join(bad))

    print("version ordering (downgrade guard)")
    # The guard exists to catch a silent regression, not to reject a correct
    # update. It used to compare bare release tuples, so a rolling-git package
    # whose registry entry held a `2026.11.2.dev0` placeholder and whose rebuilt
    # source described itself as `2026.11.2-5-g...` compared (2026,11,2,0) vs
    # (2026,11,2) and FAILED the update as a downgrade. Same-release variants
    # must order the way git does; a genuine regression must still be caught.
    t = upd._version_tuple
    check("dev placeholder sorts below its tag", t("v2026.11.2.dev0") < t("v2026.11.2"))
    check("tag sorts below commits past it", t("v2026.11.2") < t("v2026.11.2-5-g31e2aa3"))
    check(
        "dev placeholder sorts below a describe of the same release",
        t("v2026.11.2.dev0") < t("v2026.11.2-5-g31e2aa3"),
    )
    check("more commits past a tag sorts higher than fewer", t("v1.0.0-3-gdeadbee") < t("v1.0.0-9-gdeadbee"))
    # A tag bump on a SHORTER release must still win: hx moved 25.07 ->
    # 25.07.1 while its recorded version was a describe of 25.07. Without
    # padding, (25,7,1,984) beat (25,7,1,1) on the wrong digit.
    check("a new release beats a describe of the previous one", t("25.07.1") > t("25.07-984-g079a789e"))
    check("release components compare left to right", t("3.5.0") > t("3.4.99") and t("0.0.91") > t("0.0.9"))
    check("a later release beats any same-release describe", t("v2026.11.2-5-gabcdef1") < t("v2026.11.3"))
    check("a real regression still orders backwards", t("v2026.11.5-1-gabcdef1") > t("v2026.11.2-7-gabcdef1"))
    check(
        "RPM-style release suffix compares on the release",
        t("1.20.11-28.el8_10.3") == t("1.20.11"),
    )
    check("git SHA is not a version", t("7e9859e") is None)
    check("non-numeric tag is not a version", t("v-nightly") is None)
    check("empty is not a version", t("") is None)

    import contextlib as _cl
    import io as _io

    def guard_accepts(before, after, allow=False):
        orig_registry = upd._registry_version
        try:
            upd._registry_version = lambda name: after
            buf = _io.StringIO()
            with _cl.redirect_stdout(buf):
                ok = upd._check_no_downgrade("widget", before, allow, False)
            return ok, buf.getvalue()
        finally:
            upd._registry_version = orig_registry

    ok, out = guard_accepts("v2026.11.2.dev0", "v2026.11.2-5-g31e2aa3")
    check("placeholder -> describe passes the guard", ok, out.strip())
    ok, out = guard_accepts("26.5.0", "26.2.0")
    check("minor-version regression fails the guard", (not ok) and "BACKWARDS" in out, out.strip())
    ok, out = guard_accepts("26.5.0", "26.2.0", allow=True)
    check("--allow-downgrade overrides it", ok and "allow-downgrade given" in out, out.strip())
    ok, _ = guard_accepts("1.20.11-28.el8_10.3", "1.20.11-30.el8_10.4")
    check("distro release change is not a downgrade", ok)

    print("check-versions failure surfaces through _fetch_latest_map")
    # The 2026-09-02..13 portable-python TLS break made every upstream lookup
    # fail; check-versions printed "(no rows)" and build/update swallowed the
    # non-zero exit into {}, so both reported a healthy currency state. Pin
    # the contract: partial answers are kept, and a failed report is visible.
    import subprocess as _sp

    _orig_check = _sp.check_output
    _orig_run = _sp.run

    def _broken_run(cmd, *a, **kw):
        if any(str(c).endswith("check-versions") for c in cmd):
            return _sp.CompletedProcess(cmd, 2, b"", b"boom")
        return _orig_run(cmd, *a, **kw)

    def _partial_run(cmd, *a, **kw):
        if any(str(c).endswith("check-versions") for c in cmd):
            row = b"name\tcurrent\tlatest\tsource\tstatus\tpin_reason\terror\n"
            row += b"widget\t1.0\t2.0\tgithub\toutdated\t\t\n"
            return _sp.CompletedProcess(cmd, 2, row, b"1 lookup failed")
        return _orig_run(cmd, *a, **kw)

    import contextlib
    import io

    try:
        _sp.run = _broken_run
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            got = upd._fetch_latest_map()
        check("all-lookups-failed -> {} and a warning", got == {} and "INCOMPLETE" in buf.getvalue(), repr(got))

        _sp.run = _partial_run
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            got = upd._fetch_latest_map()
        check(
            "partial answers kept despite rc=2",
            got.get("widget") == ("2.0", "outdated") and "INCOMPLETE" in buf.getvalue(),
            repr(got),
        )
    finally:
        _sp.run = _orig_run
        _sp.check_output = _orig_check

    print()
    if FAILURES:
        print(f"update-cadence: {len(FAILURES)} FAILED")
        return 1
    print("update-cadence: OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
