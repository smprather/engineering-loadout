#!/bin/sh
# env-tcsh: installs, links the entrypoints, and -- the headline requirement --
# starts SILENTLY.
#
# Silence is the acceptance criterion for the tcsh env (see
# docs/superpowers/specs/2026-07-13-tcsh-env-design.md): the users this exists for
# did not choose tcsh and will not debug it. A warning on startup is a bug; a
# missing feature is not.
#
# TWO TEST-HARNESS TRAPS, both of which produce a green run that proves nothing:
#
#   1. `tcsh -i -c CMD` does NOT set $prompt, so the entire interactive block
#      (aliases, prompt) is SKIPPED. A silence test written that way passes by not
#      running the code under test. Commands must be fed on stdin.
#   2. tcsh with a piped stdin and no controlling terminal prints
#      "Warning: no access to tty" to stderr -- a harness artifact that looks
#      exactly like the noise we are testing for. A real PTY is required, hence
#      `script -qec`.
set -eu

REPO="$(cd "$(dirname "$0")/.." && pwd)"

if ! command -v tcsh >/dev/null 2>&1; then
    echo "SKIP: native tcsh smoke (no tcsh interpreter; Tier 3 installs tcsh)"
    exit 0
fi
if ! command -v script >/dev/null 2>&1; then
    echo "SKIP: native tcsh smoke (no 'script' for a PTY; cannot test startup silence honestly)"
    exit 0
fi

tmp_root=${TMPDIR:-/tmp}
TMPHOME="$(mktemp -d "$tmp_root/loadout-env-tcsh.XXXXXX")"
trap 'chmod -R u+w "$TMPHOME" 2>/dev/null; rm -rf "$TMPHOME"' EXIT
fail() { echo "FAIL: $*" >&2; exit 1; }

# Run an interactive tcsh under a real PTY, feeding it CMDS on stdin.
# Echoes stdout; stderr lands in $ERRFILE.
ERRFILE="$TMPHOME/stderr.txt"
tcsh_i_home() {
    _home=$1
    _cmd=$2
    : > "$ERRFILE"
    printf '%s\nexit\n' "$_cmd" \
        | HOME="$_home" script -qec "tcsh -i" /dev/null 2>"$ERRFILE" \
        | tr -d '\r'
}
tcsh_i() {
    tcsh_i_home "$TMPHOME" "$1"
}
tcsh_i_root() {
    _root=$1
    _cmd=$2
    : > "$ERRFILE"
    printf '%s\nexit\n' "$_cmd" \
        | env -i HOME="$TMPHOME" TCSH_CONFIG_ROOT_DIR="$_root" PATH="${PATH:-/usr/bin:/bin}" LANG="${LANG:-C.UTF-8}" TERM=xterm-256color \
            script -qec "tcsh -i" /dev/null 2>"$ERRFILE" \
        | tr -d '\r'
}
tcsh_i_clean_home() {
    _home=$1
    _cmd=$2
    : > "$ERRFILE"
    printf '%s\nexit\n' "$_cmd" \
        | env -i HOME="$_home" PATH="${PATH:-/usr/bin:/bin}" LANG="${LANG:-C.UTF-8}" TERM=xterm-256color \
            script -qec "tcsh -i" /dev/null 2>"$ERRFILE" \
        | tr -d '\r'
}

# tcsh_i_env HOME CMD [VAR=value ...] -- pass extra environment to the shell.
tcsh_i_env() {
    _home=$1
    _cmd=$2
    shift 2
    : > "$ERRFILE"
    printf '%s\nexit\n' "$_cmd" \
        | env -u TMUX HOME="$_home" TERM=xterm-256color "$@" script -qec "tcsh -i" /dev/null 2>"$ERRFILE" \
        | tr -d '\r'
}

# tcsh_i_unset HOME CMD -- like tcsh_i_env, but guarantees the startup-only
# variables are absent (the path test must not inherit the caller's NVM_BIN or
# TERMINFO_DIRS). env parses -u before the assignments, so this cannot be
# expressed through tcsh_i_env.
tcsh_i_unset() {
    _home=$1
    _cmd=$2
    : > "$ERRFILE"
    printf '%s\nexit\n' "$_cmd" \
        | env -u TMUX -u NVM_BIN -u TERMINFO_DIRS -u LOADOUT_CFG_SHARED_PREFIX \
            HOME="$_home" TERM=xterm-256color \
            script -qec "tcsh -i" /dev/null 2>"$ERRFILE" \
        | tr -d '\r'
}

# tcsh_i_raw HOME PATH CMD -- tcsh -f with a controlled PATH, no system rc.
# Used to simulate a farm node with no starship binary without depending on
# the host's /usr/bin (which may have one).
tcsh_i_raw() {
    _home=$1
    _path=$2
    _cmd=$3
    : > "$ERRFILE"
    printf '%s\nexit\n' "$_cmd" \
        | env -i HOME="$_home" PATH="$_path" LANG="${LANG:-C.UTF-8}" TERM=xterm-256color \
            /usr/bin/script -qec "tcsh -f -i" /dev/null 2>"$ERRFILE" \
        | tr -d '\r'
}

# THE THIRD HARNESS TRAP, and the nastiest: `script` gives the child a PTY, so
# tcsh's OWN diagnostics come back on the PTY -- i.e. in stdout -- and $ERRFILE
# stays EMPTY. The headline "empty stderr" assertion below therefore cannot see
# a shell that is complaining on every startup. Two real bugs shipped through
# that hole during the 2026-08-08 parity work:
#
#   * `PPID: Undefined variable.`  -- tcsh has no $PPID (that is bash's).
#   * `0: Event not found.`        -- an unescaped `!` in a double-quoted alias
#                                     body triggering history expansion.
#
# Both printed on every interactive startup while stderr was empty and the test
# was green. So scan the OUTPUT for tcsh's error vocabulary too.
assert_no_csh_noise() {
    _label=$1
    _text=$2
    for _pat in 'Undefined variable' 'Event not found' 'Badly placed ()' \
                'Missing }' 'Missing ]' 'Too many arguments' 'Expression Syntax' \
                'Variable syntax' 'Unmatched' 'No match' 'if: Expression Syntax' \
                'alias: Too dangerous' 'Ambiguous output redirect' 'Command not found'; do
        case $_text in
            *"$_pat"*) fail "$_label: tcsh printed '$_pat':
$_text" ;;
        esac
    done
}

# W3: a pre-W3 install left a ~/.cshrc link behind; the install must prune it.
ln -s .config/tcsh/tcshrc "$TMPHOME/.cshrc"

HOME="$TMPHOME" LOADOUT_CFG_SHARED_PREFIX= "$REPO/loadout" install -y env-tcsh --no-backup >/dev/null

[ -e "$TMPHOME/.tcshrc" ] || fail ".tcshrc not linked"
if [ -e "$TMPHOME/.cshrc" ] || [ -L "$TMPHOME/.cshrc" ]; then
    fail ".cshrc is retired (plain csh is unsupported) and must be pruned, not linked"
fi
[ -f "$TMPHOME/.config/tcsh/global/tcshrc" ] || fail "global layer not installed"
[ -x "$TMPHOME/.config/tcsh/global/git-branch.sh" ] || fail "git-branch.sh not executable"

# --- THE headline test: an env-only HOME (no loadout tools installed at all)
# --- must start with EMPTY stderr. This is the farm-node case.
out=$(tcsh_i 'echo alive')
[ ! -s "$ERRFILE" ] || fail "interactive tcsh wrote to stderr:
$(cat "$ERRFILE")"
assert_no_csh_noise "interactive startup" "$out"

# --- Startup must ALSO be clean when the shell inherits a loadout BASH
# --- environment, which is the common case: a user types `tcsh` inside their
# --- loadout bash login shell and every LOADOUT_CFG_* is already exported.
# --- Values the two shells share are bash-shaped, and consuming one blindly is
# --- how the prompt ended up rendering readline's `\[` markers literally.
out=$(
    printf 'echo "P=$prompt"\nexit\n' \
        | HOME="$TMPHOME" \
          LOADOUT_CFG_PROMPT_COLOR_NORMAL='\[\e[38;2;255;255;0m\]' \
          LOADOUT_CFG_PROMPT_COLOR_FARM='\[\e[38;2;255;0;0m\]' \
          script -qec "tcsh -i" /dev/null 2>"$ERRFILE" \
        | tr -d '\r'
)
[ ! -s "$ERRFILE" ] || fail "tcsh inheriting a bash loadout env wrote to stderr:
$(cat "$ERRFILE")"
assert_no_csh_noise "inherited-bash-env startup" "$out"
case $out in
    *'\['*|*'\]'*) fail "bash readline markers leaked into the tcsh prompt: [$out]" ;;
esac
case $out in
    *'\033'*|*'\e['*) fail "prompt color left as literal escape text, not a real ESC: [$out]" ;;
esac

# --- A non-interactive tcsh script must still run. tcsh sources ~/.tcshrc for
# --- non-interactive shells too, so an `exit` in the rc file would kill every
# --- script the user runs -- a spectacular way to break a farm.
: > "$ERRFILE"
cat > "$TMPHOME/s.csh" <<'EOF'
echo script-ran
if ( $?EDITOR ) then
    echo EDITOR_SET
else
    echo EDITOR_UNSET
endif
EOF
out=$(env -u EDITOR -u VISUAL -u GIT_EDITOR HOME="$TMPHOME" tcsh "$TMPHOME/s.csh" 2>"$ERRFILE") \
    || fail "non-interactive tcsh script exited non-zero"
echo "$out" | grep -q '^script-ran$' || fail "non-interactive tcsh script did not run: [$out]"
# bash exports EDITOR/VISUAL/GIT_EDITOR only inside its interactive block;
# tcsh must not hand scripts a different environment.
echo "$out" | grep -qx 'EDITOR_UNSET' || fail "non-interactive tcsh still exports EDITOR: [$out]"
[ ! -s "$ERRFILE" ] || fail "non-interactive tcsh wrote to stderr:
$(cat "$ERRFILE")"

# --- The environment actually landed.
out=$(tcsh_i 'echo "VI=$LOADOUT_CFG_PREFERRED_VI"')
echo "$out" | grep -q "VI=nvim" || fail "LOADOUT_CFG_* not set in tcsh: [$out]"

out=$(tcsh_i 'alias b')
echo "$out" | grep -q "cd \.\." || fail "aliases not loaded: [$out]"

# --- The prompt must never leak git's error text (an unborn HEAD or a detached
# --- HEAD once rendered git's "Use '--' to separate paths" hint into the prompt).
if command -v git >/dev/null 2>&1; then
    ( cd "$TMPHOME" && git init -q . 2>/dev/null ) || true
    out=$(cd "$TMPHOME" && tcsh_i 'echo "P=$prompt"')
    echo "$out" | grep -q "separate paths from revisions" \
        && fail "git error text leaked into the prompt: [$out]"
    [ ! -s "$ERRFILE" ] || fail "prompt in a fresh repo wrote to stderr:
$(cat "$ERRFILE")"
fi

# --- The helper scripts are the mechanism that lets "csh has no functions" stop
# --- being a reason to drop features, so they must install AND stay executable.
# --- install_path() syncs global/ wholesale; a mode regression there would make
# --- every helper-backed alias silently do nothing.
HELPERS="$TMPHOME/.config/tcsh/global/helpers"
[ -d "$HELPERS" ] || fail "helpers/ not installed"
for h in is-truthy vercmp recent-dir recent-file recent-files path-list \
         grep-all-history git-stash-pull safe-symlink latest-link seed-history \
         prompt-color find-count zhead total-cpu lsf-queues vnc-start \
         vnc-kill-newest detect-online tmp-root path-remove path-trim \
         cd-command git-branches loadout-packages just-recipes \
         ls-command new-file extract-rpm disk-usage check-extended-keys nvm-bin; do
    [ -x "$HELPERS/$h" ] || fail "helper not installed executable: $h"
done

# --- The helpers are POSIX sh and run as separate processes, so their behaviour
# --- is testable directly. is_truthy in particular MUST agree with the bash
# --- version -- both shells compare the same LOADOUT_CFG_* values, and a
# --- disagreement would silently enable a feature in one shell only.
"$HELPERS/is-truthy" 1        || fail "is-truthy: 1 should be true"
"$HELPERS/is-truthy" enabled  || fail "is-truthy: enabled should be true"
"$HELPERS/is-truthy" 0        && fail "is-truthy: 0 should be false"
"$HELPERS/is-truthy" ""       && fail "is-truthy: empty should be false"
"$HELPERS/is-truthy" anything || fail "is-truthy: non-empty string should be true"
# check-extended-keys must be a POSIX wrapper: the bash-only timed read lives
# inside its `bash -c` probe, not in the script /bin/sh parses.
TERM=kitty /bin/sh "$HELPERS/check-extended-keys" || fail "check-extended-keys: cheap kitty path failed under /bin/sh"
TERM=xterm-256color /bin/sh "$HELPERS/check-extended-keys" </dev/null && fail "check-extended-keys: non-tty probe should fail"
if command -v dash >/dev/null 2>&1; then
    TERM=kitty dash "$HELPERS/check-extended-keys" || fail "check-extended-keys is not POSIX (dash rejected it)"
    dash -n "$HELPERS/check-extended-keys" || fail "check-extended-keys has a POSIX syntax error"
fi
# Numeric, not lexical: 2.9 < 2.10. A string compare gets this backwards.
"$HELPERS/vercmp" 2.9 -lt 2.10 || fail "vercmp: 2.9 should be < 2.10"
"$HELPERS/vercmp" 1.2 -eq 1.2.0 || fail "vercmp: 1.2 should equal 1.2.0"
"$HELPERS/vercmp" --between 1.0 1.5 2.0 || fail "vercmp: 1.5 should be within [1.0,2.0]"

# --- Split/shared config architecture: TCSH_CONFIG_ROOT_DIR can point at a
# --- loadout-owned shared config root, while HOME-local override layers still
# --- apply afterwards. This mirrors bash's BASH_CONFIG_ROOT_DIR + home overlay.
ALTROOT="$TMPHOME/shared-tcsh-root"
mkdir -p "$ALTROOT"
cp -a "$TMPHOME/.config/tcsh/global" "$ALTROOT/global"
for layer in corp site team project user; do
    mkdir -p "$ALTROOT/$layer"
done
mkdir -p "$TMPHOME/.config/tcsh/user"
echo 'setenv LOADOUT_TEST_HOME_OVERLAY yes' > "$TMPHOME/.config/tcsh/user/config.csh"
echo 'setenv LOADOUT_TEST_HOME_TCSHRC loaded' > "$TMPHOME/.config/tcsh/user/tcshrc"
out=$(tcsh_i_root "$ALTROOT" 'echo "ROOT=$TCSH_CONFIG_ROOT_DIR" ; echo "OV=$LOADOUT_TEST_HOME_OVERLAY" ; echo "RC=$LOADOUT_TEST_HOME_TCSHRC" ; alias loadout_tmp_root')
assert_no_csh_noise "TCSH_CONFIG_ROOT_DIR overlay" "$out"
echo "$out" | grep -q "ROOT=$ALTROOT" || fail "TCSH_CONFIG_ROOT_DIR not exported/respected: [$out]"
echo "$out" | grep -q "OV=yes" || fail "home config overlay not sourced after shared root: [$out]"
echo "$out" | grep -q "RC=loaded" || fail "home tcshrc overlay not sourced after shared root: [$out]"
echo "$out" | grep -q "$ALTROOT/global/helpers/tmp-root" || fail "global aliases did not resolve helpers from TCSH_CONFIG_ROOT_DIR: [$out]"

# --- The @envs shared-prefix bake must cover tcsh, not only bash. A direct
# --- tcsh login must find the shared tree even when LOADOUT_CFG_SHARED_PREFIX is
# --- NOT inherited from the parent process.
BAKE_HOME="$TMPHOME/bake-home"
SHARED_PREFIX="$TMPHOME/shared-prefix!bang"
mkdir -p "$BAKE_HOME" "$SHARED_PREFIX/bin"
HOME="$BAKE_HOME" LOADOUT_CFG_SHARED_PREFIX="$SHARED_PREFIX" "$REPO/loadout" install -y env-tcsh --no-backup >/dev/null
grep -F "setenv LOADOUT_CFG_SHARED_PREFIX \"$TMPHOME/shared-prefix\!bang\"" "$BAKE_HOME/.config/tcsh/global/config.csh" >/dev/null \
    || fail "env-tcsh install did not bake LOADOUT_CFG_SHARED_PREFIX into config.csh"
out=$(tcsh_i_clean_home "$BAKE_HOME" 'echo "USER=$USER" ; echo "SP=$LOADOUT_CFG_SHARED_PREFIX"')
assert_no_csh_noise "tcsh shared-prefix bake clean env" "$out"
echo "$out" | grep -q "USER=" || fail "tcsh did not bootstrap USER from a clean env: [$out]"
echo "$out" | grep -q "SP=$SHARED_PREFIX" || fail "baked tcsh LOADOUT_CFG_SHARED_PREFIX not loaded from clean env: [$out]"

# --- A helper-backed alias must work END TO END inside tcsh. Testing the helper
# --- alone proves nothing about the alias quoting, which is where csh bites.
mkdir -p "$TMPHOME/probe/oldest" && sleep 1 && mkdir -p "$TMPHOME/probe/newest"
out=$(cd "$TMPHOME/probe" && tcsh_i 'cdd ; pwd')
assert_no_csh_noise "cdd alias" "$out"
echo "$out" | grep -q "probe/newest" || fail "cdd did not cd to the newest dir: [$out]"

# --- Every directory change lists. csh does this with cwdcmd, which fires for
# --- cd, pushd, popd and implicitcd alike -- there is no call site that can
# --- forget, unlike the bash cd() wrapper.
touch "$TMPHOME/probe/newest/CWDCMD_MARKER"
out=$(cd "$TMPHOME/probe" && tcsh_i 'cd newest')
echo "$out" | grep -q "CWDCMD_MARKER" || fail "cwdcmd did not list after cd: [$out]"

# --- `cd` gets the bash env's conveniences: a FILE argument goes to its parent.
# --- Also a guard against the worst possible regression here -- an empty target
# --- makes csh's builtin go to $HOME, so a typo'd path must NOT move you.
touch "$TMPHOME/probe/newest/afile"
out=$(cd "$TMPHOME/probe" && tcsh_i 'cd newest/afile ; pwd')
assert_no_csh_noise "cd to a file" "$out"
echo "$out" | grep -q "probe/newest$" || fail "cd FILE did not land in its parent dir: [$out]"

out=$(cd "$TMPHOME/probe" && tcsh_i 'cd /nonexistent/definitely/not/here ; pwd')
assert_no_csh_noise "cd to a missing path" "$out"
echo "$out" | grep -q "probe$" || fail "cd to an uncreatable path moved us anyway: [$out]"

# --- Environment parity with the bash env.
out=$(tcsh_i 'echo "O=$LOADOUT_ONLINE" ; echo "PIP=$PIP_REQUIRE_VIRTUALENV" ; echo "ED=$EDITOR"')
assert_no_csh_noise "environment" "$out"
echo "$out" | grep -qE 'O=[01]'  || fail "LOADOUT_ONLINE not set to 0/1: [$out]"
echo "$out" | grep -q  'PIP=1'   || fail "PIP_REQUIRE_VIRTUALENV not exported: [$out]"
echo "$out" | grep -q  'ED=nvim' || fail "EDITOR not derived from LOADOUT_CFG_PREFERRED_VI: [$out]"

# --- PATH order must match bash's final order. Both shells prepend, so the
# --- iteration list is reversed relative to the visible PATH: NVM_BIN comes
# --- last (bash sources nvm.sh first, then every user dir prepends ahead of it).
mkdir -p "$TMPHOME/.cargo/bin" "$TMPHOME/.venv/bin" "$TMPHOME/.opencode/bin" \
         "$TMPHOME/node_modules/.bin" "$TMPHOME/go/bin" "$TMPHOME/.local/bin" \
         "$TMPHOME/.nvm/versions/node/v20.1.0/bin" \
         "$TMPHOME/.local/share/terminfo" "$TMPHOME/.local/share/loadout/share/terminfo"
out=$(tcsh_i_unset "$TMPHOME" \
    'echo "PATH_SEQ=$path" ; echo "NVM_BIN=$NVM_BIN" ; echo "TI=$TERMINFO_DIRS"')
assert_no_csh_noise "path order" "$out"
path_seq=$(printf '%s\n' "$out" | sed -n 's/^PATH_SEQ=//p' | tail -1)
[ -n "$path_seq" ] || fail "could not read PATH from tcsh: [$out]"
path_index() {
    printf '%s\n' "$path_seq" | tr ' ' '\n' | grep -n -F -- "$1" | cut -d: -f1 | head -1
}
i_local=$(path_index "$TMPHOME/.local/bin")
i_go=$(path_index "$TMPHOME/go/bin")
i_nm=$(path_index "$TMPHOME/node_modules/.bin")
i_op=$(path_index "$TMPHOME/.opencode/bin")
i_venv=$(path_index "$TMPHOME/.venv/bin")
i_cargo=$(path_index "$TMPHOME/.cargo/bin")
i_nvm=$(path_index "$TMPHOME/.nvm/versions/node/v20.1.0/bin")
# NVM_BIN comes after every newly prepended user dir, exactly as bash's
# nvm.sh-then-prepend sequence leaves it. /usr/local/bin may already be in the
# inherited PATH; bash does not move an existing entry either, so its absolute
# position is not part of the contract.
for _pair in "$i_local:$i_go" "$i_go:$i_nm" "$i_nm:$i_op" "$i_op:$i_venv" \
             "$i_venv:$i_cargo" "$i_cargo:$i_nvm"; do
    _a=${_pair%%:*}
    _b=${_pair#*:}
    [ -n "$_a" ] && [ -n "$_b" ] && [ "$_a" -lt "$_b" ] || fail "PATH order differs from bash:
$path_seq"
done
echo "$out" | grep -qx "NVM_BIN=$TMPHOME/.nvm/versions/node/v20.1.0/bin" \
    || fail "NVM_BIN was not resolved without an nvm.sh source: [$out]"
echo "$out" | grep -qx "TI=$TMPHOME/.local/share/loadout/share/terminfo:$TMPHOME/.local/share/terminfo" \
    || fail "TERMINFO_DIRS order differs from bash (prefix first): [$out]"

# --- `ls -1` must bypass eza: eza has no -1 and can print nothing on a non-tty.
cat > "$TMPHOME/.local/bin/eza" <<'EOF'
#!/bin/sh
echo EZA_MARK
EOF
chmod +x "$TMPHOME/.local/bin/eza"
out=$(tcsh_i "ls -1 '$TMPHOME/.local/bin/eza'")
assert_no_csh_noise "ls -1" "$out"
case $out in
    *EZA_MARK*) fail "ls -1 was routed through eza: [$out]" ;;
esac
echo "$out" | grep -q '\.local/bin/eza' || fail "ls -1 printed no filename: [$out]"
out=$(tcsh_i "ls '$TMPHOME/.local/bin/eza'")
echo "$out" | grep -q 'EZA_MARK' || fail "plain ls no longer uses eza: [$out]"
rm -f "$TMPHOME/.local/bin/eza"

# --- sp1/sp2 must change what starship reads, not just the shell-local prompt.
out=$(tcsh_i_env "$TMPHOME" \
    'sp2 ; echo "H=$LOADOUT_CFG_PROMPT_INCLUDE_HOST" ; /bin/sh -c "echo C=\$LOADOUT_CFG_PROMPT_INCLUDE_HOST"' \
    LOADOUT_CFG_ENABLE_STARSHIP=0)
assert_no_csh_noise "sp2" "$out"
echo "$out" | grep -q 'H=1' || fail "sp2 did not set LOADOUT_CFG_PROMPT_INCLUDE_HOST: [$out]"
echo "$out" | grep -q 'C=1' || fail "sp2 did not EXPORT the prompt switch: [$out]"
out=$(tcsh_i_env "$TMPHOME" \
    'sp2 ; sp1 ; echo "H=$LOADOUT_CFG_PROMPT_INCLUDE_HOST"' \
    LOADOUT_CFG_ENABLE_STARSHIP=0)
echo "$out" | grep -q 'H=0' || fail "sp1 did not clear LOADOUT_CFG_PROMPT_INCLUDE_HOST: [$out]"

# --- new/extract_rpm with no argument must be an arity error, not a command
# --- lookup ("Bad ! arg selector" is the csh alias-expansion failure).
out=$(tcsh_i 'new ; echo "ST=$status"')
case $out in
    *'Bad ! arg selector'*|*'Command not found'*) fail "bare new fell through to command lookup: [$out]" ;;
esac
echo "$out" | grep -qi 'usage' || fail "bare new printed no usage: [$out]"
out=$(tcsh_i 'extract_rpm ; echo "ST=$status"')
case $out in
    *'Bad ! arg selector'*|*'Command not found'*) fail "bare extract_rpm fell through to command lookup: [$out]" ;;
esac
echo "$out" | grep -qi 'usage' || fail "bare extract_rpm printed no usage: [$out]"
out=$(tcsh_i_env "$TMPHOME" \
    "new '$TMPHOME/newfile' ; if ( -x '$TMPHOME/newfile' ) echo NEW_OK" \
    LOADOUT_CFG_PREFERRED_VI=true)
echo "$out" | grep -q 'NEW_OK' || fail "new FILE did not create an executable file: [$out]"

# --- `du DIR` must keep DIR on du's side of the pipe. The alias form appended
# --- it to sort, which errored with "read failed: ...: Is a directory".
mkdir -p "$TMPHOME/dutest/sub"
dd if=/dev/zero of="$TMPHOME/dutest/sub/file" bs=1024 count=4 2>/dev/null
out=$(tcsh_i "du '$TMPHOME/dutest'")
case $out in
    *'sort:'*) fail "du DIR sent DIR to sort: [$out]" ;;
esac
echo "$out" | grep -q "$TMPHOME/dutest" || fail "du DIR did not report DIR: [$out]"

# --- set rmstar must actually ask: `alias rm 'rm -f'` suppressed the prompt.
mkdir -p "$TMPHOME/rmtest"
touch "$TMPHOME/rmtest/a" "$TMPHOME/rmtest/b" "$TMPHOME/rmtest/c"
out=$(cd "$TMPHOME" && tcsh_i "cd '$TMPHOME/rmtest'
rm *
n
if ( -f a ) echo A_KEPT
if ( -f b ) echo B_KEPT
if ( -f c ) echo C_KEPT")
assert_no_csh_noise "rmstar" "$out"
for _mark in A_KEPT B_KEPT C_KEPT; do
    echo "$out" | grep -q "$_mark" || fail "rm * removed files without asking (rmstar defeated): [$out]"
done
tmphome_rm=$(cd "$TMPHOME/rmtest" && tcsh_i 'touch single ; rm single ; if ( ! -e single ) echo RM_OK')
echo "$tmphome_rm" | grep -q 'RM_OK' || fail "plain rm stopped working: [$tmphome_rm]"

# --- Extended keys: with no cheap TERM answer and type-ahead pending, the DA
# --- probe must refuse to eat the input and still export the 0 tmux expects.
out=$(tcsh_i_env "$TMPHOME" \
    'if ( $?EXTENDED_KEYS_SUPPORTED ) echo "E=$EXTENDED_KEYS_SUPPORTED" ; if ( ! $?EXTENDED_KEYS_SUPPORTED ) echo E=unset' \
    TERM=xterm-256color)
assert_no_csh_noise "extended keys probe" "$out"
echo "$out" | grep -q 'E=0' || fail "probe path did not export EXTENDED_KEYS_SUPPORTED=0: [$out]"

# --- Completions and key bindings loaded (they are separate sourced files, so a
# --- syntax error in either is silent unless something asserts they took).
#
# The count is NOT at the start of the captured output: the pty echoes the
# command, and the PROMPT is printed in front of the result -- the repo's own
# tcshrc paints a coloured prompt (starship's, with ANSI colour escapes and
# the path, the git branch, the python version and the character glyph). So
# the number lands at the END of a prompt-prefixed line, and asserting the
# output STARTS with a digit failed even though the completions WERE
# registered (the count was 1). Extract the TRAILING number instead: strip
# the colour escapes, take the number at the end of a line, and use the last
# one -- the echoed command line has no trailing number, so it cannot
# contribute a false positive.
out=$(tcsh_i 'complete | grep -c loadout')
assert_no_csh_noise "completions" "$out"
count=$(printf '%s\n' "$out" \
    | sed -e 's/\x1b\[[0-9;]*m//g' \
    | grep -oE '[0-9]+$' | tail -1)
[ "${count:-0}" -gt 0 ] || fail "completions.csh did not register anything: [$out]"
out=$(tcsh_i 'bindkey "^I"')
assert_no_csh_noise "keybinds" "$out"
echo "$out" | grep -q 'complete-word-fwd' || fail "keybinds.csh did not bind TAB: [$out]"

# --- Per-PID history with inheritance, mirroring the bash env. This is the
# --- assertion that would have caught the $PPID bug at its source.
out=$(tcsh_i 'echo "HF=$histfile"')
assert_no_csh_noise "history" "$out"
echo "$out" | grep -q 'HF=.*tcsh_history\.' || fail "per-PID histfile not set: [$out]"

# --- Site aliases loaded by the system csh rc (Environment Modules, gawk,
# --- site tooling) run BEFORE ~/.tcshrc. They must survive the entrypoint.
out=$(tcsh_i "alias site_probe 'echo site'; source '$TMPHOME/.tcshrc'; alias site_probe")
assert_no_csh_noise "site alias survival" "$out"
echo "$out" | grep -q 'echo site' || fail "re-sourcing the tcsh entrypoint wiped a site alias: [$out]"

# --- rg aliases: the literal !* glob must reach rg, and the user's arguments
# --- must be appended, not substituted into the glob (csh alias semantics).
mkdir -p "$TMPHOME/.local/bin"
cat > "$TMPHOME/.local/bin/rg" <<EOF
#!/bin/sh
printf '%s\n' "\$@" > "$TMPHOME/rg-args"
EOF
chmod +x "$TMPHOME/.local/bin/rg"
out=$(tcsh_i 'g probe')
assert_no_csh_noise "rg alias" "$out"
grep -Fxq -- 'probe' "$TMPHOME/rg-args" || fail "g did not pass its pattern to rg: [$(cat "$TMPHOME/rg-args")]"
grep -Fq -- '!*.snapshot*' "$TMPHOME/rg-args" || fail "g lost the literal !*.snapshot* glob: [$(cat "$TMPHOME/rg-args")]"
if grep -Fq -- 'probe.snapshot*' "$TMPHOME/rg-args"; then
    fail "g substituted the pattern into the glob: [$(cat "$TMPHOME/rg-args")]"
fi

# --- path_remove / path_trim: a csh alias executes only the first iteration
# --- of an inline foreach, so these must be helpers.
out=$(tcsh_i 'set path = ( /usr/bin /bin /usr/bin /tmp/x ); path_remove /bin; echo "R=$path N=$#path"; set path = ( /usr/bin /bin /usr/bin ); path_trim; echo "T=$path N=$#path"')
assert_no_csh_noise "path aliases" "$out"
echo "$out" | grep -q 'R=/usr/bin /usr/bin /tmp/x N=3' || fail "path_remove did not remove exactly /bin: [$out]"
echo "$out" | grep -q 'T=/usr/bin /bin N=2' || fail "path_trim did not dedupe: [$out]"

# --- Quoted directory arguments must survive the helper round-trip.
mkdir -p "$TMPHOME/space dir" "$TMPHOME/latest dir"
out=$(cd "$TMPHOME" && tcsh_i "cd '$TMPHOME/space dir'; echo \"MARK=\$cwd\"")
assert_no_csh_noise "cd with spaces" "$out"
echo "$out" | grep -q "MARK=.*space dir" || fail "cd did not handle a quoted path with spaces: [$out]"
out=$(cd "$TMPHOME" && tcsh_i "latest '$TMPHOME/latest dir'; echo \"MARK=\$cwd\"")
assert_no_csh_noise "latest with spaces" "$out"
echo "$out" | grep -q "MARK=.*latest dir" || fail "latest did not handle a quoted path with spaces: [$out]"

# --- LESS_TERMCAP_* must be real ESC bytes. less does NOT process backslash
# --- escapes in these variables, so a literal \033 renders as text.
out=$(tcsh_i 'printf "%s" "$LESS_TERMCAP_md" | od -An -tx1')
assert_no_csh_noise "LESS_TERMCAP" "$out"
echo "$out" | grep -q '1b 5b 31 3b 33 32 6d' || fail "LESS_TERMCAP_md is not a real ESC sequence: [$out]"

# --- LOADOUT_CFG_ENABLE_STARSHIP=0 must select the hand-rolled fallback.
out=$(tcsh_i_env "$TMPHOME" \
    'echo "P=[$prompt]"' LOADOUT_CFG_ENABLE_STARSHIP=0)
assert_no_csh_noise "starship switch off" "$out"
echo "$out" | grep -q 'P=\[.*%B' || fail "hand-rolled prompt was not selected: [$out]"

# --- A host with NO starship binary (the env-only farm case) must still start
# --- silently and use the hand-rolled prompt. Build a PATH without starship:
# --- tcsh itself, the helpers' POSIX tools, and nothing else.
FAKEBIN="$TMPHOME/faithful-bin"
mkdir -p "$FAKEBIN"
for _c in tcsh sh ls whoami stty id sed cut ps cp dirname printf od git grep awk \
          tr head tail sort wc cat rm mkdir chmod stat realpath basename date \
          hostname env uname md5sum timeout find xargs touch readlink tty; do
    _p=$(command -v "$_c" 2>/dev/null) && ln -sf "$_p" "$FAKEBIN/$_c"
done
out=$(tcsh_i_raw "$TMPHOME" "$FAKEBIN" \
    "setenv LOADOUT_ONLINE 0; source '$TMPHOME/.tcshrc'; echo \"P=[\$prompt]\"")
assert_no_csh_noise "missing starship" "$out"
echo "$out" | grep -q 'P=\[.*%B' || fail "missing starship did not fall back to the hand-rolled prompt: [$out]"

# --- GRC on a direct tcsh login: env-tcsh ships no grc binary, so the aliases
# --- must find the copy the bash env vendors (a standard @envs install has it).
# --- FAKEBIN deliberately contains no grc, so only the added path can supply it.
mkdir -p "$TMPHOME/.config/bash/global/grc/bin"
printf '#!/bin/sh\nexit 0\n' > "$TMPHOME/.config/bash/global/grc/bin/grc"
chmod +x "$TMPHOME/.config/bash/global/grc/bin/grc"
out=$(tcsh_i_raw "$TMPHOME" "$FAKEBIN" \
    "source '$TMPHOME/.tcshrc'; alias colourify")
assert_no_csh_noise "grc aliases" "$out"
echo "$out" | grep -q 'grc -es' || fail "GRC aliases are still dead on a direct tcsh login: [$out]"

# --- HOME unset: every non-interactive tcsh printed "HOME: Undefined variable."
# --- and the entry point aborted before defining anything. The guard must
# --- recover HOME from the passwd entry and keep going, silently.
out=$(
    printf 'source "$TCSH_CONFIG_ROOT_DIR/tcshrc"\necho "H=$HOME"\necho AFTER=ok\nexit\n' \
        | env -i PATH="$FAKEBIN" TCSH_CONFIG_ROOT_DIR="$TMPHOME/.config/tcsh" \
            TERM=xterm-256color /usr/bin/script -qec "tcsh -f -i" /dev/null 2>"$ERRFILE" \
        | tr -d '\r'
)
[ ! -s "$ERRFILE" ] || fail "HOME-unset startup wrote to stderr:
$(cat "$ERRFILE")"
case $out in
    *'Undefined variable'*) fail "HOME-unset startup still aborts: [$out]" ;;
esac
echo "$out" | grep -q 'H=/' || fail "HOME was not recovered from passwd: [$out]"
echo "$out" | grep -q 'AFTER=ok' || fail "entry point aborted with HOME unset: [$out]"

# --- Dynamic completions: /dev/null inside a complete wordlist is parsed as a
# --- spec delimiter by tcsh; 2>&1| is an ambiguous csh redirect. Both made
# --- every git/module completion die at TAB.
out=$(tcsh_i 'git checkout \t')
assert_no_csh_noise "git completion" "$out"
out=$(tcsh_i "alias module 'echo site'
module load \t")
assert_no_csh_noise "module completion" "$out"

# --- tmux reads EXTENDED_KEYS_SUPPORTED; tcsh must provide it for terminals
# --- where the cheap check applies (no stdin probe needed for alacritty).
out=$(tcsh_i_env "$TMPHOME" 'echo "EXT=$EXTENDED_KEYS_SUPPORTED"' TERM=alacritty)
assert_no_csh_noise "extended keys" "$out"
echo "$out" | grep -q 'EXT=1' || fail "tcsh did not export EXTENDED_KEYS_SUPPORTED: [$out]"

# --- Reinstall must not clobber a user-created layer (the env-st lesson).
echo 'setenv LOADOUT_TEST_KEEPME 1' > "$TMPHOME/.config/tcsh/user/config.csh"
HOME="$TMPHOME" LOADOUT_CFG_SHARED_PREFIX= "$REPO/loadout" install -y env-tcsh --no-backup >/dev/null
[ -f "$TMPHOME/.config/tcsh/user/config.csh" ] || fail "reinstall deleted the user layer"

# --- ~/.cshrc is RETIRED and pruned only when it is a loadout link. A regular
# --- user file is not ours to delete, and tcsh ignores it while ~/.tcshrc
# --- exists, so it is harmless to leave in place.
printf 'setenv LOADOUT_USER_CSHRC 1\n' > "$TMPHOME/.cshrc"
HOME="$TMPHOME" LOADOUT_CFG_SHARED_PREFIX= "$REPO/loadout" install -y env-tcsh --no-backup >/dev/null
[ -f "$TMPHOME/.cshrc" ] || fail "install deleted a regular ~/.cshrc"
grep -q 'LOADOUT_USER_CSHRC' "$TMPHOME/.cshrc" || fail "install rewrote a regular ~/.cshrc"
[ -e "$TMPHOME/.tcshrc" ] || fail ".tcshrc not linked after the .cshrc install"

# --- A symlinked ~/.config/tcsh must be materialized WITHOUT losing the
# --- corp/site/team/project/user layers stored at the link target (the bash
# --- handler has preserve_bash_layers_from_symlink; tcsh/zsh did not).
chmod -R u+w "$TMPHOME/.config/tcsh"
mv "$TMPHOME/.config/tcsh" "$TMPHOME/tcsh-external"
mkdir -p "$TMPHOME/tcsh-external/user"
echo 'setenv LOADOUT_TEST_SYMLAYER 1' > "$TMPHOME/tcsh-external/user/config.csh"
ln -s ../tcsh-external "$TMPHOME/.config/tcsh"
HOME="$TMPHOME" LOADOUT_CFG_SHARED_PREFIX= "$REPO/loadout" install -y env-tcsh --no-backup >/dev/null
[ ! -L "$TMPHOME/.config/tcsh" ] || fail "symlinked ~/.config/tcsh was not materialized"
[ -f "$TMPHOME/.config/tcsh/user/config.csh" ] || fail "install lost layers from a symlinked ~/.config/tcsh"
out=$(tcsh_i 'echo "SYM=$LOADOUT_TEST_SYMLAYER"')
assert_no_csh_noise "symlinked config layers" "$out"
echo "$out" | grep -q 'SYM=1' || fail "preserved layer was not sourced: [$out]"

echo "install-env-tcsh: OK"
