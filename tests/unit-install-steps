    test_runtime_error_is_fail_row,
    test_tar_error_is_fail_row,
    test_bad_archive_does_not_block_next,
    test_vim_missing_sentinel_is_fail,
    test_ldd_only_checks_written_bins,
    test_verification_failure_prints_summary,
    test_failed_checkout_removes_clone,
    test_headless_sync_times_out,
    test_run_timeout_kills_group,
    test_generated_wrappers_quote_paths,
    test_describe_python_suite_uses_install_root,
    test_disabled_messages_use_out_of_service_wording,
    test_build_scripts_honor_loadout_patchelf,
)


def main():
    m = load_loadout()
    for fn in TESTS:
        print(f"-- {fn.__name__}")
        with tempfile.TemporaryDirectory(prefix=".loadout-test-steps.") as tmp:
            try:
                fn(m, tmp)
            except Exception as exc:
                check(fn.__name__, False, f"{type(exc).__name__}: {exc}")
            finally:
                _unseal(tmp)
    print(f"\n{PASSED} passed, {FAILED} failed")
    return 1 if FAILED else 0


if __name__ == "__main__":
    sys.exit(main())
