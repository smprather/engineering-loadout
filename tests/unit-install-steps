    )


def test_disabled_messages_use_out_of_service_wording(m, tmp):
    reg = {
        "x": {"kind": "bin", "platforms": ["linux"], "disabled": True, "disabled_reason": "broken build"},
        "y": {"kind": "bin", "platforms": ["linux"], "depends": ["x"]},
    }
    msgs = []
    for call in (lambda: m.expand_groups(["x"], reg), lambda: m.walk_depends(["y"], reg)):
        try:
            call()
        except m.ResolverError as exc:
            msgs.append(str(exc))
    check("both disabled paths raise ResolverError", len(msgs) == 2, repr(msgs))
    bad = [msg for msg in msgs if "online" in msg.lower() or "offline" in msg.lower()]
    check("disabled messages never say online/offline", not bad, repr(bad))


def test_build_scripts_honor_loadout_patchelf(m, tmp):
    """build/build-shell exports LOADOUT_PATCHELF=/usr/bin/patchelf and sets
    HOME=/tmp, so a script that only knows ~/.local/bin/patchelf fails there."""
    import glob

    offenders = []
    for path in sorted(glob.glob(os.path.join(REPO, "build", "build-*.sh"))):
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
        assigns = [
            ln for ln in text.splitlines() if ln.lstrip().startswith("PATCHELF=") and ".local/bin/patchelf" in ln
        ]
        fallback = "LOADOUT_PATCHELF" in text or "command -v patchelf" in text or 'command -v "$PATCHELF"' in text
        if assigns and not fallback:
            offenders.append(os.path.basename(path))
    check(
        "every build script that names ~/.local/bin/patchelf honors LOADOUT_PATCHELF",
        not offenders,
        ", ".join(offenders),
    )


