#!/usr/bin/env python3
"""
unit-install-steps -- unit tests for individual installer steps in
loadout_main.py: removal on sealed trees, the snapshot target table, symlink
placement, and (as later fixes land) atomic replacement and phase-failure
reporting.

Every case runs in its own temp dir against small fixture trees; nothing here
touches the real HOME or payload. Must run under the bundled Python (PEP 758).
Exits 0 if all cases pass, 1 otherwise.
"""

import importlib.machinery
import importlib.util
import json
import os
import sys
import tempfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LOADOUT_PATH = os.path.join(REPO, "loadout_main.py")


def load_loadout():
    loader = importlib.machinery.SourceFileLoader("loadout_mod", LOADOUT_PATH)
    spec = importlib.util.spec_from_loader("loadout_mod", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


PASSED = 0
FAILED = 0


def check(name, cond, detail=""):
    global PASSED, FAILED
    if cond:
        PASSED += 1
        print(f"  PASS  {name}")
    else:
        FAILED += 1
        print(f"  FAIL  {name}  {detail}")


def _sealed_tree(root):
    """A managed tree after _seal_managed: dirs 0555, files 0444."""
    os.makedirs(os.path.join(root, "a", "b"))
    for rel in ("top.txt", "a/mid.txt", "a/b/leaf.txt"):
        with open(os.path.join(root, rel), "w") as fh:
            fh.write(rel)
    for dirpath, _dirnames, filenames in os.walk(root, topdown=False):
        for name in filenames:
            os.chmod(os.path.join(dirpath, name), 0o444)
        os.chmod(dirpath, 0o555)


def _unseal(root):
    for dirpath, _dirs, _files in os.walk(root):
        try:
            os.chmod(dirpath, 0o755)
        except OSError:
            pass


def test_rmtree_healing_sealed_tree(m, tmp):
    tree = os.path.join(tmp, "sealed")
    _sealed_tree(tree)
    try:
        m.remove_path(tree)
        err = None
    except Exception as exc:
        err = exc
        _unseal(tree)
    check("remove_path removes a sealed 0555/0444 tree", err is None and not os.path.lexists(tree), repr(err))


def test_sync_dir_delete_sealed_subdir(m, tmp):
    src = os.path.join(tmp, "src")
    os.makedirs(os.path.join(src, "keep"))
    with open(os.path.join(src, "keep", "k.txt"), "w") as fh:
        fh.write("k")
    dest = os.path.join(tmp, "dest")
    os.makedirs(dest)
    _sealed_tree(os.path.join(dest, "old"))
    os.chmod(dest, 0o555)
    try:
        m.sync_dir(src, dest, delete=True)
        err = None
    except Exception as exc:
        err = exc
    _unseal(dest)
    check(
        "sync_dir(delete=True) removes a sealed subdir upstream dropped",
        err is None and not os.path.lexists(os.path.join(dest, "old")),
        repr(err),
    )
    check("sync_dir still copies the surviving tree", os.path.isfile(os.path.join(dest, "keep", "k.txt")))


def _covered(rel, targets):
    for t in targets:
        if rel == t or rel.startswith(t + "/") or t.startswith(rel + "/"):
            return True
    return False


def test_snapshot_targets_cover_env_handlers(m, tmp):
    with open(os.path.join(REPO, "payload", "packages.json")) as fh:
        data = json.load(fh)
    reg = data.get("packages", data)
    targets = m._env_snapshot_targets(reg)
    missing = []
    for name in list(m.ENV_HANDLERS) + [n for n, v in reg.items() if isinstance(v, dict) and v.get("kind") == "env"]:
        if name == "env-xfce4-terminal":
            continue  # seed-once, app-owned files: deliberately never backed up or restored
        install_to = (reg.get(name) or {}).get("install_to", "")
        if not install_to.startswith("~/"):
            continue
        rel = install_to[2:].rstrip("/")
        if not _covered(rel, targets):
            missing.append(f"{name}:{rel}")
    check("every env package's root is in the snapshot table", not missing, ", ".join(sorted(set(missing))))
    for rel in (".tcshrc", ".zshenv", ".zshrc", ".zprofile", ".config/bash/profile", ".config/tcsh/tcshrc"):
        check(f"snapshot table lists {rel}", rel in targets)


def test_lns_on_real_dir_raises_install_refused(m, tmp):
    target_dir = os.path.join(tmp, "realdir")
    os.makedirs(target_dir)
    try:
        m.lns("elsewhere", target_dir)
        got = None
    except SystemExit as exc:
        got = f"SystemExit({exc.code})"
    except m.InstallRefused:
        got = "InstallRefused"
    check("lns over a real directory raises InstallRefused, not SystemExit", got == "InstallRefused", str(got))
    check("the directory is left in place", os.path.isdir(target_dir) and not os.path.islink(target_dir))


def _rows(m, thing):
    return [r for r in m.INSTALL_RESULTS if r[0] == thing]


def test_runtime_error_is_fail_row(m, tmp):
    m.INSTALL_RESULTS.clear()

    def boom():
        raise RuntimeError("unsafe tar member path: ../x")

    try:
        got = m.run_install_step("x", boom)
        escaped = None
    except Exception as exc:
        got, escaped = None, exc
    check("RuntimeError does not escape run_install_step", escaped is None, repr(escaped))
    check("RuntimeError becomes a FAIL row", [r[1] for r in _rows(m, "x")] == ["FAIL"], repr(_rows(m, "x")))
    check("the failed step returns None", got is None)


def test_tar_error_is_fail_row(m, tmp):
    import tarfile

    m.INSTALL_RESULTS.clear()

    def boom():
        raise tarfile.ReadError("not a bzip2 file")

    try:
        m.run_install_step("y", boom)
        escaped = None
    except Exception as exc:
        escaped = exc
    check("tarfile.ReadError becomes a FAIL row", escaped is None and _rows(m, "y")[0][1] == "FAIL", repr(escaped))


def _runtime_fixture(m, tmp, names_good_bad):
    import io
    import tarfile

    repo = os.path.join(tmp, "repo")
    home = os.path.join(tmp, "home")
    os.makedirs(home)
    rt = os.path.join(repo, "payload", m.prebuilt_exact_platform_ids()[0], "runtime")
    os.makedirs(rt)
    registry = {}
    for name, good in names_good_bad:
        archive = os.path.join(rt, f"{name}.tar.bz2")
        if good:
            with tarfile.open(archive, "w:bz2") as tf:
                data = b"sentinel"
                info = tarfile.TarInfo(f"share/{name}/sentinel")
                info.size = len(data)
                tf.addfile(info, io.BytesIO(data))
        else:
            with open(archive, "wb") as fh:
                fh.write(b"this is not a tar archive")
        registry[name] = {
            "kind": "bin",
            "platforms": ["linux"],
            "install_to": "~/.local",
            "sentinel": f"share/{name}/sentinel",
        }
    return repo, home, registry


def test_bad_archive_does_not_block_next(m, tmp):
    repo, home, registry = _runtime_fixture(m, tmp, [("aaa", False), ("bbb", True)])
    m.INSTALL_RESULTS.clear()
    m._VERIFY_CONTENT = False
    try:
        m.install_runtime_archives(repo, home, None, registry)
        escaped = None
    except Exception as exc:
        escaped = exc
    finally:
        m._VERIFY_CONTENT = True
    sentinel = os.path.join(m._local_root(home), "share", "bbb", "sentinel")
    check("a corrupt archive does not abort the phase", escaped is None, repr(escaped))
    check("the archive after it still installs", os.path.isfile(sentinel))
    check(
        "the corrupt archive is a FAIL row",
        [r[1] for r in _rows(m, "aaa runtime")] == ["FAIL"],
        repr(m.INSTALL_RESULTS),
    )
    check("the good archive is an OK row", [r[1] for r in _rows(m, "bbb runtime")] == ["OK"], repr(m.INSTALL_RESULTS))


def test_vim_missing_sentinel_is_fail(m, tmp):
    import io
    import tarfile

    repo = os.path.join(tmp, "repo")
    home = os.path.join(tmp, "home")
    os.makedirs(home)
    rt = os.path.join(repo, "payload", m.prebuilt_exact_platform_ids()[0], "runtime")
    os.makedirs(rt)
    with tarfile.open(os.path.join(rt, "vim92.tar.bz2"), "w:bz2") as tf:
        info = tarfile.TarInfo("runtime/syntax/x.vim")
        info.size = 1
        tf.addfile(info, io.BytesIO(b"x"))
    m.INSTALL_RESULTS.clear()
    m._VERIFY_CONTENT = False
    try:
        m.run_install_step("Vim runtime", m.install_vim_runtime, repo, home, None, {})
    finally:
        m._VERIFY_CONTENT = True
    check(
        "vim runtime without filetype.vim is a FAIL row",
        [r[1] for r in _rows(m, "Vim runtime")] == ["FAIL"],
        repr(_rows(m, "Vim runtime")),
    )


def test_ldd_only_checks_written_bins(m, tmp):
    bindir = os.path.join(tmp, "bin")
    os.makedirs(bindir)
    for name in ("a", "b", "c"):
        path = os.path.join(bindir, name)
        with open(path, "w") as fh:
            fh.write("#!/bin/sh\n")
        os.chmod(path, 0o755)
    calls = []

    class _Proc:
        stdout = b""

    saved_run, saved_ldd = m.subprocess.run, m._LDD
    m.subprocess.run = lambda cmd, *a, **k: calls.append(cmd) or _Proc()
    m._LDD = "/usr/bin/ldd"
    try:
        m.check_prebuilt_binary_dependencies(bindir, names={"a"})
    finally:
        m.subprocess.run, m._LDD = saved_run, saved_ldd
    checked = [os.path.basename(c[-1]) for c in calls]
    check("ldd checks only the binaries this run installed", checked == ["a"], repr(checked))


def test_verification_failure_prints_summary(m, tmp):
    import contextlib
    import io

    m.INSTALL_RESULTS.clear()
    saved = m.cli.main

    def fake_main(*_a, **_k):
        m.record_result("pre-built binaries", "OK", "")
        raise m.ContentVerificationError("sha256 mismatch for payload/x")

    m.cli.main = fake_main
    out, err = io.StringIO(), io.StringIO()
    try:
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            rc = m.main(["install", "x", "-y"])
    finally:
        m.cli.main = saved
    text = out.getvalue() + err.getvalue()
    check("verification failure exits 1", rc == 1, f"rc={rc}")
    check("earlier phases appear in the printed summary", "pre-built binaries" in text, text[-600:])
    check("the message says earlier phases completed", "earlier" in text.lower(), text[-600:])


TESTS = (
    test_rmtree_healing_sealed_tree,
    test_sync_dir_delete_sealed_subdir,
    test_snapshot_targets_cover_env_handlers,
    test_lns_on_real_dir_raises_install_refused,
    test_runtime_error_is_fail_row,
    test_tar_error_is_fail_row,
    test_bad_archive_does_not_block_next,
    test_vim_missing_sentinel_is_fail,
    test_ldd_only_checks_written_bins,
    test_verification_failure_prints_summary,
)


def main():
    m = load_loadout()
    for fn in TESTS:
        print(f"-- {fn.__name__}")
        with tempfile.TemporaryDirectory(prefix=".loadout-test-steps.") as tmp:
            try:
                fn(m, tmp)
            except Exception as exc:
                check(fn.__name__, False, f"{type(exc).__name__}: {exc}")
            finally:
                _unseal(tmp)
    print(f"\n{PASSED} passed, {FAILED} failed")
    return 1 if FAILED else 0


if __name__ == "__main__":
    sys.exit(main())
