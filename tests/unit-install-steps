def test_ldd_only_checks_written_bins(m, tmp):
    bindir = os.path.join(tmp, "bin")
    os.makedirs(bindir)
    for name in ("a", "b", "c"):
        path = os.path.join(bindir, name)
        with open(path, "w") as fh:
            fh.write("#!/bin/sh\n")
        os.chmod(path, 0o755)
    calls = []

    class _Proc:
        stdout = b""

    saved_run, saved_ldd = m.subprocess.run, m._LDD
    m.subprocess.run = lambda cmd, *a, **k: calls.append(cmd) or _Proc()
    m._LDD = "/usr/bin/ldd"
    try:
        m.check_prebuilt_binary_dependencies(bindir, names={"a"})
    finally:
        m.subprocess.run, m._LDD = saved_run, saved_ldd
    checked = [os.path.basename(c[-1]) for c in calls]
    check("ldd checks only the binaries this run installed", checked == ["a"], repr(checked))


def test_verification_failure_prints_summary(m, tmp):
    import contextlib
    import io

    m.INSTALL_RESULTS.clear()
    saved = m.cli.main

    def fake_main(*_a, **_k):
        m.record_result("pre-built binaries", "OK", "")
        raise m.ContentVerificationError("sha256 mismatch for payload/x")

    m.cli.main = fake_main
    out, err = io.StringIO(), io.StringIO()
    try:
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            rc = m.main(["install", "x", "-y"])
    finally:
        m.cli.main = saved
    text = out.getvalue() + err.getvalue()
    check("verification failure exits 1", rc == 1, f"rc={rc}")
    check("earlier phases appear in the printed summary", "pre-built binaries" in text, text[-600:])
    check("the message says earlier phases completed", "earlier" in text.lower(), text[-600:])


def _stub(path, body):
    with open(path, "w") as fh:
        fh.write("#!/bin/sh\n" + body)
    os.chmod(path, 0o755)
    return path


def _alive(pid):
    try:
        with open(f"/proc/{pid}/stat") as fh:
            return fh.read().rsplit(")", 1)[1].split()[0] != "Z"
    except OSError:
        return False


def test_failed_checkout_removes_clone(m, tmp):
    repo = os.path.join(tmp, "repo")
    home = os.path.join(tmp, "home")
    os.makedirs(os.path.join(repo, "envs", "nvim"))
    with open(os.path.join(repo, "envs", "nvim", "lazy-lock.json"), "w") as fh:
        json.dump({"plug": {"branch": "main", "commit": "0123456789abcdef"}}, fh)
    os.makedirs(os.path.join(home, ".config", "nvim"))
    with open(os.path.join(home, ".config", "nvim", "init.lua"), "w") as fh:
        fh.write("-- fixture\n")
    stash = os.path.join(tmp, "stash")
    os.makedirs(os.path.join(stash, "owner", "plug.git"))
    # clone succeeds (creates the dir), the pin checkout fails.
    git = _stub(
        os.path.join(tmp, "git"),
        'if [ "$1" = clone ]; then for a; do last=$a; done; mkdir -p "$last"; exit 0; fi\nexit 1\n',
    )
    saved = (m._resolve_git, m._resolve_nvim_stash)
    m._resolve_git = lambda _home: git
    m._resolve_nvim_stash = lambda _home: stash
    try:
        dst = os.path.join(m._local_root(home), "share", "nvim", "lazy", "plug")
        m.INSTALL_RESULTS.clear()
        m.install_nvim_plugin_bundle(repo, home, None)
        first = [r[1] for r in m.INSTALL_RESULTS if r[0] == "nvim plugins"]
        gone = not os.path.lexists(dst)
        m.INSTALL_RESULTS.clear()
        m.install_nvim_plugin_bundle(repo, home, None)
        second = [r[1] for r in m.INSTALL_RESULTS if r[0] == "nvim plugins"]
    finally:
        m._resolve_git, m._resolve_nvim_stash = saved
    check("a failed pin checkout is a FAIL row", first == ["FAIL"], repr(first))
    check("a failed pin checkout removes the half-made clone", gone)
    check("the next install fails again instead of counting it as kept", second == ["FAIL"], repr(second))


def test_headless_sync_times_out(m, tmp):
    home = os.path.join(tmp, "home")
    os.makedirs(os.path.join(home, ".config", "nvim"))
    with open(os.path.join(home, ".config", "nvim", "init.lua"), "w") as fh:
        fh.write("-- fixture\n")
    pidfile = os.path.join(tmp, "nvim.pid")
    nvim = _stub(os.path.join(tmp, "nvim"), f'echo $$ > "{pidfile}"\nexec sleep 30\n')
    saved = (m._resolve_loadout_nvim_bin, m._resolve_nvim_stash, m._nvim_headless_env, m._NVIM_HEADLESS_TIMEOUT)
    m._resolve_loadout_nvim_bin = lambda _home: nvim
    m._resolve_nvim_stash = lambda _home: tmp
    m._nvim_headless_env = lambda _home: dict(os.environ)
    m._NVIM_HEADLESS_TIMEOUT = 1
    try:
        m.INSTALL_RESULTS.clear()
        m.install_nvim_lazy_update(tmp, home, None)
    finally:
        (m._resolve_loadout_nvim_bin, m._resolve_nvim_stash, m._nvim_headless_env, m._NVIM_HEADLESS_TIMEOUT) = saved
    rows = [r for r in m.INSTALL_RESULTS if r[0] == "Neovim Lazy sync"]
    check("a hung headless sync is a FAIL row", [r[1] for r in rows] == ["FAIL"], repr(rows))
    check("the FAIL row says it timed out", bool(rows) and "timed out" in rows[0][2], repr(rows))
    with open(pidfile) as fh:
        pid = int(fh.read())
    check("the hung nvim was killed", not _alive(pid))


def test_run_timeout_kills_group(m, tmp):
    import subprocess
    import time

    pidfile = os.path.join(tmp, "pids")
    try:
        m.run(["sh", "-c", f'echo $$ > "{pidfile}"; sleep 30 & echo $! >> "{pidfile}"; sleep 30'], timeout=1)
        raised = False
    except subprocess.TimeoutExpired:
        raised = True
    check("run() raises TimeoutExpired", raised)
    with open(pidfile) as fh:
        pids = [int(x) for x in fh.read().split()]
    deadline = time.time() + 5
    while time.time() < deadline and any(_alive(p) for p in pids):
        time.sleep(0.1)
    check("no process of the timed-out group survives", not any(_alive(p) for p in pids), repr(pids))


def test_generated_wrappers_quote_paths(m, tmp):
    """Generated sh embeds paths with shlex.quote: an install root holding
    spaces, $, quotes or backticks must still exec the right target."""
    import subprocess

    root = os.path.join(tmp, 'a b$c"d`e')
    bindir = os.path.join(m._local_root(root), "bin")
    os.makedirs(bindir)
    target = _stub(os.path.join(bindir, "tool"), 'echo "TARGET|${PYTHONPATH:-}|$*"\n')
    shim = os.path.join(tmp, "shim")
    with open(shim, "w") as fh:
        fh.write(m._prefer_shim_body(root, "tool"))
    os.chmod(shim, 0o755)
    site = os.path.join(root, "lib", "site packages")
    wrapper = os.path.join(tmp, "wrapper")
    try:
        text = m._pythonpath_wrapper_text(site, target)
    except AttributeError as exc:
        text = None
        check("_pythonpath_wrapper_text exists", False, str(exc))
    for label, path in (("prefer shim", shim), ("PYTHONPATH wrapper", wrapper)):
        if path == wrapper:
            if text is None:
                continue
            with open(wrapper, "w") as fh:
                fh.write(text)
            os.chmod(wrapper, 0o755)
        syntax = subprocess.run(["sh", "-n", path], capture_output=True, text=True)
        check(f"{label} parses under sh -n", syntax.returncode == 0, syntax.stderr)
        res = subprocess.run([path, "x y", "z"], capture_output=True, text=True, env={"PATH": "/usr/bin:/bin"})
        check(f"{label} reaches its target", res.stdout.startswith("TARGET|"), res.stdout + res.stderr)
        check(f"{label} passes arguments intact", res.stdout.rstrip("\n").endswith("|x y z"), res.stdout)
        if path == wrapper:
            check("wrapper puts the quoted site-packages first", res.stdout.startswith(f"TARGET|{site}"), res.stdout)


def test_describe_python_suite_uses_install_root(m, tmp):
    import contextlib
    import io
    import types

    saved = {k: os.environ.get(k) for k in ("HOME", "XDG_DATA_HOME")}
    os.environ["HOME"] = os.path.join(tmp, "home")
    os.environ["XDG_DATA_HOME"] = os.path.join(tmp, "xdg")
    os.makedirs(os.environ["HOME"])
    try:
        root = m._resolve_home(None)
        stamp = m._suite_stamp_path(m._resolve_install_to(m._SUITE_INSTALL_TO, root))
        os.makedirs(os.path.dirname(stamp), exist_ok=True)
        with open(stamp, "w") as fh:
            json.dump({"python": "3.15.0", "abi": "cpython-315"}, fh)
        reg = m._load_tool_registry(REPO)
        out = io.StringIO()
        with contextlib.redirect_stdout(out):
