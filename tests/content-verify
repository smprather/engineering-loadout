#!/usr/bin/env python3
"""
content-verify -- unit test for install-time content verification.

Confirms that _Bz2Store.resolve() refuses a payload whose bytes do not match
the committed .content-manifest, accepts one that does, and honours the
verification-disabled switch. Uses a synthetic repo + manifest (no real
payload touched). Runs under the bundled Python 3.14.

Exits 0 if all cases pass, 1 otherwise.
"""

import importlib.machinery
import importlib.util
import os
import sys
import tempfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LOADOUT_PATH = os.path.join(REPO, "loadout_main.py")

PASSED = 0
FAILED = 0


def check(name, cond, detail=""):
    global PASSED, FAILED
    if cond:
        PASSED += 1
        print(f"  PASS  {name}")
    else:
        FAILED += 1
        print(f"  FAIL  {name}  {detail}")


def load_loadout():
    loader = importlib.machinery.SourceFileLoader("loadout_mod", LOADOUT_PATH)
    spec = importlib.util.spec_from_loader("loadout_mod", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def main():
    m = load_loadout()
    with tempfile.TemporaryDirectory() as repo:
        payload = os.path.join(repo, "payload", "el8", "bin")
        os.makedirs(payload)
        blob = os.path.join(payload, "tool.bz2")
        with open(blob, "wb") as fh:
            fh.write(b"not-really-bz2-but-fine-for-hashing")
        digest = m._sha256_file(blob)
        rel = os.path.relpath(blob, repo)

        # write a manifest with the correct hash
        manifest = os.path.join(repo, ".content-manifest")
        with open(manifest, "w") as fh:
            fh.write("# content manifest\n")
            fh.write(f"sha256  {digest}  {rel}\n")

        m._load_content_manifest(repo)
        m._VERIFY_CONTENT = True

        # 1. matching file resolves
        ok = True
        try:
            m._verify_source_files([blob])
        except m.ContentVerificationError as exc:
            ok = False
            print("   ", exc)
        check("matching file verifies", ok)

        # 2. tampered file is refused
        with open(blob, "ab") as fh:
            fh.write(b"X")  # flip the bytes
        refused = False
        try:
            m._verify_source_files([blob])
        except m.ContentVerificationError:
            refused = True
        check("tampered file refused", refused)

        # 3. --no-verify disables the check
        m._VERIFY_CONTENT = False
        passed_disabled = True
        try:
            m._verify_source_files([blob])
        except m.ContentVerificationError:
            passed_disabled = False
        check("verification-disabled skips the check", passed_disabled)
        m._VERIFY_CONTENT = True

        # 4. a file not listed in the manifest is a hard error
        unlisted = os.path.join(payload, "rogue.bz2")
        with open(unlisted, "wb") as fh:
            fh.write(b"dropped-in")
        rogue_refused = False
        try:
            m._verify_source_files([unlisted])
        except m.ContentVerificationError:
            rogue_refused = True
        check("unlisted payload file refused", rogue_refused)

        # 5. resolve() enforces on the real chokepoint (restore the good blob)
        with open(blob, "wb") as fh:
            fh.write(b"not-really-bz2-but-fine-for-hashing")
        store = m._Bz2Store()
        resolve_ok = store.resolve(blob) == blob
        check("resolve() returns a verified file unchanged", resolve_ok)
        with open(blob, "ab") as fh:
            fh.write(b"X")
        resolve_refused = False
        try:
            store.resolve(blob)
        except m.ContentVerificationError:
            resolve_refused = True
        check("resolve() refuses a tampered file", resolve_refused)

        # 6. open_logical() (chunked font zips, read in place) verifies every part
        fonts = os.path.join(repo, "payload", "fonts")
        os.makedirs(fonts)
        parts = []
        for i, chunk in enumerate((b"PK-part-zero", b"part-one")):
            part = os.path.join(fonts, f"Font.zip.part-{i:03d}")
            with open(part, "wb") as fh:
                fh.write(chunk)
            parts.append(part)
        with open(manifest, "a") as fh:
            for part in parts:
                fh.write(f"sha256  {m._sha256_file(part)}  {os.path.relpath(part, repo)}\n")
        m._load_content_manifest(repo)
        src = store.open_logical(os.path.join(fonts, "Font.zip"))
        check("open_logical() reads verified parts as one file", src.read() == b"PK-part-zeropart-one")
        src.close()
        with open(parts[1], "ab") as fh:
            fh.write(b"X")
        check(
            "open_logical() refuses a tampered part",
            _raises(m.ContentVerificationError, store.open_logical, os.path.join(fonts, "Font.zip")),
        )

    test_every_payload_phase_verifies(m)
    test_missing_manifest_fails_closed(m)

    print(f"\n{PASSED} passed, {FAILED} failed")
    return 1 if FAILED else 0


def _raises(exc_type, fn, *args):
    try:
        fn(*args)
    except exc_type:
        return True
    except Exception as exc:
        print(f"    (raised {type(exc).__name__}: {exc})")
        return False
    return False


def _write(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "wb") as fh:
        fh.write(data)


def _manifest_then_tamper(m, repo, files):
    """Record every fixture file in .content-manifest, then flip one byte of
    each -- the shape of a payload modified after the manifest was signed."""
    with open(os.path.join(repo, ".content-manifest"), "w") as fh:
        fh.write("# content manifest\n")
        for f in files:
            fh.write(f"sha256  {m._sha256_file(f)}  {os.path.relpath(f, repo)}\n")
    for f in files:
        with open(f, "ab") as fh:
            fh.write(b"X")
    m._load_content_manifest(repo)
    m._VERIFY_CONTENT = True


def test_every_payload_phase_verifies(m):
    """Every phase that installs payload bytes must hash them first -- not only
    the bz2 artifacts that go through _Bz2Store.resolve()."""
    print("-- every payload phase verifies its sources")
    with tempfile.TemporaryDirectory() as repo, tempfile.TemporaryDirectory() as home:
        plat = m.prebuilt_exact_platform_ids()[0]
        pdir = os.path.join(repo, "payload", plat)
        typelib = os.path.join(pdir, "typelibs", "Fake-1.0.typelib")
        _write(typelib, b"typelib")
        ts = m.treesitter_platform_id()
        parser = os.path.join(repo, "payload", "treesitter", "prebuilt", ts, "parser", "fake.so")
        _write(parser, b"\x7fELF-not-really")
        query = os.path.join(repo, "payload", "treesitter", "prebuilt", ts, "queries", "fake", "highlights.scm")
        _write(query, b"; q")
        wheel = os.path.join(pdir, "wheels", "faketool-1.0-py3-none-any.whl")
        _write(wheel, b"PK-not-really")
        archive = os.path.join(pdir, "portable-python-3.15.0-test.tar.bz2")
        _write(archive, b"BZh-not-really")
        _manifest_then_tamper(m, repo, [typelib, parser, query, wheel, archive])

        check(
            "tampered typelib refused",
            _raises(m.ContentVerificationError, m.install_typelibs, repo, home, None),
        )
        check(
            "tampered parser refused",
            _raises(m.ContentVerificationError, m.install_treesitter_parsers, repo, home, None),
        )
        check(
            "tampered portable-python refused",
            _raises(m.ContentVerificationError, m.install_portable_python, repo, home, None),
        )

        calls = []
        saved_run = m.run
        m.run = lambda *a, **k: calls.append(a) or saved_run(["true"])
        registry = {"faketool": {"kind": "python-tool", "uv_tool": "faketool", "platforms": ["linux"]}}
        try:
            refused = _raises(m.ContentVerificationError, m.install_python_tools, repo, home, None, registry)
        finally:
            m.run = saved_run
        check("tampered wheel refused before uv runs", refused and not calls, f"uv calls: {calls}")


def test_missing_manifest_fails_closed(m):
    """No .content-manifest means nothing can be verified: refuse, unless the
    user explicitly opted out with --no-verify."""
    print("-- a missing manifest fails closed")
    import types

    def args(no_verify):
        return types.SimpleNamespace(
            no_verify=no_verify,
            install_follows_symlinks="auto",
            allow_online_plugin_sync=False,
            dry_run=True,
            dest_dir=None,
        )

    with tempfile.TemporaryDirectory() as repo, tempfile.TemporaryDirectory() as home:
        os.makedirs(os.path.join(repo, "payload"))
        saved = m.cmd_resolve
        m.cmd_resolve = lambda *_a, **_k: 0
        try:
            rc = m.cmd_install(args(False), {}, None, repo, home)
            check("missing manifest fails closed", rc == 1, f"rc={rc}")
            rc = m.cmd_install(args(True), {}, None, repo, home)
            check("--no-verify still gets past the manifest gate", rc == 0, f"rc={rc}")
        finally:
            m.cmd_resolve = saved
            m._VERIFY_CONTENT = True


if __name__ == "__main__":
    sys.exit(main())
