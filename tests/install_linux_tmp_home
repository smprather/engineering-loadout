#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<EOF
Usage: $0 [OPTIONS]

Run the Linux installer against a temporary HOME to simulate a fresh user.

Options:
  --keep-home       Print and keep the temp HOME after the test.
  --with-fonts      Install vendored fonts too. Default skips fonts for speed.
  --help, -h        Show this help message.
EOF
}

keep_home=0
with_fonts=0

while [[ $# -gt 0 ]]; do
    case "$1" in
    --keep-home)
        keep_home=1
        shift
        ;;
    --with-fonts)
        with_fonts=1
        shift
        ;;
    --help | -h)
        usage
        exit 0
        ;;
    *)
        echo "Unknown option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
done

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo_dir=$(cd "$script_dir/.." && pwd)
test_home=$(mktemp -d /tmp/loadout-install-home.XXXXXX)
test_cache=$(mktemp -d /tmp/loadout-install-cache.XXXXXX)
test_state=$(mktemp -d /tmp/loadout-install-state.XXXXXX)
test_hooks=$(mktemp -d /tmp/loadout-install-hooks.XXXXXX)
install_log=$(mktemp /tmp/loadout-install-log.XXXXXX)

cleanup() {
    if [[ "$keep_home" == "1" ]]; then
        echo "Kept temp HOME: $test_home"
        echo "Kept XDG_CACHE_HOME: $test_cache"
        echo "Kept XDG_STATE_HOME: $test_state"
    else
        rm -rf "$test_home" "$test_cache" "$test_state" "$test_hooks" "$install_log"
    fi
}
trap cleanup EXIT

assert_exists() {
    local path="$1"
    if [[ ! -e "$path" && ! -L "$path" ]]; then
        echo "Missing expected path: $path" >&2
        exit 1
    fi
}

assert_symlink() {
    local path="$1"
    if [[ ! -L "$path" ]]; then
        echo "Expected symlink: $path" >&2
        exit 1
    fi
}

cat > "$test_hooks/hook1.sh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
{
    echo "hook1"
    echo "repo=$LOADOUT_REPO"
    echo "home=$LOADOUT_HOME"
    echo "dest_dir=$LOADOUT_DEST_DIR"
    echo "backup=$LOADOUT_BACKUP_DIR"
    echo "no_backup=$LOADOUT_NO_BACKUP"
} >> "$LOADOUT_HOME/post-install-hooks.log"
EOF

cat > "$test_hooks/hook2.py" <<'EOF'
#!/usr/bin/env python3
import os

with open(os.path.join(os.environ["LOADOUT_HOME"], "post-install-hooks.log"), "a") as fh:
    fh.write("hook2\n")
EOF

chmod +x "$test_hooks/hook1.sh" "$test_hooks/hook2.py"

install_args=(
    --dest-dir "$test_home"
    install
    "@engineering-loadout"
    --post-install-hook "$test_hooks/hook1.sh"
    --post-install-hook "$test_hooks/hook2.py"
)
if [[ "$with_fonts" != "1" ]]; then
    install_args+=(--skip @fonts-all)
fi

if [[ -f "$repo_dir/tldr/tldr-pages.tar.bz2" || -f "$repo_dir/tldr/tldr-pages.tar.gz" ]]; then
    mkdir -p "$test_home/.cache/tealdeer/tldr-pages"
    touch "$test_home/.cache/tealdeer/tldr-pages/stale-before-install"
fi

echo "Temp HOME: $test_home"
(
    cd /tmp
    XDG_CACHE_HOME="$test_cache" \
    XDG_STATE_HOME="$test_state" \
        "$repo_dir/loadout" "${install_args[@]}"
) 2>&1 | tee "$install_log"

# Header: Rich prints "Install Results" (no colon, embedded in box-drawing),
# plain fallback prints "Install results:" — match either.
if ! grep -Eq "Install [Rr]esults" "$install_log"; then
    echo "Expected final install results table" >&2
    exit 1
fi
# Per-row checks tolerate both Rich (│ name │ status │) and plain whitespace.
if ! grep -Eq "config files[[:space:]│|]+yes" "$install_log"; then
    echo "Expected 'config files' success row in install results table" >&2
    exit 1
fi
if ! grep -Eq "fonts[[:space:]│|]+skip[[:space:]│|]+no font-\* packages" "$install_log"; then
    echo "Expected fonts skip row in install results table" >&2
    exit 1
fi

assert_symlink "$test_home/.bashrc"
assert_symlink "$test_home/.bash_profile"
assert_symlink "$test_home/.bash_login"
assert_symlink "$test_home/.profile"
assert_symlink "$test_home/.vimrc"
assert_symlink "$test_home/.tmux.conf"
assert_symlink "$test_home/.editorconfig"

assert_exists "$test_home/post-install-hooks.log"
mapfile -t hook_log < "$test_home/post-install-hooks.log"
last_hook_index=$((${#hook_log[@]} - 1))
if [[ "${hook_log[0]}" != "hook1" || "${hook_log[$last_hook_index]}" != "hook2" ]]; then
    echo "Expected post-install hooks to run in argument order" >&2
    printf '%s\n' "${hook_log[@]}" >&2
    exit 1
fi
if ! grep -q "^backup=$test_home/loadout_backups/backup" "$test_home/post-install-hooks.log"; then
    echo "Expected LOADOUT_BACKUP_DIR to point at current backup dir" >&2
    cat "$test_home/post-install-hooks.log" >&2
    exit 1
fi
if ! grep -q "^dest_dir=$test_home" "$test_home/post-install-hooks.log"; then
    echo "Expected LOADOUT_DEST_DIR to equal --dest-dir value" >&2
    cat "$test_home/post-install-hooks.log" >&2
    exit 1
fi

assert_exists "$test_home/.config/bash/bashrc"
assert_exists "$test_home/.config/nvim/init.lua"
assert_exists "$test_home/.config/nvim/after/ftplugin/tcl.lua"
assert_exists "$test_home/.config/nvim/after/ftplugin/yaml.lua"
assert_exists "$test_home/.config/nvim/after/lsp/ty.lua"
assert_exists "$test_home/.config/tmux/tmux.conf"
assert_exists "$test_home/.config/starship/starship.toml"
if [[ -f "$repo_dir/tldr/tldr-pages.tar.bz2" || -f "$repo_dir/tldr/tldr-pages.tar.gz" ]]; then
    assert_exists "$test_home/.cache/tealdeer/tldr-pages"
    if [[ -e "$test_home/.cache/tealdeer/tldr-pages/stale-before-install" ]]; then
        echo "Expected tldr cache install to replace existing cache" >&2
        exit 1
    fi
fi
if [[ -d "$repo_dir/pre_built/el8.x86_64.glibc2p28" ]]; then
    assert_exists "$test_home/.local/bin/fd"
    assert_exists "$test_home/.local/bin/eza"
    assert_exists "$test_home/.local/bin/tmux"
    assert_exists "$test_home/.local/bin/choose"
    assert_exists "$test_home/.local/bin/patchelf"
    assert_exists "$test_home/.local/bin/nvim"
    assert_exists "$test_home/.local/lib64/libevent_core-2.1.so.6"
    rpath=$("$test_home/.local/bin/patchelf" --print-rpath "$test_home/.local/bin/tmux")
    if [[ "$rpath" != *'$ORIGIN/../lib64'* ]]; then
        echo "Expected tmux RPATH to include vendored lib64 path, got: $rpath" >&2
        exit 1
    fi
fi
if [[ -f "$repo_dir/pre_built/el8.x86_64.glibc2p28/runtime/vim92.tar.bz2" || -f "$repo_dir/vim/runtime.tar.bz2" ]]; then
    assert_exists "$test_home/.local/share/vim/vim92/filetype.vim"
fi
if [[ -f "$repo_dir/pre_built/el8.x86_64.glibc2p28/runtime/nvim.tar.bz2" ]]; then
    assert_exists "$test_home/.local/share/nvim/runtime/filetype.lua"
fi
if [[ -f "$repo_dir/pre_built/el8.x86_64.glibc2p28/runtime/helix.tar.bz2" || -f "$repo_dir/helix/helix_runtime.tar.bz2" ]]; then
    assert_exists "$test_home/.config/helix/runtime/tutor"
fi
assert_exists "$test_home/.local/share/nvim/loadout/vendor/nvim-treesitter/lua/nvim-treesitter/init.lua"
assert_exists "$test_home/.local/share/nvim/loadout/vendor/treesitter-parser-registry/registry.json"
assert_exists "$test_home/.local/share/nvim/tree-sitter-parsers/parser/python.so"
assert_exists "$test_home/.local/share/nvim/tree-sitter-parsers/queries/python/highlights.scm"
assert_exists "$test_home/.local/share/nvim/tree-sitter-parsers/parser-info/python.lua"

# Active plugin bundle is seeded into lazy/ (with .git intact) so plugins work
# offline; lazy.nvim itself is seeded too, making init.lua's bootstrap a no-op.
if [[ -f "$repo_dir/nvim/vendor/plugins/nvim-catalog-plugins.tar.bz2" ]]; then
    assert_exists "$test_home/.local/share/nvim/lazy/lazy.nvim/.git"
    assert_exists "$test_home/.local/share/nvim/lazy/snacks.nvim/.git"
fi

nvim_bin=""
if [[ -x "$test_home/.local/bin/nvim" ]]; then
    nvim_bin="$test_home/.local/bin/nvim"
elif command -v nvim >/dev/null; then
    nvim_bin=$(command -v nvim)
fi

if [[ -n "$nvim_bin" ]]; then
    if [[ ! -d "$test_home/.local/share/nvim/lazy/lazy.nvim" ]]; then
        fake_git_dir="$test_home/fake-git-bin"
        mkdir -p "$fake_git_dir"
        printf '%s\n' '#!/usr/bin/env sh' 'exit 127' > "$fake_git_dir/git"
        chmod +x "$fake_git_dir/git"
        HOME="$test_home" \
            XDG_CONFIG_HOME="$test_home/.config" \
            XDG_DATA_HOME="$test_home/.local/share" \
            XDG_CACHE_HOME="$test_cache" \
            XDG_STATE_HOME="$test_state" \
            PATH="$fake_git_dir:$PATH" \
            "$nvim_bin" --headless -n \
            +'lua if vim.g.loadout_plugins_enabled ~= false then vim.api.nvim_err_writeln("expected plugin layer disabled without lazy.nvim"); vim.cmd("cquit 1") end' \
            +qa
    fi

    printf 'print("ok")\n' > "$test_home/tree-sitter-smoke.py"
    HOME="$test_home" \
        XDG_CONFIG_HOME="$test_home/.config" \
        XDG_DATA_HOME="$test_home/.local/share" \
        XDG_CACHE_HOME="$test_cache" \
        XDG_STATE_HOME="$test_state" \
        "$nvim_bin" --clean --headless -n "$test_home/tree-sitter-smoke.py" \
        +"set runtimepath+=$test_home/.local/share/nvim/loadout/vendor/treesitter-parser-registry" \
        +"set runtimepath+=$test_home/.local/share/nvim/loadout/vendor/nvim-treesitter" \
        +"set runtimepath+=$test_home/.local/share/nvim/tree-sitter-parsers" \
        +'lua local expected = vim.env.HOME .. "/.local/share/nvim/runtime"; if not vim.o.runtimepath:find(expected, 1, true) then vim.api.nvim_err_writeln(vim.o.runtimepath); vim.cmd("cquit 1") end; if vim.fn.filereadable(expected .. "/filetype.lua") ~= 1 then vim.api.nvim_err_writeln(expected); vim.cmd("cquit 1") end' \
        +'lua local ok, err = pcall(function() require("nvim-treesitter").setup({ install_dir = vim.fn.stdpath("data") .. "/tree-sitter-parsers" }); vim.treesitter.start(0); vim.treesitter.get_parser(0, "python"):parse() end); if not ok then vim.api.nvim_err_writeln(err); vim.cmd("cquit 1") end; print("Tree-sitter smoke OK")' \
        +qa
    echo ""
else
    echo "nvim not found; skipped Tree-sitter runtime smoke"
fi

echo "Install temp-home smoke OK"
