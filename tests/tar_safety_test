#!/usr/bin/env python3
"""
tar_safety_test — focused test for safe_extract_tar's path-traversal,
symlink-escape, hardlink-escape, and safe-relative-symlink behavior.

Builds synthetic tarballs in memory, runs them through
engineering-loadout's safe_extract_tar (via SourceFileLoader so the file
without a .py extension can still be imported as a module), and asserts
the expected accept/reject outcome.

Exits 0 if all cases pass, 1 otherwise.
"""
import importlib.machinery
import importlib.util
import io
import os
import shutil
import sys
import tarfile
import tempfile


REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ELOADOUT = os.path.join(REPO, "engineering-loadout")


def load_eloadout():
    loader = importlib.machinery.SourceFileLoader("eloadout", ELOADOUT)
    spec = importlib.util.spec_from_loader("eloadout", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def make_tar(members):
    """members: list of (name, kind, content_or_linkname)
       kind: 'file' | 'symlink' | 'hardlink' | 'dir'"""
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w") as tf:
        for name, kind, payload in members:
            ti = tarfile.TarInfo(name=name)
            if kind == "file":
                data = payload.encode() if isinstance(payload, str) else payload
                ti.size = len(data)
                ti.type = tarfile.REGTYPE
                ti.mode = 0o644
                tf.addfile(ti, io.BytesIO(data))
            elif kind == "symlink":
                ti.type = tarfile.SYMTYPE
                ti.linkname = payload
                tf.addfile(ti)
            elif kind == "hardlink":
                ti.type = tarfile.LNKTYPE
                ti.linkname = payload
                tf.addfile(ti)
            elif kind == "dir":
                ti.type = tarfile.DIRTYPE
                ti.mode = 0o755
                tf.addfile(ti)
            else:
                raise ValueError(kind)
    buf.seek(0)
    return buf


def run_case(name, members, expect_reject):
    """Returns True if behavior matched expectation."""
    eloadout = load_eloadout()
    dest = tempfile.mkdtemp(prefix="tar_safety_")
    rejected = False
    err = ""
    try:
        with tarfile.open(fileobj=make_tar(members), mode="r") as tf:
            eloadout.safe_extract_tar(tf, dest)
    except RuntimeError as e:
        rejected = True
        err = str(e)
    except Exception as e:
        rejected = True
        err = f"{type(e).__name__}: {e}"
    finally:
        shutil.rmtree(dest, ignore_errors=True)
    if expect_reject and rejected:
        print(f"  PASS  {name}  (rejected: {err})")
        return True
    if not expect_reject and not rejected:
        print(f"  PASS  {name}  (extracted cleanly)")
        return True
    if expect_reject and not rejected:
        print(f"  FAIL  {name}  (expected rejection, got clean extract)")
        return False
    print(f"  FAIL  {name}  (expected clean extract, got rejection: {err})")
    return False


def main():
    print("tar_safety_test — synthetic tarball safety checks")
    print("")
    cases = [
        # 1. Plain file inside extraction root — must succeed.
        ("safe regular file",
            [("foo.txt", "file", "hello")],
            False),
        # 2. Absolute member path — reject.
        ("absolute member path",
            [("/etc/passwd", "file", "evil")],
            True),
        # 3. .. escape in member name — reject.
        ("dotdot escape in name",
            [("../escape.txt", "file", "evil")],
            True),
        # 4. Safe relative symlink inside extraction tree — must succeed.
        ("safe relative symlink inside tree",
            [("subdir", "dir", None),
             ("subdir/target.txt", "file", "ok"),
             ("subdir/link.txt", "symlink", "target.txt")],
            False),
        # 5. Symlink whose target escapes via .. — reject.
        ("symlink escape via dotdot",
            [("bad_link", "symlink", "../../etc/passwd")],
            True),
        # 6. Symlink to absolute path — reject.
        ("symlink escape via absolute",
            [("bad_link", "symlink", "/etc/passwd")],
            True),
        # 7. Hardlink to a path outside root — reject.
        ("hardlink escape",
            [("bad_hardlink", "hardlink", "../../etc/passwd")],
            True),
    ]

    passed = 0
    failed = 0
    for name, members, expect_reject in cases:
        if run_case(name, members, expect_reject):
            passed += 1
        else:
            failed += 1

    print("")
    print(f"{passed} passed, {failed} failed")
    sys.exit(0 if failed == 0 else 1)


if __name__ == "__main__":
    main()
