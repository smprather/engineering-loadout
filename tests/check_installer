#!/usr/bin/env bash
# Fast installer sanity checks — runs in seconds, no temp HOME needed.
# Run before commits touching the loadout installer or packages.json.
#
# Checks:
#   1. Python 3.6 syntax (EL8 /usr/bin/python3) — catches py2 except syntax etc.
#   2. doctor — registry integrity, archive presence, dep resolution
#   3. dry-run (@core-cli) — resolver sanity, verify key core packages resolve
#   4. dry-run (@engineering-loadout) — full bundled-set completeness
#   5. bare 'install' must error (no "default install" anymore)
#
# Usage:
#   ./tests/check_installer

set -euo pipefail

REPO_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
INSTALLER="$REPO_DIR/loadout"
FAILURES=0

fail() {
    echo "FAIL: $*" >&2
    FAILURES=$((FAILURES + 1))
}

pass() {
    echo "ok  : $*"
}

# ---------------------------------------------------------------------------
# 1. Python 3.6 syntax check
# ---------------------------------------------------------------------------
echo "--- 1. Python 3.6 syntax (EL8 /usr/bin/python3) ---"
SYS_PY3=/usr/bin/python3
if [[ -x "$SYS_PY3" ]]; then
    PY36_VER=$("$SYS_PY3" --version 2>&1)
    if "$SYS_PY3" -m py_compile "$INSTALLER" 2>/dev/null; then
        pass "loadout compiles under $SYS_PY3 ($PY36_VER)"
    else
        fail "loadout has syntax error under $SYS_PY3 ($PY36_VER)"
        "$SYS_PY3" -m py_compile "$INSTALLER" 2>&1 | head -5 >&2
    fi
else
    echo "skip: $SYS_PY3 not found"
fi

# ---------------------------------------------------------------------------
# 2. doctor — registry integrity
# ---------------------------------------------------------------------------
echo "--- 2. doctor ---"
DOCTOR_OUT=$(cd /tmp && "$INSTALLER" doctor 2>&1)
if echo "$DOCTOR_OUT" | grep -qiE "^ERROR|^FAIL|missing|unresolved"; then
    fail "doctor reported issues"
    echo "$DOCTOR_OUT" | grep -iE "ERROR|FAIL|missing|unresolved" >&2
else
    pass "doctor clean"
fi

# ---------------------------------------------------------------------------
# 3. dry-run @core-cli — resolver returns expected core packages
# ---------------------------------------------------------------------------
echo "--- 3. dry-run @core-cli ---"
DRY_CORE=$(cd /tmp && "$INSTALLER" install "@core-cli" --dry-run 2>&1)
REQUIRED_CORE=(bat rg eza fd jq)
for pkg in "${REQUIRED_CORE[@]}"; do
    if echo "$DRY_CORE" | grep -qE "(^|[[:space:],])${pkg}([[:space:],]|$)"; then
        pass "@core-cli resolves: $pkg"
    else
        fail "@core-cli missing: $pkg"
    fi
done

# ---------------------------------------------------------------------------
# 4. dry-run @engineering-loadout — full bundled-set completeness
# ---------------------------------------------------------------------------
echo "--- 4. dry-run @engineering-loadout ---"
DRY_FULL=$(cd /tmp && "$INSTALLER" install "@engineering-loadout" --dry-run 2>&1)

# Packages that were previously orphaned / missing from the group
REQUIRED_FULL=(nodejs modules lua-language-server octave fish ngspice nvim vim bash tmux uv)
for pkg in "${REQUIRED_FULL[@]}"; do
    if echo "$DRY_FULL" | grep -qE "(^|[[:space:],])${pkg}([[:space:],]|$)"; then
        pass "full set resolves: $pkg"
    else
        fail "full set missing: $pkg — check @engineering-loadout group"
    fi
done

FULL_COUNT=$(echo "$DRY_FULL" | grep -oE 'Resolved [0-9]+' | grep -oE '[0-9]+' || echo 0)
if [[ "$FULL_COUNT" -ge 80 ]]; then
    pass "@engineering-loadout resolves $FULL_COUNT packages (≥80)"
else
    fail "@engineering-loadout resolves only $FULL_COUNT packages — expected ≥80"
fi

# ---------------------------------------------------------------------------
# 5. bare 'install' must error (strict CLI; no default install)
# ---------------------------------------------------------------------------
echo "--- 5. bare 'install' must error ---"
if (cd /tmp && "$INSTALLER" install >/dev/null 2>&1); then
    fail "bare 'install' succeeded (should error with exit 1)"
else
    pass "bare 'install' errors as expected"
fi

# ---------------------------------------------------------------------------
# Result
# ---------------------------------------------------------------------------
echo ""
if [[ "$FAILURES" -eq 0 ]]; then
    echo "All checks passed."
    exit 0
else
    echo "$FAILURES check(s) FAILED." >&2
    exit 1
fi
