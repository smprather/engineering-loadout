#!/usr/bin/env bash
# Fast installer sanity checks — runs in seconds, no temp HOME needed.
# Run before commits touching engineering-loadout or packages.json.
#
# Checks:
#   1. Python 3.6 syntax (EL8 /usr/bin/python3) — catches py2 except syntax etc.
#   2. doctor — registry integrity, archive presence, dep resolution
#   3. dry-run (default) — resolver sanity, verify key packages resolve
#   4. dry-run (--profile engineering-loadout) — full profile completeness
#
# Usage:
#   ./tests/check_installer

set -euo pipefail

REPO_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
INSTALLER="$REPO_DIR/engineering-loadout"
FAILURES=0

fail() {
    echo "FAIL: $*" >&2
    FAILURES=$((FAILURES + 1))
}

pass() {
    echo "ok  : $*"
}

# ---------------------------------------------------------------------------
# 1. Python 3.6 syntax check
# ---------------------------------------------------------------------------
echo "--- 1. Python 3.6 syntax (EL8 /usr/bin/python3) ---"
SYS_PY3=/usr/bin/python3
if [[ -x "$SYS_PY3" ]]; then
    PY36_VER=$("$SYS_PY3" --version 2>&1)
    if "$SYS_PY3" -m py_compile "$INSTALLER" 2>/dev/null; then
        pass "engineering-loadout compiles under $SYS_PY3 ($PY36_VER)"
    else
        fail "engineering-loadout has syntax error under $SYS_PY3 ($PY36_VER)"
        "$SYS_PY3" -m py_compile "$INSTALLER" 2>&1 | head -5 >&2
    fi
else
    echo "skip: $SYS_PY3 not found"
fi

# ---------------------------------------------------------------------------
# 2. doctor — registry integrity
# ---------------------------------------------------------------------------
echo "--- 2. doctor ---"
DOCTOR_OUT=$(cd /tmp && "$INSTALLER" doctor 2>&1)
if echo "$DOCTOR_OUT" | grep -qiE "^ERROR|^FAIL|missing|unresolved"; then
    fail "doctor reported issues"
    echo "$DOCTOR_OUT" | grep -iE "ERROR|FAIL|missing|unresolved" >&2
else
    pass "doctor clean"
fi

# ---------------------------------------------------------------------------
# 3. dry-run (default) — resolver returns expected core packages
# ---------------------------------------------------------------------------
echo "--- 3. dry-run (default) ---"
DRY_DEFAULT=$(cd /tmp && "$INSTALLER" --dry-run --no-backup --skip @fonts-all 2>&1)
REQUIRED_DEFAULT=(nvim vim hx bash bat rg eza fd tmux jq uv)
for pkg in "${REQUIRED_DEFAULT[@]}"; do
    if echo "$DRY_DEFAULT" | grep -qE "(^|[[:space:],])${pkg}([[:space:],]|$)"; then
        pass "default resolves: $pkg"
    else
        fail "default missing: $pkg"
    fi
done

# Package count sanity
COUNT=$(echo "$DRY_DEFAULT" | grep -oE 'Resolved [0-9]+' | grep -oE '[0-9]+' || echo 0)
if [[ "$COUNT" -ge 50 ]]; then
    pass "default resolves $COUNT packages (≥50)"
else
    fail "default resolves only $COUNT packages — expected ≥50"
fi

# ---------------------------------------------------------------------------
# 4. dry-run (--profile engineering-loadout) — full profile completeness
# ---------------------------------------------------------------------------
echo "--- 4. dry-run (--profile engineering-loadout) ---"
DRY_FULL=$(cd /tmp && "$INSTALLER" --profile engineering-loadout --dry-run --no-backup 2>&1)

# Packages that were previously orphaned / missing from the group
REQUIRED_FULL=(nodejs modules lua-language-server octave fish ngspice)
for pkg in "${REQUIRED_FULL[@]}"; do
    if echo "$DRY_FULL" | grep -qE "(^|[[:space:],])${pkg}([[:space:],]|$)"; then
        pass "full profile resolves: $pkg"
    else
        fail "full profile missing: $pkg — check @engineering-loadout group"
    fi
done

FULL_COUNT=$(echo "$DRY_FULL" | grep -oE 'Resolved [0-9]+' | grep -oE '[0-9]+' || echo 0)
if [[ "$FULL_COUNT" -ge 80 ]]; then
    pass "full profile resolves $FULL_COUNT packages (≥80)"
else
    fail "full profile resolves only $FULL_COUNT packages — expected ≥80"
fi

# ---------------------------------------------------------------------------
# Result
# ---------------------------------------------------------------------------
echo ""
if [[ "$FAILURES" -eq 0 ]]; then
    echo "All checks passed."
    exit 0
else
    echo "$FAILURES check(s) FAILED." >&2
    exit 1
fi
