            (
                {
                    "LOADOUT_GUI_HOST_GL": "1",
                    "LOADOUT_GUI_HOST_FONTCONFIG": preload,
                    "LD_LIBRARY_PATH": "/caller/lib",
                    "LD_PRELOAD": preload,
                    "QT_QPA_PLATFORM_PLUGIN_PATH": "/caller/qt",
                    "KLAYOUT_PYTHONHOME": "/caller/python",
                    "RUBYLIB": "/caller/ruby",
                    "GEM_HOME": "/caller/gems",
                    "GEM_PATH": "/caller/gems",
