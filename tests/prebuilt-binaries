                for key, value in (defaults | values).items():
                    assert actual.get(key) == value, (
                        f"{name}: {overrides}: {key}={actual.get(key)!r}, expected {value!r}"
                    )
    print(f"  OK   (wrapper):      klayout {len(names)} launchers x {len(cases)} environment cases")


def smoke_pythonpath_launcher_wrappers(tmpdir, failures):
    """Verify uv_tool launchers that must export the tool venv's PYTHONPATH.

    LibreLane runs some of its steps as `openroad -python <script>`, and
    openroad executes those scripts with its EMBEDDED interpreter -- in this
    bundle, portable-python, which ships no click/rich/yaml. The odbpy scripts
    import all three. LibreLane's own venv has them, but a venv's site-packages
    is not on a subprocess's sys.path; only PYTHONPATH crosses that boundary.
    The installer therefore replaces uv's launcher symlink with a small sh
    wrapper that prepends the venv site-packages.

    This gate fails if the wrapper is missing (the flow would die at the first
    Odb.* step with "No module named 'click'") or if it does not point at a
    real directory (a moved/renamed venv would silently stop resolving).
    """
    bin_dir = os.path.join(tmpdir, "local", "bin")
    launcher = os.path.join(bin_dir, "librelane")
    if not os.path.exists(launcher):
        return  # librelane not installed in this tree -- nothing to check

    if os.path.islink(launcher):
        detail = "still a plain symlink; helper scripts would fail to import click"
        print(f"  FAIL (wrapper):      librelane {detail}")
        failures.append(("librelane PYTHONPATH wrapper", detail))
        return

    try:
        with open(launcher) as fh:
            text = fh.read()
    except OSError as exc:
        print(f"  FAIL (wrapper):      librelane {exc}")
        failures.append(("librelane PYTHONPATH wrapper", str(exc)))
        return

    if "_LOADOUT_PYTHONPATH_WRAPPER" not in text:
        detail = "launcher carries no loadout PYTHONPATH wrapper"
        print(f"  FAIL (wrapper):      librelane {detail}")
        failures.append(("librelane PYTHONPATH wrapper", detail))
        return

    match = re.search(r'^PYTHONPATH="([^"]+)"', text, re.M)
    if not match:
        detail = "wrapper does not export PYTHONPATH"
        print(f"  FAIL (wrapper):      librelane {detail}")
        failures.append(("librelane PYTHONPATH wrapper", detail))
        return
    site_packages = match[1]
    if not os.path.isdir(site_packages):
        detail = f"wrapper points at a missing site-packages: {site_packages}"
        print(f"  FAIL (wrapper):      librelane {detail}")
        failures.append(("librelane PYTHONPATH wrapper", detail))
        return
    for module in ("click", "rich"):
        if not os.path.isdir(os.path.join(site_packages, module)):
            detail = f"{module} absent from the wrapped site-packages ({site_packages})"
            print(f"  FAIL (wrapper):      librelane {detail}")
            failures.append(("librelane PYTHONPATH wrapper", detail))
            return

    # The wrapper must still exec something that exists.
    target = re.search(r'^exec "([^"]+)"', text, re.M)
    if not target or not os.path.isfile(target[1]):
        detail = "wrapper exec target is missing"
        print(f"  FAIL (wrapper):      librelane {detail}")
        failures.append(("librelane PYTHONPATH wrapper", detail))
        return

    print(f"  OK   (wrapper):      librelane PYTHONPATH -> {site_packages}")


def smoke_runtime_layout(tmpdir, env):
    failures = []
    bin_dir = os.path.join(tmpdir, "local", "bin")

    def has_bin(name):
        return os.path.exists(os.path.join(bin_dir, name))

    print("Smoke-testing installed runtimes...\n")

    if has_bin("nvim"):
        nvim = os.path.join(bin_dir, "nvim")
        # The install tree may be a symlink into the persistent cache; nvim
        # canonicalizes runtimepath, so compare against the real path.
        runtime = os.path.realpath(os.path.join(tmpdir, "local", "share", "nvim", "runtime"))
        if require_path(os.path.join(runtime, "filetype.lua"), "nvim runtime", failures):
            nvim_env = env.copy()
            nvim_env.update(
                {
                    "XDG_CACHE_HOME": os.path.join(tmpdir, ".cache", "nvim-smoke"),
                    "XDG_STATE_HOME": os.path.join(tmpdir, "local", "state", "nvim-smoke"),
                }
            )
            lua_check = (
                f"local expected = {runtime!r}; "
                "local rtp = vim.o.runtimepath; "
                "if not rtp:find(expected, 1, true) then "
                "vim.api.nvim_err_writeln(rtp); vim.cmd('cquit 1'); end; "
                "if vim.fn.filereadable(expected .. '/filetype.lua') ~= 1 then "
                "vim.api.nvim_err_writeln(expected); vim.cmd('cquit 1'); end"
            )
            try:
                proc = subprocess.run(
                    [nvim, "--clean", "--headless", "-n", "+lua " + lua_check, "+qa"],
                    cwd=tmpdir,
                    env=nvim_env,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    timeout=10,
                )
            except subprocess.TimeoutExpired:
                print("  FAIL (headless):     nvim runtime  timeout")
                failures.append(("nvim runtime", "headless timeout"))
            except Exception as exc:
                print(f"  FAIL (headless):     nvim runtime  {exc}")
                failures.append(("nvim runtime", str(exc)))
            else:
                if proc.returncode == 0:
                    print("  OK   (headless):     nvim runtime")
                else:
                    detail = output_excerpt(proc.stdout)
                    print(f"  FAIL (headless):     nvim runtime  {detail}")
                    failures.append(("nvim runtime", detail))

    if has_bin("vim") or has_bin("vim.bin"):
        require_path(
            os.path.join(tmpdir, "local", "share", "vim", "vim92", "filetype.vim"),
            "vim runtime",
            failures,
        )

    if has_bin("hx"):
        require_path(
            os.path.join(tmpdir, "local", "share", "helix", "runtime", "tutor"),
            "helix runtime",
            failures,
        )
        # `hx --version` exits 0 from a helix with no grammars, no queries and a
        # config it silently threw away, so the banner proves nothing. Two things
        # actually need proving on a stock node:
        #   1. the wrapper's HELIX_RUNTIME resolves to the installed tree, and the
        #      grammars + queries are really in it (a dead runtime means no
        #      highlighting anywhere, with no error);
        #   2. this helix ACCEPTS the config env-helix ships. helix parses
        #      config.toml with deny_unknown_fields -- one unrecognised key and it
        #      discards the WHOLE file for stock defaults, exiting 0. Upstream has
        #      already renamed one key we set ([editor] insecure ->
        #      [editor.workspace-trust]), so binary and config must stay in step.
        # `--health` exits 0 on a malformed config, hence the text assertions.
        grammar_dir = os.path.join(tmpdir, "local", "share", "helix", "runtime", "grammars")
        n_grammars = len(glob.glob(os.path.join(grammar_dir, "*.so")))
        if n_grammars < 200:
            detail = f"only {n_grammars} grammars in {grammar_dir}"
            print(f"  FAIL (grammars):     helix runtime  {detail}")
            failures.append(("helix runtime", detail))
        else:
            print(f"  OK   (grammars):     helix runtime ({n_grammars} parsers)")

        hx_cfg = os.path.join(tmpdir, "helix-health-cfg")
        os.makedirs(os.path.join(hx_cfg, "helix"), exist_ok=True)
        helix_env_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "envs", "helix")
        for name in ("config.toml", "languages.toml"):
            src = os.path.join(helix_env_dir, name)
            if os.path.exists(src):
                shutil.copy(src, os.path.join(hx_cfg, "helix", name))
        hx_env = dict(env, XDG_CONFIG_HOME=hx_cfg)
        try:
            proc = subprocess.run(
                [os.path.join(bin_dir, "hx"), "--health", "rust"],
                cwd=tmpdir,
                env=hx_env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=60,
            )
        except Exception as exc:
            print(f"  FAIL (health):       helix config  {exc}")
            failures.append(("helix config", str(exc)))
        else:
            out = proc.stdout.decode("utf-8", "replace")
            if "malformed" in out or "unknown field" in out:
                detail = output_excerpt(proc.stdout)
                print(f"  FAIL (health):       helix config  {detail}")
                failures.append(("helix config", detail))
            elif "Highlight queries" not in out or "✓" not in out:
                detail = output_excerpt(proc.stdout)
                print(f"  FAIL (health):       helix config  no highlight support: {detail}")
                failures.append(("helix config", detail))
            else:
                print("  OK   (health):       helix config")

    if has_bin("openroad"):
        # `openroad -version` prints "26Q3" from a binary that cannot load Tcl at
        # all -- and that is the failure most likely to ship, because openroad
        # resolves BOTH libpython3.14 and libtcl8.6 out of portable-python's lib
        # dir. portable-python owns lib/tcl8.6 at Tcl 8.6.17 and its init.tcl
        # does `package require -exact Tcl 8.6.17`, while EL8's system Tcl is
        # 8.6.8, so the two cannot be mixed in either direction. If the
        # portable-python depend is ever dropped, or RPATH stops reaching its
        # lib dir, openroad dies with "Can't find a usable init.tcl" on the
        # first real command while -version keeps printing a version.
        #
        # So: read a real LEF + DEF and query the resulting database.
        or_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "build", "openroad")
        work = os.path.join(tmpdir, "openroad-smoke")
        try:
            os.makedirs(work, exist_ok=True)
            for name in ("gscl45nm.lef", "design.def", "smoke.tcl"):
                shutil.copy(os.path.join(or_dir, name), os.path.join(work, name))
            proc = subprocess.run(
                [os.path.join(bin_dir, "openroad"), "-no_init", "-exit", "smoke.tcl"],
                cwd=work,
                env=env,
                timeout=180,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
            )
        except Exception as exc:
            print(f"  FAIL (pnr):          openroad runtime  {exc}")
            failures.append(("openroad runtime", str(exc)))
        else:
            out = proc.stdout.decode("utf-8", "replace")
            if "init.tcl" in out:
                detail = output_excerpt(proc.stdout)
                print(f"  FAIL (tcl):          openroad runtime  Tcl library unresolved: {detail}")
                failures.append(("openroad runtime", detail))
            elif "SMOKE_INSTANCES=12" not in out or "SMOKE_NETS=24" not in out:
                detail = output_excerpt(proc.stdout)
                print(f"  FAIL (pnr):          openroad runtime  {detail}")
                failures.append(("openroad runtime", detail))
            else:
                print("  OK   (pnr):          openroad  read LEF+DEF, 12 insts / 24 nets")

    if has_bin("less"):
        # less is built --with-regex=posix deliberately: the PCRE2 backend adds
        # libpcre2-8.so.0 to NEEDED, and that lib is owned by gui_libs. Coupling
        # the pager to the GUI bundle would leave a headless compute node with no
        # gui_libs installed and no working pager.
        #
        # The generic ldd probe CANNOT catch a regression here: the clean-container
        # run installs @shared, which includes gui_libs, so a PCRE2-linked less
        # resolves fine there and scores green -- and only breaks on the machines
        # this repo actually targets. build-less.sh asserts the closure, but only
        # when someone runs it.
        #
        # Unusually, `--version` is a real gate for once: less names its backend
        # in the banner ("less 704 (POSIX regular expressions)"), so a PCRE2 build
        # is visible without inspecting the ELF.
        try:
            proc = subprocess.run(
                [os.path.join(bin_dir, "less"), "--version"],
                cwd=tmpdir,
                env=env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=30,
            )
        except Exception as exc:
            print(f"  FAIL (regex):        less backend  {exc}")
            failures.append(("less backend", str(exc)))
        else:
            out = proc.stdout.decode("utf-8", "replace")
            if "POSIX regular expressions" not in out:
                detail = output_excerpt(proc.stdout)
                print(f"  FAIL (regex):        less backend  not a POSIX-regex build: {detail}")
                failures.append(("less backend", detail))
            else:
                print("  OK   (regex):        less backend (POSIX, no gui_libs coupling)")

    if has_bin("ngspice"):
        # Functional XSPICE smoke: the wrapper must find spinit via
        # SPICE_LIB_DIR and load analog.cm from lib/ngspice; --version alone
        # cannot detect a dead datadir (the modules/ngspice bug class).
        require_path(
            os.path.join(tmpdir, "local", "lib", "ngspice", "analog.cm"),
            "ngspice codemodels",
            failures,
        )
        netlist = os.path.join(tmpdir, "ngspice-xspice-smoke.cir")
        with open(netlist, "w") as fh:
            fh.write("* xspice gain smoke\nv1 1 0 1\na1 1 2 amp\n.model amp gain(gain=2.0)\nr1 2 0 1k\n.op\n.end\n")
        try:
            proc = subprocess.run(
                [os.path.join(bin_dir, "ngspice"), "-b", netlist],
                cwd=tmpdir,
                env=env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=30,
            )
        except Exception as exc:
            print(f"  FAIL (xspice):       ngspice runtime  {exc}")
            failures.append(("ngspice runtime", str(exc)))
        else:
            out = proc.stdout.decode("utf-8", "replace")
            if "Error opening code model" in out or "2.000000e+00" not in out:
                detail = output_excerpt(proc.stdout)
                print(f"  FAIL (xspice):       ngspice runtime  {detail}")
                failures.append(("ngspice runtime", detail))
            else:
                print("  OK   (xspice):       ngspice runtime")

    if has_bin("taplo"):
        # `taplo --version` is a real exit-0 banner, so the generic probe cannot
        # see the thing most likely to break: the OFFLINE JSON Schema catalog.
        # taplo's built-in catalogs are remote URLs, dead on a farm node, and a
        # dead catalog does NOT error -- it silently drops to grammar-only
        # checking and exits 0 on a file full of misspelled keys. The wrapper
        # points `lint` at the bundled catalog, whose absolute file:// URLs are
        # rewritten from a relocation token at install time; any link in that
        # chain breaking is invisible except by validating a real document.
        require_path(
            os.path.join(tmpdir, "local", "share", "taplo", "schemas", "catalog.json"),
            "taplo schema catalog",
            failures,
        )
        crate = os.path.join(tmpdir, "taplo-smoke")
        os.makedirs(crate, exist_ok=True)
        manifest = os.path.join(crate, "Cargo.toml")
        with open(manifest, "w") as fh:
            fh.write('[package]\nname = "demo"\nversion = "0.1.0"\nnot_a_real_cargo_key = 3\n')
        try:
            # Grammatically valid, schema-invalid. --no-auto-config keeps a
            # stray .taplo.toml on the build host out of the result.
            grammar = subprocess.run(
                [os.path.join(bin_dir, "taplo"), "lint", "--no-auto-config", "--no-schema", "Cargo.toml"],
                cwd=crate,
                env=env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=60,
            )
            schema = subprocess.run(
                [os.path.join(bin_dir, "taplo"), "lint", "--no-auto-config", "Cargo.toml"],
                cwd=crate,
                env=env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=60,
            )
        except Exception as exc:
            print(f"  FAIL (schema):       taplo runtime  {exc}")
            failures.append(("taplo runtime", str(exc)))
        else:
            out = schema.stdout.decode("utf-8", "replace")
            if grammar.returncode != 0:
                # The fixture must be accepted by the grammar, or a schema
                # "catch" below would just be a syntax error wearing a hat.
                detail = output_excerpt(grammar.stdout)
                print(f"  FAIL (schema):       taplo runtime  fixture is not valid TOML: {detail}")
                failures.append(("taplo runtime", detail))
            elif schema.returncode == 0 or "not_a_real_cargo_key" not in out:
                detail = output_excerpt(schema.stdout)
                print(f"  FAIL (schema):       taplo runtime  unknown Cargo.toml key not caught: {detail}")
                failures.append(("taplo runtime", detail))
            else:
                print("  OK   (schema):       taplo runtime")

    if has_bin("gtkwave"):
        # `gtkwave --version` is a real exit-0 banner, but the converters are
        # what runs in batch flows and the generic probe scores three of this
        # package's binaries green off an error message: `rtlbrowse --version`
        # exits 255 with "Could not open '--version'", which is not a fatal
        # code, so a completely broken FST reader would still pass. Prove the
        # reader and writer by round-tripping the shipped example waveform.
        examples = os.path.join(tmpdir, "local", "share", "gtkwave-gtk3", "examples")
        src_fst = os.path.join(examples, "des.fst")
        if require_path(src_fst, "gtkwave examples", failures):
            vcd = os.path.join(tmpdir, "gtkwave-des.vcd")
            fst2 = os.path.join(tmpdir, "gtkwave-des2.fst")
            try:
                with open(vcd, "wb") as fh:
                    p1 = subprocess.run(
                        [os.path.join(bin_dir, "fst2vcd"), src_fst],
                        cwd=tmpdir,
                        env=env,
                        stdout=fh,
                        stderr=subprocess.PIPE,
                        timeout=60,
                    )
                p2 = subprocess.run(
                    [os.path.join(bin_dir, "vcd2fst"), vcd, fst2],
                    cwd=tmpdir,
                    env=env,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    timeout=60,
                )
                p3 = subprocess.run(
                    [os.path.join(bin_dir, "fst2vcd"), fst2],
                    cwd=tmpdir,
                    env=env,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    timeout=60,
                )
            except Exception as exc:
                print(f"  FAIL (convert):      gtkwave runtime  {exc}")
                failures.append(("gtkwave runtime", str(exc)))
            else:
                with open(vcd, "rb") as fh:
                    vcd_bytes = fh.read()
                detail = None
                if p1.returncode != 0:
                    detail = output_excerpt(p1.stderr)
                elif b"$enddefinitions" not in vcd_bytes:
                    detail = "fst2vcd output has no $enddefinitions section"
                elif p2.returncode != 0 or not os.path.getsize(fst2):
                    detail = output_excerpt(p2.stdout) or "vcd2fst produced an empty FST"
                elif p3.returncode != 0:
                    detail = output_excerpt(p3.stdout)
                if detail:
                    print(f"  FAIL (convert):      gtkwave runtime  {detail}")
                    failures.append(("gtkwave runtime", detail))
                else:
                    print("  OK   (convert):      gtkwave runtime")

    if has_bin("btop"):
        # `btop --version` exits 0 whatever its theme directory holds, so the
        # generic probe cannot see the two failures that matter here:
        #
        #   1. btop resolves its theme directory from `/proc/self/exe` ->
        #      `<real binary>/../share/btop/themes` (src/btop.cpp, v1.4.7). A
        #      payload that installs the binary but no themes leaves btop with a
