        # or an FFmpeg bump outside Firefox's dlopen ladder all fail here.
        ff_libdir = os.path.join(tmpdir, "local", "lib", "firefox")
        check = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "build", "firefox", "check-decode.py")
        ff_env = dict(env, LD_LIBRARY_PATH=ff_libdir)
        try:
            proc = subprocess.run(
                [sys.executable, check, ff_libdir, os.path.dirname(check)],
                cwd=tmpdir,
                env=ff_env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=120,
            )
        except Exception as exc:
            print(f"  FAIL (codecs):       firefox H.264/AAC  {exc}")
            failures.append(("firefox codecs", str(exc)))
        else:
            out = proc.stdout.decode("utf-8", "replace")
            if proc.returncode == 0 and "H.264 + AAC decode OK" in out:
                print("  OK   (codecs):       firefox  H.264 + AAC decode")
            else:
                detail = output_excerpt(proc.stdout)
                print(f"  FAIL (codecs):       firefox H.264/AAC  {detail}")
                failures.append(("firefox codecs", detail))

    if not failures:
        print("Runtime payloads OK")
    print()
    return failures


def _mem_available_mb():
    """MemAvailable from /proc/meminfo, or None when unreadable."""
    try:
        with open("/proc/meminfo") as fh:
            for line in fh:
                if line.startswith("MemAvailable:"):
                    return int(line.split()[1]) // 1024
    except OSError:
        pass
    return None


def _probe_workers():
    """Probe workers scaled to free memory: each worker execs a binary and
    captures its output, so ~325 concurrent-ish probes on a memory-tight box
    can push the OOM killer. Cap at 16, drop to 4 when free memory is low."""
    mem = _mem_available_mb()
    if mem is None:
        return 16
    if mem < 2048:
        return 4
    if mem < 6144:
        return 8
    return 16


def probe_all(bin_dir, probe_env, tmpdir, tested, skipped, failures):
    """Probe every executable in bin_dir. Probes are independent, so they run
    in parallel (16 workers); the 4 s per-probe timeout budget dominates the
    sequential wall time on a box with slow-starting GUI binaries."""
    entries = []
    for fname in sorted(os.listdir(bin_dir)):
        fpath = os.path.join(bin_dir, fname)
        if not os.path.isfile(fpath) or not os.access(fpath, os.X_OK):
            continue
        entries.append((fname, fpath))

    def classify(fname, fpath):
        if is_elf(fpath):
            missing = ldd_check(fpath)
            if missing:
                host_sos = host_required_sos(missing)
                if host_sos:
                    return ("skip", f"  SKIP (host .so):     {fname:20s}  {', '.join(host_sos)}")
                return (
                    "fail",
                    f"  FAIL (ldd):          {fname:20s}  {missing[0]}",
                    (fname, "missing .so: " + "; ".join(missing)),
                )
        else:
            real, via = real_elf_for_wrapper(fpath, tmpdir)
            if real:
                host_sos = host_required_sos(ldd_check(real))
                if host_sos:
                    return ("skip", f"  SKIP (host .so):     {fname:20s}  {', '.join(host_sos)} (via {via})")

        host_command = HOST_REQUIRED_COMMANDS.get(fname)
        if host_command and not command_available(host_command[0], probe_env):
            return ("skip", f"  SKIP (host cmd):     {fname:20s}  {host_command[1]} missing")

        host_cap = HOST_REQUIRED_CAPABILITIES.get(fname)
        if host_cap and not capability_available(host_cap[0], probe_env, tmpdir):
            return ("skip", f"  SKIP (host cap):     {fname:20s}  needs {host_cap[1]}")

        if fname in NO_EXEC and is_elf(fpath):
            return ("ok", f"  OK   (ldd-only):     {fname}")

        ok, detail = probe_binary(fpath, probe_env, tmpdir)
        status = "OK:  " if ok else "FAIL:"
        if ok:
            return ("ok", f"  {status}                 {fname:20s}  {detail}")
        return ("fail", f"  {status}                 {fname:20s}  {detail}", (fname, detail))

    with concurrent.futures.ThreadPoolExecutor(max_workers=_probe_workers()) as ex:
        futs = {ex.submit(classify, fname, fpath): fname for fname, fpath in entries}
        for fut in concurrent.futures.as_completed(futs):
            result = fut.result()
            kind = result[0]
            if kind == "skip":
                skipped += 1
            elif kind == "ok":
                tested += 1
            else:
                tested += 1
                failures.append(result[2])
            print(result[1], flush=True)

    return tested, skipped, failures


@click.command(
    help="Smoke-test installed binary and runtime payloads.",
    context_settings={"help_option_names": ["-h", "--help"]},
)
@click.option("--keep", is_flag=True, help="Keep the temp install dir after testing.")
@click.option("--no-cache", is_flag=True, help="Force a fresh @shared install (ignore the persistent install tree).")
def main(keep, no_cache):
    """Smoke-test installed binary and runtime payloads.

    Runs `./loadout install @shared --dest-dir /tmp/... --no-backup` to get a
    real deployment layout, then probes each executable in <dest>/local/bin/
    with PATH limited to that bin dir plus basic system directories. Detects
    loader failures, signal crashes, "symbol lookup error" / "undefined symbol"
    in output, runtime sentinel drift, and Neovim runtime regressions.

    The install tree is cached: a persistent tree under
    ${XDG_CACHE_HOME:-~/.cache}/engineering-loadout/smoke-install-v1 is
    reused when the payload fingerprint is unchanged, so a routine re-run
    skips the ~10 minute @shared install. The probe phase always runs
    against the (possibly cached) tree. --no-cache forces a fresh install.

    Exit 0: all clean. Exit 1: failures detected (fails the pre-commit).
    """
    script_dir = os.path.dirname(os.path.abspath(__file__))
    repo_dir = os.path.dirname(script_dir)
    installer = os.path.join(repo_dir, "loadout")

    cache_root = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    install_cache = os.path.join(cache_root, "engineering-loadout", "smoke-install-v1")
    sidecar = os.path.join(install_cache, "fingerprint.json")
    fp_script = os.path.join(repo_dir, "build", "fingerprint.py")
    fp_roots = [os.path.join(repo_dir, "payload"), installer, os.path.join(repo_dir, "loadout_main.py")]

    tmpdir = tempfile.mkdtemp(prefix="loadout-smoketest-")
    try:
        os.makedirs(os.path.join(tmpdir, "home"), exist_ok=True)
        install_env = {
            "HOME": os.path.join(tmpdir, "home"),
            "PATH": BASIC_PATH,
            "LANG": os.environ.get("LANG", "C.UTF-8"),
            "TERM": "xterm-256color",
        }
        probe_env = test_env(tmpdir)

        # The install tree is NOT relocatable: the installer bakes absolute
        # paths into some artifacts (taplo's schema catalog, tealdeer's cache
        # dir), so a copied tree breaks. Instead the tree lives permanently at
        # install_cache/local and the probe scratch dir symlinks to it.
        tree = os.path.join(tmpdir, "local")
        cache_valid = (
            not no_cache
            and os.path.isfile(sidecar)
            and os.path.isdir(os.path.join(install_cache, "local", "bin"))
            and subprocess.run(
                [sys.executable, fp_script, "--fast", "--check", sidecar, "--roots", *fp_roots],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            ).returncode
            == 0
        )

        if cache_valid:
            print(f"Reusing cached install tree ({install_cache}) -- payload unchanged")
        else:
            if not no_cache:
                shutil.rmtree(install_cache, ignore_errors=True)
            os.makedirs(install_cache, exist_ok=True)
            print(f"Installing to {install_cache} ...")
            proc = subprocess.run(
                [
                    installer,
                    "install",
                    "-y",
                    "@shared",
                    "--dest-dir",
                    install_cache,
                    "--no-backup",
                ],
                env=install_env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=1200,
            )
            install_out = proc.stdout.decode("utf-8", "replace")
            if proc.returncode != 0:
                print(f"Install failed (exit {proc.returncode}):\n{install_out}")
                sys.exit(1)

        os.symlink(os.path.join(install_cache, "local"), tree)

        bin_dir = os.path.join(tree, "bin")
        if not os.path.isdir(bin_dir):
            print(f"ERROR: {bin_dir} not created by installer")
            sys.exit(1)

        print(f"Smoke-testing binaries in {bin_dir} ...\n")
        print(f"Probe PATH: {probe_env['PATH']}\n")
        failures = []
        tested = 0
        skipped = 0

        tested, skipped, failures = probe_all(bin_dir, probe_env, tmpdir, tested, skipped, failures)

        print()
        runtime_failures = smoke_runtime_layout(tmpdir, probe_env)
        failures.extend(runtime_failures)

        if failures:
            print(f"FAILED: {len(failures)} smoke checks:")
            for name, msg in failures:
                print(f"  {name}: {msg}")
            sys.exit(1)

        if not no_cache:
            subprocess.run(
                [sys.executable, fp_script, "--fast", "--write", sidecar, "--roots", *fp_roots],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )

        if skipped:
            print(f"All {tested} binaries OK ({skipped} skipped); runtimes OK")
        else:
            print(f"All {tested} binaries OK; runtimes OK")

    except subprocess.TimeoutExpired:
        print("ERROR: installer timed out")
        sys.exit(1)
    finally:
        if not keep:
            shutil.rmtree(tmpdir, ignore_errors=True)
        else:
            print(f"Kept: {tmpdir}")


if __name__ == "__main__":
    main()
