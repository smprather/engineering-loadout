                    "LD_LIBRARY_PATH": libdir + ":/caller/lib",
                    "LD_PRELOAD": None,
                    "LIBGL_DRIVERS_PATH": libdir + "/dri:/caller/dri",
                    "__EGL_VENDOR_LIBRARY_DIRS": prefix + "/share/glvnd/egl_vendor.d:/caller/egl",
                },
