                        stderr=subprocess.STDOUT,
                        timeout=60,
                    )
                except Exception as exc:
                    print(f"  FAIL (dynsym):       libpython dynsym  {exc}")
                    failures.append(("libpython dynsym", str(exc)))
                else:
                    if proc.returncode == 0:
                        print("  OK   (dynsym):       libpython .dynsym indices")
                    else:
                        detail = output_excerpt(proc.stdout)
                        print(f"  FAIL (dynsym):       libpython .dynsym indices  rc={proc.returncode} {detail}")
                        print(
