while _d not in ("", "/") and not os.path.isdir(os.path.join(_d, "installer_vendor")):
    _d = os.path.dirname(_d)
if os.path.isdir(os.path.join(_d, "installer_vendor")):
    sys.path.insert(0, os.path.join(_d, "installer_vendor"))

import rich_click as click  # noqa: E402

BASIC_PATH = "/usr/bin:/bin:/usr/sbin:/sbin"

FATAL_OUTPUT_PATTERNS = (
    "symbol lookup error",
    "undefined symbol",
    # A binary that starts but prints a known startup-failure banner is broken,
    # not OK -- expect shipped for a while printing this on every clean-EL8
    # start while the probe scored it green.
    "Tcl_Init failed",
    "Can't find a usable init.tcl",
)

HOST_REQUIRED_COMMANDS = {
    "cloc": ("perl", "host perl interpreter"),
    "meld": ("/usr/bin/python3.6", "host /usr/bin/python3.6 for EL8 PyGObject"),
    # Verilator's driver and coverage front-end are upstream Perl scripts
    # (#!/usr/bin/env perl). Perl is not bundled, same call as for cloc.
    "verilator": ("perl", "host perl interpreter for the Verilator driver"),
    "verilator_coverage": ("perl", "host perl interpreter for the Verilator driver"),
}

# Binaries that need a host CAPABILITY the loadout does not provide and cannot
# ship. Unlike HOST_REQUIRED_SOS these are not libraries -- they are kernel or
# toolkit facilities, so there is nothing to bundle and nothing to fix.
#
# Each entry is PROBED. The binary is skipped only when the probe fails, so on a
# host that has the capability it must still exit 0 -- this widens the skip set
# without weakening the gate. That distinction matters: both entries below exit
# 0 on a normal desktop and fail only in the Tier 3 container, so an
# EXPECT_NONZERO entry (which pins one exit code) would be wrong in both
# directions.
#
# Both were found by inverting the probe's pass condition to exit 0. Under the
# old rule -- anything outside {126,127,139} passes -- they were scored GREEN off
# their own error text, in every container run, for as long as they had shipped.
#
# probe argv[0] may be a bare command (resolved on the probe PATH, which puts the
# staged bin dir first) or an absolute path.
HOST_REQUIRED_CAPABILITIES = {
    "firefox": (
        ["unshare", "-U", "true"],
        "user namespaces -- firefox's sandbox calls clone(CLONE_NEWUSER) before it "
        "will even print --version, and Docker blocks that by default",
    ),
    # IDLE imports Tkinter at module scope, before it parses arguments, so it
    # cannot reach exit 0 without a loadable Tk -- not even for -h.
    "idle3": (["python3.14", "-c", "import tkinter"], "a loadable Tk for IDLE"),
    "idle3.14": (["python3.14", "-c", "import tkinter"], "a loadable Tk for IDLE"),
}

HOST_REQUIRED_SOS = {
    # GLVND/OpenGL dispatchers must come from the host display stack. Bundling
    # them can select the wrong vendor driver.
    "libGL.so.1": "host OpenGL dispatcher",
    "libGLX.so.0": "host OpenGL dispatcher",
    "libGLdispatch.so.0": "host OpenGL dispatcher",
}

# Binaries that fail/crash in headless sandboxes -- ldd-check only, skip exec.
# Each entry below has a one-line rationale.
NO_EXEC = {
    "gopls",  # LSP server -- boots via nvim; standalone --version segfaults
    # during ld.so init on the current EL8/WSL2 kernel even though
    # the binary is byte-identical to a previously-shipping release.
    # Pinned NO_EXEC until reproducible on a non-WSL2 EL8 box.
}

# Per-binary probe flags tried in order. First flag set that exits 0 wins.
#
# An entry here is required whenever a tool's working version/help flag is not
# reached by DEFAULT_PROBE -- which happens whenever an EARLIER flag in that
# list exits non-zero rather than erroring out fatally. `xterm --version` for
# example prints `bad command line option` and exits 1, so without the entry
# below the probe never reaches the `-version` that actually works.
PROBE_FLAGS = {
    "tmux": [["-V"]],
    "bzip2": [["--help"]],
    "nvim": [["--version"]],
    # X servers take single-dash options only; --version exits 1 with
    # "Unrecognized option". -help prints the usage banner and exits 0
    # without needing a parent display, so it probes cleanly headless.
    "Xephyr": [["-help"]],
    "Xephyr.bin": [["-help"]],
    "xdesk": [["--help"]],
    # --- X clients: single-dash -version, --version exits 1 ---------------
    "xterm": [["-version"]],
    "resize": [["-version"]],
    "nedit-ng": [["-V"]],
    # --- Tcl/poppler/util tools whose flag is single-dash ------------------
    # expect treats `--version` as a SCRIPT PATH and exits 1 with
    # `couldn't read file "--version"`. -version is the real flag.
    "expect": [["-version"]],
    # pdftotext reads `--version` as an input filename (I/O Error, exit 1).
    "pdftotext": [["-v"]],
    "pdftotext.bin": [["-v"]],
    "yank": [["-version"]],
    # restic has no --version FLAG; `version` is a subcommand.
    "restic": [["version"]],
    # lld is a multiplexer: bare `--version` prints "lld is a generic driver"
    # and exits 1. It needs a flavor selected before it will answer.
    "lld": [["-flavor", "gnu", "--version"]],
    # --- tools with no version flag at all; --help is the real probe -------
    "7za": [["--help"]],
    "dasel": [["--help"]],
    "idle3": [["-h"]],
    "idle3.14": [["-h"]],
    "pygwalker": [["--help"]],
    "python3-config": [["--help"]],
    "python3.14-config": [["--help"]],
    "spice-subckt-rc-reduce": [["--help"]],
    "st-reload": [["--help"]],
    "strip-ansi-escapes": [["--help"]],
    "text-serdes-dec": [["--help"]],
    "text-serdes-enc": [["--help"]],
    "time-plot": [["--help"]],
    "vcd-toggle-profiler": [["--help"]],
    "verilator_gantt": [["--help"]],
    "verilator_profcfunc": [["--help"]],
    # gtkwave batch helpers: no flags at all, bare invocation prints usage
    # and exits 0. These are the binaries that used to score green off
    # `*** Could not open '--version'` (exit 255).
    "rtlbrowse": [[]],
    "shmidcat": [[]],
}
DEFAULT_PROBE = [["--version"], ["-V"], ["-version"], ["--help"]]

# Output substrings that identify a headless-display refusal. A GUI binary
# that gets this far has loaded, resolved every .so and started running -- it
# is refusing for want of an X/Wayland display, which the probe env removes on
# purpose. Shared by the DISPLAY_REQUIRED entries in EXPECT_NONZERO below.
DISPLAY_REFUSALS = (
    "Unable to init server",
    "XOpenDisplay failed",
    "couldn't connect to display",
    "Can't open display",
    "cannot open display",
)

# Binaries with NO zero-exit invocation available.
#
# The probe's pass condition is exit 0. Before this table existed the rule was
# inverted -- ANY exit code outside {126,127,139} scored green -- so a binary
# that never ran at all passed off its own error message: gtkwave's rtlbrowse /
# shmidcat / twinwave were green off `Could not open '--version'` (exit 255)
# for as long as they had shipped. Non-zero is now accepted ONLY here, only for
# the pinned flags, only with the pinned exit code, and only when the output
# still carries the recorded pattern -- so accepting one is a written-down
# decision rather than a silent default.
#
# Entry: name -> (flags, expected_exit, (required_substrings...), why)
# expected_exit is an int, or a tuple of ints when the failure code legitimately
# varies with the environment rather than with the binary's health.
EXPECT_NONZERO = {
    # --- GUI clients: loaded fine, refusing for want of a display ----------
    "twinwave": ([], 255, DISPLAY_REFUSALS, "GTK viewer launcher; needs a display"),
    "meld": (["--version"], 1, DISPLAY_REFUSALS, "GTK diff viewer; needs a display"),
    "tkdiff": (["--version"], 1, DISPLAY_REFUSALS, "Tk diff viewer; needs a display"),
    "open-wezterm-here": (["--version"], 1, DISPLAY_REFUSALS, "wezterm-gui helper; needs a display"),
    # st prints its usage banner to stderr and exits 1 for any unknown option;
    # there is no version flag. The banner proves the binary ran.
    "st": (["--version"], 1, ("[-aiv] [-c class]",), "no version flag; usage banner proves it ran"),
    "st.bin": (["--version"], 1, ("[-aiv] [-c class]",), "no version flag; usage banner proves it ran"),
    "urxvt": (["--version"], 1, ("unknown or malformed option",), "no version flag; rejects it by name"),
    "urxvtd": (["--version"], 1, ("unknown option",), "no version flag; rejects it by name"),
    # urxvtc is a client for the urxvtd daemon and cannot reach exit 0 without
    # one. WHICH failure it hits depends on the environment, not on the
    # binary's health: exit 2 when no daemon is listening, exit 1 when the
    # socket name derived from $HOME overflows sun_path (a long temp HOME does
    # this). Both messages prove the client started and parsed its arguments,
    # so both codes are accepted -- pinning either one alone fails on the other
    # kind of host.
    "urxvtc": (
        ["--version"],
        (1, 2),
        ("socket name too long", "unable to connect to the rxvt-unicode daemon", "unknown or malformed option"),
        "daemon client; needs a running urxvtd",
    ),
    # --- flagless CLI tools whose banner proves execution ------------------
    # espresso is a 1988 Berkeley tool with no version flag; it rejects the
    # option and then prints its own release banner. Covered functionally by
    # the espresso smoke below.
    "espresso": (["--version"], 1, ("Espresso Version",), "1988 tool, no version flag; prints its release banner"),
    "false": (["--version"], 1, ("GNU coreutils",), "GNU false exits 1 unconditionally, by definition"),
    # --- servers that need a transport before they will talk ---------------
    "pyright-langserver": (
        ["--version"],
        1,
        ("Connection input stream is not set",),
        "LSP server; requires --stdio/--node-ipc to start",
    ),
    "pyright-python-langserver": (
        ["--version"],
        1,
        ("Connection input stream is not set",),
        "LSP server; requires --stdio/--node-ipc to start",
    ),
    # gocheat is a TUI; it opens /dev/tty before parsing arguments.
    "gocheat": (["--version"], 1, ("could not open a new TTY",), "TUI; opens /dev/tty before argument parsing"),
}


def test_env(tmpdir):
    """Minimal test environment: staged tools first, then basic system PATH."""
    bin_dir = os.path.join(tmpdir, "local", "bin")
    home = os.path.join(tmpdir, "home")
    env = {
        "HOME": home,
        "PATH": bin_dir + ":" + BASIC_PATH,
        "LANG": os.environ.get("LANG", "C.UTF-8"),
        "TERM": "xterm-256color",
        "XDG_CACHE_HOME": os.path.join(tmpdir, ".cache"),
        "XDG_CONFIG_HOME": os.path.join(tmpdir, ".config"),
        "XDG_DATA_HOME": os.path.join(tmpdir, "local", "share"),
        "XDG_STATE_HOME": os.path.join(tmpdir, "local", "state"),
        "DISPLAY": "",
        "WAYLAND_DISPLAY": "",
    }
    if os.environ.get("LC_ALL"):
        env["LC_ALL"] = os.environ["LC_ALL"]
    return env


def is_elf(path):
    try:
        with open(path, "rb") as fh:
            return fh.read(4) == b"\x7fELF"
    except OSError:
        return False


def command_available(command, env):
    if command.startswith("/"):
        return os.path.exists(command) and os.access(command, os.X_OK)
    for directory in env.get("PATH", "").split(os.pathsep):
        if not directory:
            continue
        candidate = os.path.join(directory, command)
        if os.path.exists(candidate) and os.access(candidate, os.X_OK):
            return True
    return False


def capability_available(argv, env, cwd):
    """Run a HOST_REQUIRED_CAPABILITIES probe; True when the capability is present.

    A missing probe binary counts as "capability absent" rather than an error:
    the point is to decide whether the tool under test can possibly work here,
    and if we cannot even ask, we must not assert that it should.
    """
    try:
        proc = subprocess.run(
            argv,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            cwd=cwd,
            env=env,
            timeout=15,
        )
    except OSError, subprocess.TimeoutExpired:
        return False
    return proc.returncode == 0


def ldd_check(path):
    ldd = "/usr/bin/ldd"
    if not os.path.isfile(ldd):
        return []
    try:
        proc = subprocess.run(
            [ldd, path],
            capture_output=True,
            timeout=5,
        )
        return [line.strip() for line in proc.stdout.decode("utf-8", "replace").splitlines() if "not found" in line]
    except OSError, subprocess.TimeoutExpired:
        return []


def missing_so_name(ldd_line):
    return ldd_line.split("=>", 1)[0].strip()


def host_required_sos(missing):
    required = []
    for line in missing:
        name = missing_so_name(line)
        reason = HOST_REQUIRED_SOS.get(name)
        if not reason:
            return []
        required.append(f"{name} ({reason})")
    return required


def output_excerpt(data, limit=400):
    if isinstance(data, bytes):
        text = data.decode("utf-8", "replace")
    else:
        text = str(data)
    text = text.strip().replace("\n", "\\n")
    if len(text) > limit:
        return text[:limit] + "..."
    return text


def real_elf_for_wrapper(wrapper_path, tmpdir):
    """Resolve the real ELF a PATH wrapper execs. Returns (path, label) or (None, None).

    Used ONLY to decide the host-required-.so skip: a wrapper is a shell script,
    so ldd says nothing about the libraries its target needs, and a container
    that legitimately lacks the host GLVND stack would score the package as a
    hard 127 failure instead of a skip.

    Two packaging conventions are covered, both already in the repo:
      bin/<name> + bin/<name>.bin        -- Xephyr, ngspice, st, surfer, ...
      bin/<name> + lib/<pkg>/<name>[.bin] -- wezterm, vcd-toggle-profiler, and
                                            klayout, whose ONE lib dir holds 13
                                            differently-named launchers
                                            (klayout + the strm* tools), so a
                                            lib/<name>/<name> guess cannot work.
      bin/<name> + lib/<pkg>/<name>-bin   -- firefox, whose real ELF is
                                            lib/firefox/firefox-bin. Upstream's
                                            suffix, not ours; without it the
                                            wrapper was exec-probed instead of
                                            resolved.
    """
    name = os.path.basename(wrapper_path)
    candidates = [(wrapper_path + ".bin", f"{name}.bin")]
    lib_root = os.path.join(tmpdir, "local", "lib")
    for pkg_dir in sorted(glob.glob(os.path.join(lib_root, "*"))):
        if not os.path.isdir(pkg_dir):
            continue
        pkg = os.path.basename(pkg_dir)
        for cand in (name, name + ".bin", name + "-bin"):
            candidates.append((os.path.join(pkg_dir, cand), f"lib/{pkg}/{cand}"))
    for path, label in candidates:
        if os.path.isfile(path) and is_elf(path):
            return path, label
    return None, None


def require_path(path, label, failures):
    if os.path.exists(path):
        print(f"  OK   (path):         {label}")
        return True
    print(f"  FAIL (path):         {label}  missing {path}")
    failures.append((label, f"missing {path}"))
    return False


def _run_probe(binary_path, flags, env, cwd):
    """Run one probe invocation. Returns (returncode, combined_output) or
    raises TimeoutExpired / OSError for the caller to classify."""
    proc = subprocess.run(
        [binary_path] + flags,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        cwd=cwd,
        env=env,
        timeout=4,
    )
    return proc.returncode, proc.stdout.decode("utf-8", "replace")


def probe_binary(binary_path, env, cwd):
    """Return (ok, detail).

    Pass condition is **exit 0**. A non-zero exit passes only via an
    EXPECT_NONZERO entry, which pins the flags, the code and a required output
    substring -- see the comment on that table for why the rule is this way
    round.
    """
    name = os.path.basename(binary_path)

    expect = EXPECT_NONZERO.get(name)
    if expect is not None:
        flags, want_code, patterns, why = expect
        want_codes = want_code if isinstance(want_code, tuple) else (want_code,)
        try:
            code, combined = _run_probe(binary_path, flags, env, cwd)
        except subprocess.TimeoutExpired:
            return False, f"expected exit {want_code}, timed out instead"
        except OSError as exc:
            return False, f"OSError: {exc}"
        for pat in FATAL_OUTPUT_PATTERNS:
            if pat in combined:
                return False, combined[:200].strip()
        if code not in want_codes:
            return False, (
                f"expected exit {'/'.join(str(c) for c in want_codes)} ({why}), got "
                f"{'signal ' + str(-code) if code < 0 else 'exit ' + str(code)}"
                f" -- {combined[:150].strip()}"
            )
        if not any(pat in combined for pat in patterns):
            return False, (
                f"exit {code} as expected but output lost its marker {patterns[0]!r} -- {combined[:150].strip()}"
            )
        return True, f"(expected exit {code}: {why})"

    flag_list = PROBE_FLAGS.get(name, DEFAULT_PROBE)
    last_code = None
    last_out = ""

    for flags in flag_list:
        try:
            code, combined = _run_probe(binary_path, flags, env, cwd)
        except subprocess.TimeoutExpired:
            return True, "(interactive -- timeout counts as OK)"
        except OSError as exc:
            return False, f"OSError: {exc}"

        last_code = code
        last_out = combined

        for pat in FATAL_OUTPUT_PATTERNS:
            if pat in combined:
                return False, combined[:200].strip()

        if code != 0:
            continue  # try the next flag set before declaring failure

        first_line = combined.split("\n")[0][:100].strip()
        return True, first_line or "(exit 0)"

    code_str = f"signal {-last_code}" if last_code is not None and last_code < 0 else f"exit {last_code}"
    return False, (
        f"no probe exited 0 (last: {code_str}) -- {last_out[:150].strip()}"
        " [add a PROBE_FLAGS or EXPECT_NONZERO entry if this is expected]"
    )


def smoke_runtime_layout(tmpdir, env):
    failures = []
    bin_dir = os.path.join(tmpdir, "local", "bin")

    def has_bin(name):
        return os.path.exists(os.path.join(bin_dir, name))

    print("Smoke-testing installed runtimes...\n")

    if has_bin("nvim"):
        nvim = os.path.join(bin_dir, "nvim")
        runtime = os.path.join(tmpdir, "local", "share", "nvim", "runtime")
        if require_path(os.path.join(runtime, "filetype.lua"), "nvim runtime", failures):
            nvim_env = env.copy()
            nvim_env.update(
                {
                    "XDG_CACHE_HOME": os.path.join(tmpdir, ".cache", "nvim-smoke"),
                    "XDG_STATE_HOME": os.path.join(tmpdir, "local", "state", "nvim-smoke"),
                }
            )
            lua_check = (
                f"local expected = {tmpdir!r} .. '/local/share/nvim/runtime'; "
                "local rtp = vim.o.runtimepath; "
                "if not rtp:find(expected, 1, true) then "
                "vim.api.nvim_err_writeln(rtp); vim.cmd('cquit 1'); end; "
                "if vim.fn.filereadable(expected .. '/filetype.lua') ~= 1 then "
                "vim.api.nvim_err_writeln(expected); vim.cmd('cquit 1'); end"
            )
            try:
                proc = subprocess.run(
                    [nvim, "--clean", "--headless", "-n", "+lua " + lua_check, "+qa"],
                    cwd=tmpdir,
                    env=nvim_env,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    timeout=10,
                )
            except subprocess.TimeoutExpired:
                print("  FAIL (headless):     nvim runtime  timeout")
                failures.append(("nvim runtime", "headless timeout"))
            except Exception as exc:
                print(f"  FAIL (headless):     nvim runtime  {exc}")
                failures.append(("nvim runtime", str(exc)))
            else:
                if proc.returncode == 0:
                    print("  OK   (headless):     nvim runtime")
                else:
                    detail = output_excerpt(proc.stdout)
                    print(f"  FAIL (headless):     nvim runtime  {detail}")
                    failures.append(("nvim runtime", detail))

    if has_bin("vim") or has_bin("vim.bin"):
        require_path(
            os.path.join(tmpdir, "local", "share", "vim", "vim92", "filetype.vim"),
            "vim runtime",
            failures,
        )

    if has_bin("hx"):
        require_path(
            os.path.join(tmpdir, "local", "share", "helix", "runtime", "tutor"),
            "helix runtime",
            failures,
        )

    if has_bin("ngspice"):
        # Functional XSPICE smoke: the wrapper must find spinit via
        # SPICE_LIB_DIR and load analog.cm from lib/ngspice; --version alone
        # cannot detect a dead datadir (the modules/ngspice bug class).
        require_path(
            os.path.join(tmpdir, "local", "lib", "ngspice", "analog.cm"),
            "ngspice codemodels",
            failures,
        )
        netlist = os.path.join(tmpdir, "ngspice-xspice-smoke.cir")
        with open(netlist, "w") as fh:
            fh.write("* xspice gain smoke\nv1 1 0 1\na1 1 2 amp\n.model amp gain(gain=2.0)\nr1 2 0 1k\n.op\n.end\n")
        try:
            proc = subprocess.run(
                [os.path.join(bin_dir, "ngspice"), "-b", netlist],
                cwd=tmpdir,
                env=env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=30,
            )
        except Exception as exc:
            print(f"  FAIL (xspice):       ngspice runtime  {exc}")
            failures.append(("ngspice runtime", str(exc)))
        else:
            out = proc.stdout.decode("utf-8", "replace")
            if "Error opening code model" in out or "2.000000e+00" not in out:
                detail = output_excerpt(proc.stdout)
                print(f"  FAIL (xspice):       ngspice runtime  {detail}")
                failures.append(("ngspice runtime", detail))
            else:
                print("  OK   (xspice):       ngspice runtime")

    if has_bin("gtkwave"):
        # `gtkwave --version` is a real exit-0 banner, but the converters are
        # what runs in batch flows and the generic probe scores three of this
        # package's binaries green off an error message: `rtlbrowse --version`
        # exits 255 with "Could not open '--version'", which is not a fatal
        # code, so a completely broken FST reader would still pass. Prove the
        # reader and writer by round-tripping the shipped example waveform.
        examples = os.path.join(tmpdir, "local", "share", "gtkwave-gtk3", "examples")
        src_fst = os.path.join(examples, "des.fst")
        if require_path(src_fst, "gtkwave examples", failures):
            vcd = os.path.join(tmpdir, "gtkwave-des.vcd")
            fst2 = os.path.join(tmpdir, "gtkwave-des2.fst")
            try:
                with open(vcd, "wb") as fh:
                    p1 = subprocess.run(
                        [os.path.join(bin_dir, "fst2vcd"), src_fst],
                        cwd=tmpdir,
                        env=env,
                        stdout=fh,
                        stderr=subprocess.PIPE,
                        timeout=60,
                    )
                p2 = subprocess.run(
                    [os.path.join(bin_dir, "vcd2fst"), vcd, fst2],
                    cwd=tmpdir,
                    env=env,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    timeout=60,
                )
                p3 = subprocess.run(
                    [os.path.join(bin_dir, "fst2vcd"), fst2],
                    cwd=tmpdir,
                    env=env,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    timeout=60,
                )
            except Exception as exc:
                print(f"  FAIL (convert):      gtkwave runtime  {exc}")
                failures.append(("gtkwave runtime", str(exc)))
            else:
                with open(vcd, "rb") as fh:
                    vcd_bytes = fh.read()
                detail = None
                if p1.returncode != 0:
                    detail = output_excerpt(p1.stderr)
                elif b"$enddefinitions" not in vcd_bytes:
                    detail = "fst2vcd output has no $enddefinitions section"
                elif p2.returncode != 0 or not os.path.getsize(fst2):
                    detail = output_excerpt(p2.stdout) or "vcd2fst produced an empty FST"
                elif p3.returncode != 0:
                    detail = output_excerpt(p3.stdout)
                if detail:
                    print(f"  FAIL (convert):      gtkwave runtime  {detail}")
                    failures.append(("gtkwave runtime", detail))
                else:
                    print("  OK   (convert):      gtkwave runtime")

    kl_real = os.path.join(tmpdir, "local", "lib", "klayout", "klayout")
    kl_host_sos = host_required_sos(ldd_check(kl_real)) if os.path.isfile(kl_real) else []
    if has_bin("klayout") and kl_host_sos:
        # KLayout NEEDs the host GLVND dispatcher even for batch work: the strm*
        # converters link the same libklayout_lay/laybasic set as the GUI, so a
        # node with no OpenGL cannot run them at all. Same host contract as
        # nedit-ng / nvim-qt / flameshot / Xephyr; the clean container has no
        # mesa-libGL, so this is a skip and not a failure.
        print(f"  SKIP (host .so):     klayout runtime  {', '.join(kl_host_sos)}")
    elif has_bin("klayout"):
        # `klayout -v` prints a compiled-in string without touching the db
        # plugins, the stream writers, or either embedded interpreter -- and all
        # 13 launchers exit 0 on --version, so the generic probe says nothing
        # about whether KLayout actually works. What must be proven is that the
        # launcher derived RUBYLIB (else the embedded ruby 3.3 loads EL8's 2.5
        # stdlib and dies) and KLAYOUT_PYTHONHOME (else libpython cannot find
        # its stdlib and aborts on "Failed to import encodings module"). Both
        # are exercised by running real batch scripts through the launcher with
        # nothing preset. -zz is batch mode, no GUI, so this runs headless.
        require_path(
            os.path.join(tmpdir, "local", "lib", "klayout", "libklayout_drc.so"),
            "klayout DRC engine",
            failures,
        )
        kl_dir = os.path.join(tmpdir, "klayout-smoke")
        os.makedirs(kl_dir, exist_ok=True)
        with open(os.path.join(kl_dir, "gen.rb"), "w") as fh:
            fh.write(
                "ly = RBA::Layout.new\n"
                'top = ly.create_cell("TOP")\n'
                "top.shapes(ly.layer(1, 0)).insert(RBA::Box.new(0, 0, 1000, 2000))\n"
                'ly.write("out.gds"); ly.write("out.oas")\n'
                "%w(out.gds out.oas).each do |f|\n"
                '  r = RBA::Layout.new; r.read(f); c = r.cell("TOP")\n'
                '  raise "#{f}: no TOP cell" unless c\n'
                "  a = c.shapes(r.layer(1, 0)).each.map { |s| s.polygon.area }.inject(0) { |x, y| x + y }\n"
                '  raise "#{f}: layer 1/0 area #{a}, expected 2000000" unless a == 2_000_000\n'
                "end\n"
                'puts "RUBY_OK"\n'
            )
        with open(os.path.join(kl_dir, "gen.py"), "w") as fh:
            fh.write(
                "import pya\n"
                "ly = pya.Layout()\n"
                'ly.create_cell("TOP").shapes(ly.layer(3, 0)).insert(pya.Box(0, 0, 100, 100))\n'
                'ly.write("py.gds")\n'
                'print("PYTHON_OK")\n'
            )
        kl_env = env.copy()
        for leak in ("RUBYLIB", "GEM_HOME", "GEM_PATH", "KLAYOUT_PYTHONHOME", "DISPLAY", "WAYLAND_DISPLAY"):
            kl_env.pop(leak, None)
        kl = os.path.join(bin_dir, "klayout")
        try:
            rb = subprocess.run(
                [kl, "-zz", "-r", "gen.rb"],
                cwd=kl_dir,
                env=kl_env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=120,
            )
            py = subprocess.run(
                [kl, "-zz", "-rm", "gen.py"],
                cwd=kl_dir,
                env=kl_env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=120,
            )
            conv = subprocess.run(
                [os.path.join(bin_dir, "strm2oas"), "out.gds", "conv.oas"],
                cwd=kl_dir,
                env=kl_env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=120,
            )
        except Exception as exc:
            print(f"  FAIL (batch):        klayout runtime  {exc}")
            failures.append(("klayout runtime", str(exc)))
        else:
            detail = None
            if rb.returncode != 0 or b"RUBY_OK" not in rb.stdout:
                detail = output_excerpt(rb.stdout)
            elif py.returncode != 0 or b"PYTHON_OK" not in py.stdout:
                detail = output_excerpt(py.stdout)
            elif conv.returncode != 0 or not os.path.getsize(os.path.join(kl_dir, "conv.oas")):
                detail = output_excerpt(conv.stdout) or "strm2oas wrote nothing"
            if detail:
                print(f"  FAIL (batch):        klayout runtime  {detail}")
                failures.append(("klayout runtime", detail))
            else:
                print("  OK   (batch):        klayout runtime")

    if has_bin("verilator") and shutil.which("perl"):
        # `verilator --version` passes even with a dead VERILATOR_ROOT, because
        # the version string is compiled into verilator_bin. What must be proven
        # is that the Perl driver resolved VERILATOR_ROOT from its own installed
        # path and found the relocated share/verilator tree. Deliberately
        # --lint-only and NOT --build: the clean container has no g++, and
        # linting still exercises root resolution + the full SV front end.
        require_path(
            os.path.join(tmpdir, "local", "share", "verilator", "include", "verilated.mk"),
            "verilator include tree",
            failures,
        )
        rtl = os.path.join(tmpdir, "verilator-smoke.v")
        with open(rtl, "w") as fh:
            fh.write(
                "module top(input logic clk, output logic [7:0] cnt);\n"
                "   always_ff @(posedge clk) cnt <= cnt + 8'd1;\n"
                "endmodule\n"
            )
        vl_env = env.copy()
        vl_env.pop("VERILATOR_ROOT", None)
        try:
            good = subprocess.run(
                [os.path.join(bin_dir, "verilator"), "--lint-only", rtl],
                cwd=tmpdir,
                env=vl_env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=60,
            )
            # A lint that cannot fail is not a lint. Prove the front end
            # actually analyzes by feeding it an undefined signal.
            bad_rtl = os.path.join(tmpdir, "verilator-smoke-bad.v")
            with open(bad_rtl, "w") as fh:
                fh.write("module bad(output logic a); assign a = no_such_signal; endmodule\n")
            bad = subprocess.run(
                [os.path.join(bin_dir, "verilator"), "--lint-only", bad_rtl],
                cwd=tmpdir,
                env=vl_env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=60,
            )
        except Exception as exc:
            print(f"  FAIL (lint):         verilator runtime  {exc}")
            failures.append(("verilator runtime", str(exc)))
        else:
            detail = None
            if good.returncode != 0:
                detail = output_excerpt(good.stdout)
            elif b"Misinstalled" in good.stdout or b"VERILATOR_ROOT" in good.stdout:
                detail = output_excerpt(good.stdout)
            elif bad.returncode == 0 or b"no_such_signal" not in bad.stdout:
                detail = "lint accepted an undefined signal: " + output_excerpt(bad.stdout)
            if detail:
                print(f"  FAIL (lint):         verilator runtime  {detail}")
                failures.append(("verilator runtime", detail))
            else:
                print("  OK   (lint):         verilator runtime")

    if has_bin("ruby"):
        # `ruby --version` proves nothing here: the interpreter starts fine even
        # when its whole stdlib is unreachable, because EL8's ruby is not built
        # --enable-load-relative and bakes /usr paths into $LOAD_PATH. What must
        # be proven is that the RELOCATED tree resolves: the stdlib, the default
        # gems whose stdlib entries were absolute symlinks into /usr, and the
        # extension gems whose .so files had to be moved to the canonical
        # rubygems layout. Also assert stderr is silent -- a permanently-printed
        # "Ignoring <gem> because its extensions are not built" is exactly the
        # known-false warning this repo refuses to ship.
        script = (
            "mods = %w[json psych yaml bigdecimal stringio digest openssl zlib erb set uri net/http];"
            "mods.each { |m| require m };"
            "print RUBY_VERSION"
        )
        try:
            proc = subprocess.run(
                [os.path.join(bin_dir, "ruby"), "-e", script],
                cwd=tmpdir,
                env=env,
                capture_output=True,
                timeout=60,
            )
        except Exception as exc:
            print(f"  FAIL (stdlib):       ruby  {exc}")
            failures.append(("ruby", str(exc)))
        else:
            out = proc.stdout.decode("utf-8", "replace").strip()
            err = proc.stderr.decode("utf-8", "replace").strip()
            if proc.returncode != 0 or not out.startswith("3."):
                detail = output_excerpt(proc.stderr or proc.stdout)
                print(f"  FAIL (stdlib):       ruby  {detail}")
                failures.append(("ruby", detail))
            elif err:
                detail = f"stderr not silent: {err.splitlines()[0][:80]}"
                print(f"  FAIL (stdlib):       ruby  {detail}")
                failures.append(("ruby", detail))
            else:
                print(f"  OK   (stdlib):       ruby {out} stdlib + default gems, stderr clean")

        # `gem` is a wrapper around a script that ships a #!/usr/bin/ruby shebang;
        # if the wrapper is wrong it silently runs the SYSTEM ruby (2.5 or none).
        # Checking the reported installation dir is what catches that.
        try:
            proc = subprocess.run(
                [os.path.join(bin_dir, "gem"), "env"],
                cwd=tmpdir,
                env=env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=60,
            )
        except Exception as exc:
            print(f"  FAIL (gem):          ruby gem  {exc}")
            failures.append(("ruby gem", str(exc)))
        else:
            out = proc.stdout.decode("utf-8", "replace")
            if proc.returncode != 0 or "INSTALLATION DIRECTORY" not in out:
                detail = output_excerpt(proc.stdout)
                print(f"  FAIL (gem):          ruby gem  {detail}")
                failures.append(("ruby gem", detail))
            elif tmpdir not in out:
                detail = "gem resolves outside the staged tree (system ruby leaked in?)"
                print(f"  FAIL (gem):          ruby gem  {detail}")
                failures.append(("ruby gem", detail))
            else:
                print("  OK   (gem):          ruby gem resolves inside the staged tree")

    if has_bin("spice-subckt-rc-reduce"):
        # Functional smoke: the tool has NO --version flag, and an exit-0 run
        # proves nothing about a reduction engine -- a mis-built binary can
        # happily parse a netlist and reduce nothing. So feed it a real RC mesh
        # and assert the node count actually drops. This 6-node chain reduces to
        # its 2 ports at a loose tau; anything that leaves >= 6 nodes means the
        # TICER elimination never ran.
        netlist = os.path.join(tmpdir, "rc-reduce-smoke.subckt")
        with open(netlist, "w") as fh:
            fh.write(
                ".subckt rcchain in out\n"
                "r1 in n1 100\nc1 n1 0 1f\n"
                "r2 n1 n2 100\nc2 n2 0 1f\n"
                "r3 n2 n3 100\nc3 n3 0 1f\n"
                "r4 n3 out 100\n"
                ".ends\n"
            )
        reduced_out = os.path.join(tmpdir, "rc-reduce-smoke.out.subckt")
        try:
            proc = subprocess.run(
                [
                    os.path.join(bin_dir, "spice-subckt-rc-reduce"),
                    netlist,
                    "-o",
                    reduced_out,
                    "--tau",
                    "1e-6",
                    "-v",
                ],
                cwd=tmpdir,
                env=env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=30,
            )
        except Exception as exc:
            print(f"  FAIL (reduce):       spice-subckt-rc-reduce  {exc}")
            failures.append(("spice-subckt-rc-reduce", str(exc)))
        else:
            out = proc.stdout.decode("utf-8", "replace")
            m = re.search(r"Nodes:\s+(\d+)\s*->\s*(\d+)", out)
            if proc.returncode != 0 or not m:
                detail = output_excerpt(proc.stdout)
                print(f"  FAIL (reduce):       spice-subckt-rc-reduce  {detail}")
                failures.append(("spice-subckt-rc-reduce", detail))
            elif int(m.group(2)) >= int(m.group(1)):
                detail = f"no reduction: {m.group(1)} -> {m.group(2)} nodes"
                print(f"  FAIL (reduce):       spice-subckt-rc-reduce  {detail}")
                failures.append(("spice-subckt-rc-reduce", detail))
            elif not os.path.isfile(reduced_out) or os.path.getsize(reduced_out) == 0:
                detail = "reduced netlist not written"
                print(f"  FAIL (reduce):       spice-subckt-rc-reduce  {detail}")
                failures.append(("spice-subckt-rc-reduce", detail))
            else:
                print(f"  OK   (reduce):       spice-subckt-rc-reduce  {m.group(1)} -> {m.group(2)} nodes")

    if has_bin("espresso"):
        # Functional smoke: espresso is a pure function, so --version-style checks
        # are meaningless -- a mis-built binary could still run and mis-reduce. Give
        # it the 3-input majority truth table and assert it minimizes to exactly 3
        # product terms (ab + ac + bc).
        pla = os.path.join(tmpdir, "espresso-majority.pla")
        with open(pla, "w") as fh:
            fh.write(".i 3\n.o 1\n011 1\n101 1\n110 1\n111 1\n.e\n")
        try:
            proc = subprocess.run(
                [os.path.join(bin_dir, "espresso"), pla],
                cwd=tmpdir,
                env=env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=15,
            )
        except Exception as exc:
            print(f"  FAIL (minimize):     espresso  {exc}")
            failures.append(("espresso", str(exc)))
        else:
            out = proc.stdout.decode("utf-8", "replace")
            if ".p 3" not in out:
                detail = output_excerpt(proc.stdout)
                print(f"  FAIL (minimize):     espresso  {detail}")
                failures.append(("espresso", detail))
            else:
                print("  OK   (minimize):     espresso")

    if has_bin("restic"):
        # Roundtrip smoke: a backup tool that runs but can't restore is worthless, and
        # `restic version` cannot detect that. init -> backup -> restore -> content match.
        rdir = os.path.join(tmpdir, "restic-smoke")
        src = os.path.join(rdir, "src")
        rec = os.path.join(rdir, "rec")
        os.makedirs(src, exist_ok=True)
        os.makedirs(rec, exist_ok=True)
        with open(os.path.join(src, "canary.txt"), "w") as fh:
            fh.write("restic-prebuilt-canary")
        renv = dict(env, RESTIC_PASSWORD="smoke", RESTIC_REPOSITORY=os.path.join(rdir, "repo"))
        rbin = os.path.join(bin_dir, "restic")
        ok = True
        for args in (["init"], ["backup", src], ["restore", "latest", "--target", rec]):
            try:
                r = subprocess.run(
                    [rbin] + args, cwd=tmpdir, env=renv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=60
                )
            except Exception as exc:
                print(f"  FAIL (roundtrip):    restic  {exc}")
                failures.append(("restic", str(exc)))
                ok = False
                break
            if r.returncode != 0:
                d = output_excerpt(r.stdout)
                print(f"  FAIL (roundtrip):    restic  {d}")
                failures.append(("restic", d))
                ok = False
                break
        if ok:
            found = subprocess.run(["grep", "-qr", "restic-prebuilt-canary", rec]).returncode == 0
            if found:
                print("  OK   (roundtrip):    restic")
            else:
                print("  FAIL (roundtrip):    restic  restored content mismatch")
                failures.append(("restic", "restore mismatch"))

    if has_bin("jupyter-lab"):
        # The jupyterlab wheel also declares a `jupyter-labhub` console script,
        # which imports jupyterhub -- a multi-user server this bundle
        # deliberately does not ship. Left in place it is a permanently-broken
        # command on the user's PATH that dies with "No module named
        # 'jupyterhub'", and the generic probe scored it green because it exits
        # 1. The installer prunes it; assert it stayed pruned.
        if has_bin("jupyter-labhub"):
            detail = "dead jupyter-labhub launcher was not pruned (needs unbundled jupyterhub)"
            print(f"  FAIL (launcher):     jupyterlab  {detail}")
            failures.append(("jupyterlab", detail))
        else:
            print("  OK   (launcher):     jupyterlab  dead jupyter-labhub launcher pruned")

    if has_bin("pdftotext"):
        # CJK extraction via bundled poppler-data: a predefined-CMap PDF with
        # no ToUnicode map is silent garbage without the data files (the
        # wrapper must export POPPLER_DATADIR at the install prefix).
        require_path(
            os.path.join(tmpdir, "local", "share", "poppler", "cidToUnicode", "Adobe-Japan1"),
            "pdftotext poppler-data",
            failures,
        )
        smoke_pdf = os.path.join(tmpdir, "cjk-smoke.pdf")
        gen = os.path.join(
            os.path.dirname(os.path.abspath(__file__)), "..", "build", "pdftotext", "make-cjk-smoke-pdf.py"
        )
        try:
            subprocess.run([sys.executable, gen, smoke_pdf], check=True, timeout=30)
            proc = subprocess.run(
                [os.path.join(bin_dir, "pdftotext"), smoke_pdf, "-"],
                cwd=tmpdir,
                env=env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=30,
            )
        except Exception as exc:
            print(f"  FAIL (cjk):          pdftotext runtime  {exc}")
            failures.append(("pdftotext runtime", str(exc)))
        else:
            out = proc.stdout.decode("utf-8", "replace")
            if "あい" in out and "Missing language pack" not in out:
                print("  OK   (cjk):          pdftotext runtime")
            else:
                detail = output_excerpt(proc.stdout)
                print(f"  FAIL (cjk):          pdftotext runtime  {detail}")
                failures.append(("pdftotext runtime", detail))

    if has_bin("markdown-oxide"):
        # `markdown-oxide --version` exits 0 from a binary that cannot resolve a
        # single wikilink, and the generic probe would score that green. Drive
        # the real protocol instead (initialize -> didOpen -> definition against
        # a temp .obsidian vault) -- same reasoning as the pdftotext CJK probe
        # above. This is what makes envs/nvim/lsp/markdown_oxide.lua worth
        # shipping; without it the LSP config is inert.
        smoke = os.path.join(
            os.path.dirname(os.path.abspath(__file__)), "..", "build", "markdown-oxide", "lsp-smoke.py"
        )
        try:
            proc = subprocess.run(
                [sys.executable, smoke, os.path.join(bin_dir, "markdown-oxide")],
                cwd=tmpdir,
                env=env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=120,
            )
        except Exception as exc:
            print(f"  FAIL (lsp):          markdown-oxide  {exc}")
            failures.append(("markdown-oxide", str(exc)))
        else:
            if proc.returncode == 0:
                print("  OK   (lsp):          markdown-oxide  wikilink resolved")
            else:
                detail = output_excerpt(proc.stdout)
                print(f"  FAIL (lsp):          markdown-oxide  {detail}")
                failures.append(("markdown-oxide", detail))

    if has_bin("python3.14"):
        # Display-free Tcl interp smoke: the bundle's sitecustomize must point
        # TCL_LIBRARY at the shipped lib/tcl8.6 tree (a stale/clobbered tree
        # fails init.tcl's `package require -exact`). Needs host X client libs
        # only to import _tkinter (libtk links libX11); skip on hosts without
        # them, same contract as the GL-linked GUI apps.
        try:
            proc = subprocess.run(
                [
                    os.path.join(bin_dir, "python3.14"),
                    "-c",
                    "import tkinter; print('TKINTER_OK', tkinter.Tcl().eval('info patchlevel'))",
                ],
                cwd=tmpdir,
                env=env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=30,
            )
        except Exception as exc:
            print(f"  FAIL (tkinter):      python tkinter  {exc}")
            failures.append(("python tkinter", str(exc)))
        else:
            out = proc.stdout.decode("utf-8", "replace")
            if "TKINTER_OK" in out:
                print("  OK   (tkinter):      python tkinter")
            elif "ImportError" in out and ("libX" in out or "libfontconfig" in out):
                print("  SKIP (host .so):     python tkinter  host X client libs missing")
            else:
                detail = output_excerpt(proc.stdout)
                print(f"  FAIL (tkinter):      python tkinter  {detail}")
                failures.append(("python tkinter", detail))

    parsers = os.path.join(tmpdir, "local", "share", "nvim", "tree-sitter-parsers")
    if os.path.isdir(parsers):
        require_path(os.path.join(parsers, "parser", "python.so"), "tree-sitter python parser", failures)
        require_path(os.path.join(parsers, "queries", "python", "highlights.scm"), "tree-sitter python query", failures)
        require_path(os.path.join(parsers, "parser-info", "python.lua"), "tree-sitter python parser-info", failures)

    if not failures:
        print("Runtime payloads OK")
    print()
    return failures


@click.command(
    name="prebuilt-binaries",
    context_settings={"help_option_names": ["-h", "--help"]},
)
@click.option("--keep", is_flag=True, help="Keep the temp install dir after testing.")
def main(keep):
    """Smoke-test installed binary and runtime payloads.

    Runs `./loadout install @shared --dest-dir /tmp/... --no-backup` to get a
    real deployment layout, then probes each executable in <dest>/local/bin/
    with PATH limited to that bin dir plus basic system directories. Detects
    loader failures, signal crashes, "symbol lookup error" / "undefined symbol"
    in output, runtime sentinel drift, and Neovim runtime regressions.

    Exit 0: all clean. Exit 1: failures detected (fails the pre-commit).
    """
    script_dir = os.path.dirname(os.path.abspath(__file__))
    repo_dir = os.path.dirname(script_dir)
    installer = os.path.join(repo_dir, "loadout")

    tmpdir = tempfile.mkdtemp(prefix="loadout-smoketest-")
    try:
        os.makedirs(os.path.join(tmpdir, "home"), exist_ok=True)
        install_env = {
            "HOME": os.path.join(tmpdir, "home"),
            "PATH": BASIC_PATH,
            "LANG": os.environ.get("LANG", "C.UTF-8"),
            "TERM": "xterm-256color",
        }
        probe_env = test_env(tmpdir)

        print(f"Installing to {tmpdir} ...")
        proc = subprocess.run(
            [
                installer,
                "install",
                "@shared",
                "--dest-dir",
                tmpdir,
                "--no-backup",
            ],
            env=install_env,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=1200,
        )
        install_out = proc.stdout.decode("utf-8", "replace")
        if proc.returncode != 0:
            print(f"Install failed (exit {proc.returncode}):\n{install_out}")
            sys.exit(1)

        bin_dir = os.path.join(tmpdir, "local", "bin")
        if not os.path.isdir(bin_dir):
            print(f"ERROR: {bin_dir} not created by installer")
            sys.exit(1)

        print(f"Smoke-testing binaries in {bin_dir} ...\n")
        print(f"Probe PATH: {probe_env['PATH']}\n")
        failures = []
        tested = 0
        skipped = 0

        for fname in sorted(os.listdir(bin_dir)):
            fpath = os.path.join(bin_dir, fname)
            if not os.path.isfile(fpath) or not os.access(fpath, os.X_OK):
                continue

            if is_elf(fpath):
                missing = ldd_check(fpath)
                if missing:
                    host_sos = host_required_sos(missing)
                    if host_sos:
                        print(f"  SKIP (host .so):     {fname:20s}  {', '.join(host_sos)}")
                        skipped += 1
                        continue
                    msg = "missing .so: " + "; ".join(missing)
                    print(f"  FAIL (ldd):          {fname:20s}  {missing[0]}")
                    failures.append((fname, msg))
                    continue
            else:
                # A wrapper cannot be ldd-checked, so exec'ing it in a container
                # that legitimately lacks the host GLVND stack reports 127 for a
                # package that is fine. Resolve the real ELF for the host-.so
                # skip decision only: when anything is missing that is NOT
                # host-required, fall through to the normal exec probe so real
                # breakage still surfaces.
                real, via = real_elf_for_wrapper(fpath, tmpdir)
                if real:
                    host_sos = host_required_sos(ldd_check(real))
                    if host_sos:
                        print(f"  SKIP (host .so):     {fname:20s}  {', '.join(host_sos)} (via {via})")
                        skipped += 1
                        continue

            host_command = HOST_REQUIRED_COMMANDS.get(fname)
            if host_command and not command_available(host_command[0], probe_env):
                print(f"  SKIP (host cmd):     {fname:20s}  {host_command[1]} missing")
                skipped += 1
                continue

            host_cap = HOST_REQUIRED_CAPABILITIES.get(fname)
            if host_cap and not capability_available(host_cap[0], probe_env, tmpdir):
                print(f"  SKIP (host cap):     {fname:20s}  needs {host_cap[1]}")
                skipped += 1
                continue

            if fname in NO_EXEC and is_elf(fpath):
                print(f"  OK   (ldd-only):     {fname}")
                tested += 1
                continue

            tested += 1
            ok, detail = probe_binary(fpath, probe_env, tmpdir)
            status = "OK:  " if ok else "FAIL:"
            print(f"  {status}                 {fname:20s}  {detail}")
            if not ok:
                failures.append((fname, detail))

        print()
        runtime_failures = smoke_runtime_layout(tmpdir, probe_env)
        failures.extend(runtime_failures)

        if failures:
            print(f"FAILED: {len(failures)} smoke checks:")
            for name, msg in failures:
                print(f"  {name}: {msg}")
            sys.exit(1)

        if skipped:
            print(f"All {tested} binaries OK ({skipped} skipped); runtimes OK")
        else:
            print(f"All {tested} binaries OK; runtimes OK")

    except subprocess.TimeoutExpired:
        print("ERROR: installer timed out")
        sys.exit(1)
    finally:
        if not keep:
            shutil.rmtree(tmpdir, ignore_errors=True)
        else:
            print(f"Kept: {tmpdir}")


if __name__ == "__main__":
    main()
