        except Exception as exc:
            print(f"  FAIL (lsp):          spice-netlist-ls  {exc}")
            failures.append(("spice-netlist-ls", str(exc)))
            proc = None
        if proc is not None:
            out = proc.stdout.decode("utf-8", "replace")
            if (
