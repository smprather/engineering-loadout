#!/usr/bin/env python3
"""Unit tests for install font installation.

Covers split-zip rejoining, fonts-dir preparation (symlink policy, directory
backup/no-backup behavior) and the shared-tree destination (fonts + generated
fontconfig snippet) without requiring the real vendored font archives.
"""

import importlib.machinery
import importlib.util
import io
import os
import shutil
import tempfile
import zipfile

REPO_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
INSTALL_PATH = os.path.join(REPO_DIR, "loadout_main.py")
LOADER = importlib.machinery.SourceFileLoader("loadout_install", INSTALL_PATH)
SPEC = importlib.util.spec_from_loader(LOADER.name, LOADER)
install = importlib.util.module_from_spec(SPEC)
LOADER.exec_module(install)


def make_split_font_zip(fonts_dir, base_name, chunk_size=20):
    """Write a valid zip with one .ttf entry, split into chunk_size-byte parts."""
    buf = io.BytesIO()
    with zipfile.ZipFile(buf, "w", compression=zipfile.ZIP_STORED) as zf:
        zf.writestr("dummy.ttf", b"FAKE TTF DATA " * 10)
    data = buf.getvalue()

    i = 0
    offset = 0
    while offset < len(data):
        part_path = os.path.join(fonts_dir, f"{base_name}.part-{i:03d}")
        with open(part_path, "wb") as fh:
            fh.write(data[offset : offset + chunk_size])
        offset += chunk_size
        i += 1

    return i  # number of parts written


def make_repo(tmp_dir):
    repo_dir = os.path.join(tmp_dir, "repo")
    fonts_dir = os.path.join(repo_dir, "payload", "fonts")
    os.makedirs(fonts_dir)
    make_split_font_zip(fonts_dir, "TestFont.zip", chunk_size=20)
    return repo_dir


def user_fonts_dir(home):
    return os.path.join(install._local_root(home), "share", "fonts")


def test_split_zip_rejoin():
    tmp = tempfile.mkdtemp(prefix="test-fonts.")
    try:
        repo_dir = make_repo(tmp)
        home = os.path.join(tmp, "home")
        os.makedirs(home)

        install.install_fonts(repo_dir, home)

        ufd = user_fonts_dir(home)
        installed = os.listdir(ufd) if os.path.isdir(ufd) else []
        assert "dummy.ttf" in installed, f"Expected dummy.ttf in {ufd}; got: {installed}"
        print("PASS: split-zip rejoin -> dummy.ttf")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def test_foreign_symlink_preserved():
    """A user-made fonts symlink (e.g. -> a shared tree) is the intended way to
    share fonts; the installer must not delete the link or write its target."""
    tmp = tempfile.mkdtemp(prefix="test-fonts.")
    try:
        repo_dir = make_repo(tmp)
        home = os.path.join(tmp, "home")
        ufd = user_fonts_dir(home)
        os.makedirs(os.path.dirname(ufd))

        link_target = os.path.join(tmp, "shared-fonts")
        os.makedirs(link_target)
        open(os.path.join(link_target, "shared.ttf"), "w").close()
        os.symlink(link_target, ufd)

        install.install_fonts(repo_dir, home)

        assert os.path.islink(ufd), "foreign fonts symlink must be preserved"
        assert os.path.realpath(ufd) == link_target
        assert os.listdir(link_target) == ["shared.ttf"], "symlink target must not be written"
        print("PASS: foreign fonts symlink preserved, target untouched")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def test_repo_pointing_symlink_replaced():
    """A symlink that resolves into the repo is stale/unsafe (extraction would
    write into the source tree); it is removed and replaced with a real dir."""
    tmp = tempfile.mkdtemp(prefix="test-fonts.")
    try:
        repo_dir = make_repo(tmp)
        home = os.path.join(tmp, "home")
        ufd = user_fonts_dir(home)
        os.makedirs(os.path.dirname(ufd))

        os.symlink(os.path.join(repo_dir, "payload", "fonts"), ufd)

        install.install_fonts(repo_dir, home)

        assert not os.path.islink(ufd), "repo-pointing symlink should have been removed"
        assert "dummy.ttf" in os.listdir(ufd), "dummy.ttf should be installed"
        print("PASS: repo-pointing symlink replaced with real directory")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def test_dangling_symlink_replaced():
    tmp = tempfile.mkdtemp(prefix="test-fonts.")
    try:
        repo_dir = make_repo(tmp)
        home = os.path.join(tmp, "home")
        ufd = user_fonts_dir(home)
        os.makedirs(os.path.dirname(ufd))

        os.symlink(os.path.join(tmp, "gone"), ufd)

        install.install_fonts(repo_dir, home)

        assert not os.path.islink(ufd), "dangling symlink should have been removed"
        assert "dummy.ttf" in os.listdir(ufd), "dummy.ttf should be installed"
        print("PASS: dangling symlink replaced with real directory")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def test_shared_tree_fonts_and_snippet():
    """shared_root installs fonts once into the tree and writes the fontconfig
    snippet the shell layer points FONTCONFIG_FILE at -- the user home stays empty."""
    tmp = tempfile.mkdtemp(prefix="test-fonts.")
    try:
        repo_dir = make_repo(tmp)
        home = os.path.join(tmp, "home")
        shared = os.path.join(tmp, "shared-tree")
        os.makedirs(shared)

        install.install_fonts(repo_dir, home, shared_root=shared)

        shared_fonts = os.path.join(shared, "share", "fonts")
        assert "dummy.ttf" in os.listdir(shared_fonts), f"fonts should land in {shared_fonts}"
        conf = os.path.join(shared, "etc", "fonts", "loadout-fonts.conf")
        text = open(conf).read()
        assert f"<dir>{shared_fonts}</dir>" in text, text
        assert "/etc/fonts/fonts.conf" in text, "snippet must re-include the system config"
        assert not os.path.exists(home), "shared install must not write the user home"
        print("PASS: shared tree got fonts + fontconfig snippet, home untouched")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def test_shared_tree_symlink_skips_snippet():
    """When the shared fonts path is a foreign symlink (fonts already managed
    elsewhere) nothing is written and no snippet advertises an unpopulated dir."""
    tmp = tempfile.mkdtemp(prefix="test-fonts.")
    try:
        repo_dir = make_repo(tmp)
        home = os.path.join(tmp, "home")
        shared = os.path.join(tmp, "shared-tree")
        shared_fonts = os.path.join(shared, "share", "fonts")
        os.makedirs(os.path.dirname(shared_fonts))

        link_target = os.path.join(tmp, "big-scratch-fonts")
        os.makedirs(link_target)
        os.symlink(link_target, shared_fonts)

        install.install_fonts(repo_dir, home, shared_root=shared)

        assert os.path.islink(shared_fonts), "foreign symlink must be preserved"
        assert os.listdir(link_target) == [], "symlink target must not be written"
        assert not os.path.exists(os.path.join(shared, "etc", "fonts", "loadout-fonts.conf"))
        print("PASS: shared-tree symlink preserved, no snippet written")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def test_existing_dir_backed_up():
    tmp = tempfile.mkdtemp(prefix="test-fonts.")
    try:
        repo_dir = make_repo(tmp)
        home = os.path.join(tmp, "home")
        ufd = user_fonts_dir(home)
        os.makedirs(ufd)

        # Pre-populate fonts dir with a sentinel file
        sentinel = os.path.join(ufd, "old-font.ttf")
        open(sentinel, "w").close()

        install.install_fonts(repo_dir, home)

        backup = ufd + ".bak"
        assert os.path.isdir(backup), f"Old fonts dir should be backed up to {backup}"
        assert os.path.exists(os.path.join(backup, "old-font.ttf")), "Sentinel file should be in backup"
        assert os.path.isdir(ufd), "Fresh fonts dir should exist"
        assert "dummy.ttf" in os.listdir(ufd), "dummy.ttf should be installed"
        print("PASS: existing fonts dir backed up, new dir populated")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def test_existing_dir_backup_numbering():
    tmp = tempfile.mkdtemp(prefix="test-fonts.")
    try:
        repo_dir = make_repo(tmp)
        home = os.path.join(tmp, "home")
        ufd = user_fonts_dir(home)
        os.makedirs(ufd)
        # Pre-create .bak so numbering kicks in
        os.makedirs(ufd + ".bak")

        install.install_fonts(repo_dir, home)

        assert os.path.isdir(ufd + ".bak.1"), "Second backup should use .bak.1 when .bak already exists"
        print("PASS: backup numbering works when .bak already exists")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def test_existing_dir_no_backup_reused():
    tmp = tempfile.mkdtemp(prefix="test-fonts.")
    try:
        repo_dir = make_repo(tmp)
        home = os.path.join(tmp, "home")
        ufd = user_fonts_dir(home)
        os.makedirs(ufd)

        sentinel = os.path.join(ufd, "old-font.ttf")
        open(sentinel, "w").close()

        install.install_fonts(repo_dir, home, no_backup=True)

        assert not os.path.exists(ufd + ".bak"), "no_backup should not create a fonts backup"
        assert os.path.exists(sentinel), "Existing font files should remain when reusing the dir"
        assert "dummy.ttf" in os.listdir(ufd), "dummy.ttf should be installed"
        print("PASS: existing fonts dir reused with no_backup")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


if __name__ == "__main__":
    test_split_zip_rejoin()
    test_foreign_symlink_preserved()
    test_repo_pointing_symlink_replaced()
    test_dangling_symlink_replaced()
    test_shared_tree_fonts_and_snippet()
    test_shared_tree_symlink_skips_snippet()
    test_existing_dir_backed_up()
    test_existing_dir_backup_numbering()
    test_existing_dir_no_backup_reused()
    print("All font tests passed.")
