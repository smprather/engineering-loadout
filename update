#!/usr/bin/env python3
"""update — per-package updater for engineering-loadout.

Usage:
  ./update                        run all automated packages (no commit)
  ./update nodejs yara-rules      run specific automated packages
  ./update nvim bat rg            show update guidance for those packages
  ./update --list                 table: package | kind | version | description
  ./update --commit               stage + commit automated output
  ./update --dry-run              print commands without executing
  ./update --tag vX.Y.Z          version hint for nodejs and yara-rules
"""

from __future__ import print_function

import argparse
import json
import os
import subprocess
import sys

REPO = os.path.dirname(os.path.abspath(__file__))
BUILD = os.path.join(REPO, "pre_built", "build_scripts")


# ── package registry ──────────────────────────────────────────────────────────

# Fully automated: ./update runs a script end-to-end.
# Dev-only repo artifacts (yara-rules, tldr-data, tmux-plugins) are not
# end-user-installed packages but are vendored into the repo by the dev and
# bundled into the installer; they live alongside installable packages here.
AUTOMATED = {
    "yara-rules": {
        "supports_tag": True,
        "git_paths": ["yara/"],
        "desc": "Vendored YARA-Forge full ruleset (yara/yara-rules-full.yar.bz2)",
    },
    "nodejs": {
        "supports_tag": True,
        "git_paths": ["pre_built/", ".strip-manifest", "packages.json"],
    },
    "tldr-data": {
        "git_paths": ["tldr/"],
    },
    "tmux-plugins": {
        "git_paths": ["tmux/vendor/plugins/"],
        "desc": "Vendored tmux plugins (tmux/vendor/plugins/)",
    },
}

# Build-script: requires EL8 build machine.  script lives in BUILD/.
BUILD_SCRIPTS = {
    "fish": {"script": "build-fish.sh", "runtime": "fish.tar.bz2"},
    "gvim": {"script": "build-gvim.sh", "runtime": "vim92.tar.bz2"},
    "jq": {"script": "build-jq.sh"},
    "kak": {"script": "build-kakoune.sh"},
    "micro": {"script": "build-micro.sh"},
    "ncdu": {"script": "build-ncdu.sh"},
