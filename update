RUNNERS = {
    "tldr": run_tldr,
    "tmux-plugins": run_tmux_plugins,
    "yara": run_yara,
    "nodejs": run_nodejs,
    "binaries": show_binaries,
    "runtimes": show_runtimes,
}

# Paths to git-add for each automated item
ITEM_GIT_PATHS = {
    "tldr": ["tldr/"],
    "tmux-plugins": ["tmux/vendor/plugins/"],
    "yara": ["yara/"],
    "nodejs": ["pre_built/", ".strip-manifest", "packages.json"],
}


# ── git commit ────────────────────────────────────────────────────────────────


def git_commit(items_run, dry_run=False):
    paths = []
    for item in items_run:
        for p in ITEM_GIT_PATHS.get(item, []):
            if os.path.exists(os.path.join(REPO, p)):
                paths.append(p)

    if not paths:
        return

    _sep("git commit")
    status = (
        subprocess.check_output(
            ["git", "status", "--porcelain"] + paths,
            cwd=REPO,
        )
        .decode("utf-8")
        .strip()
    )
    if not status:
        print("No changes detected — nothing to commit.")
        return

    msg = "chore: update {}\n\nUpdated by ./update:\n{}".format(
        ", ".join(items_run),
        "\n".join("  - " + i for i in items_run),
    )
    print()
    rc = _run(["git", "add"] + paths, dry_run)
    if rc != 0 and not dry_run:
        print("WARNING: git add failed rc={}".format(rc))
        return
    _run(["git", "commit", "-m", msg], dry_run)


# ── subcommands ───────────────────────────────────────────────────────────────


def cmd_list():
    col_w = [14, 8]
    fmt = "{:<{}} {:<{}} {}"
    print(fmt.format("ITEM", col_w[0], "KIND", col_w[1], "DESCRIPTION"))
    print("─" * 72)
    for name in ITEMS_ORDERED:
        info = ITEMS[name]
        print(fmt.format(name, col_w[0], info["kind"], col_w[1], info["desc"]))


# ── main ──────────────────────────────────────────────────────────────────────


def main():
    ap = argparse.ArgumentParser(
        prog="update",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument(
        "items",
        nargs="*",
        metavar="ITEM",
        help="items to run (default: all automated); choices: {}".format(", ".join(ITEMS_ORDERED)),
    )
    ap.add_argument("--list", action="store_true", help="show item table and exit")
    ap.add_argument("--dry-run", action="store_true", help="print commands without executing")
    ap.add_argument("--no-commit", action="store_true", help="skip git commit (commit is default)")
    ap.add_argument(
        "--tag", default=None, metavar="VERSION", help="version hint for sub-updaters that support it (nodejs, yara)"
    )
    args = ap.parse_args()

    if args.list:
        cmd_list()
        return

    items = args.items if args.items else AUTO_DEFAULT

    unknown = [i for i in items if i not in ITEMS]
    if unknown:
        ap.error("unknown item(s): {}  (choices: {})".format(", ".join(unknown), ", ".join(ITEMS_ORDERED)))

    auto_succeeded = []
    all_ok = True
    for item in items:
        ok = RUNNERS[item](dry_run=args.dry_run, tag=args.tag)
        if ITEMS[item]["kind"] == "auto":
            (auto_succeeded if ok else []).append(item)
            if not ok:
                all_ok = False

    if not args.no_commit and auto_succeeded:
        git_commit(auto_succeeded, dry_run=args.dry_run)

    _sep()
    if args.dry_run:
        print("Dry-run complete.")
    elif all_ok:
        print("Done.")
    else:
        print("Done (some items failed — see warnings above).")
        sys.exit(1)


if __name__ == "__main__":
    main()
