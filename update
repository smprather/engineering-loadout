    print(f"     objdump -T {name} | awk '/GLIBC/{{print $5}}' | sort -Vr | head -1")
    print(f"     patchelf --set-rpath '$ORIGIN/../lib64:$ORIGIN/../lib' {name}")
    print(f"     bzip2 -k {name}")
    print(f"  2. cp {name}.bz2 pre_built/el8.x86_64.glibc2p28/bin/")
    print("  3. ./strip_all_elf_binaries")
    print("  4. git add pre_built/ .strip-manifest packages.json")


# -- --list --------------------------------------------------------------------


def _fetch_latest_map():
    """Run check-versions --format tsv; return {name: latest_version_str}."""
    cv = os.path.join(BUILD, "check-versions")
    if not os.path.isfile(cv):
        return {}
    try:
        out = subprocess.check_output(
            [sys.executable, cv, "--format", "tsv"],
            cwd=REPO,
            timeout=60,
            stderr=subprocess.DEVNULL,
        ).decode("utf-8")
    except Exception:
        return {}
    result = {}
    for line in out.splitlines()[1:]:
        parts = line.split("\t")
        if len(parts) >= 3 and parts[0] and parts[2]:
            status = parts[4] if len(parts) >= 5 else ""
            result[parts[0]] = (parts[2], status)
    return result


def cmd_list(outdated_only=False):
    latest_map = _fetch_latest_map()
    rolling_latest = {n: _remote_head_short(u) for n, u in ROLLING_GIT.items()}
    rows = []

    for name in sorted(ROLLING_GIT):
        rows.append((name, "rolling-git", _pkg_version(name)))

    for name in AUTOMATED:
        tag_note = " (--tag)" if AUTOMATED[name].get("supports_tag") else ""
        rows.append((name, "automated" + tag_note, _pkg_version(name)))

    for name in sorted(BUILD_SCRIPTS):
        runtime = BUILD_SCRIPTS[name].get("runtime", "")
        kind = "build" + (" +runtime" if runtime else "")
        rows.append((name, kind, _pkg_version(name)))

    for name in sorted(IMPORT_SCRIPTS):
        rows.append((name, "import-script", _pkg_version(name)))

    dl_names = DOWNLOAD_ONLY | {k for k, v in PACKAGES.items() if not k.startswith("@") and v.get("kind") == "bin"}
    dl = sorted(n for n in dl_names if n not in AUTOMATED and n not in BUILD_SCRIPTS and n not in IMPORT_SCRIPTS)
    for name in dl:
        rows.append((name, "download", _pkg_version(name)))

    col = [20, 16, 12]
    hdr = "{:<{}} {:<{}} {:<{}} {}".format("PACKAGE", col[0], "KIND", col[1], "VERSION", col[2], "LATEST")
    print(hdr)
    print("-" * 72)
    for name, kind, ver in rows:
        if name in ROLLING_GIT:
            raw_latest = rolling_latest.get(name, "")
            up_to_date = bool(raw_latest) and raw_latest in (ver or "")
            if outdated_only and (not raw_latest or up_to_date):
                continue
            lstr = raw_latest or "-"
        else:
            raw_latest, status = latest_map.get(name, ("", ""))
            if outdated_only and (not raw_latest or raw_latest == ver):
                continue
            lstr = raw_latest.lstrip("v") if raw_latest else "-"
            # Non-homogeneous version/latest -- the upstream resolver almost
            # certainly mis-parsed; flag it instead of showing a bogus delta.
            if status == "mismatch":
                lstr = lstr + "   !! version/latest format differ -- check resolver"
        vstr = ver or "-"
        print("{:<{}} {:<{}} {:<{}} {}".format(name, col[0], kind, col[1], vstr, col[2], lstr))


# -- git commit ----------------------------------------------------------------


def _git_paths_for(name):
    if name in AUTOMATED:
        return AUTOMATED[name].get("git_paths", [])
    if name in ROLLING_GIT:
        wheels = _platform_wheels_dir()
        paths = ["pre_built/packages.json"]
        if wheels:
            paths.append(os.path.relpath(wheels, REPO))
        return paths
    return []


def git_commit(succeeded, dry_run=False):
    paths = []
    for name in succeeded:
        for p in _git_paths_for(name):
            full = os.path.join(REPO, p)
            if os.path.exists(full) and p not in paths:
                paths.append(p)

    if not paths:
        return

    _sep("git commit")
    status = (
        subprocess.check_output(
            ["git", "status", "--porcelain"] + paths,
            cwd=REPO,
        )
        .decode("utf-8")
        .strip()
    )
    if not status:
        print("No changes detected -- nothing to commit.")
        return

    msg = "chore: update {}\n\nUpdated by ./update:\n{}".format(
        ", ".join(succeeded),
        "\n".join("  - " + n for n in succeeded),
    )
    print()
    rc = _run(["git", "add"] + paths, dry_run)
    if rc != 0 and not dry_run:
        print(f"WARNING: git add failed rc={rc}")
        return
    _run(["git", "commit", "-m", msg], dry_run)


# -- main ----------------------------------------------------------------------

ALL_KNOWN = (
    set(AUTOMATED)
    | set(BUILD_SCRIPTS)
    | set(IMPORT_SCRIPTS)
    | set(ROLLING_GIT)
    | DOWNLOAD_ONLY
    | {n for n, p in PACKAGES.items() if not n.startswith("@") and p.get("kind") == "bin"}
)


@click.command(
    name="update",
    context_settings={"help_option_names": ["-h", "--help"]},
)
@click.argument("packages", nargs=-1, metavar="PACKAGE...")
@click.option("--list", "show_list", is_flag=True, help="Table: package | kind | version | latest.")
@click.option(
    "--list-outdated",
    "list_outdated",
    is_flag=True,
    help="Same as --list, but only packages where latest > current.",
)
@click.option("--commit", "do_commit", is_flag=True, help="Stage + commit automated output (default: no commit).")
@click.option("--rebuild", is_flag=True, help="Rolling-git: rebuild even if the source commit is unchanged.")
@click.option("--dry-run", "dry_run", is_flag=True, help="Print commands without executing.")
@click.option(
    "--tag",
    default=None,
    metavar="VERSION",
    help="Version hint for nodejs and yara (e.g. v26.3.0 or 20260517).",
)
def main(packages, show_list, list_outdated, do_commit, rebuild, dry_run, tag):
    """update -- per-package updater for loadout.

    With no arguments, runs every automated package end-to-end without
    committing. Pass package names to update specific items, or use the
    listing/commit flags below.

    Examples:

      ./update                          # run all automated packages
      ./update nodejs yara-rules        # update specific packages
      ./update liberty-tools --rebuild  # force rebuild of a rolling-git wheel
      ./update nvim bat rg              # show update guidance for those packages
      ./update --list                   # table of every known package
      ./update --list-outdated          # only outdated packages
      ./update --commit                 # stage + commit automated output
      ./update --tag v26.3.0 nodejs     # version hint for nodejs/yara
    """
    if show_list or list_outdated:
        cmd_list(outdated_only=list_outdated)
        return

    packages = list(packages) if packages else list(AUTOMATED) + sorted(ROLLING_GIT)

    unknown = [p for p in packages if p not in ALL_KNOWN]
    if unknown:
        raise click.UsageError("unknown package(s): {}".format(", ".join(unknown)))

    auto_succeeded = []
    all_ok = True

    for name in packages:
        kind = _classify(name)
        if kind == "rolling":
            ok = _run_rolling(name, dry_run=dry_run, force=rebuild)
            if ok:
                auto_succeeded.append(name)
            else:
                all_ok = False
        elif kind == "automated":
            ok = _run_automated(name, dry_run=dry_run, tag=tag)
            if ok:
                auto_succeeded.append(name)
            else:
                all_ok = False
        elif kind == "build":
            _show_build(name)
        elif kind == "import":
            _show_import(name)
        elif kind == "download":
            _show_download(name)
        else:
            print(f"WARNING: no handler for '{name}'")

    if do_commit and auto_succeeded:
        git_commit(auto_succeeded, dry_run=dry_run)

    _sep()
    if dry_run:
        print("Dry-run complete.")
    elif all_ok:
        print("Done.")
    else:
        print("Done (some automated items failed -- see warnings above).")
        sys.exit(1)


if __name__ == "__main__":
    main()
