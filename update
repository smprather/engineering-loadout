    print("  Find latest upstream version + URL:")
    print("    ./pre_built/build_scripts/check-versions --outdated-only")
    print()
    print("  On EL8 build machine:")
    print("  1. Download EL8/x86_64 binary from GitHub releases")
    print("     objdump -T {n} | awk '/GLIBC/{{print $5}}' | sort -Vr | head -1".format(n=name))
