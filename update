# -- packages.json helpers -----------------------------------------------------


def _load_packages():
    path = os.path.join(REPO, "pre_built", "packages.json")
    if not os.path.isfile(path):
        return {}
    with open(path) as f:
        return json.load(f).get("packages", {})


PACKAGES = _load_packages()

# Rolling-git packages: built fresh from source on every ./update.  Tagged in
# packages.json with "rolling_git": "<clone-url>".  The wheel is rebuilt only
# when the source commit differs from the recorded version; the version stamped
# back into packages.json is `git describe --tags --always --dirty` of HEAD.
ROLLING_GIT = {
    name: info["rolling_git"] for name, info in PACKAGES.items() if isinstance(info, dict) and info.get("rolling_git")
}


def _pkg_version(name):
    # Dev-artifact versions live outside packages.json.
    if name == "yara-rules":
        tag_file = os.path.join(REPO, "yara", "release-tag.txt")
        if os.path.isfile(tag_file):
            with open(tag_file) as fh:
                return fh.read().strip()
        return ""
    return PACKAGES.get(name, {}).get("version", "")


def _pkg_desc(name):
    # Prefer inline desc for pseudo-packages not in packages.json.
    inline = AUTOMATED.get(name, {}).get("desc") or IMPORT_SCRIPTS.get(name, {}).get("desc")
    if inline:
        return inline
    return PACKAGES.get(name, {}).get("description", "")


def _classify(name):
    if name in ROLLING_GIT:
        return "rolling"
    if name in AUTOMATED:
        return "automated"
    if name in BUILD_SCRIPTS:
        return "build"
    if name in IMPORT_SCRIPTS:
        return "import"
    if name in DOWNLOAD_ONLY:
        return "download"
    if name in PACKAGES and PACKAGES[name].get("kind") == "bin":
        return "download"
    return None


# -- output helpers ------------------------------------------------------------


def _sep(title="", width=72):
    if title:
        pad = max(0, width - len(title) - 4)
        print("\n-- {} {}".format(title, "-" * pad))
    else:
        print("-" * width)


def _run(cmd, dry_run=False):
    display = " ".join(cmd) if isinstance(cmd, (list, tuple)) else cmd
    print(f"$ {display}")
    if dry_run:
        return 0
    return subprocess.call(cmd, cwd=REPO)


# -- automated runners ---------------------------------------------------------


def _fetch_json(url):
    req = Request(url, headers={"User-Agent": "loadout-update/1.0", "Accept": "application/vnd.github+json"})
    with urlopen(req, timeout=60) as r:
        return json.loads(r.read())


def _download_file(url, dest):
    print(f"  GET {url}")
    req = Request(url, headers={"User-Agent": "loadout-update/1.0"})
    with urlopen(req, timeout=120) as r:
        with open(dest, "wb") as f:
            while True:
                chunk = r.read(65536)
                if not chunk:
                    break
                f.write(chunk)


def _run_yara_rules(dry_run=False, tag=None):
    if tag:
        resolved_tag = tag
    else:
        print("Fetching latest YARA-Forge release...")
        meta = _fetch_json(_YARA_API_LATEST)
        resolved_tag = meta["tag_name"]
        print(f"  Latest: {resolved_tag}")

    current_tag = ""
    if os.path.exists(_YARA_TAG_FILE):
        with open(_YARA_TAG_FILE) as f:
            current_tag = f.read().strip()
    if current_tag == resolved_tag:
        print(f"Already at {resolved_tag} -- nothing to do.")
        return True

    zip_url = _YARA_ZIP_URL.format(tag=resolved_tag)
    if dry_run:
        print(f"$ [download {zip_url} -> yara/]")
        return True

    with tempfile.TemporaryDirectory(prefix="yara-forge-") as tmp:
        zip_path = os.path.join(tmp, "rules-full.zip")
        print(f"Downloading {resolved_tag} rules...")
        _download_file(zip_url, zip_path)

        print(f"  Extracting {_YARA_ZIP_MEMBER}...")
        with zipfile.ZipFile(zip_path) as zf:
            raw = zf.read(_YARA_ZIP_MEMBER)

        print(f"  Rules size: {len(raw) // 1024 // 1024} MB uncompressed")

        os.makedirs(_YARA_DIR, exist_ok=True)
        bz2_tmp = _YARA_RULES_BZ2 + ".tmp"
        with bz2.open(bz2_tmp, "wb", compresslevel=9) as f:
            f.write(raw)
        os.replace(bz2_tmp, _YARA_RULES_BZ2)

        with open(_YARA_TAG_FILE, "w") as f:
            f.write(resolved_tag + "\n")

    compressed_kb = os.path.getsize(_YARA_RULES_BZ2) // 1024
    print(f"  Compressed: {compressed_kb} KB")
    return True


def _run_tldr_data(dry_run=False):
    cache_home = os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache"))
    cache_dir = os.path.join(cache_home, "tealdeer")
    pages_dir = os.path.join(cache_dir, "tldr-pages")
    output = os.path.join(REPO, "tldr", "tldr-pages.tar.bz2")

    if dry_run:
        print("$ tldr --update")
        print(f"$ tar cjf {output} -C {cache_dir} tldr-pages/")
        return True

    rc = subprocess.call(["tldr", "--update"])
    if rc != 0:
        print(f"ERROR: tldr --update failed rc={rc}")
        return False

    if not os.path.isdir(pages_dir):
        print(f"ERROR: tldr-pages not found at {pages_dir} after update")
        return False

    os.makedirs(os.path.join(REPO, "tldr"), exist_ok=True)
    old_gz = os.path.join(REPO, "tldr", "tldr-pages.tar.gz")
    if os.path.exists(old_gz):
        os.remove(old_gz)

    print(f"Bundling {pages_dir} -> {output}")
    rc = subprocess.call(["tar", "cjf", output, "-C", cache_dir, "tldr-pages/"])
    if rc != 0:
        print(f"ERROR: tar failed rc={rc}")
        return False

    size_mb = os.path.getsize(output) // 1024 // 1024
    print(f"Done: {size_mb}M written to {output}")
    return True


def _run_tmux_plugins(dry_run=False):
    tmux_conf = os.path.join(REPO, "tmux", "tmux.conf")
    plugin_dir = os.path.join(REPO, "tmux", "vendor", "plugins")

    plugins = []
    with open(tmux_conf) as f:
        for line in f:
            m = re.search(r"set -g @plugin '([^']+)'", line)
            if m:
                plugins.append(m.group(1))

    if not plugins:
        print("No @plugin entries found in tmux.conf")
        return True

    os.makedirs(plugin_dir, exist_ok=True)
    ok = True
    for plugin in plugins:
        name = os.path.basename(plugin)
        dest = os.path.join(plugin_dir, name)
        url = f"https://github.com/{plugin}.git"
        print(f"Updating {plugin}...")
        if dry_run:
            print(f"$ git clone --depth 1 {url} {dest}")
            continue
        shutil.rmtree(dest, ignore_errors=True)
        rc = subprocess.call(["git", "clone", "--depth", "1", url, dest])
        if rc != 0:
            print(f"ERROR: git clone failed for {plugin}")
            ok = False
            continue
        shutil.rmtree(os.path.join(dest, ".git"), ignore_errors=True)

    return ok


def _run_env_nvim(dry_run=False):
    """Update nvim plugins via Lazy and repack the offline catalog archive."""
    lazy_dir = os.path.expanduser("~/.local/share/nvim/lazy")
    catalog_archive = os.path.join(REPO, "nvim", "vendor", "plugins", "nvim-catalog-plugins.tar.bz2")
    nvim_bin = os.path.expanduser("~/.local/bin/nvim")

    if not os.path.isfile(nvim_bin) or not os.access(nvim_bin, os.X_OK):
        print(f"ERROR: nvim not found at {nvim_bin} -- run ./loadout install nvim first")
        return False

    # Step 1: update plugins via Lazy
    cmd = [nvim_bin, "--headless", "+Lazy! update", "+qa"]
    print("Updating plugins: {}".format(" ".join(cmd)))
    if not dry_run:
        rc = subprocess.call(cmd)
        if rc != 0:
            print(f"WARNING: Lazy! update exited rc={rc} -- continuing with repack")

    if not os.path.isdir(lazy_dir):
        print(f"ERROR: lazy plugin dir not found at {lazy_dir}")
        return False

    # Step 2: repack catalog archive with relative paths (./PluginName/...)
    # Use -C so archive entries are relative to lazy_dir, not absolute filesystem paths.
    print(f"Repacking {catalog_archive} ...")
    os.makedirs(os.path.dirname(catalog_archive), exist_ok=True)
    tmp = catalog_archive + ".tmp"
    if dry_run:
        print(f"$ tar cjf {catalog_archive} -C {lazy_dir} .")
        print("$ ./strip_all_elf_binaries")
        return True

    rc = subprocess.call(["tar", "cjf", tmp, "-C", lazy_dir, "."])
    if rc != 0:
        print(f"ERROR: tar failed rc={rc}")
        if os.path.exists(tmp):
            os.remove(tmp)
        return False

    os.replace(tmp, catalog_archive)
    size_mb = os.path.getsize(catalog_archive) // 1024 // 1024
    print(f"  {size_mb}M -> {catalog_archive}")

    # Step 3: strip ELF payloads inside the archive
    rc = subprocess.call([os.path.join(REPO, "strip_all_elf_binaries")], cwd=REPO)
    if rc != 0:
        print(f"WARNING: strip_all_elf_binaries exited rc={rc}")

    return True


def _run_automated(name, dry_run=False, tag=None):
    _sep(name)
    if name == "yara-rules":
        return _run_yara_rules(dry_run=dry_run, tag=tag)
    elif name == "nodejs":
        cmd = [os.path.join(BUILD, "import-nodejs")]
        if tag:
            cmd += ["--tag", tag]
        rc = _run(cmd, dry_run)
        if rc != 0:
            print(f"WARNING: {name} exited rc={rc}")
            return False
        print()
        rc2 = _run([os.path.join(REPO, "strip_all_elf_binaries")], dry_run)
        if rc2 != 0:
            print(f"WARNING: strip_all_elf_binaries exited rc={rc2}")
        return True
    elif name == "tldr-data":
        return _run_tldr_data(dry_run=dry_run)
    elif name == "tmux-plugins":
        return _run_tmux_plugins(dry_run=dry_run)
    elif name == "env-nvim":
        return _run_env_nvim(dry_run=dry_run)
    else:
        print(f"ERROR: no runner for automated package '{name}'")
        return False


# -- rolling-git wheels ----------------------------------------------------------


def _git(args, cwd=None):
    return subprocess.check_output(["git"] + args, cwd=cwd, stderr=subprocess.DEVNULL).decode("utf-8").strip()


def _find_uv():
    for cand in (os.path.expanduser("~/.local/bin/uv"), shutil.which("uv")):
        if cand and os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return None


def _platform_wheels_dir():
    """Return the pre_built/<platform>/wheels dir (prefer el8 when several)."""
    candidates = sorted(glob.glob(os.path.join(REPO, "pre_built", "*", "wheels")))
    if not candidates:
        return None
    for c in candidates:
        if "el8" in os.path.basename(os.path.dirname(c)):
            return c
    return candidates[0]


def _remote_head_short(url):
    """Short SHA of remote HEAD via ls-remote (no clone). '' on failure."""
    try:
        out = _git(["ls-remote", url, "HEAD"])
    except Exception:
        return ""
    return out.split()[0][:7] if out else ""


def _build_backend(clone):
    """PEP517 build-backend declared in the clone's pyproject.toml ('' if none)."""
    try:
        with open(os.path.join(clone, "pyproject.toml")) as fh:
            txt = fh.read()
    except OSError:
        return ""
    m = re.search(r'build-backend\s*=\s*"([^"]+)"', txt)
    return m.group(1) if m else ""


def _set_pkg_version(name, version):
    """Surgically replace the version value inside one package block (minimal diff)."""
    path = os.path.join(REPO, "pre_built", "packages.json")
    with open(path) as fh:
        txt = fh.read()
    i = txt.find(f'"{name}": {{')
    if i < 0:
        raise KeyError(f"package {name} not found in packages.json")
    # Walk from the package's opening brace to its matching close.
    depth = 0
    j = txt.index("{", i)
    while j < len(txt):
        if txt[j] == "{":
            depth += 1
        elif txt[j] == "}":
            depth -= 1
            if depth == 0:
                j += 1
                break
        j += 1
    block = txt[i:j]
    new_block, n = re.subn(
        r'("version"\s*:\s*")([^"]*)(")',
        lambda m: m.group(1) + version + m.group(3),
        block,
        count=1,
    )
    if n != 1:
        raise KeyError(f"version key not found for {name}")
    with open(path, "w") as fh:
        fh.write(txt[:i] + new_block + txt[j:])


def _run_rolling(name, dry_run=False, force=False):
    _sep(name)
    url = ROLLING_GIT[name]
    wheels_dir = _platform_wheels_dir()
    if not wheels_dir:
        print("ERROR: no pre_built/<platform>/wheels dir found")
        return False

    current = _pkg_version(name)
    remote_short = _remote_head_short(url)
    if not force and remote_short and remote_short in (current or "") and not dry_run:
        print(f"Already at {current} (remote HEAD {remote_short}) -- nothing to build.")
        return True

    if dry_run:
        print(f"$ git clone --filter=blob:none {url} <tmp>")
        print("$ git -C <tmp> describe --tags --always --dirty")
        print("$ uv build --wheel --out-dir <tmp> <tmp>")
        print(f"$ (prune old <dist>-*.whl, copy new wheel into {os.path.relpath(wheels_dir, REPO)})")
        print(f"$ (stamp packages.json version for {name})")
        return True

    uv = _find_uv()
    if not uv:
        print("ERROR: uv not found -- required to build rolling-git wheels")
        return False

    tmp = tempfile.mkdtemp(prefix=f"rolling-{name}-")
    try:
        clone = os.path.join(tmp, "src")
        print(f"Cloning {url} ...")
        rc = subprocess.call(["git", "clone", "--filter=blob:none", "--quiet", url, clone])
        if rc != 0:
            print("  partial clone failed; retrying full clone")
            shutil.rmtree(clone, ignore_errors=True)
            rc = subprocess.call(["git", "clone", "--quiet", url, clone])
        if rc != 0:
            print(f"ERROR: git clone failed for {url}")
            return False

        try:
            version = _git(["describe", "--tags", "--always", "--dirty"], cwd=clone)
        except Exception:
            version = _git(["rev-parse", "--short", "HEAD"], cwd=clone)
        print(f"  source version: {version}")
        if version == current and not force:
            print(f"Already at {version} -- source unchanged, skipping rebuild.")
            return True

        out_dir = os.path.join(tmp, "wheels")
        os.makedirs(out_dir)
        env = os.environ.copy()
        if "maturin" in _build_backend(clone):
            # Under PEP517, maturin tags a bare linux_x86_64 wheel; force a
            # portable manylinux_2_28 build (EL8 glibc floor) to match the
            # repo's wheel-compat policy.  maturin reads MATURIN_PEP517_ARGS
            # when invoked by a build frontend (uv/pip/build).
            env["MATURIN_PEP517_ARGS"] = "--compatibility manylinux_2_28"
        print("Building wheel via uv ...")
        rc = subprocess.call([uv, "build", "--wheel", "--out-dir", out_dir, clone], env=env)
        if rc != 0:
            print(f"ERROR: uv build failed for {name}")
            return False

        built = [f for f in os.listdir(out_dir) if f.endswith(".whl")]
        if not built:
            print(f"ERROR: no wheel produced for {name}")
            return False
        wheel = built[0]
        dist = wheel.split("-")[0]  # normalized dist name, e.g. liberty_tools

        removed = [f for f in os.listdir(wheels_dir) if f.endswith(".whl") and f.split("-")[0] == dist and f != wheel]
        for f in removed:
            os.remove(os.path.join(wheels_dir, f))
        shutil.copy2(os.path.join(out_dir, wheel), os.path.join(wheels_dir, wheel))
        for f in removed:
            print(f"  removed old {f}")
        print(f"  installed {wheel}")

        _set_pkg_version(name, version)
        print(f"  packages.json version -> {version}")
        return True
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


