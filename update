# ── packages.json helpers ─────────────────────────────────────────────────────


def _load_packages():
    path = os.path.join(REPO, "pre_built", "packages.json")
    if not os.path.isfile(path):
        return {}
    with open(path) as f:
        return json.load(f).get("packages", {})


PACKAGES = _load_packages()


def _pkg_version(name):
    # Dev-artifact versions live outside packages.json.
    if name == "yara-rules":
        tag_file = os.path.join(REPO, "yara", "release-tag.txt")
        if os.path.isfile(tag_file):
            with open(tag_file) as fh:
                return fh.read().strip()
        return ""
    return PACKAGES.get(name, {}).get("version", "")


def _pkg_desc(name):
    # Prefer inline desc for pseudo-packages not in packages.json.
    inline = AUTOMATED.get(name, {}).get("desc") or IMPORT_SCRIPTS.get(name, {}).get("desc")
    if inline:
        return inline
    return PACKAGES.get(name, {}).get("description", "")


def _classify(name):
    if name in AUTOMATED:
        return "automated"
    if name in BUILD_SCRIPTS:
        return "build"
    if name in IMPORT_SCRIPTS:
        return "import"
    if name in DOWNLOAD_ONLY:
        return "download"
    if name in PACKAGES and PACKAGES[name].get("kind") == "bin":
        return "download"
    return None


# ── output helpers ────────────────────────────────────────────────────────────


def _sep(title="", width=72):
    if title:
        pad = max(0, width - len(title) - 4)
        print("\n── {} {}".format(title, "─" * pad))
    else:
        print("─" * width)


def _run(cmd, dry_run=False):
    display = " ".join(cmd) if isinstance(cmd, (list, tuple)) else cmd
    print("$ {}".format(display))
    if dry_run:
        return 0
    return subprocess.call(cmd, cwd=REPO)


# ── automated runners ─────────────────────────────────────────────────────────


def _run_automated(name, dry_run=False, tag=None):
    _sep(name)
    if name == "yara-rules":
        cmd = [os.path.join(REPO, "update_yara_forge_rules_full")]
        if tag:
            cmd += ["--tag", tag]
        rc = _run(cmd, dry_run)
    elif name == "nodejs":
        cmd = [os.path.join(BUILD, "import-nodejs")]
        if tag:
            cmd += ["--tag", tag]
        rc = _run(cmd, dry_run)
        if rc == 0:
            print()
            rc2 = _run([os.path.join(REPO, "strip_all_elf_binaries")], dry_run)
            if rc2 != 0:
                print("WARNING: strip_all_elf_binaries exited rc={}".format(rc2))
    elif name == "tldr-data":
        rc = _run([os.path.join(REPO, "update_tldr_cache")], dry_run)
    elif name == "tmux-plugins":
        rc = _run([os.path.join(REPO, "update_tmux_plugins")], dry_run)
    else:
        print("ERROR: no runner for automated package '{}'".format(name))
        return False
    if rc != 0:
        print("WARNING: {} exited rc={}".format(name, rc))
        return False
    return True


# ── guidance printers ─────────────────────────────────────────────────────────


def _show_build(name):
    _sep(name)
    info = BUILD_SCRIPTS[name]
    ver = _pkg_version(name)
    if ver:
        print("  current: v{}".format(ver))
    print()
    print("  On EL8 build machine:")
    print("    ./pre_built/build_scripts/{} --tag vX.Y.Z".format(info["script"]))
    if "runtime" in info:
        print("    (also produces pre_built/<platform>/runtime/{})".format(info["runtime"]))
    print()
    print("  After building:")
    print("    ./strip_all_elf_binaries")
    print("    git add pre_built/ .strip-manifest packages.json")


def _show_import(name):
    _sep(name)
    info = IMPORT_SCRIPTS[name]
    ver = _pkg_version(name)
    if ver:
        print("  current: v{}".format(ver))
    print()
    print("  {}".format(info["cmd"]))
    print()
    print("  Note: {}".format(info["note"]))
    print()
    print("  After importing:")
    print("    git add pre_built/ packages.json")


def _show_download(name):
    _sep(name)
    ver = _pkg_version(name)
    if ver:
        print("  current: v{}".format(ver))
    print()
    print("  Find latest upstream version + URL:")
    print("    ./pre_built/build_scripts/check-versions --outdated-only")
    print()
    print("  On EL8 build machine:")
    print("  1. Download EL8/x86_64 binary from GitHub releases")
    print("     objdump -T {n} | awk '/GLIBC/{{print $5}}' | sort -Vr | head -1".format(n=name))
    print("     patchelf --set-rpath '$ORIGIN/../lib64:$ORIGIN/../lib' {n}".format(n=name))
    print("     bzip2 -k {n}".format(n=name))
    print("  2. cp {n}.bz2 pre_built/el8.x86_64.glibc2p28/bin/".format(n=name))
    print("  3. ./strip_all_elf_binaries")
    print("  4. git add pre_built/ .strip-manifest packages.json")


# ── --list ────────────────────────────────────────────────────────────────────


def cmd_list():
    rows = []

    for name in ("yara-rules", "nodejs", "tldr-data", "tmux-plugins"):
        tag_note = " (--tag)" if AUTOMATED[name].get("supports_tag") else ""
        rows.append((name, "automated" + tag_note, _pkg_version(name), _pkg_desc(name)))

    for name in sorted(BUILD_SCRIPTS):
        runtime = BUILD_SCRIPTS[name].get("runtime", "")
        kind = "build" + (" +runtime" if runtime else "")
        rows.append((name, kind, _pkg_version(name), _pkg_desc(name)))

    for name in sorted(IMPORT_SCRIPTS):
        rows.append((name, "import-script", _pkg_version(name), _pkg_desc(name)))

    dl_names = DOWNLOAD_ONLY | {k for k, v in PACKAGES.items() if not k.startswith("@") and v.get("kind") == "bin"}
    dl = sorted(n for n in dl_names if n not in AUTOMATED and n not in BUILD_SCRIPTS and n not in IMPORT_SCRIPTS)
    for name in dl:
        rows.append((name, "download", _pkg_version(name), _pkg_desc(name)))

    col = [16, 16, 9]
    hdr = "{:<{}} {:<{}} {:<{}} {}".format("PACKAGE", col[0], "KIND", col[1], "VERSION", col[2], "DESCRIPTION")
    print(hdr)
    print("─" * 80)
    for name, kind, ver, desc in rows:
        vstr = ("v" + ver) if ver else "-"
        print("{:<{}} {:<{}} {:<{}} {}".format(name, col[0], kind, col[1], vstr, col[2], desc[:48]))


# ── git commit ────────────────────────────────────────────────────────────────


def git_commit(succeeded, dry_run=False):
    paths = []
    for name in succeeded:
        for p in AUTOMATED[name].get("git_paths", []):
            if os.path.exists(os.path.join(REPO, p)):
                paths.append(p)

    if not paths:
        return

    _sep("git commit")
    status = (
        subprocess.check_output(
            ["git", "status", "--porcelain"] + paths,
            cwd=REPO,
        )
        .decode("utf-8")
        .strip()
    )
    if not status:
        print("No changes detected — nothing to commit.")
        return

    msg = "chore: update {}\n\nUpdated by ./update:\n{}".format(
        ", ".join(succeeded),
        "\n".join("  - " + n for n in succeeded),
    )
    print()
    rc = _run(["git", "add"] + paths, dry_run)
    if rc != 0 and not dry_run:
        print("WARNING: git add failed rc={}".format(rc))
        return
    _run(["git", "commit", "-m", msg], dry_run)


# ── main ──────────────────────────────────────────────────────────────────────

ALL_KNOWN = (
    set(AUTOMATED)
    | set(BUILD_SCRIPTS)
    | set(IMPORT_SCRIPTS)
    | DOWNLOAD_ONLY
    | {n for n, p in PACKAGES.items() if not n.startswith("@") and p.get("kind") == "bin"}
)


def main():
    ap = argparse.ArgumentParser(
        prog="update",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument(
        "packages",
        nargs="*",
        metavar="PACKAGE",
        help="packages to update/show (default: run all automated)",
    )
    ap.add_argument("--list", action="store_true", help="table: package | kind | version | description")
    ap.add_argument("--commit", action="store_true", help="stage + commit automated output (default: no commit)")
    ap.add_argument("--dry-run", action="store_true", help="print commands without executing")
    ap.add_argument(
        "--tag", default=None, metavar="VERSION", help="version hint for nodejs and yara (e.g. v26.3.0 or 20260517)"
    )
    args = ap.parse_args()

    if args.list:
        cmd_list()
        return

    packages = args.packages if args.packages else list(AUTOMATED)

    unknown = [p for p in packages if p not in ALL_KNOWN]
    if unknown:
        ap.error("unknown package(s): {}".format(", ".join(unknown)))

    auto_succeeded = []
    all_ok = True

    for name in packages:
        kind = _classify(name)
        if kind == "automated":
            ok = _run_automated(name, dry_run=args.dry_run, tag=args.tag)
            if ok:
                auto_succeeded.append(name)
            else:
                all_ok = False
        elif kind == "build":
            _show_build(name)
        elif kind == "import":
            _show_import(name)
        elif kind == "download":
            _show_download(name)
        else:
            print("WARNING: no handler for '{}'".format(name))

    if args.commit and auto_succeeded:
        git_commit(auto_succeeded, dry_run=args.dry_run)

    _sep()
    if args.dry_run:
        print("Dry-run complete.")
    elif all_ok:
        print("Done.")
    else:
        print("Done (some automated items failed — see warnings above).")
        sys.exit(1)


if __name__ == "__main__":
    main()
