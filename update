#!/usr/bin/env python3
"""update — unified dev-artifact updater for engineering-loadout.

Automated items (default: all four):
  tldr          bundle tealdeer tldr-pages for offline installs
  tmux-plugins  re-clone tmux plugins listed in tmux.conf, strip .git
  yara          vendor latest YARA-Forge full rules
  nodejs        nvm install --lts, bundle as node.tar.bz2

Guide items (print instructions, no network/build):
  binaries      download, or build, latest 'bins'
  runtimes      build/import runtime archives (fish, octave, nvim, ...)

Usage:
  ./update                        run all automated items, commit
  ./update yara nodejs            only those two, commit
  ./update nodejs --tag v26.2.0   pin version, commit
  ./update --no-commit            run all automated, skip commit
  ./update --dry-run              show commands without executing
  ./update --list                 item table
  ./update binaries               show binary update guidance
  ./update runtimes               show runtime build guidance
"""

from __future__ import print_function

import argparse
import os
import subprocess
import sys
import textwrap

REPO = os.path.dirname(os.path.abspath(__file__))
BUILD = os.path.join(REPO, "pre_built", "build_scripts")

ITEMS_ORDERED = ["tldr", "tmux-plugins", "yara", "nodejs", "binaries", "runtimes"]

ITEMS = {
    "tldr": {
        "desc": "Bundle tealdeer tldr-pages cache for offline installs",
        "kind": "auto",
    },
    "tmux-plugins": {
        "desc": "Re-clone tmux plugins listed in tmux.conf, strip .git",
        "kind": "auto",
    },
    "yara": {
        "desc": "Vendor latest YARA-Forge full rules (--tag YYYYMMDD to pin)",
        "kind": "auto",
        "supports_tag": True,
    },
    "nodejs": {
        "desc": "nvm install --lts, bundle as node.tar.bz2 (--tag vX.Y.Z to pin)",
        "kind": "auto",
        "supports_tag": True,
    },
    "binaries": {
        "desc": "Download, or build, latest 'bins'",
        "kind": "guide",
    },
    "runtimes": {
        "desc": "Build and import runtime archives (fish, octave, nvim, ...)",
        "kind": "guide",
    },
}

AUTO_DEFAULT = [k for k in ITEMS_ORDERED if ITEMS[k]["kind"] == "auto"]


# ── output helpers ────────────────────────────────────────────────────────────


def _sep(title="", width=72):
    if title:
        pad = max(0, width - len(title) - 4)
        print("\n── {} {}".format(title, "─" * pad))
    else:
        print("─" * width)


def _run(cmd, dry_run=False):
    """Print and optionally execute cmd; return subprocess exit code (0 on dry-run)."""
    display = " ".join(cmd) if isinstance(cmd, (list, tuple)) else cmd
    print("$ {}".format(display))
    if dry_run:
        return 0
    return subprocess.call(cmd, cwd=REPO)


# ── automated runners ─────────────────────────────────────────────────────────


def run_tldr(dry_run=False, tag=None):
    _sep("tldr")
    rc = _run([os.path.join(REPO, "update_tldr_cache")], dry_run)
    if rc != 0:
        print("WARNING: update_tldr_cache exited rc={}".format(rc))
    return rc == 0


def run_tmux_plugins(dry_run=False, tag=None):
    _sep("tmux-plugins")
    rc = _run([os.path.join(REPO, "update_tmux_plugins")], dry_run)
    if rc != 0:
        print("WARNING: update_tmux_plugins exited rc={}".format(rc))
    return rc == 0


def run_yara(dry_run=False, tag=None):
    _sep("yara")
    cmd = [os.path.join(REPO, "update_yara_forge_rules_full")]
    if tag:
        cmd += ["--tag", tag]
    rc = _run(cmd, dry_run)
    if rc != 0:
        print("WARNING: update_yara_forge_rules_full exited rc={}".format(rc))
    return rc == 0


def run_nodejs(dry_run=False, tag=None):
    _sep("nodejs")
    cmd = [os.path.join(BUILD, "import-nodejs")]
    if tag:
        cmd += ["--tag", tag]
    rc = _run(cmd, dry_run)
    if rc != 0:
        print("WARNING: import-nodejs exited rc={}".format(rc))
        return False
    print()
    rc2 = _run([os.path.join(REPO, "strip_all_elf_binaries")], dry_run)
    if rc2 != 0:
        print("WARNING: strip_all_elf_binaries exited rc={}".format(rc2))
    return True


# ── guide printers ────────────────────────────────────────────────────────────


