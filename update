    "nvim-qt": {"script": "build-nvim-qt.sh"},
    "octave": {"script": "build-octave.sh", "runtime": "octave.tar.bz2"},
    "st": {"script": "build-st.sh"},
    "tmux": {"script": "build-tmux.sh"},
    "urxvt": {"script": "build-urxvt.sh"},
    "vim": {"script": "build-gvim.sh", "runtime": "vim92.tar.bz2"},
    "zsh": {"script": "build-zsh.sh"},
