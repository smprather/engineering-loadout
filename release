#!/usr/bin/env python3
"""
release: run pre-release gates, then create a GitHub release.

Usage:
    ./release                  # tag today's date, create release
    ./release --tag v2026.05.12
    ./release --dry-run        # run gates only, no tag or GitHub release
    ./release --skip-scan      # skip the malware scan (NOT recommended; for a
                               # known yara false positive only)
    ./release --allow-unsigned # release with an UNSIGNED tag (breaks trust chain)

A preflight runs FIRST, before any gate: it checks `gh` auth and proves the tag
signer produces a real signature with no tty, askpass or DISPLAY. Authentication
problems therefore surface at kickoff, while the operator is still at the
keyboard, instead of hanging an hour later when the slow gates have finished.

Every release then runs independent pre-release gates in parallel: malware scan,
binary smoke test, version table, and checksum generation. The final tag and
GitHub release step runs only after the mandatory gates pass.

The tag is date-based (v<YYYY.MM.DD>). Re-running on the same day REPLACES the
existing release and tag with the current tree, rather than failing on the
collision -- a given day's release is always the latest state.

Requires: gh (GitHub CLI) authenticated, git repo with remote set.
"""

import concurrent.futures
import datetime
import hashlib
import json
import os
import subprocess
import sys
import tempfile
from dataclasses import dataclass

_d = os.path.dirname(os.path.abspath(__file__))
while _d not in ("", "/") and not os.path.isdir(os.path.join(_d, "installer_vendor")):
    _d = os.path.dirname(_d)
if os.path.isdir(os.path.join(_d, "installer_vendor")):
    sys.path.insert(0, os.path.join(_d, "installer_vendor"))

import rich_click as click  # noqa: E402


def run(cmd, **kwargs):
    return subprocess.run(cmd, **kwargs)


SHA256SUMS_NAME = "sha256sums.txt"
# The nvim plugin stash: ~328 MB, shipped as a release ASSET (not a git payload).
# Reused across same-day/routine re-releases when its bytes are unchanged so the
# release does not re-upload 328 MB every time (_can_reuse_stash).
STASH_REL = "envs/nvim/vendor/plugins/nvim-plugin-stash.tar.bz2"
STASH_ASSET_NAME = os.path.basename(STASH_REL)
STEP_SCAN_TITLE = "Step 0: Scanning bundled binaries for malware (YARA-Forge)"
STEP_SMOKE_TITLE = "Step 1: Smoke-testing pre-built binaries"
STEP_VERSIONS_TITLE = "Step 2: Generating version table"
STEP_CHECKSUMS_TITLE = f"Step 3: Generating {SHA256SUMS_NAME} + checksum table"


@dataclass
class StepResult:
    name: str
    title: str
    returncode: int = 0
    output: str = ""
    data: object = None


def _signing_configured():
    """True when git has a signing key configured (SSH or GPG)."""
    r = subprocess.run(["git", "config", "--get", "user.signingkey"], capture_output=True, text=True)
    return r.returncode == 0 and r.stdout.strip() != ""


SIGNING_PROBE_TAG = "loadout-release-signing-preflight"


def _delete_probe_tag():
    subprocess.run(["git", "tag", "-d", SIGNING_PROBE_TAG], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _test_sign_noninteractive():
    """Prove the tag signer works with every interactive channel closed.

    A release runs unattended for a long time (scan + smoke are the slow part),
    so a signer that can still prompt does not fail -- it HANGS, at the very
    end, after all the expensive work. This signs a throwaway tag with no tty,
    no askpass and no DISPLAY, so the only way it succeeds is a live ssh-agent
    (or an unencrypted key). Returns (ok, detail).
    """
    env = dict(os.environ)
    env["SSH_ASKPASS_REQUIRE"] = "never"  # OpenSSH >= 8.4: never fall back to a GUI prompt
    env["GIT_TERMINAL_PROMPT"] = "0"
    env.pop("SSH_ASKPASS", None)
    env.pop("DISPLAY", None)

    _delete_probe_tag()  # a killed earlier run can leave one behind
    try:
        r = subprocess.run(
            ["git", "tag", "-s", SIGNING_PROBE_TAG, "-m", SIGNING_PROBE_TAG],
            capture_output=True,
            text=True,
            env=env,
            stdin=subprocess.DEVNULL,
            timeout=60,
        )
    except subprocess.TimeoutExpired:
        _delete_probe_tag()
        return False, "signer did not finish in 60s -- it is waiting for a passphrase"

    if r.returncode != 0:
        _delete_probe_tag()
        # git's own diagnosis comes FIRST ("error: Enter passphrase ...");
        # the last line is the useless "tag message left in .git/TAG_EDITMSG".
        lines = [ln.strip() for ln in (r.stderr or r.stdout).splitlines() if ln.strip()]
        useful = [ln for ln in lines if ln.startswith(("error:", "fatal:"))]
        return False, (useful or lines or ["git tag -s failed"])[0]

    obj = subprocess.run(["git", "cat-file", "-p", SIGNING_PROBE_TAG], capture_output=True, text=True)
    _delete_probe_tag()
    # Belt and braces: a zero exit is not proof of a signature. The 2026-07-22
    # release shipped an unsigned tag because nothing ever checked the object.
    if "BEGIN SSH SIGNATURE" not in obj.stdout and "BEGIN PGP SIGNATURE" not in obj.stdout:
        return False, "git tag -s exited 0 but produced a tag with no signature block"
    return True, "throwaway tag signed with no tty, askpass or DISPLAY"


def _gh_authenticated():
    r = subprocess.run(["gh", "auth", "status"], capture_output=True, text=True)
    if r.returncode == 0:
        return True, "gh CLI authenticated"
    err = (r.stderr or r.stdout).strip().splitlines()
    return False, err[-1] if err else "gh auth status failed"


def _print_signing_remediation():
    print("", file=sys.stderr)
    print("  The tag signer needs a live ssh-agent holding the key. Run, in your shell:", file=sys.stderr)
    print("", file=sys.stderr)
    print('      eval "$(ssh-agent -s)" && ssh-add ~/.ssh/id_ed25519', file=sys.stderr)
    print("", file=sys.stderr)
    print("  then re-run the release with that agent's socket:", file=sys.stderr)
    print("", file=sys.stderr)
    print("      SSH_AUTH_SOCK=$SSH_AUTH_SOCK ./release", file=sys.stderr)
    print("", file=sys.stderr)
    print("  (From a background/tool shell SSH_AUTH_SOCK is usually unset -- find the", file=sys.stderr)
    print("  keyed agent with: for s in $(ls -t /tmp/ssh-*/agent.*); do", file=sys.stderr)
    print("  SSH_AUTH_SOCK=$s ssh-add -l >/dev/null 2>&1 && echo $s && break; done)", file=sys.stderr)
    print("", file=sys.stderr)
    print("  To release without a signature anyway, pass --allow-unsigned.", file=sys.stderr)


def _preflight(dry_run, allow_unsigned):
    """Authenticate BEFORE any long-running gate.

    Everything credential-shaped is settled here, at kickoff, while the operator
    is still at the keyboard -- not an hour later when the scan and smoke test
    have finished and nobody is around to answer a prompt. Returns True when the
    tag will be signed.
    """
    _print_heading("Preflight: authentication (before any gate)")

    gh_ok, gh_detail = _gh_authenticated()
    print(f"  gh auth       : {'OK' if gh_ok else 'FAILED'} -- {gh_detail}", flush=True)

    key = _signing_configured()
    sign_ok, sign_detail = (False, "no user.signingkey configured")
    if key:
        sign_ok, sign_detail = _test_sign_noninteractive()
    print(f"  tag signing   : {'OK' if sign_ok else 'FAILED'} -- {sign_detail}", flush=True)

    if dry_run:
        # No tag is created, so nothing here can block; still reported above.
        return sign_ok

    if not gh_ok:
        print("\nRelease blocked: gh CLI is not authenticated. Run: gh auth login", file=sys.stderr)
        sys.exit(1)

    if not sign_ok:
        if not allow_unsigned:
            print("\nRelease blocked: cannot produce a SIGNED tag.", file=sys.stderr)
            print("An unsigned tag breaks the top link of the trust chain", file=sys.stderr)
            print("(signed tag -> sha256sums.txt -> payload bytes; docs/SECURITY.md).", file=sys.stderr)
            _print_signing_remediation()
            sys.exit(1)
        print("  WARNING: --allow-unsigned -- this release will carry an UNSIGNED tag.")
        print("  The content-manifest trust chain will NOT be tamper-evident.")

    return sign_ok


def _sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


# Integrity-critical, in-tree files a downloader can verify without pulling the
# multi-GB source archive. `.content-manifest` in turn pins the SHA-256 of every
# payload file, so its single hash transitively binds the whole tree.
INTEGRITY_TARGETS = [
    ".content-manifest",
    "loadout",
    "loadout_main.py",
    "payload/packages.json",
    # The nvim plugin stash is NOT in .content-manifest (it is a release asset, not a git
    # payload), so its hash must be published here directly -- this is the link
    # ./fetch-stash checks before the installer will accept the downloaded bytes.
    STASH_REL,
]


def _integrity_hashes(script_dir):
    """[(repo-relative path, sha256)] for each integrity target that exists."""
    pairs = []
    for rel in INTEGRITY_TARGETS:
        full = os.path.join(script_dir, rel)
        if os.path.isfile(full):
            pairs.append((rel, _sha256_file(full)))
    return pairs


def _write_sha256sums(script_dir, pairs):
    """Write sha256sums.txt (coreutils `sha256sum -c` format) from PAIRS so the
    file and the release-notes table share one source of truth."""
    out = os.path.join(script_dir, SHA256SUMS_NAME)
    with open(out, "w") as fh:
        for rel, digest in pairs:
            fh.write(f"{digest}  {rel}\n")
    return out


def _checksum_table_md(pairs):
    """Markdown table of PAIRS for the GitHub release notes (renders on-page)."""
    lines = [
        "## Asset checksums (SHA-256)",
        "",
        "Integrity-critical files pinned by this release. `.content-manifest` in "
        "turn pins every payload file, so verifying it (or running "
        "`./loadout doctor --verify`) covers the whole tree.",
        "",
        "| File | SHA-256 |",
        "|------|---------|",
    ]
    for rel, digest in pairs:
        lines.append(f"| `{rel}` | `{digest}` |")
    return "\n".join(lines)


def _version_table_from_tsv(versions_tsv):
    """Markdown release-notes table from farm-versions TSV output."""
    lines = [row for row in versions_tsv.splitlines() if row.strip()]
    md_rows = []
    for line in lines[1:]:  # skip header
        parts = line.split("\t")
        if len(parts) >= 5 and parts[2]:  # skip missing
            binary, name, version, _status, homepage = parts[0], parts[1], parts[2], parts[3], parts[4]
            md_rows.append(f"| [{name}]({homepage}) | `{binary}` | {version} |")

    if not md_rows:
        return ""

    version_table = "\n## Pre-built binary versions\n\n"
    version_table += "| Tool | Binary | Version |\n"
    version_table += "|------|--------|--------|\n"
    version_table += "\n".join(md_rows)
    return version_table


def _print_heading(title):
    print("=" * 60)
    print(title)
    print("=" * 60, flush=True)


def _emit_step_result(result):
    print()
    _print_heading(result.title)
    if result.output:
        print(result.output, end="" if result.output.endswith("\n") else "\n")
    if result.returncode == 0:
        print(f"  {result.name}: passed", flush=True)
    else:
        print(f"  {result.name}: failed with exit {result.returncode}", file=sys.stderr, flush=True)


def _command_step(name, title, cmd):
    proc = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        encoding="utf-8",
        errors="replace",
    )
    return StepResult(name=name, title=title, returncode=proc.returncode, output=proc.stdout)


def _skip_scan_step(script_dir, tag):
    _record_skip_scan_justification(script_dir, tag)
    return StepResult(
        name="malware scan",
        title=STEP_SCAN_TITLE,
        output="SKIPPED via --skip-scan (not recommended).\n",
    )


def _version_step(farm_versions):
    proc = subprocess.run(
        [farm_versions, "--format", "tsv"],
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
    )
    if proc.returncode != 0:
        output = "  WARNING: version table generation failed; release notes omit tool versions.\n"
        if proc.stderr:
            output += proc.stderr
        return StepResult(name="version table", title=STEP_VERSIONS_TITLE, output=output, data="")

    version_table = _version_table_from_tsv(proc.stdout)
    row_count = max(0, len([row for row in proc.stdout.splitlines() if row.strip()]) - 1)
    return StepResult(
        name="version table",
        title=STEP_VERSIONS_TITLE,
        output=f"  collected {row_count} version rows\n",
        data=version_table,
    )


def _checksum_step(script_dir):
    pairs = _integrity_hashes(script_dir)
    sums_path = _write_sha256sums(script_dir, pairs)
    return StepResult(
        name="checksums",
        title=STEP_CHECKSUMS_TITLE,
        output=f"  wrote {sums_path} ({len(pairs)} files)\n",
        data={"pairs": pairs, "sums_path": sums_path},
    )


def _run_parallel_pre_release_steps(script_dir, smoke_test, farm_versions, malware_scan, tag, skip_scan):
    """Run all independent pre-release steps concurrently."""
    _print_heading("Starting independent pre-release steps in parallel")

    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as executor:
        futures = {}
        if skip_scan:
            future = executor.submit(_skip_scan_step, script_dir, tag)
        else:
            future = executor.submit(_command_step, "malware scan", STEP_SCAN_TITLE, [malware_scan])
        futures[future] = ("malware scan", STEP_SCAN_TITLE)

        future = executor.submit(_command_step, "binary smoke test", STEP_SMOKE_TITLE, [smoke_test])
        futures[future] = ("binary smoke test", STEP_SMOKE_TITLE)

        future = executor.submit(_version_step, farm_versions)
        futures[future] = ("version table", STEP_VERSIONS_TITLE)

        future = executor.submit(_checksum_step, script_dir)
        futures[future] = ("checksums", STEP_CHECKSUMS_TITLE)

        results = {}
        for future in concurrent.futures.as_completed(futures):
            name, title = futures[future]
            try:
                result = future.result()
            except Exception as exc:  # noqa: BLE001 - release gate must surface any worker failure.
                result = StepResult(name=name, title=title, returncode=1, output=f"{exc}\n")
            _emit_step_result(result)
            results[result.name] = result

    return results


def _verify_section_md(tag, signing):
    """Copy-paste verification steps for the release notes."""
    steps = [
        "## Verifying this release",
        "",
        "```sh",
        "# from a checkout of the tag (or an extracted source archive):",
        "sha256sum -c sha256sums.txt     # pins the integrity-critical files above",
        "./loadout doctor --verify       # re-hashes every payload file vs .content-manifest",
    ]
    if signing:
        steps.append(f"git tag -v {tag}                # verify the SSH-signed tag")
    steps.append("```")
    return "\n".join(steps)


def _replace_existing_release(tag):
    """Project policy: a given day's release is always the latest state, and the
    tag is date-based (v<YYYY.MM.DD>), so a same-day re-run must REPLACE any
    existing release/tag rather than fail on the collision. Tears down the
    GitHub release (and its assets) and the remote+local tag; a no-op for a
    brand-new tag."""
    exists = subprocess.run(["gh", "release", "view", tag], capture_output=True, text=True)
    if exists.returncode == 0:
        print(f"  replacing existing GitHub release {tag} ...")
        subprocess.run(["gh", "release", "delete", tag, "--yes"])
    _delete_tag(tag)


def _delete_tag(tag):
    """Remove the remote then local tag; ignore absence (fresh tag, or a release
    that exists without a pushed tag). Used both to tear a release down fully and
    to move the tag under a KEPT release (stash-reuse path)."""
    subprocess.run(["git", "push", "origin", "--delete", tag], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["git", "tag", "-d", tag], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _remote_release_exists(tag):
    return subprocess.run(["gh", "release", "view", tag], capture_output=True, text=True).returncode == 0


def _remote_stash_asset(tag):
    """(present, size) for the plugin-stash asset on the existing release TAG."""
    r = subprocess.run(["gh", "release", "view", tag, "--json", "assets"], capture_output=True, text=True)
    if r.returncode != 0:
        return (False, 0)
    try:
        assets = json.loads(r.stdout).get("assets", [])
    except ValueError, AttributeError:
        return (False, 0)
    for a in assets:
        if a.get("name") == STASH_ASSET_NAME:
            return (True, a.get("size", 0))
    return (False, 0)


def _remote_stash_sha(tag):
    """SHA-256 recorded for the plugin stash in the EXISTING release's
    sha256sums.txt, or None if there is no release / no sums asset / no stash
    line. Downloading the tiny sums file is how we compare stash CONTENT without
    the GitHub asset API (which does not expose a content digest). The temp file
    lives OUTSIDE the repo -- the pre-commit hook runs `git add -A`, so a stray
    file in the tree would risk being committed."""
    fd, tmp = tempfile.mkstemp(prefix="release-prev-sums.", suffix=".txt")
    os.close(fd)
    r = subprocess.run(
        ["gh", "release", "download", tag, "-p", SHA256SUMS_NAME, "-O", tmp, "--clobber"],
        capture_output=True,
        text=True,
    )
    sha = None
    if r.returncode == 0 and os.path.isfile(tmp):
        try:
            with open(tmp) as fh:
                for line in fh:
                    parts = line.split()
                    if len(parts) == 2 and parts[1] == STASH_REL:
                        sha = parts[0]
                        break
        except OSError:
            sha = None
    try:
        os.remove(tmp)
    except OSError:
        pass
    return sha


def _can_reuse_stash(tag, stash_path, local_stash_sha):
    """True when the existing release already carries a byte-identical stash
    asset, so the 328 MB upload can be skipped. Requires an existing release, a
    present stash asset whose size matches the local file, AND a matching SHA-256
    in the previous release's sha256sums.txt -- size alone is not proof."""
    if not (os.path.isfile(stash_path) and local_stash_sha and _remote_release_exists(tag)):
        return False
    present, remote_size = _remote_stash_asset(tag)
    if not present or remote_size != os.path.getsize(stash_path):
        return False
    return _remote_stash_sha(tag) == local_stash_sha


def _verify_published_stash(tag, stash_path):
    """(ok, detail): confirm the release is PUBLISHED (not a draft -- a draft is
    invisible to /releases/latest, which is what ./fetch-stash resolves) and
    still carries the stash asset at the right size. Never trust an upload/edit
    exit code; re-read the release and check -- the 2026-07-22 lesson."""
    r = subprocess.run(["gh", "release", "view", tag, "--json", "isDraft,assets"], capture_output=True, text=True)
    if r.returncode != 0:
        return (False, "cannot read the release after publish")
    try:
        d = json.loads(r.stdout)
    except ValueError, AttributeError:
        return (False, "release JSON unparseable after publish")
    if d.get("isDraft"):
        return (False, "release is still a DRAFT (invisible to /releases/latest)")
    want = os.path.getsize(stash_path)
    for a in d.get("assets", []):
        if a.get("name") == STASH_ASSET_NAME:
            if a.get("size") == want:
                return (True, "published; stash asset present, size matches")
            return (False, f"stash asset size {a.get('size')} != local {want}")
    return (False, "stash asset missing from published release")


def _record_skip_scan_justification(script_dir, tag):
    """--skip-scan bypasses the malware gate; record that it happened so the
    ledger has an audit trail rather than a silent skip."""
    log = os.path.join(script_dir, "assurance", "downloads.log")
    try:
        os.makedirs(os.path.dirname(log), exist_ok=True)
        with open(log, "a") as fh:
            date = datetime.datetime.now(datetime.UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
            fh.write(f"{date}\tRELEASE-SKIP-SCAN\ttag={tag or '(auto)'} -- malware scan bypassed via --skip-scan\n")
    except OSError:
        pass


@click.command(
    name="release",
    context_settings={"help_option_names": ["-h", "--help"]},
)
@click.option("--tag", default=None, metavar="TAG", help="Release tag (default: v<today YYYY.MM.DD>).")
@click.option(
    "--dry-run",
    "dry_run",
    is_flag=True,
    help="Run pre-release gates only; skip tagging and GitHub release.",
)
@click.option(
    "--skip-scan",
    "skip_scan",
    is_flag=True,
    help="Skip the YARA malware scan (NOT recommended; only for a known false positive).",
)
@click.option(
    "--allow-unsigned",
    "allow_unsigned",
    is_flag=True,
    help="Release even when the tag cannot be signed (breaks the trust chain; NOT recommended).",
)
def main(tag, dry_run, skip_scan, allow_unsigned):
    """Run pre-release gates, then create a GitHub release.

    Authentication is settled in a preflight step BEFORE any gate runs, because
    the gates are slow and the operator is only reliably at the keyboard at
    kickoff. The malware scan, binary smoke test, version table, and checksum
    generation are independent and run in parallel. The tag/release step waits
    for them and aborts when a mandatory gate fails.

    Requires: gh (GitHub CLI) authenticated, git repo with remote set.
    """
    script_dir = os.path.dirname(os.path.abspath(__file__))
    smoke_test = os.path.join(script_dir, "tests", "prebuilt-binaries")
    farm_versions = os.path.join(script_dir, "build", "farm-versions")
    malware_scan = os.path.join(script_dir, "scan-for-malware")
    tag = tag or "v{}".format(datetime.date.today().strftime("%Y.%m.%d"))

    signing = _preflight(dry_run, allow_unsigned)

    results = _run_parallel_pre_release_steps(script_dir, smoke_test, farm_versions, malware_scan, tag, skip_scan)

    scan_result = results["malware scan"]
    if scan_result.returncode != 0:
        print("\nRelease blocked: malware scan reported detections (or failed).", file=sys.stderr)
        print("Investigate every hit before releasing. Override with --skip-scan only", file=sys.stderr)
        print("if you have confirmed it is a YARA false positive.", file=sys.stderr)
        sys.exit(1)

    smoke_result = results["binary smoke test"]
    if smoke_result.returncode != 0:
        print("\nRelease blocked: binary smoke test failed.", file=sys.stderr)
        print("Fix failing binaries before releasing.", file=sys.stderr)
        sys.exit(1)

    checksum_result = results["checksums"]
    if checksum_result.returncode != 0:
        print("\nRelease blocked: checksum generation failed.", file=sys.stderr)
        sys.exit(1)

    if dry_run:
        print("\nDry run -- pre-release gates passed. Skipping tag and GitHub release.")
        return

    version_table = results["version table"].data or ""
    pairs = checksum_result.data["pairs"]
    sums_path = checksum_result.data["sums_path"]

    # `signing` comes from the preflight, which proved the signer actually
    # produces a signature non-interactively. It is deliberately NOT re-derived
    # from `git config` here: a bare config lookup says a key is *named*, not
    # that signing works, and that gap is exactly how the 2026-07-22 release
    # shipped an unsigned tag. Uploading the key is a one-time owner step --
    # see docs/SECURITY.md section 6.
    notes = "\n\n".join(
        section
        for section in (
            "All pre-built binaries passed smoke test.",
            _checksum_table_md(pairs),
            _verify_section_md(tag, signing),
            version_table.strip(),
        )
        if section
    )

    # The nvim plugin stash rides as an ASSET, not a git payload: it is ~328 MB of bz2'd
    # git packfiles, so committing it added ~328 MB to history on EVERY refresh,
    # permanently. Its sha256 is in sha256sums.txt above, which this signed tag covers --
    # that is the chain ./fetch-stash verifies before the installer will touch the bytes.
    stash = os.path.join(script_dir, STASH_REL)
    local_stash_sha = dict(pairs).get(STASH_REL)

    # Reuse the existing release's stash asset when its bytes are unchanged, so a
    # routine re-release does not re-upload 328 MB. Requires a signed tag: a
    # reused asset is only as trustworthy as the tag that (re)binds sha256sums.txt.
    reuse_stash = bool(signing) and _can_reuse_stash(tag, stash, local_stash_sha)

    # Assets: the sums file plus the content manifest itself, so a downloader can
    # verify the full payload tree without cloning the multi-GB source archive.
    # The stash joins them only when NOT reusing the remote copy.
    assets = [sums_path]
    content_manifest = os.path.join(script_dir, ".content-manifest")
    if os.path.isfile(content_manifest):
        assets.append(content_manifest)
    if os.path.isfile(stash):
        if reuse_stash:
            print(
                f"  reusing the existing release's stash asset "
                f"({os.path.getsize(stash) // 1048576} MB, sha256 unchanged) -- not re-uploading"
            )
        else:
            assets.append(stash)
            print(f"  attaching nvim plugin stash ({os.path.getsize(stash) // 1048576} MB)")
    else:
        print("  NOTE: no nvim-plugin-stash.tar.bz2 -- releasing without it.")
        print("        Users will get nvim with no plugins. Build it with")
        print("        build/build-nvim-plugin-stash if that is not what you want.")

    print()
    _print_heading(f"Step 4: Creating tag and GitHub release: {tag}")

    # Same-day releases replace the existing one (date-based tag). When reusing the
    # stash we must KEEP the release object (it holds the 328 MB asset), so only
    # the tag is moved; otherwise the whole release is torn down and recreated.
    if reuse_stash:
        _delete_tag(tag)
    else:
        _replace_existing_release(tag)

    tag_cmd = ["git", "tag", "-s" if signing else "-a", tag, "-m", tag]
    if not signing:
        print("  WARNING: creating an UNSIGNED annotated tag (--allow-unsigned).")
        print("  The content-manifest trust chain is NOT tamper-evident (docs/SECURITY.md).")
    result = run(tag_cmd)
    if result.returncode != 0:
        print("git tag failed.", file=sys.stderr)
        sys.exit(1)

    # Never take the signer's exit status as proof. Confirm the object really
    # carries a signature before anything downstream claims it does.
    if signing:
        obj = subprocess.run(["git", "cat-file", "-p", tag], capture_output=True, text=True)
        if "BEGIN SSH SIGNATURE" not in obj.stdout and "BEGIN PGP SIGNATURE" not in obj.stdout:
            print("Release blocked: tag was created WITHOUT a signature.", file=sys.stderr)
            subprocess.run(["git", "tag", "-d", tag], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            sys.exit(1)

    result = run(["git", "push", "origin", tag])
    if result.returncode != 0:
        print("git push tag failed.", file=sys.stderr)
        sys.exit(1)

    if reuse_stash:
        # Deleting the tag drafts the kept release (GitHub drafts a release whose
        # tag vanished, and recreating the tag does NOT auto-republish). Undraft
        # it, refresh the notes, and clobber only the small assets -- the stash
        # asset is left in place. Then VERIFY the release is published and still
        # carries the stash; on any doubt self-heal with a full stash upload
        # rather than ship an invisible or asset-less release.
        run(["gh", "release", "edit", tag, "--draft=false", "--notes", notes])
        small = [a for a in assets if a != stash]
        if small:
            result = run(["gh", "release", "upload", tag, *small, "--clobber"])
            if result.returncode != 0:
                print("gh release upload failed.", file=sys.stderr)
                sys.exit(1)
        ok, detail = _verify_published_stash(tag, stash)
        if not ok:
            print(f"  reuse verification failed ({detail}); self-healing with a full stash upload.", file=sys.stderr)
            run(["gh", "release", "upload", tag, stash, "--clobber"])
            run(["gh", "release", "edit", tag, "--draft=false"])
            ok, detail = _verify_published_stash(tag, stash)
            if not ok:
                print(f"Release blocked: {detail}", file=sys.stderr)
                sys.exit(1)
        print(f"  reuse verified: {detail}")
    else:
        result = run(["gh", "release", "create", tag, "--title", tag, "--notes", notes, *assets])
        if result.returncode != 0:
            print("gh release create failed.", file=sys.stderr)
            sys.exit(1)
        # Re-read: confirm the freshly-uploaded stash actually landed (never trust
        # the create exit code alone).
        if os.path.isfile(stash):
            ok, detail = _verify_published_stash(tag, stash)
            if not ok:
                print(f"Release blocked: {detail}", file=sys.stderr)
                sys.exit(1)

    print(f"\nRelease {tag} created" + (" (signed tag)." if signing else " (UNSIGNED tag)."))


if __name__ == "__main__":
    main()
