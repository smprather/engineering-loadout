    "treesitter-parsers": {
      "kind": "data",
      "archive": "treesitter/prebuilt/TS_PLATFORM/parser/",
      "install_to": "~/.local/share/nvim/tree-sitter-parsers/parser",
      "version": "",
      "platforms": ["linux"],
      "default": true,
      "tags": ["editor", "parser"],
      "description": "Pre-built tree-sitter parsers (.so) for 300+ languages"
    },

    "treesitter-queries": {
      "kind": "data",
      "archive": "treesitter/prebuilt/TS_PLATFORM/",
      "install_to": "~/.local/share/nvim/tree-sitter-parsers",
      "version": "",
      "platforms": ["linux"],
      "default": true,
      "tags": ["editor", "parser"],
      "description": "Tree-sitter parser-info, queries, registry, and build-info metadata"
    },

    "env-bash": {
      "kind": "env",
      "source": "bash/",
      "install_to": "~/.config/bash",
      "extra_links": [
        {"from": "~/.config/bash/bashrc", "to": "~/.bashrc"},
        {"from": "~/.config/bash/bashrc", "to": "~/.bash_profile"},
        {"from": "~/.config/bash/bashrc", "to": "~/.bash_login"},
        {"from": "~/.config/bash/bashrc", "to": "~/.profile"}
      ],
      "supports_layers": ["corp", "site", "project", "user"],
      "run_install_scripts": true,
      "platforms": ["linux", "macos"],
      "default": true,
      "tags": ["env", "shell"],
      "recommends": ["bash", "starship", "env-starship", "fzf", "zoxide"],
      "description": "Bash 5-layer config (system → corp → site → project → user) with prompt, aliases, completions"
    },

    "env-nvim": {
      "kind": "env",
      "source": "nvim/",
      "install_to": "~/.config/nvim",
      "supports_layers": ["corp", "site", "project", "user"],
      "platforms": ["linux", "macos", "windows"],
      "default": true,
      "tags": ["env", "editor"],
      "recommends": ["nvim", "treesitter-parsers", "treesitter-queries"],
      "description": "Neovim layer dispatcher (lazy.nvim plugin specs + LSP configs across all layers)"
    },

    "env-vim": {
      "kind": "env",
      "source": "vim/",
      "install_to": "~/.config/vim",
      "extra_links": [
        {"from": "~/.config/vim/vimrc", "to": "~/.vimrc"},
        {"from": "~/.config/vim/vim",   "to": "~/.vim"}
      ],
      "platforms": ["linux", "macos"],
      "default": true,
      "tags": ["env", "editor"],
      "recommends": ["vim"],
      "description": "Vim 9 config + bundled native pack/vendor plugins"
    },

    "env-tmux": {
      "kind": "env",
      "source": "tmux/",
      "install_to": "~/.config/tmux",
      "extra_links": [
        {"from": "~/.config/tmux/tmux.conf", "to": "~/.tmux.conf"},
        {"from": "~/.config/tmux/tmux",      "to": "~/.tmux"}
      ],
      "platforms": ["linux", "macos"],
      "default": true,
      "tags": ["env", "terminal"],
      "recommends": ["tmux"],
      "description": "tmux config + bundled tpm/resurrect/continuum plugins"
    },

    "env-helix": {
      "kind": "env",
      "source": "helix/",
      "install_to": "~/.config/helix",
      "platforms": ["linux", "macos", "windows"],
      "default": true,
      "tags": ["env", "editor"],
      "recommends": ["hx", "helix-runtime"],
      "description": "Helix editor user config (paired with helix-runtime)"
    },

    "env-kak": {
      "kind": "env",
      "source": "kak/kakrc",
      "install_to": "~/.config/kak/kakrc",
      "platforms": ["linux", "macos"],
      "default": true,
      "tags": ["env", "editor"],
      "recommends": ["kak"],
      "description": "Kakoune kakrc (copied only if not already present)"
    },

    "env-starship": {
      "kind": "env",
      "source": "starship/starship.linux.toml",
      "install_to": "~/.config/starship/starship.toml",
      "extra_links": [
        {"from": "starship/config-schema.json", "to": "~/.config/starship/config-schema.json"}
      ],
      "platforms": ["linux", "macos"],
      "default": true,
      "tags": ["env", "prompt"],
      "recommends": ["starship"],
      "description": "Starship prompt config (Linux/macOS variant)"
    },

    "env-wezterm": {
      "kind": "env",
      "source": "wezterm/wezterm.lua",
      "install_to": "~/.config/wezterm/wezterm.lua",
      "platforms": ["windows", "linux", "macos"],
      "default": true,
      "tags": ["env", "terminal"],
      "description": "WezTerm config (Lua)"
    },

    "env-editorconfig": {
      "kind": "env",
      "source": "editorconfig/editorconfig",
      "install_to": "~/.editorconfig",
      "platforms": ["linux", "macos", "windows"],
      "default": true,
      "tags": ["env", "editor"],
      "description": "Root .editorconfig (whitespace + indent defaults)"
    },

    "env-pip": {
      "kind": "env",
      "source": "python/pip.conf",
      "install_to": "~/.config/pip/pip.conf",
      "platforms": ["linux", "macos"],
      "default": true,
      "tags": ["env", "python"],
      "description": "pip config with require-virtualenv=true (protects base Python env)"
    },

    "env-powershell": {
      "kind": "env",
      "source": "powershell/Microsoft.PowerShell_profile.ps1",
      "install_to": "%USERPROFILE%/Documents/PowerShell/Microsoft.PowerShell_profile.ps1",
