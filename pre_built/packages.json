      ],
      "platforms": ["windows"],
      "default": true,
      "tags": ["env", "shell"],
      "description": "PowerShell profile (aliases, coreutils wrappers, PSReadLine, Starship, zoxide, PSFzf)"
    },

    "env-autohotkey": {
      "kind": "env",
      "source": "autohotkey/hotkeys.ahk",
