    "@core-cli": {
      "kind": "group",
      "members": ["rg", "bat", "eza", "fd", "fzf", "zoxide", "jq", "yq",
                  "dasel", "miller", "choose", "sd", "tldr", "broot"],
      "description": "Small, fast, daily-use CLI tools"
    },
    "@system-monitor": {
      "kind": "group",
      "members": ["htop", "btop", "btm", "procs", "duf", "dust", "gping"],
      "description": "Resource and process monitors"
    },
    "@dev-tools": {
      "kind": "group",
      "members": ["just", "hyperfine", "lazygit", "delta", "shfmt", "stylua",
                  "ruff", "ty", "uv", "tree-sitter", "patchelf"],
      "description": "Developer tooling (runners, benchmarkers, formatters, linters)"
    },
    "@editor-cli": {
      "kind": "group",
      "members": ["vim", "nvim", "hx", "micro", "kak"],
      "description": "Terminal modal editors"
    },
    "@editor-gui": {
      "kind": "group",
      "members": ["gvim", "nedit-ng", "meld"],
      "description": "GUI editors (depend on gui_libs)"
    },
    "@editor-suite": {
      "kind": "group",
      "members": ["@editor-cli", "env-vim", "env-nvim", "env-helix", "env-kak"],
      "description": "Editor binaries plus their config bundles"
    },
    "@shells-optional": {
      "kind": "group",
      "members": ["zsh", "fish", "fish-runtime"],
      "description": "Optional shells (bash is in @default)"
    },
    "@compression": {
      "kind": "group",
      "members": ["bzip2", "pigz", "pv"],
      "description": "Compression and pipe utilities"
    },
    "@scientific": {
      "kind": "group",
      "members": ["gnuplot", "octave", "octave-runtime"],
      "description": "Scientific computing (octave is opt-in)"
    },
    "@gui-suite": {
      "kind": "group",
      "members": ["@editor-gui", "gui_libs", "gobject-typelibs", "xterm", "xsel", "yank",
                  "meld-runtime", "vim92-runtime"],
      "description": "Full GUI stack for headless EE farm GUI forwarding"
    },
    "@python-stack": {
      "kind": "group",
      "members": ["portable-python", "uv", "ruff", "ty"],
      "description": "Python interpreter + Astral tooling"
    },
    "@python-tools-extra": {
      "kind": "group",
      "members": ["visidata", "jupyterlab", "time-plot"],
      "description": "Optional Python tools installed via uv tool install"
    },
    "@security": {
      "kind": "group",
      "members": ["yara", "agent-deck"],
      "description": "Security and agent tooling"
    },
    "@core-environments": {
      "kind": "group",
      "members": ["env-bash", "env-tmux", "env-starship", "env-editorconfig", "env-pip"],
      "description": "Essential config bundles (bash, tmux, prompt, editorconfig, pip)"
    },
    "@all-environments": {
      "kind": "group",
      "members": ["@core-environments", "env-nvim", "env-vim", "env-helix", "env-kak"],
      "description": "Every Linux/macOS config bundle"
    },
    "@fonts-default": {
      "kind": "group",
      "members": ["font-firacode", "font-jetbrainsmono"],
      "description": "Smaller default font footprint"
    },
    "@fonts-all": {
      "kind": "group",
      "members": ["@fonts-default", "font-envycoder", "font-hack", "font-inconsolata",
                  "font-iosevkaterm", "font-sourcecodepro"],
      "description": "All bundled Nerd Font families"
    },
    "@data-bundles": {
      "kind": "group",
      "members": ["tldr-data", "treesitter-parsers", "treesitter-queries"],
      "description": "Bundled data caches (tldr, tree-sitter parsers)"
    },
    "@engineering-loadout": {
      "kind": "group",
      "members": ["@default", "@editor-gui", "@gui-suite", "@scientific",
                  "@python-tools-extra", "@fonts-all", "@shells-optional"],
      "description": "Full loadout — every bundled package and group"
    }
  }
}
