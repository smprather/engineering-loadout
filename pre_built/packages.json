      "archive": "pre_built/PLATFORM/portable-python-*.tar.bz2",
      "install_to": "~/.local",
      "version": "3.14.4",
      "platforms": ["linux"],
      "default": true,
      "tags": ["python", "runtime"],
      "description": "BOLT-optimized portable CPython build with bundled install.sh"
    },

    "gobject-typelibs": {
      "kind": "typelib",
      "typelibs": ["Atk-1.0.typelib", "cairo-1.0.typelib", "Gdk-3.0.typelib", "GdkPixbuf-2.0.typelib",
                   "Gio-2.0.typelib", "GIRepository-2.0.typelib", "GLib-2.0.typelib", "GObject-2.0.typelib",
                   "Gtk-3.0.typelib", "GtkSource-3.0.typelib", "Pango-1.0.typelib"],
      "install_to": "~/.local/lib/girepository-1.0",
      "version": "",
      "platforms": ["linux"],
      "default": true,
      "tags": ["gui", "gobject"],
      "description": "GObject introspection typelibs (GLib/Gtk3/GtkSource3/Pango/Atk/cairo)"
    },

    "helix-runtime": {
      "kind": "runtime",
