      "install_to": "~/.cache/tealdeer/tldr-pages",
      "version": "",
      "platforms": ["linux", "macos", "windows"],
      "default": true,
      "tags": ["docs", "cache"],
      "description": "Bundled tldr-pages cache for offline tealdeer use"
