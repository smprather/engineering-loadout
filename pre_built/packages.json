{
  "_comment": "Package registry for the engineering-loadout installer (formerly dotfiles). See pre_built/ADDING_BINARIES.md for the workflow.",

  "schema_version": 2,

  "_schema": {
    "kind":                "Package type: 'bin', 'lib-bundle', 'runtime', 'typelib', 'python-base', 'python-tool', 'env', 'font', 'data', 'group'.",
    "default":             "If true, installed when no selection flags given. Inverted polarity of legacy 'optional'. When both present, 'default' wins.",
    "platforms":           "List of platforms where this package is valid: 'linux', 'macos', 'windows'. Default ['linux'] when omitted.",
    "tags":                "Free-form labels for filtering/grouping (e.g. ['search', 'editor', 'gui']).",
    "depends":             "Hard dependencies: package names (or @group refs) that MUST be installed alongside this one. Resolver auto-pulls them; skipping a hard dep of a selected pkg is an error unless --no-deps or --force.",
    "recommends":          "Soft dependencies: package names (or @group refs) auto-pulled when available; silently dropped if skipped or unavailable.",
    "archive":             "Path (relative to repo root) to the archive this package extracts. For kinds 'runtime', 'font', 'data', 'python-base'.",
    "install_to":          "Target install path. '~' expanded at install time.",
    "source":              "Source dir or file (relative to repo root). For kind='env'.",
    "extra_links":         "List of {from, to} entries describing additional symlinks to create after the env is installed.",
    "supports_layers":     "For kind='env': layer names (corp/site/project/user) the env supports for user overrides.",
    "run_install_scripts": "For kind='env': if true, run install hooks discovered in the deployed env dir.",
    "members":             "For kind='group': list of package names or @group refs the group expands to. Resolver expands recursively with cycle detection.",
    "bins":                "(legacy) List of bin/*.bz2 stems (without .bz2) owned by this package.",
    "libs":                "(legacy) List of lib64/*.bz2 stems exclusively owned by this package. Omit or leave empty for libs shared by multiple tools — those are always installed.",
    "typelibs":            "(legacy) List of typelibs/*.typelib files required by this package (documentation only; all typelibs in the dir are always installed).",
    "wheels":              "(legacy) List of Python package names whose wheels are bundled in wheels/ for offline uv tool install.",
    "uv_tool":             "(legacy) Package name passed to 'uv tool install' for Python-based tools. Triggers install_python_tools().",
    "version":             "(legacy) Version of the bundled binary or package.",
    "description":         "(legacy) One-line description shown by --list-tools.",
    "optional":            "DEPRECATED — use 'default: false' instead. Still honored when 'default' is absent."
  },

  "packages": {
