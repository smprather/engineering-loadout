#!/bin/sh
# Drop into (or run a command in) the AlmaLinux 8.10 build-machine container
# defined by build/Dockerfile, with this repo bind-mounted at /repo.
#
# See build/Dockerfile's header for why payload-mutating work (build-*.sh,
# strip-all-elf-binaries, gen-content-manifest, gen-installed-sizes,
# gen-readme-table) must run in here rather than on the native host.
#
# Usage:
#   build/build-shell                       # interactive shell in /repo
#   build/build-shell ./build/build-tmux.sh --tag 3.7b
#   build/build-shell ./build/strip-all-elf-binaries
#
# Builds the image on first use (or after Dockerfile changes); cached after
# that, so this stays fast. Runs as the invoking user's uid:gid so files the
# container writes into the bind-mounted repo are not root-owned on the host.

set -eu

REPO="$(cd "$(dirname "$0")/.." && pwd)"
IMAGE="loadout-build"

# Persistent build cache, bind-mounted at /cache. The container is --rm, so
# anything a build writes to its own /tmp dies with it -- fine for a 2-minute
# binary, ruinous for openroad (60-90 min, most of it OR-Tools). Long builds
# point their prefixes here (see LOADOUT_BUILD_CACHE in build-openroad.sh), so a
# failed run resumes instead of starting from zero.
CACHE_DIR="${LOADOUT_BUILD_CACHE:-$HOME/.cache/loadout-build}"
mkdir -p "$CACHE_DIR"

docker build -q -t "$IMAGE" -f "$REPO/build/Dockerfile" "$REPO/build" >/dev/null

if [ "$#" -eq 0 ]; then
    set -- bash
fi

tty_flags=""
if [ -t 0 ] && [ -t 1 ]; then
    tty_flags="-it"
fi

# python3.15 on PATH inside the container. The build image deliberately does
# NOT install python3.15 (build/Dockerfile: loadout self-hosts it), so the
# repo's own bootstrap tree -- the SAME portable-python the payload ships,
# extracted by ./loadout -- is put on PATH here. Several repo scripts are
# `#!/usr/bin/env python3.15` (strip-all-elf-binaries, gen-installed-sizes,
# gen-content-manifest, gen-readme-table) and the build scripts invoke them
# by path, so without this they die with "env: 'python3.15': No such file or
# directory" -- which is how build-klayout.sh's final strip step failed on
# 2026-10-21.
#
# The bootstrap tree is extracted from payload/<platform>/portable-python-*.tar.bz2
# by the `loadout` shim (offline, no dnf package needed). If it is not there
# yet, create it here -- the extraction is the shim's cold-bootstrap path.
BOOT="$REPO/.loadout-bootstrap"
if [ ! -x "$BOOT/bin/python3.15" ]; then
    archive=$(ls "$REPO"/payload/*/portable-python-*.tar.bz2 2>/dev/null | head -1)
    if [ -n "$archive" ]; then
        archive_root=$(basename "$archive" .tar.bz2)
        mkdir -p "$BOOT"
        bzip2 -dc "$archive" | tar xf - -C "$BOOT" --strip-components=2 "$archive_root/local"
    fi
fi
if [ -x "$BOOT/bin/python3.15" ]; then
    # The container sees the repo at /repo, so the bootstrap is at
    # /repo/.loadout-bootstrap there -- the HOST path would point at host
    # directories that do not exist in the container. The image's own PATH is
    # the base (verified to be exactly what is set below).
    boot_path="/repo/.loadout-bootstrap/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
else
    echo "WARNING: no python3.15 bootstrap in $BOOT -- repo scripts with a" >&2
    echo "         python3.15 shebang will fail. Run ./loadout -V first." >&2
    boot_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
fi

# --- timing (first-class requirement) --------------------------------------
# The release gates and the test suite are timed, but the DOMINANT cost of a
# release is the payload REBUILDS: openroad 60-90 min, strace-ui ~35 min,
# klayout ~25 min -- none of which the release gates see. build-shell is the
# MANDATED entry point for all payload work (build/Dockerfile: "do all
# compiling/packaging/payload-mutating work in this container via
# build/build-shell"), so timing it HERE captures every rebuild with no
# per-script change.
#
# The row lands in the same tracked timeline as the release gates
# (assurance/release-timings.tsv), so "where did the release time go" has
# the rebuilds in it and not just the two-minute gates. The gate name is
# "build:<script>" -- build:build-openroad.sh, build:build-klayout.sh, ...
#
# `exec` is replaced by a foreground run so the duration can be measured; the
# container still gets the terminal (docker run -it) and the host shell
# forwards SIGINT to the foreground process group, so an interactive session
# still interrupts the container.
_t_start=$(date +%s)
_t_label="build:shell"
for _t_arg in "$@"; do
    case "$_t_arg" in
        -*) continue ;;
        *.sh|*/build-*) _t_label="build:$(basename "$_t_arg")"; break ;;
    esac
done

# shellcheck disable=SC2086  # tty_flags is intentionally word-split (1 or 2 flags)
_t_rc=0
docker run --rm $tty_flags \
    -v "$REPO:/repo" \
    -w /repo \
    -u "$(id -u):$(id -g)" \
    -v /etc/passwd:/etc/passwd:ro \
    -v /etc/group:/etc/group:ro \
    -v "$CACHE_DIR:/cache" \
    -e HOME=/tmp \
    -e PATH="$boot_path" \
    -e LOADOUT_BUILD_CACHE=/cache \
    -e LOADOUT_PATCHELF=/usr/bin/patchelf \
    "$IMAGE" "$@" || _t_rc=$?

_t_end=$(date +%s)
# Timing data must never fail a build.
{
    printf '%s\t%s\t%s\t%s\t%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        "$_t_label" \
        "$((_t_end - _t_start))" \
        "$([ "$_t_rc" -eq 0 ] && echo PASS || echo FAIL)" \
        "build-shell" \
        >> "$REPO/assurance/release-timings.tsv"
} 2>/dev/null || true

exit "$_t_rc"
