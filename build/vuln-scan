#!/usr/bin/env python3.14
"""vuln-scan -- known-vulnerability scan of the pinned wheelhouse via osv-scanner.

Scope: the Python wheelhouse (newest version per package -- what a fresh uv
resolve selects). Distro-provided libraries (glibc, openssl, Qt, ...) are not
represented in OSV ecosystems and stay out of scope; the malware scan covers
the shipped bytes.

Policy: a finding fails the run unless assurance/vuln-baseline.json accepts
that exact package@version AND advisory id with a written reason. Stale
baseline entries (advisory no longer reported) are printed so the baseline
cannot rot. --update-baseline regenerates it; review every auto-generated
reason.

    ./build/vuln-scan                  # gate: fail on unbaselined findings
    ./build/vuln-scan --all-versions   # also older wheelhouse versions
    ./build/vuln-scan --update-baseline
    ./build/vuln-scan --report /tmp/findings.json
"""

import json
import os
import re
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import security_tools  # noqa: E402

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BASELINE = os.path.join(REPO, "assurance", "vuln-baseline.json")


def normalize(name):
    return re.sub(r"[-_.]+", "-", name).lower()


def _version_key(version):
    """Sortable PEP440-ish key: numeric chunks first, then text. Good enough for
    the wheelhouse (release-only versions); documented, not a full comparator."""
    parts = re.split(r"[._-]", version)
    key = []
    for part in parts:
        if part.isdigit():
            key.append((0, int(part), ""))
        else:
            key.append((1, 0, part))
    return key


def newest_wheels(wheels_dir):
    """[(normalized_name, version)] -- newest wheel per package."""
    best = {}
    for name in sorted(os.listdir(wheels_dir)):
        if not name.endswith(".whl"):
            continue
        parts = name[:-4].split("-")
        if len(parts) < 2:
            continue
        norm, version = normalize(parts[0]), parts[1]
        if norm not in best or _version_key(version) > _version_key(best[norm]):
            best[norm] = version
    return sorted(best.items())


def all_wheels(wheels_dir):
    """[(normalized_name, version)] -- every wheel in the wheelhouse."""
    out = []
    for name in sorted(os.listdir(wheels_dir)):
        if not name.endswith(".whl"):
            continue
        parts = name[:-4].split("-")
        if len(parts) >= 2:
            out.append((normalize(parts[0]), parts[1]))
    return out


def _fixed_versions(vuln):
    fixed = set()
    for affected in vuln.get("affected", []):
        for rng in affected.get("ranges", []):
            for event in rng.get("events", []):
                if "fixed" in event:
                    fixed.add(str(event["fixed"]))
    return sorted(fixed, key=_version_key)


def scan_lockfiles(tmp_dir):
    """Run osv-scanner over tmp_dir; return {(name, version): {advisories, fixed}}."""
    osv = security_tools.tool_path("osv-scanner")
    out_path = os.path.join(tmp_dir, "osv.json")
    cmd = [osv, "scan", "source", "-r", tmp_dir, "--format", "json", "--output-file", out_path]
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode not in (0, 1):
        print(proc.stderr, file=sys.stderr)
        print("ERROR: osv-scanner failed.", file=sys.stderr)
        sys.exit(2)
    if not os.path.isfile(out_path):
        print(proc.stderr, file=sys.stderr)
        print("ERROR: osv-scanner produced no report.", file=sys.stderr)
        sys.exit(2)
    with open(out_path) as fh:
        doc = json.load(fh)
    findings = {}
    for result in doc.get("results", []):
        for pkg in result.get("packages", []):
            p = pkg["package"]
            advisories = pkg.get("vulnerabilities", [])
            if not advisories:
                continue
            key = (p["name"], p["version"])
            entry = findings.setdefault(key, {"advisories": set(), "fixed": set()})
            for vuln in advisories:
                entry["advisories"].add(vuln["id"])
                entry["fixed"].update(_fixed_versions(vuln))
    return {
        key: {
            "advisories": sorted(value["advisories"]),
            "fixed": sorted(value["fixed"], key=_version_key),
        }
        for key, value in findings.items()
    }


def load_baseline(path=BASELINE):
    if not os.path.isfile(path):
        return {"schema": 1, "accepted": {}}
    with open(path) as fh:
        doc = json.load(fh)
    if doc.get("schema") != 1 or not isinstance(doc.get("accepted"), dict):
        print(f"ERROR: {path} is not a schema-1 baseline.", file=sys.stderr)
        sys.exit(2)
    return doc


def classify(findings, baseline):
    """(blocking, stale): unbaselined findings and stale baseline pairs."""
    accepted = baseline.get("accepted", {})
    blocking = {}
    for (name, version), data in sorted(findings.items()):
        key = f"{name}@{version}"
        accepted_ids = set(accepted.get(key, {}).get("advisories", []))
        missing = [a for a in data["advisories"] if a not in accepted_ids]
        if missing:
            blocking[key] = {"missing": missing, "fixed": data["fixed"]}
    stale = []
    for key, entry in sorted(accepted.items()):
        if key not in {f"{n}@{v}" for n, v in findings}:
            stale.append((key, list(entry.get("advisories", []))))
            continue
        name, version = key.rsplit("@", 1)
        current = set(findings.get((name, version), {}).get("advisories", []))
        gone = [a for a in entry.get("advisories", []) if a not in current]
        if gone:
            stale.append((key, gone))
    return blocking, stale


def write_baseline(findings, old_baseline, path=BASELINE):
    accepted = {}
    old = old_baseline.get("accepted", {})
    for (name, version), data in sorted(findings.items()):
        key = f"{name}@{version}"
        reason = old.get(key, {}).get("reason")
        if not reason:
            if data["fixed"]:
                reason = "REVIEW -- fixed in {}; refresh the wheel or document why not".format(", ".join(data["fixed"]))
            else:
                reason = "REVIEW -- no fixed version published; document why this is not exploitable"
        accepted[key] = {"advisories": data["advisories"], "reason": reason}
    doc = {
        "schema": 1,
        "note": "Accepted findings for build/vuln-scan. Every entry needs a reviewed reason; "
        "stale entries are reported and must be removed after a refresh.",
        "accepted": accepted,
    }
    with open(path, "w") as fh:
        json.dump(doc, fh, indent=2)
        fh.write("\n")


def main(argv):
    all_versions = "--all-versions" in argv
    update = "--update-baseline" in argv
    baseline_path = BASELINE
    report_path = None
    if "--baseline" in argv:
        baseline_path = argv[argv.index("--baseline") + 1]
    if "--report" in argv:
        report_path = argv[argv.index("--report") + 1]

    platform_dir = security_tools.payload_platform_dir()
    wheels_dir = os.path.join(platform_dir, "wheels")
    wheels = all_wheels(wheels_dir) if all_versions else newest_wheels(wheels_dir)
    print(f"vuln-scan: {len(wheels)} wheel package(s){' (all versions)' if all_versions else ' (newest per package)'}")

    with tempfile.TemporaryDirectory(prefix=".loadout-vuln-scan-") as tmp:
        with open(os.path.join(tmp, "requirements.txt"), "w") as fh:
            for name, version in wheels:
                fh.write(f"{name}=={version}\n")
        findings = scan_lockfiles(tmp)

    if report_path:
        with open(report_path, "w") as fh:
            json.dump({f"{n}@{v}": d for (n, v), d in findings.items()}, fh, indent=2)
            fh.write("\n")

    baseline = load_baseline(baseline_path)
    blocking, stale = classify(findings, baseline)

    print(f"  {len(findings)} package(s) with advisories; {len(baseline.get('accepted', {}))} baseline entr(y/ies)")
    for key, data in sorted(blocking.items()):
        fixed = ", ".join(data["fixed"]) if data["fixed"] else "no fixed version published"
        print(f"  UNBASELINED  {key}: {', '.join(data['missing'])} (fixed: {fixed})")
    for key, ids in stale:
        print(f"  STALE BASELINE  {key}: {', '.join(ids)} no longer reported")
    if stale:
        print("  -> refresh the baseline with --update-baseline after reviewing")

    if update:
        write_baseline(findings, baseline, baseline_path)
        print(f"  baseline written: {baseline_path} (review every reason)")
        return 0
    if blocking:
        print("\nvuln-scan: FAIL -- unbaselined advisories (see above).", file=sys.stderr)
        return 1
    print("vuln-scan: CLEAN -- every blocking advisory is baselined")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
