#!/usr/bin/env python3.14
"""
export: publish a verified, git-less copy of this checkout to an install directory.

The result is byte-for-byte what a GitHub release tarball contains -- `git archive`
applies the same `export-ignore` rules -- so the installation directory carries the
payload, the installer, `.content-manifest` and the docs, but none of the dev
tooling (`build/`, `tests/`, `update`, `release`, `scan-for-malware`, AGENTS.md...)
and no `.git`.

WHY THIS EXISTS RATHER THAN "just run git archive": the security claims survive an
export only if the export is of something that was actually verified. `git archive`
archives a COMMIT, so uncommitted edits silently do not ship, and nothing stops you
archiving a tree whose payload no longer matches its manifest. This runs the checks
first and refuses on failure.

WHAT SURVIVES INTO THE EXPORT (verified, not assumed -- see docs/RELEASE.md):
  - `.content-manifest`, the strict sha256 allowlist covering every payload file.
    The installer enforces it on EVERY install, so follow-on
    `./loadout install <pkg>` from the install directory is checked exactly as it
    is from a clone. A single flipped byte fails with CONTENT VERIFICATION FAILED.
  - `.release-version`, stamped by `git archive`'s export-subst, so a git-less tree
    still reports a real version instead of "unknown".
  - `fetch-stash` / `refresh-stash`, deliberately not export-ignored, so the
    exported tree can still acquire and re-verify the Neovim plugin stash.

WHAT CHANGES: in the release flow the chain is
    signed tag -> sha256sums.txt -> .content-manifest -> payload bytes
When YOU export locally there is no signed tag over your export, so you become the
authority for that last hop. That is not a weakening if you verify before
exporting, which is what this script enforces -- but if anyone else installs from
the directory, pass --with-sums so they can check `.content-manifest` against the
release independently.

Usage:
    ./build/export /path/to/install-dir
    ./build/export /path/to/install-dir --with-sums        # also copy sha256sums.txt
    ./build/export /path/to/install-dir --fetch-stash      # download the stash fresh
    ./build/export /path/to/install-dir --no-stash         # skip the stash entirely
    ./build/export /path/to/install-dir --allow-dirty      # ONLY archives HEAD regardless
"""

import hashlib
import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.request

_d = os.path.dirname(os.path.abspath(__file__))
while _d not in ("", "/") and not os.path.isdir(os.path.join(_d, "installer_vendor")):
    _d = os.path.dirname(_d)
if os.path.isdir(os.path.join(_d, "installer_vendor")):
    sys.path.insert(0, os.path.join(_d, "installer_vendor"))

import rich_click as click  # noqa: E402

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
STASH_REL = "envs/nvim/vendor/plugins/nvim-plugin-stash.tar.bz2"
FETCHED_MANIFEST = ".content-manifest.fetched"
SUMS_NAME = "sha256sums.txt"
SLUG = "smprather/engineering-loadout"


def eprint(*a):
    print(*a, file=sys.stderr, flush=True)


def info(*a):
    # Flush: fetch-stash writes directly to fd 1, so unflushed prints here would
    # appear after its output and misrepresent the order things happened in.
    print(*a, flush=True)


def _sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def _git(*args, check=True):
    return subprocess.run(["git", "-C", REPO, *args], capture_output=True, text=True, check=check)


def _heading(msg):
    print("=" * 62)
    print(msg)
    print("=" * 62, flush=True)


def check_clean_tree(allow_dirty):
    """`git archive` archives HEAD, so uncommitted work silently does not ship.

    That is the right behaviour -- you export what you committed -- but it makes a
    dirty tree a trap: the directory you hand out would not match the tree you
    tested. Refuse unless the operator says otherwise.
    """
    dirty = _git("status", "--porcelain").stdout.strip()
    if not dirty:
        info("  working tree  : clean")
        return True
    n = len(dirty.splitlines())
    if allow_dirty:
        info(f"  working tree  : DIRTY ({n} path(s)) -- --allow-dirty given, archiving HEAD anyway")
        info("                  those uncommitted changes will NOT be in the export.")
        return True
    eprint(f"\nRefusing to export: {n} uncommitted path(s).")
    eprint("`git archive` ships HEAD, so those changes would silently be missing from")
    eprint("the install directory. Commit them, or pass --allow-dirty to export HEAD as-is.")
    eprint("")
    for line in dirty.splitlines()[:10]:
        eprint("    " + line)
    if n > 10:
        eprint(f"    ... and {n - 10} more")
    return False


def check_signed_tag():
    """Advisory: report whether HEAD's nearest tag still verifies.

    Never fatal -- exporting an untagged commit is legitimate. But the three
    outcomes must not be conflated: "verifies", "the signature is BAD", and
    "verification could not be attempted" mean very different things, and
    reporting the third as the second sends people hunting a compromise that
    isn't there. `gpg.ssh.allowedSignersFile` is commonly set repo-locally, so a
    fresh clone simply has no trust roots configured.
    """
    r = _git("describe", "--tags", "--abbrev=0", check=False)
    tag = r.stdout.strip()
    if r.returncode != 0 or not tag:
        info("  signed tag    : none reachable from HEAD (advisory)")
        return
    v = _git("tag", "-v", tag, check=False)
    blob = v.stdout + v.stderr
    if "Good" in blob and "signature" in blob.lower():
        info(f"  signed tag    : {tag} verifies")
        return
    if "allowedSignersFile" in blob:
        info(f"  signed tag    : {tag} -- CANNOT VERIFY: gpg.ssh.allowedSignersFile is not configured")
        info("                  This does NOT mean the tag is bad, only that this clone has no")
        info("                  trust roots. It is usually set repo-locally; make it global with:")
        info("                    git config --global gpg.ssh.allowedSignersFile ~/.ssh/allowed_signers")
        return
    if "BAD signature" in blob or "bad signature" in blob.lower():
        info(f"  signed tag    : {tag} has a BAD SIGNATURE -- stop and investigate this clone")
        return
    info(f"  signed tag    : {tag} did not verify (advisory) -- {blob.strip().splitlines()[0][:70]}")


def check_payload(skip_verify):
    """Re-hash every payload file against .content-manifest before exporting.

    This is the claim the install directory inherits, so prove it here rather than
    assume it: an export of a tree whose payload already drifted would hand out a
    directory that fails on the user's first install.
    """
    if skip_verify:
        info("  payload       : SKIPPED (--skip-verify) -- the export is unverified")
        return True
    proc = subprocess.run(
        [os.path.join(REPO, "loadout"), "doctor", "--verify"],
        capture_output=True,
        text=True,
        cwd=REPO,
    )
    out = proc.stdout + proc.stderr

    # Judge on the manifest result, NOT on doctor's exit status. doctor exits
    # non-zero for anything it dislikes -- including a missing nvim plugin stash,
    # which is gitignored and fetched separately, so it is ABSENT BY DESIGN in a
    # fresh clone. Treating that as "payload does not match the manifest" refused
    # every clean clone, and refused hardest when --fetch-stash was passed, whose
    # entire premise is that the stash is not there yet.
    verified_line = next((ln.strip() for ln in out.splitlines() if "content-manifest verified" in ln), None)
    if verified_line is None:
        eprint("\nRefusing to export: payload does not match .content-manifest.")
        for line in out.splitlines():
            if any(k in line.lower() for k in ("mismatch", "drift", "verif", "error")):
                eprint("    " + line.strip())
        eprint("\nRegenerate it with `python3.14 build/gen-content-manifest` if the payload")
        eprint("changed on purpose (see docs/RELEASE.md section 4).")
        return False
    info("  payload       : " + verified_line)

    # A missing archive is still worth refusing over -- unless it is the stash.
    missing = []
    collecting = False
    for line in out.splitlines():
        if line.startswith("Missing archives"):
            collecting = True
            continue
        if collecting:
            if not line.startswith(" "):
                break
            missing.append(line.strip())
    other = [m for m in missing if STASH_REL not in m]
    if other:
        eprint("\nRefusing to export: payload archives are missing.")
        for m in other:
            eprint("    " + m)
        return False
    if missing:
        info("  stash archive : absent (expected -- gitignored, acquired via fetch-stash)")
    return True


def do_archive(dest, force):
    if os.path.exists(dest) and os.listdir(dest):
        if not force:
            eprint(f"\nRefusing to export: {dest} exists and is not empty (pass --force to overwrite).")
            return False
        info(f"  clearing      : {dest} (--force)")
        for name in os.listdir(dest):
            p = os.path.join(dest, name)
            shutil.rmtree(p) if os.path.isdir(p) and not os.path.islink(p) else os.remove(p)
    os.makedirs(dest, exist_ok=True)
    tar = subprocess.Popen(["git", "-C", REPO, "archive", "--format=tar", "HEAD"], stdout=subprocess.PIPE)
    extract = subprocess.Popen(["tar", "x", "-C", dest], stdin=tar.stdout)
    tar.stdout.close()
    extract.communicate()
    if tar.wait() != 0 or extract.returncode != 0:
        eprint("\ngit archive | tar failed")
        return False
    return True


def place_stash(dest, mode, from_file, sums):
    """Get the plugin stash into the export without weakening its verification.

    Reusing the local copy is the fast path, but the hash is RE-CHECKED against
    .content-manifest.fetched rather than trusting that file -- otherwise a stash
    that changed on disk since it was fetched would be copied out with a stale
    attestation, which is exactly the kind of quiet gap this chain exists to close.
    """
    src_stash = os.path.join(REPO, STASH_REL)
    src_fetched = os.path.join(REPO, FETCHED_MANIFEST)
    dest_stash = os.path.join(dest, STASH_REL)

    if mode == "none":
        info("  stash         : skipped (--no-stash); nvim installs, plugin step warns")
        return True

    if mode == "fetch" or from_file:
        cmd = [os.path.join(dest, "tools/fetch-stash")]
        if from_file:
            cmd += ["--from-file", os.path.abspath(from_file)]
            if sums:
                cmd += ["--sums", os.path.abspath(sums)]
        info("  stash         : running fetch-stash in the export ...")
        rc = subprocess.run(cmd, cwd=dest).returncode
        if rc != 0:
            eprint("  stash         : fetch-stash FAILED -- the export has no verified stash")
            return False
        return True

    # Default: reuse the local copy when it is present AND still matches its record.
    if not os.path.isfile(src_stash):
        info("  stash         : not present locally -- run ./tools/fetch-stash in the export later")
        return True
    recorded = None
    if os.path.isfile(src_fetched):
        for line in open(src_fetched, encoding="utf-8"):
            parts = line.split()
            if len(parts) == 3 and parts[2] == STASH_REL:
                recorded = parts[1]
    if recorded is None:
        info("  stash         : present but not in .content-manifest.fetched -- NOT copied")
        info("                  (run ./tools/fetch-stash in the export; an unverified stash is refused)")
        return True
    actual = _sha256(src_stash)
    if actual != recorded:
        eprint("  stash         : local copy does NOT match .content-manifest.fetched -- NOT copied")
        eprint(f"                  recorded {recorded[:16]}.. != on-disk {actual[:16]}..")
        eprint("                  re-run ./tools/fetch-stash here, then export again.")
        return False
    os.makedirs(os.path.dirname(dest_stash), exist_ok=True)
    shutil.copy2(src_stash, dest_stash)
    shutil.copy2(src_fetched, os.path.join(dest, FETCHED_MANIFEST))
    mb = os.path.getsize(dest_stash) // 1048576
    info(f"  stash         : copied ({mb} MB), sha256 re-verified against its record")
    return True


def _release_sums_url(tag):
    return f"https://github.com/{SLUG}/releases/download/{tag}/{SUMS_NAME}"


def sums_available(with_sums):
    """Can --with-sums be satisfied? Checked BEFORE any expensive work.

    sha256sums.txt is gitignored, so a fresh clone never has one -- and finding
    that out *after* a 327 MB stash download (as this did) is a waste of the
    operator's time for a completely predictable failure.
    """
    if not with_sums:
        return True
    if os.path.isfile(os.path.join(REPO, SUMS_NAME)):
        return True
    tag = _git("describe", "--tags", "--abbrev=0", check=False).stdout.strip()
    if tag:
        info(f"  {SUMS_NAME}   : not local -- will download it from release {tag}")
        return True
    eprint(f"\nRefusing to export: --with-sums given but {SUMS_NAME} is not present and")
    eprint("no release tag is reachable from HEAD to download it from.")
    eprint("Generate it with ./build/release, fetch it from the release page, or drop --with-sums.")
    return False


def place_sums(dest, with_sums):
    """sha256sums.txt is gitignored, so it is never in the archive.

    Without it nobody but you can check `.content-manifest` itself against the
    release -- fine for a personal install dir, not fine if others install from it.
    """
    if not with_sums:
        return True
    src = os.path.join(REPO, SUMS_NAME)
    out = os.path.join(dest, SUMS_NAME)
    if os.path.isfile(src):
        shutil.copy2(src, out)
        info(f"  {SUMS_NAME}   : copied -- third parties can verify .content-manifest independently")
        return True
    tag = _git("describe", "--tags", "--abbrev=0", check=False).stdout.strip()
    url = _release_sums_url(tag)
    try:
        with urllib.request.urlopen(url, timeout=60) as r, open(out, "wb") as fh:
            fh.write(r.read())
    except (urllib.error.URLError, OSError) as exc:
        eprint(f"  {SUMS_NAME}   : could not download from {url}: {exc}")
        eprint("                  (the export is complete and usable; only --with-sums failed)")
        return False
    info(f"  {SUMS_NAME}   : downloaded from release {tag}")
    return True


@click.command(context_settings={"help_option_names": ["-h", "--help"]})
@click.argument("dest", type=click.Path(file_okay=False))
@click.option("--allow-dirty", is_flag=True, help="Export HEAD even with uncommitted changes (they will NOT ship).")
@click.option("--skip-verify", is_flag=True, help="Skip the payload check (NOT recommended).")
@click.option("--force", is_flag=True, help="Overwrite a non-empty destination.")
@click.option("--with-sums", is_flag=True, help=f"Also copy {SUMS_NAME} so others can verify the manifest.")
@click.option("--fetch-stash", "fetch_stash", is_flag=True, help="Download the stash fresh instead of copying.")
@click.option("--no-stash", "no_stash", is_flag=True, help="Do not place the plugin stash at all.")
@click.option(
    "--stash-from-file", type=click.Path(dir_okay=False), help="Stash file to verify + install into the export."
)
@click.option("--sums", type=click.Path(dir_okay=False), help=f"{SUMS_NAME} to verify --stash-from-file against.")
def main(dest, allow_dirty, skip_verify, force, with_sums, fetch_stash, no_stash, stash_from_file, sums):
    """Publish a verified, git-less copy of this checkout to DEST.

    DEST is then a working loadout: `DEST/loadout install <pkg>` verifies every
    payload file against .content-manifest exactly as a clone does.
    """
    dest = os.path.abspath(dest)

    _heading("Pre-export checks")
    if not check_clean_tree(allow_dirty):
        raise SystemExit(1)
    check_signed_tag()
    if not check_payload(skip_verify):
        raise SystemExit(1)
    # Checked here, before the archive and any 327 MB stash download: a
    # predictable failure should not cost the operator ten minutes first.
    if not sums_available(with_sums):
        raise SystemExit(1)

    _heading(f"Exporting HEAD -> {dest}")
    if not do_archive(dest, force):
        raise SystemExit(1)
    version = "unknown"
    vf = os.path.join(dest, ".release-version")
    if os.path.isfile(vf):
        version = open(vf, encoding="utf-8").read().strip()
    info(f"  version       : {version}")

    mode = "none" if no_stash else ("fetch" if fetch_stash else "copy")
    if not place_stash(dest, mode, stash_from_file, sums):
        raise SystemExit(1)
    if not place_sums(dest, with_sums):
        raise SystemExit(1)

    _heading("Done")
    info(f"  {dest}")
    print("")
    info("  Verify it stands on its own:")
    info(f"    cd {dest} && ./loadout doctor --verify")
    print("")
    info("  Then install from it:")
    info(f"    {dest}/loadout install @engineering-loadout")


if __name__ == "__main__":
    main()
