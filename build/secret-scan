#!/usr/bin/env python3.14
"""secret-scan -- gitleaks over the first-party tree (T1 + release gate).

Scans the checkout for committed secrets with the committed gitleaks engine
(build/gitleaks/: pinned, provenance-documented, offline-capable) and the
committed config (build/gitleaks/loadout.toml, which extends the default rules
and allowlists vendored trees and generated hash inventories -- see the config
for every reviewed exception).

    ./build/secret-scan             # working tree (fast; the release/T1 gate)
    ./build/secret-scan --history   # full git history (slower; periodic audit)
    ./build/secret-scan --report out.json

Exit 0 only when no un-allowlisted leak is found. A --history hit in an old
commit cannot be fixed by editing -- treat it as a rotation event, not a
deletion.
"""

import bz2
import hashlib
import json
import os
import stat
import subprocess
import sys
import tempfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
GITLEAKS_DIR = os.path.join(REPO, "build", "gitleaks")
CONFIG = os.path.join(GITLEAKS_DIR, "loadout.toml")
CACHE = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache"),
    "engineering-loadout",
    "secret-scan-v1",
)


def _sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def gitleaks_bin():
    """Extract the committed engine, verifying the bz2 against sha256.txt first."""
    bz2_path = os.path.join(GITLEAKS_DIR, "gitleaks.bz2")
    want = open(os.path.join(GITLEAKS_DIR, "sha256.txt")).read().split()[0]
    got = _sha256(bz2_path)
    if got != want:
        print(f"ERROR: {bz2_path} sha256 {got} != pinned {want}", file=sys.stderr)
        print("The committed engine changed without updating sha256.txt.", file=sys.stderr)
        sys.exit(2)
    version = open(os.path.join(GITLEAKS_DIR, "version.txt")).read().strip()
    dest_dir = os.path.join(CACHE, f"gitleaks-{version}")
    dest = os.path.join(dest_dir, "gitleaks")
    if not os.path.isfile(dest):
        os.makedirs(dest_dir, exist_ok=True)
        tmp = dest + ".tmp"
        with bz2.open(bz2_path, "rb") as src, open(tmp, "wb") as fh:
            while True:
                chunk = src.read(1024 * 1024)
                if not chunk:
                    break
                fh.write(chunk)
        os.chmod(tmp, stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP | stat.S_IROTH | stat.S_IXOTH)
        os.replace(tmp, dest)
    return dest


def _print_findings(findings):
    print(f"secret-scan: {len(findings)} finding(s):", file=sys.stderr)
    for f in findings:
        print(
            f"  {f.get('File', '?')}:{f.get('StartLine', '?')}  {f.get('RuleID', '?')}  (redacted)",
            file=sys.stderr,
        )
    print("", file=sys.stderr)
    print("If a finding is a reviewed non-secret, add a narrow allowlist to", file=sys.stderr)
    print(f"  {CONFIG}", file=sys.stderr)
    print("-- never a blanket exclusion. If it is real, rotate the credential first.", file=sys.stderr)


def main(argv):
    history = "--history" in argv
    report = None
    max_mb = 5
    args = [a for a in argv if a != "--history"]
    if "--report" in args:
        report = args[args.index("--report") + 1]
    if "--max-mb" in args:
        max_mb = int(args[args.index("--max-mb") + 1])

    if not os.path.isfile(CONFIG):
        print(f"ERROR: config not found: {CONFIG}", file=sys.stderr)
        return 2

    bin_path = gitleaks_bin()
    tmp_report = report or os.path.join(tempfile.mkdtemp(prefix=".loadout-secret-scan-"), "report.json")
    mode = "git" if history else "dir"
    print(f"secret-scan: {mode} scan of {REPO} (max {max_mb} MB per file){' -- full history' if history else ''}")
    cmd = [
        bin_path,
        mode,
        ".",
        "-c",
        CONFIG,
        "--max-target-megabytes",
        str(max_mb),
        "--redact",
        "--no-banner",
        "--exit-code",
        "0",
        "--report-format",
        "json",
        "--report-path",
        tmp_report,
    ]
    # cwd + "." keeps reported paths repo-relative, which is what the config's
    # allowlist regexes are anchored against (absolute paths would bypass them).
    proc = subprocess.run(cmd, cwd=REPO, capture_output=True, text=True)
    if proc.returncode != 0:
        print(proc.stdout, end="")
        print(proc.stderr, end="", file=sys.stderr)
        print("ERROR: gitleaks failed to run.", file=sys.stderr)
        return 2

    findings = []
    if os.path.isfile(tmp_report):
        try:
            with open(tmp_report) as fh:
                findings = json.load(fh) or []
        except ValueError:
            print("ERROR: gitleaks report is unreadable.", file=sys.stderr)
            return 2
    if findings:
        _print_findings(findings)
        return 1
    print("secret-scan: CLEAN -- no un-allowlisted secrets")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
