#!/bin/sh
# Offline Rust toolchain + crate-store smoke for AlmaLinux 8.10.
#
# Proves, with NO network (driver runs the container --network none), that:
#   * `./loadout install @rust` installs rustc/cargo + the bundled local-registry
#     and env-cargo writes a STOCK ~/.cargo/config.toml (online-first policy --
#     no static source replacement since 2026-08-22).
#   * a fresh crate depending on bundled crates compiles via the shell `cargo`
#     WRAPPER (env-bash functions.sh), which injects the store as a --config
#     source replacement when crates.io is unreachable. Bare `cargo` with the
#     stock config can NOT resolve offline -- driving the build through sh
#     tests nothing the product provides, so the build runs under bash with
#     the installed bashrc sourced (non-interactive: functions load, the
#     interactive setup is skipped).
#
# Runs the whole thing TWICE:
#   1. default destination  -> install into the test user's $HOME (.local)
#   2. non-default --dest-dir /tmp/loadout-alt (un-dotted local/ tree; the
#      wrapper finds that store via LOADOUT_CFG_SHARED_PREFIX)
set -eu

src=${LOADOUT_RUST_SRC:-/src}
dst=${LOADOUT_RUST_WORKDIR:-/work/dotfiles}
proj=/work/offline-proj
alt=/tmp/loadout-alt

[ -d "$src" ] || { echo "ERROR: repo source not found: $src" >&2; exit 2; }

echo "### copying checkout into container"
rm -rf "$dst"; mkdir -p "$dst"
tar --exclude=.git --exclude=.loadout-bootstrap --exclude=.ruff_cache \
    --exclude=.claude --exclude=__pycache__ --exclude=loadout_backups \
    --exclude='*.log' -C "$src" -cf - . | tar -C "$dst" -xf -
cd "$dst"
./loadout --help >/dev/null   # warms the portable-python bootstrap (offline)

# The crate under test pulls a real closure: anyhow (no deps), serde + derive
# (proc-macro chain: syn/quote/proc-macro2), serde_json, and ratatui (a TUI lib
# -- exactly the offline-friendly kind we curated in).
echo "### writing test crate (uses bundled crates: anyhow, serde, serde_json, ratatui)"
rm -rf "$proj"; mkdir -p "$proj/src"
cat > "$proj/Cargo.toml" <<'EOF'
[package]
name = "offline-test"
version = "0.0.0"
edition = "2021"

[dependencies]
anyhow = "1"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
ratatui = "*"
EOF
cat > "$proj/src/main.rs" <<'EOF'
use serde::Serialize;

#[derive(Serialize)]
struct Pane { title: String, rows: u16 }

fn main() -> anyhow::Result<()> {
    // touch ratatui so it is actually linked, not just resolved
    let area = ratatui::layout::Rect::new(0, 0, 80, 24);
    let p = Pane { title: "offline".into(), rows: area.height };
    println!("{}", serde_json::to_string(&p)?);
    Ok(())
}
EOF

run_one() {
    label=$1; dest_flag=$2; cargo_home_base=$3; bindir=$4; shared_prefix=$5
    echo
    echo "============================================================"
    echo "### MODE: $label"
    echo "============================================================"

    # shellcheck disable=SC2086
    ./loadout install -y @rust env-bash $dest_flag --no-backup

    cfg="$cargo_home_base/.cargo/config.toml"
    echo "--- installer-written $cfg (stock by policy; fallback is runtime-injected) ---"
    [ -f "$cfg" ] || { echo "ERROR: env-cargo did not write $cfg" >&2; exit 1; }
    cat "$cfg"
    case "$(cat "$cfg")" in
        *replace-with=*)
            echo "ERROR: $cfg must be stock (no static source replacement)" >&2; exit 1 ;;
    esac

    echo "--- toolchain present: $bindir/{rustc,cargo} ---"
    [ -x "$bindir/rustc" ] && [ -x "$bindir/cargo" ] || {
        echo "ERROR: rustc/cargo not installed under $bindir" >&2; exit 1; }

    echo "--- cargo build --offline via the shell wrapper (HOME=$cargo_home_base) ---"
    rm -rf "$proj/target" "$proj/Cargo.lock"
    # Clean env: HOME (-> .cargo/config.toml + installed bashrc), PATH
    # (-> bundled rustc/cargo + system cc), TERM, plus the shared prefix for
    # --dest-dir trees so the wrapper finds that store. The prefix travels as
    # LOADOUT_TEST_PREFIX and is exported AFTER sourcing bashrc: the installed
    # config.sh bakes LOADOUT_CFG_SHARED_PREFIX="" (the staged tree is
    # relocatable; real per-user shells get the prefix from their own env
    # install), so exporting it beforehand would be clobbered.
    # `cargo build --offline` states offline up front, so no probe traffic.
    env -i \
        HOME="$cargo_home_base" \
        PATH="$bindir:/usr/bin:/bin" \
        TERM=dumb \
        LOADOUT_TEST_PREFIX="$shared_prefix" \
        bash -c "source \"\$HOME/.config/bash/bashrc\" >/dev/null 2>&1; [ -n \"\$LOADOUT_TEST_PREFIX\" ] && export LOADOUT_CFG_SHARED_PREFIX=\"\$LOADOUT_TEST_PREFIX\"; cd '$proj' && cargo build --offline --verbose 2>&1 | tail -25"

    echo "--- run the built binary ---"
    out="$("$proj/target/debug/offline-test")"
    echo "  output: $out"
    case "$out" in
        *'"title":"offline"'*'"rows":24'*) echo "  OK: $label compiled + ran offline" ;;
        *) echo "ERROR: unexpected program output for $label" >&2; exit 1 ;;
    esac
}

# Mode 1: default destination = the test user's HOME (.local tree).
run_one "default destination (\$HOME/.local)" "" "$HOME" "$HOME/.local/bin" ""

# Mode 2: non-default --dest-dir (un-dotted local/ tree). env-cargo writes
# <dest>/.cargo/config.toml and the store/toolchain land under <dest>/local.
rm -rf "$alt"; mkdir -p "$alt"
run_one "non-default --dest-dir $alt" "--dest-dir $alt" "$alt" "$alt/local/bin" "$alt/local"

# Tool rebuild: prove the bundled superset store can reconstruct a real loadout
# rust binary offline. Uses the Mode-1 ($HOME) toolchain + store + config; the
# tool SOURCE was baked into the image at build time (it is not in the store --
# the store carries dependency crates, the source comes with the checkout).
echo
echo "============================================================"
: "${RIPGREP_VERSION:?RIPGREP_VERSION not set in the image -- rebuild it}"
echo "### TOOL REBUILD: ripgrep $RIPGREP_VERSION, cargo build --offline"
echo "============================================================"
rgsrc=/work/ripgrep-src
rm -rf "$rgsrc"; cp -a /opt/ripgrep-src "$rgsrc"
env -i HOME="$HOME" PATH="$HOME/.local/bin:/usr/bin:/bin" TERM=dumb \
    bash -c "source \"\$HOME/.config/bash/bashrc\" >/dev/null 2>&1; cd '$rgsrc' && cargo build --offline --release 2>&1 | tail -6"
rgbin="$rgsrc/target/release/rg"
[ -x "$rgbin" ] || { echo "ERROR: ripgrep did not build offline" >&2; exit 1; }
ver="$("$rgbin" --version | head -1)"
echo "  built: $ver"
case "$ver" in
    *"ripgrep $RIPGREP_VERSION"*) echo "  OK: loadout rust tool rebuilt offline from the store" ;;
    *) echo "ERROR: expected ripgrep $RIPGREP_VERSION, got: $ver" >&2; exit 1 ;;
esac

echo
echo "### ALL PASSED: 2 install modes + offline tool rebuild (no network, no manual config)"
