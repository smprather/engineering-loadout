#!/usr/bin/env python3.14
"""
gen-content-manifest -- write .content-manifest: a sha256 of every shipped
payload file, as stored on disk (per .part-NNN chunk, not the rejoined whole).

Unlike .strip-manifest (a rebuild-skip cache that records tar archives by
size+mtime only), .content-manifest is a content allowlist: it lets
`loadout install --verify` and `loadout doctor --verify` confirm that every
byte about to be extracted matches what was committed and signed. Because
chunks are hashed as-stored, install-time verification hashes exactly the
bytes it reads with no rejoin cost.

Coverage: everything under payload/ (all platform dirs, packages.json, fonts,
tldr, yara, typelibs, wheels, crate-store, treesitter prebuilt, windows) plus
envs/*/vendor/ (the nvim + tmux plugin bundles). Run after any payload change
(strip-all-elf-binaries calls it); the result is committed and covered by the
signed release tag.

Usage: build/gen-content-manifest [--check]
  (no args)  regenerate .content-manifest
  --check    verify on-disk files against the committed manifest; exit 1 on drift
"""

import hashlib
import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MANIFEST = os.path.join(REPO, ".content-manifest")

# Roots whose every file is hashed, relative to the repo.
ROOTS = [
    "payload",
    os.path.join("envs", "nvim", "vendor"),
    os.path.join("envs", "tmux", "vendor"),
]


def sha256_of(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


# The nvim plugin stash is a RELEASE ASSET, not a git payload (328 MB of bz2'd packfiles;
# committing it added ~328 MB to history on every refresh). It is gitignored but usually
# PRESENT on a build box, so it must be excluded explicitly -- otherwise the committed
# manifest would hash a file that most checkouts do not have, and `--check` would fail for
# everyone who has not fetched it. Its integrity is covered by sha256sums.txt in the
# signed release, and ./tools/fetch-stash records the verified hash in .content-manifest.fetched.
EXCLUDE = {
    os.path.join("envs", "nvim", "vendor", "plugins", "nvim-plugin-stash.tar.bz2"),
}


def _excluded(rel):
    if rel in EXCLUDE:
        return True
    # chunked form of the same asset, if an old checkout still has one
    return rel.startswith(os.path.join("envs", "nvim", "vendor", "plugins", "nvim-plugin-stash.tar.bz2."))


def iter_files():
    for root in ROOTS:
        base = os.path.join(REPO, root)
        if not os.path.isdir(base):
            continue
        for dirpath, dirs, files in os.walk(base):
            dirs[:] = sorted(dirs)
            for name in sorted(files):
                full = os.path.join(dirpath, name)
                if os.path.islink(full) or not os.path.isfile(full):
                    continue
                rel = os.path.relpath(full, REPO)
                if _excluded(rel):
                    continue
                yield rel, full


def generate():
    lines = ["# content manifest -- sha256 of every shipped payload file, as stored"]
    lines.append("# generated by build/gen-content-manifest; verified at install with --verify")
    rows = []
    for rel, full in iter_files():
        rows.append(f"sha256  {sha256_of(full)}  {rel}")
    rows.sort()
    lines.extend(rows)
    with open(MANIFEST, "w") as fh:
        fh.write("\n".join(lines) + "\n")
    print(f"wrote {MANIFEST} ({len(rows)} files)")


def load_manifest():
    entries = {}
    if not os.path.isfile(MANIFEST):
        return entries
    for line in open(MANIFEST):
        line = line.rstrip("\n")
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 2)
        if len(parts) == 3 and parts[0] == "sha256":
            entries[parts[2]] = parts[1]
    return entries


def check():
    manifest = load_manifest()
    if not manifest:
        print("ERROR: .content-manifest missing or empty; run build/gen-content-manifest", file=sys.stderr)
        return 1
    on_disk = dict(iter_files())
    problems = []
    for rel, digest in manifest.items():
        full = os.path.join(REPO, rel)
        if not os.path.isfile(full):
            problems.append(f"MISSING  {rel}")
        elif sha256_of(full) != digest:
            problems.append(f"MISMATCH {rel}")
    for rel in on_disk:
        if rel not in manifest:
            problems.append(f"UNLISTED {rel}")
    if problems:
        print(f"content-manifest drift ({len(problems)}):", file=sys.stderr)
        for p in problems:
            print(f"  {p}", file=sys.stderr)
        return 1
    print(f"content-manifest OK ({len(manifest)} files verified)")
    return 0


def main(argv):
    if "--check" in argv:
        return check()
    generate()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
