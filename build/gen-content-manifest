#!/usr/bin/env python3.14
"""
gen-content-manifest -- write .content-manifest: a sha256 of every shipped
payload file, as stored on disk (per .part-NNN chunk, not the rejoined whole).

Unlike .strip-manifest (a rebuild-skip cache that records tar archives by
size+mtime only), .content-manifest is a content allowlist: it lets
`loadout install --verify` and `loadout doctor --verify` confirm that every
byte about to be extracted matches what was committed and signed. Because
chunks are hashed as-stored, install-time verification hashes exactly the
bytes it reads with no rejoin cost.

Coverage: everything under payload/ (all platform dirs, packages.json, fonts,
tldr, typelibs, wheels, treesitter prebuilt) plus envs/*/vendor/
(the nvim + tmux plugin bundles). Run after any payload change
(strip-all-elf-binaries calls it); the result is committed and covered by the
signed release tag.

THE MANIFEST COVERS THE *SHIPPED* CONTENT SET -- what `git archive HEAD` puts
in a release tarball -- not whatever happens to be sitting in the release
host's working directory. Files git will not ship (untracked AND ignored:
.gitignore, .git/info/exclude, core.excludesFile) are skipped, because hashing
one commits a path that cannot exist in a clean clone or export: `--check`
passes on the host that generated it and fails everywhere else, and
build/export refuses. A vendored plugin tree is exactly where this happens
(tmux-persist arrived with gitignored .agents/, .codex/ and .claude/
directories that the top-level .gitignore matches at any depth). Tracked-but-
ignored files ARE shipped and stay covered; untracked files that are not
ignored stay covered too, because the documented payload chain (build -> copy
into payload/ -> gen-* -> git add) regenerates the manifest before `git add`
makes the file shipped.

Usage: build/gen-content-manifest [--check]
  (no args)  regenerate .content-manifest
  --check    verify on-disk files against the committed manifest; exit 1 on drift
"""

import hashlib
import os
import subprocess
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MANIFEST = os.path.join(REPO, ".content-manifest")

# Roots whose every file is hashed, relative to the repo.
ROOTS = [
    "payload",
    os.path.join("envs", "nvim", "vendor"),
    os.path.join("envs", "tmux", "vendor"),
]


class ManifestError(Exception):
    """A condition that must abort the run (not drift in the manifest itself)."""


def sha256_of(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


# The nvim plugin stash is a RELEASE ASSET, not a git payload (328 MB of bz2'd packfiles;
# committing it added ~328 MB to history on every refresh). It is gitignored but usually
# PRESENT on a build box, so it must be excluded explicitly -- otherwise the committed
# manifest would hash a file that most checkouts do not have, and `--check` would fail for
# everyone who has not fetched it. Its integrity is covered by sha256sums.txt in the
# signed release, and ./tools/fetch-stash records the verified hash in .content-manifest.fetched.
EXCLUDE = {
    os.path.join("envs", "nvim", "vendor", "plugins", "nvim-plugin-stash.tar.bz2"),
}


def _excluded(rel):
    if rel in EXCLUDE:
        return True
    # chunked form of the same asset, if an old checkout still has one
    return rel.startswith(os.path.join("envs", "nvim", "vendor", "plugins", "nvim-plugin-stash.tar.bz2."))


def _git(args):
    """Run git in REPO; return the CompletedProcess, or None when there is no git tree.

    None means "this is not a git checkout" (no .git): an extracted release
    tarball or an exported install directory, which by construction contains
    only shipped files. REPO must be the repository ROOT (it is by
    construction); the explicit .git probe also stops git from discovering a
    PARENT repository when an export happens to sit inside one. A tree WITH
    .git that cannot be queried is a hard error -- silently treating it as
    git-less would skip the ignored-file filter and re-open the export blocker.

    `-c safe.directory=REPO` keeps the filter working when the repo is a
    foreign-owned bind mount (the EL8 build container), where git would
    otherwise refuse with "dubious ownership".
    """
    if not os.path.exists(os.path.join(REPO, ".git")):
        return None
    try:
        return subprocess.run(["git", "-c", f"safe.directory={REPO}", "-C", REPO, *args], capture_output=True)
    except OSError as exc:
        raise ManifestError(
            f"git is unavailable in a git checkout ({exc}); cannot determine the shipped content set"
        ) from exc


def untracked_ignored():
    """Repo-relative files git will NOT ship: untracked AND ignored.

    This is the filter that keeps unshipped files out of the manifest. It
    covers every standard ignore source (per-directory .gitignore,
    .git/info/exclude, core.excludesFile), so a host-specific global ignore
    cannot leak a path into the committed manifest either. Tracked-but-ignored
    files (git add -f) are NOT in this set: they ship and must stay covered.
    """
    proc = _git(["ls-files", "-z", "-o", "-i", "--exclude-standard", "--", *ROOTS])
    if proc is None:
        return set()
    if proc.returncode != 0:
        raise ManifestError("git ls-files failed in a git checkout: " + proc.stderr.decode("utf-8", "replace").strip())
    return {p.decode("utf-8", "surrogateescape") for p in proc.stdout.split(b"\0") if p}


def iter_files():
    ignored = untracked_ignored()
    for root in ROOTS:
        base = os.path.join(REPO, root)
        if not os.path.isdir(base):
            continue
        for dirpath, dirs, files in os.walk(base):
            dirs[:] = sorted(dirs)
            for name in sorted(files):
                full = os.path.join(dirpath, name)
                if os.path.islink(full) or not os.path.isfile(full):
                    continue
                rel = os.path.relpath(full, REPO)
                if _excluded(rel) or rel in ignored:
                    continue
                yield rel, full


def parse_manifest(text):
    entries = {}
    for line in text.splitlines():
        line = line.rstrip("\n")
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 2)
        if len(parts) == 3 and parts[0] == "sha256":
            entries[parts[2]] = parts[1]
    return entries


def generate():
    lines = ["# content manifest -- sha256 of every shipped payload file, as stored"]
    lines.append("# generated by build/gen-content-manifest; verified at install with --verify")
    rows = []
    for rel, full in iter_files():
        rows.append(f"sha256  {sha256_of(full)}  {rel}")
    rows.sort()
    lines.extend(rows)
    with open(MANIFEST, "w") as fh:
        fh.write("\n".join(lines) + "\n")
    print(f"wrote {MANIFEST} ({len(rows)} files)")


def load_manifest():
    if not os.path.isfile(MANIFEST):
        return {}
    with open(MANIFEST) as fh:
        return parse_manifest(fh.read())


def check():
    manifest = load_manifest()
    if not manifest:
        print("ERROR: .content-manifest missing or empty; run build/gen-content-manifest", file=sys.stderr)
        return 1
    shipped = dict(iter_files())
    problems = []
    for rel, digest in manifest.items():
        full = os.path.join(REPO, rel)
        if rel in shipped:
            if sha256_of(full) != digest:
                problems.append(f"MISMATCH {rel}")
        elif os.path.lexists(full):
            # Present on this host but not part of the shipped set (ignored and
            # untracked). A manifest entry here verifies on this host and is
            # MISSING in every clean clone or export -- the 2026-10-07 blocker.
            problems.append(f"NOT-SHIPPED {rel}")
        else:
            problems.append(f"MISSING  {rel}")
    for rel in shipped:
        if rel not in manifest:
            problems.append(f"UNLISTED {rel}")
    if problems:
        print(f"content-manifest drift ({len(problems)}):", file=sys.stderr)
        for p in problems:
            print(f"  {p}", file=sys.stderr)
        return 1
    print(f"content-manifest OK ({len(manifest)} files verified)")
    return 0


def main(argv):
    try:
        if "--check" in argv:
            return check()
        generate()
        return 0
    except ManifestError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
