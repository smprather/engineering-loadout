#!/usr/bin/env python3.14
"""
release: run pre-release gates, then create a GitHub release.

Usage:
    ./build/release                  # derive the next YYYY.M.N tag, create release
    ./build/release --tag 2026.9.7   # exact tag (repair/overwrite, or a pinned release)
    ./build/release --dry-run        # run gates only, no tag or GitHub release
    ./build/release --skip-scan      # skip the malware scan (NOT recommended; for a
                               # known yara false positive only)
    ./build/release --allow-unsigned # release with an UNSIGNED tag (breaks trust chain)

A preflight runs FIRST, before any gate: it checks `gh` auth and proves the tag
signer produces a real signature with no tty, askpass or DISPLAY. Authentication
problems therefore surface at kickoff, while the operator is still at the
keyboard, instead of hanging an hour later when the slow gates have finished.

Every release then runs independent pre-release gates in parallel: malware scan,
binary smoke test, version table, and checksum generation. The final tag and
GitHub release step runs only after the mandatory gates pass.

Tags are `YYYY.M.N` (no leading `v`), N a 1-based counter within the month --
canonical PEP 440, so no leading zeros (`2026.9.1`, never `2026.09.01`). A bare
run derives the next counter, but only when the month's latest release is fully
published: a tag with no release, a draft, or an unreadable state blocks the run
and names the repair command. Re-running with an explicit existing `--tag`
REPLACES that release and moves the tag -- the overwrite path for a release that
has not earned trust yet. Once a release is trusted, ship the next N, however
small the change (docs/RELEASE.md section 8).

Requires: gh (GitHub CLI) authenticated, git repo with remote set.
"""

import concurrent.futures
import datetime
import hashlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
from dataclasses import dataclass

_d = os.path.dirname(os.path.abspath(__file__))
while _d not in ("", "/") and not os.path.isdir(os.path.join(_d, "installer_vendor")):
    _d = os.path.dirname(_d)
if os.path.isdir(os.path.join(_d, "installer_vendor")):
    sys.path.insert(0, os.path.join(_d, "installer_vendor"))

import rich_click as click  # noqa: E402


def run(cmd, **kwargs):
    return subprocess.run(cmd, **kwargs)


SHA256SUMS_NAME = "sha256sums.txt"
# The nvim plugin stash: ~328 MB, shipped as a release ASSET (not a git payload).
# Reused across same-day/routine re-releases when its bytes are unchanged so the
# release does not re-upload 328 MB every time (_can_reuse_stash).
STASH_REL = "envs/nvim/vendor/plugins/nvim-plugin-stash.tar.bz2"
STASH_ASSET_NAME = os.path.basename(STASH_REL)
STEP_SCAN_TITLE = "Step 0: Scanning bundled binaries for malware (YARA-Forge)"
STEP_SMOKE_TITLE = "Step 1: Smoke-testing pre-built binaries"
STEP_VERSIONS_TITLE = "Step 2: Generating version table"
STEP_CHECKSUMS_TITLE = f"Step 3: Generating {SHA256SUMS_NAME} + SBOM + checksum table"
STEP_MANIFEST_TITLE = "Step 3b: Verifying .content-manifest against the git export"
STEP_SECRET_TITLE = "Step 4: Scanning for committed secrets (gitleaks)"
STEP_VULN_TITLE = "Step 5: Scanning the closure for known vulnerabilities (osv-scanner)"


@dataclass
class StepResult:
    name: str
    title: str
    returncode: int = 0
    output: str = ""
    data: object = None


def _signing_configured():
    """True when git has a signing key configured (SSH or GPG)."""
    r = subprocess.run(["git", "config", "--get", "user.signingkey"], capture_output=True, text=True)
    return r.returncode == 0 and r.stdout.strip() != ""


SIGNING_PROBE_TAG = "loadout-release-signing-preflight"


def _delete_probe_tag():
    subprocess.run(["git", "tag", "-d", SIGNING_PROBE_TAG], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _test_sign_noninteractive():
    """Prove the tag signer works with every interactive channel closed.

    A release runs unattended for a long time (scan + smoke are the slow part),
    so a signer that can still prompt does not fail -- it HANGS, at the very
    end, after all the expensive work. This signs a throwaway tag with no tty,
    no askpass and no DISPLAY, so the only way it succeeds is a live ssh-agent
    (or an unencrypted key). Returns (ok, detail).
    """
    env = dict(os.environ)
    env["SSH_ASKPASS_REQUIRE"] = "never"  # OpenSSH >= 8.4: never fall back to a GUI prompt
    env["GIT_TERMINAL_PROMPT"] = "0"
    env.pop("SSH_ASKPASS", None)
    env.pop("DISPLAY", None)

    _delete_probe_tag()  # a killed earlier run can leave one behind
    try:
        r = subprocess.run(
            ["git", "tag", "-s", SIGNING_PROBE_TAG, "-m", SIGNING_PROBE_TAG],
            capture_output=True,
            text=True,
            env=env,
            stdin=subprocess.DEVNULL,
            timeout=60,
        )
    except subprocess.TimeoutExpired:
        _delete_probe_tag()
        return False, "signer did not finish in 60s -- it is waiting for a passphrase"

    if r.returncode != 0:
        _delete_probe_tag()
        # git's own diagnosis comes FIRST ("error: Enter passphrase ...");
        # the last line is the useless "tag message left in .git/TAG_EDITMSG".
        lines = [ln.strip() for ln in (r.stderr or r.stdout).splitlines() if ln.strip()]
        useful = [ln for ln in lines if ln.startswith(("error:", "fatal:"))]
        return False, (useful or lines or ["git tag -s failed"])[0]

    obj = subprocess.run(["git", "cat-file", "-p", SIGNING_PROBE_TAG], capture_output=True, text=True)
    _delete_probe_tag()
    # Belt and braces: a zero exit is not proof of a signature. The 2026-07-22
    # release shipped an unsigned tag because nothing ever checked the object.
    if "BEGIN SSH SIGNATURE" not in obj.stdout and "BEGIN PGP SIGNATURE" not in obj.stdout:
        return False, "git tag -s exited 0 but produced a tag with no signature block"
    return True, "throwaway tag signed with no tty, askpass or DISPLAY"


def _gh_authenticated():
    r = subprocess.run(["gh", "auth", "status"], capture_output=True, text=True)
    if r.returncode == 0:
        return True, "gh CLI authenticated"
    err = (r.stderr or r.stdout).strip().splitlines()
    return False, err[-1] if err else "gh auth status failed"


def _print_signing_remediation():
    print("", file=sys.stderr)
    print("  The tag signer needs a live ssh-agent holding the key. Run, in your shell:", file=sys.stderr)
    print("", file=sys.stderr)
    print('      eval "$(ssh-agent -s)" && ssh-add ~/.ssh/id_ed25519', file=sys.stderr)
    print("", file=sys.stderr)
    print("  then re-run the release with that agent's socket:", file=sys.stderr)
    print("", file=sys.stderr)
    print("      SSH_AUTH_SOCK=$SSH_AUTH_SOCK ./build/release", file=sys.stderr)
    print("", file=sys.stderr)
    print("  (From a background/tool shell SSH_AUTH_SOCK is usually unset -- find the", file=sys.stderr)
    print("  keyed agent with: for s in $(ls -t /tmp/ssh-*/agent.*); do", file=sys.stderr)
    print("  SSH_AUTH_SOCK=$s ssh-add -l >/dev/null 2>&1 && echo $s && break; done)", file=sys.stderr)
    print("", file=sys.stderr)
    print("  To release without a signature anyway, pass --allow-unsigned.", file=sys.stderr)


def _preflight(dry_run, allow_unsigned):
    """Authenticate BEFORE any long-running gate.

    Everything credential-shaped is settled here, at kickoff, while the operator
    is still at the keyboard -- not an hour later when the scan and smoke test
    have finished and nobody is around to answer a prompt. Returns True when the
    tag will be signed.
    """
    _print_heading("Preflight: authentication (before any gate)")

    gh_ok, gh_detail = _gh_authenticated()
    print(f"  gh auth       : {'OK' if gh_ok else 'FAILED'} -- {gh_detail}", flush=True)

    key = _signing_configured()
    sign_ok, sign_detail = (False, "no user.signingkey configured")
    if key:
        sign_ok, sign_detail = _test_sign_noninteractive()
    print(f"  tag signing   : {'OK' if sign_ok else 'FAILED'} -- {sign_detail}", flush=True)

    if dry_run:
        # No tag is created, so nothing here can block; still reported above.
        return sign_ok

    if not gh_ok:
        print("\nRelease blocked: gh CLI is not authenticated. Run: gh auth login", file=sys.stderr)
        sys.exit(1)

    if not sign_ok:
        if not allow_unsigned:
            print("\nRelease blocked: cannot produce a SIGNED tag.", file=sys.stderr)
            print("An unsigned tag breaks the top link of the trust chain", file=sys.stderr)
            print("(signed tag -> sha256sums.txt -> payload bytes; docs/SECURITY.md).", file=sys.stderr)
            _print_signing_remediation()
            sys.exit(1)
        print("  WARNING: --allow-unsigned -- this release will carry an UNSIGNED tag.")
        print("  The content-manifest trust chain will NOT be tamper-evident.")

    return sign_ok


def _sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


# Integrity-critical, in-tree files a downloader can verify without pulling the
# multi-GB source archive. `.content-manifest` in turn pins the SHA-256 of every
# payload file, so its single hash transitively binds the whole tree.
INTEGRITY_TARGETS = [
    ".content-manifest",
    "loadout",
    "loadout_main.py",
    "payload/packages.json",
    # The nvim plugin stash is NOT in .content-manifest (it is a release asset, not a git
    # payload), so its hash must be published here directly -- this is the link
    # ./tools/fetch-stash checks before the installer will accept the downloaded bytes.
    STASH_REL,
    # Generated by build/sbom inside the checksum step; covered by the signed
    # sums like every other integrity-critical file.
    "sbom.cdx.json",
]


def _integrity_hashes(script_dir):
    """[(repo-relative path, sha256)] for each integrity target that exists."""
    pairs = []
    for rel in INTEGRITY_TARGETS:
        full = os.path.join(script_dir, rel)
        if os.path.isfile(full):
            pairs.append((rel, _sha256_file(full)))
    return pairs


def _write_sha256sums(script_dir, pairs):
    """Write sha256sums.txt (coreutils `sha256sum -c` format) from PAIRS so the
    file and the release-notes table share one source of truth."""
    out = os.path.join(script_dir, SHA256SUMS_NAME)
    with open(out, "w") as fh:
        for rel, digest in pairs:
            fh.write(f"{digest}  {rel}\n")
    return out


def _checksum_table_md(pairs):
    """Markdown table of PAIRS for the GitHub release notes (renders on-page)."""
    lines = [
        "## Asset checksums (SHA-256)",
        "",
        "Integrity-critical files pinned by this release. `.content-manifest` in "
        "turn pins every payload file, so verifying it (or running "
        "`./loadout doctor --verify`) covers the whole tree.",
        "",
        "| File | SHA-256 |",
        "|------|---------|",
    ]
    for rel, digest in pairs:
        lines.append(f"| `{rel}` | `{digest}` |")
    return "\n".join(lines)


def _sbom_section_md():
    """One paragraph for the release notes; the asset itself is checksummed."""
    return "\n".join(
        [
            "## SBOM",
            "",
            "`sbom.cdx.json` (CycloneDX) inventories the shipped closure: every Python wheel",
            "(syft) and every registry package. Its SHA-256 is",
            "in the checksums table above, so the signed tag binds it like any other asset.",
        ]
    )


def _version_table_from_tsv(versions_tsv):
    """Markdown release-notes table from farm-versions TSV output."""
    lines = [row for row in versions_tsv.splitlines() if row.strip()]
    md_rows = []
    for line in lines[1:]:  # skip header
        parts = line.split("\t")
        if len(parts) >= 5 and parts[2]:  # skip missing
            binary, name, version, _status, homepage = parts[0], parts[1], parts[2], parts[3], parts[4]
            md_rows.append(f"| [{name}]({homepage}) | `{binary}` | {version} |")

    if not md_rows:
        return ""

    version_table = "\n## Pre-built binary versions\n\n"
    version_table += "| Tool | Binary | Version |\n"
    version_table += "|------|--------|--------|\n"
    version_table += "\n".join(md_rows)
    return version_table


def _print_heading(title):
    print("=" * 60)
    print(title)
    print("=" * 60, flush=True)


def _emit_step_result(result):
    print()
    _print_heading(result.title)
    if result.output:
        print(result.output, end="" if result.output.endswith("\n") else "\n")
    if result.returncode == 0:
        print(f"  {result.name}: passed", flush=True)
    else:
        print(f"  {result.name}: failed with exit {result.returncode}", file=sys.stderr, flush=True)


def _command_step(name, title, cmd):
    proc = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        encoding="utf-8",
        errors="replace",
    )
    return StepResult(name=name, title=title, returncode=proc.returncode, output=proc.stdout)


def _skip_scan_step(script_dir, tag):
    _record_skip_scan_justification(script_dir, tag)
    return StepResult(
        name="malware scan",
        title=STEP_SCAN_TITLE,
        output="SKIPPED via --skip-scan (not recommended).\n",
    )


def _version_step(farm_versions):
    proc = subprocess.run(
        [farm_versions, "--format", "tsv"],
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
    )
    if proc.returncode != 0:
        output = "  WARNING: version table generation failed; release notes omit tool versions.\n"
        if proc.stderr:
            output += proc.stderr
        return StepResult(name="version table", title=STEP_VERSIONS_TITLE, output=output, data="")

    version_table = _version_table_from_tsv(proc.stdout)
    row_count = max(0, len([row for row in proc.stdout.splitlines() if row.strip()]) - 1)
    return StepResult(
        name="version table",
        title=STEP_VERSIONS_TITLE,
        output=f"  collected {row_count} version rows\n",
        data=version_table,
    )


def _secret_scan_step(script_dir):
    """gitleaks over the tree AND full history (both take seconds here).

    The history pass catches secrets deleted before release, which a tree scan
    cannot see; an old-commit hit is a rotation event, not an edit."""
    lines = []
    for mode in ("tree", "history"):
        cmd = [os.path.join(script_dir, "build", "secret-scan")]
        if mode == "history":
            cmd.append("--history")
        proc = subprocess.run(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, encoding="utf-8", errors="replace"
        )
        if proc.returncode != 0:
            lines.append(f"  {mode}: FINDINGS\n")
            lines.append(proc.stdout or "")
            return StepResult(
                name="secret scan", title=STEP_SECRET_TITLE, returncode=proc.returncode, output="".join(lines)
            )
        lines.append(f"  {mode}: CLEAN\n")
    return StepResult(name="secret scan", title=STEP_SECRET_TITLE, output="".join(lines))


def _vuln_scan_step(script_dir):
    return _command_step("vulnerability scan", STEP_VULN_TITLE, [os.path.join(script_dir, "build", "vuln-scan")])


def _manifest_export_step(script_dir):
    """Prove HEAD:.content-manifest covers exactly what `git archive HEAD` ships.

    `gen-content-manifest --check` verifies the WORKING TREE against the manifest,
    so a manifest that lists a gitignored file -- present on this host, absent
    from the commit -- passes there and fails in every clean clone. That is the
    2026-10-07 release that published 158 entries no checkout could satisfy.
    """
    gate = os.path.join(script_dir, "build", "verify-manifest-export")
    return _command_step("manifest export", STEP_MANIFEST_TITLE, [sys.executable, gate])


def _checksum_step(script_dir):
    # The SBOM is generated here (not a separate gate) so its hash lands in
    # sha256sums.txt and the signed tag binds it.
    sbom = os.path.join(script_dir, "build", "sbom")
    proc = subprocess.run([sbom], capture_output=True, text=True, encoding="utf-8", errors="replace")
    if proc.returncode != 0:
        return StepResult(
            name="checksums",
            title=STEP_CHECKSUMS_TITLE,
            returncode=proc.returncode,
            output=(proc.stdout or "") + (proc.stderr or ""),
        )
    sbom_path = os.path.join(script_dir, "sbom.cdx.json")
    if not os.path.isfile(sbom_path):
        return StepResult(
            name="checksums",
            title=STEP_CHECKSUMS_TITLE,
            returncode=1,
            output="ERROR: build/sbom exited 0 but wrote no sbom.cdx.json\n",
        )
    pairs = _integrity_hashes(script_dir)
    sums_path = _write_sha256sums(script_dir, pairs)
    return StepResult(
        name="checksums",
        title=STEP_CHECKSUMS_TITLE,
        output=f"  {proc.stdout.strip()}\n  wrote {sums_path} ({len(pairs)} files)\n",
        data={"pairs": pairs, "sums_path": sums_path},
    )


# --- binary smoke-test cache ---------------------------------------------------
# The smoke test installs @shared into a temp tree and probes every binary/runtime
# -- ~4.5 min, the slowest gate. Its result is a pure function of the bytes it
# installs plus the code that installs and probes them, so a content fingerprint
# lets a routine re-release skip an identical re-run. Modelled on the (proven)
# scan-for-malware clean-cache: pass-only, double-checked key, keyed on real bytes.
SMOKE_CACHE_SCHEMA = 1
SMOKE_CACHE_DIR_NAME = os.path.join("engineering-loadout", "release-smoke-v1")


def _smoke_cache_dir():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(base, SMOKE_CACHE_DIR_NAME)


def _smoke_source_fingerprint(script_dir):
    """Fingerprint of every file whose bytes can change the smoke result.

    Deliberately a SUPERSET of what `@shared` installs: hashing extra files only
    costs an occasional needless re-run, whereas MISSING one is a false green --
    a cache hit that ships an untested binary. That asymmetry is why this walks
    all of payload/ (not a per-platform subset) plus the installer and the probe
    script itself.

    Delegates to build/fingerprint.py --exact (byte hashes, folded in sorted
    order, platform-keyed) -- the same trust semantics as the previous inline
    implementation, one implementation shared with the test suite."""
    fp = os.path.join(script_dir, "build", "fingerprint.py")
    roots = [
        os.path.join(script_dir, "payload"),
        os.path.join(script_dir, "loadout"),
        os.path.join(script_dir, "loadout_main.py"),
        os.path.join(script_dir, "tests", "prebuilt-binaries"),
    ]
    proc = subprocess.run(
        [sys.executable, fp, "--exact", "--roots", *roots],
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
    )
    if proc.returncode != 0:
        raise RuntimeError(f"fingerprint.py failed: {proc.stderr}")
    data = json.loads(proc.stdout)
    return {"sha256": data["sha256"], "files": data["files"]}


def _platform_fingerprint():
    """uname + glibc: the smoke also links against host glibc and runs host tools,
    so a platform/libc change must invalidate a cached pass."""
    uname = subprocess.run(["uname", "-s", "-m"], capture_output=True, text=True)
    glibc = subprocess.run(["getconf", "GNU_LIBC_VERSION"], capture_output=True, text=True)
    return {
        "uname": uname.stdout.strip(),
        "glibc": glibc.stdout.strip(),
    }


def _smoke_cache_key(script_dir):
    data = {
        "schema": SMOKE_CACHE_SCHEMA,
        "platform": _platform_fingerprint(),
        "source": _smoke_source_fingerprint(script_dir),
    }
    encoded = json.dumps(data, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(encoded.encode("utf-8")).hexdigest(), data


def _load_smoke_cache(cache_id, key_data):
    path = os.path.join(_smoke_cache_dir(), f"{cache_id}.json")
    try:
        with open(path, encoding="utf-8") as fh:
            entry = json.load(fh)
    except OSError, json.JSONDecodeError:
        return None
    # Only a recorded PASS counts, and the full key must match byte-for-byte --
    # the cache_id alone is not trusted (guards a hash collision or schema drift).
    if entry.get("verdict") != "pass" or entry.get("key") != key_data:
        return None
    return entry


def _write_smoke_cache(cache_id, key_data, output):
    d = _smoke_cache_dir()
    try:
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, f"{cache_id}.json"), "w", encoding="utf-8") as fh:
            json.dump(
                {
                    "verdict": "pass",
                    "key": key_data,
                    "recorded": datetime.datetime.now(datetime.UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
                    "output_tail": "".join(output.splitlines(keepends=True)[-15:]),
                },
                fh,
                sort_keys=True,
            )
    except OSError:
        pass  # a cache we cannot write is not a release failure


def _smoke_step(script_dir, smoke_test, use_cache):
    """Run the binary smoke test, or return a cached PASS when the fingerprint of
    everything it installs/probes is unchanged. The fingerprint hash runs in this
    worker thread, overlapping the other parallel gates, so a cache hit turns the
    slowest gate into a ~40 s hash."""
    cache_id = key_data = None
    if use_cache:
        cache_id, key_data = _smoke_cache_key(script_dir)
        entry = _load_smoke_cache(cache_id, key_data)
        if entry is not None:
            n = key_data["source"]["files"]
            output = (
                f"  CACHED PASS -- {n} source files unchanged since {entry.get('recorded', '?')}\n"
                f"  (fingerprint {cache_id[:16]}; skipping the ~4.5 min re-run. "
                f"Force a fresh run with --no-cache.)\n"
            )
            return StepResult(name="binary smoke test", title=STEP_SMOKE_TITLE, returncode=0, output=output)

    result = _command_step("binary smoke test", STEP_SMOKE_TITLE, [smoke_test])
    if use_cache and result.returncode == 0:
        _write_smoke_cache(cache_id, key_data, result.output)
    return result


def _mem_available_mb():
    """MemAvailable from /proc/meminfo, or None when unreadable."""
    try:
        with open("/proc/meminfo") as fh:
            for line in fh:
                if line.startswith("MemAvailable:"):
                    return int(line.split()[1]) // 1024
    except OSError:
        pass
    return None


_CI_LOG = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
    "engineering-loadout",
    "ci-runtimes.tsv",
)
_CI_LOG_LOCK = threading.Lock()


def _log_runtime(suite, test, seconds, status, detail=""):
    """Append one CI runtime row (see build/ci-runtimes). Best-effort."""
    try:
        with _CI_LOG_LOCK:
            os.makedirs(os.path.dirname(_CI_LOG), exist_ok=True)
            ts = datetime.datetime.now(datetime.UTC).strftime("%Y-%m-%dT%H:%M:%SZ")

            def clean(s):
                return str(s).replace("\t", " ").replace("\n", " ").strip()

            with open(_CI_LOG, "a") as fh:
                fh.write(f"{ts}\t{clean(suite)}\t{clean(test)}\t{int(seconds)}\t{clean(status)}\t{clean(detail)}\n")
    except OSError:
        pass


def _log_gate_result(result, seconds, detail=""):
    status = "PASS" if result.returncode == 0 else "FAIL"
    if "SKIPPED" in (result.output or ""):
        status = "SKIP"
    _log_runtime("release", result.name, seconds, status, detail)


def _kill_descendants():
    """SIGKILL every descendant of this process, leaves first.

    The OOM watchdog exits with os._exit(), which does NOT reap children. The
    malware scan runs its clamscan shards as grandchildren (ThreadPoolExecutor
    -> subprocess.run), so an abort left ~12 GB of orphaned clamscan processes
    running until they were killed by hand (observed 2026-09-09). Walk /proc,
    collect the descendant tree, and kill leaves before parents so nothing
    reparents out of reach. Best-effort: never raises.
    """
    children = {}
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            with open(f"/proc/{entry}/stat", "rb") as fh:
                data = fh.read()
            ppid = int(data.rsplit(b")", 1)[1].split()[1])
        except OSError, ValueError, IndexError:
            continue
        children.setdefault(ppid, []).append(int(entry))
    victims = []
    stack = list(children.get(os.getpid(), []))
    while stack:
        pid = stack.pop()
        victims.append(pid)
        stack.extend(children.get(pid, []))
    for pid in reversed(victims):
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass


def _abort_oom(avail):
    """Print the OOM abort message, reap descendants, and exit non-zero."""
    print(
        f"\n  ABORT: free memory dropped to {avail} MB -- aborting gates to avoid the OOM killer.\n"
        "  Re-run with more RAM free, or let the gates run sequentially (they do so automatically).",
        file=sys.stderr,
        flush=True,
    )
    _kill_descendants()
    os._exit(3)


def _run_parallel_pre_release_steps(
    script_dir, smoke_test, farm_versions, malware_scan, tag, skip_scan, use_smoke_cache, scan_flags
):
    """Run all independent pre-release steps concurrently.

    The gates are memory-heavy: the smoke test installs ~8 GB, the malware
    scan reads the whole payload, the fingerprint hashes it again. On a box
    with little free RAM, running all four at once can push the kernel's OOM
    killer into killing the terminal (observed 2026-09-09: 32 GB box, 12 GB
    already in swap, four parallel gates -> OOM). So the worker count scales
    with MemAvailable, and a watchdog aborts the run with a clear message
    before the kernel gets the chance."""
    _print_heading("Starting independent pre-release steps in parallel")

    mem = _mem_available_mb()
    if mem is not None and mem < 2048:
        print(f"  WARNING: only {mem} MB available; running gates SEQUENTIALLY to avoid OOM", flush=True)
        seq_stop = threading.Event()

        def seq_watchdog():
            while not seq_stop.wait(2.0):
                avail = _mem_available_mb()
                if avail is not None and avail < 1024:
                    _abort_oom(avail)

        threading.Thread(target=seq_watchdog, daemon=True).start()
        results = {}
        for _name, _title, fn in (
            (
                "malware scan",
                STEP_SCAN_TITLE,
                lambda: (
                    _skip_scan_step(script_dir, tag)
                    if skip_scan
                    else _command_step("malware scan", STEP_SCAN_TITLE, [malware_scan, *scan_flags])
                ),
            ),
            ("binary smoke test", STEP_SMOKE_TITLE, lambda: _smoke_step(script_dir, smoke_test, use_smoke_cache)),
            ("checksums", STEP_CHECKSUMS_TITLE, lambda: _checksum_step(script_dir)),
            ("manifest export", STEP_MANIFEST_TITLE, lambda: _manifest_export_step(script_dir)),
            ("secret scan", STEP_SECRET_TITLE, lambda: _secret_scan_step(script_dir)),
            ("vulnerability scan", STEP_VULN_TITLE, lambda: _vuln_scan_step(script_dir)),
        ):
            t0 = time.monotonic()
            result = fn()
            _log_gate_result(result, time.monotonic() - t0, tag)
            _emit_step_result(result)
            results[result.name] = result
        seq_stop.set()
        return results

    workers = 4
    if mem is not None and mem < 6144:
        workers = 2
        print(f"  WARNING: {mem} MB available; running gates with {workers} workers to avoid OOM", flush=True)

    stop = threading.Event()

    def watchdog():
        while not stop.wait(2.0):
            avail = _mem_available_mb()
            if avail is not None and avail < 1024:
                _abort_oom(avail)

    watcher = threading.Thread(target=watchdog, daemon=True)
    watcher.start()

    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as executor:
        futures = {}
        submit_times = {}

        def submit(fn, *args):
            fut = executor.submit(fn, *args)
            submit_times[fut] = time.monotonic()
            return fut

        if skip_scan:
            future = submit(_skip_scan_step, script_dir, tag)
        else:
            future = submit(_command_step, "malware scan", STEP_SCAN_TITLE, [malware_scan, *scan_flags])
        futures[future] = ("malware scan", STEP_SCAN_TITLE)

        future = submit(_smoke_step, script_dir, smoke_test, use_smoke_cache)
        futures[future] = ("binary smoke test", STEP_SMOKE_TITLE)

        future = submit(_version_step, farm_versions)
        futures[future] = ("version table", STEP_VERSIONS_TITLE)

        future = submit(_checksum_step, script_dir)
        futures[future] = ("checksums", STEP_CHECKSUMS_TITLE)

        future = submit(_manifest_export_step, script_dir)
        futures[future] = ("manifest export", STEP_MANIFEST_TITLE)

        future = submit(_secret_scan_step, script_dir)
        futures[future] = ("secret scan", STEP_SECRET_TITLE)

        future = submit(_vuln_scan_step, script_dir)
        futures[future] = ("vulnerability scan", STEP_VULN_TITLE)

        results = {}
        for future in concurrent.futures.as_completed(futures):
            name, title = futures[future]
            try:
                result = future.result()
            except Exception as exc:  # noqa: BLE001 - release gate must surface any worker failure.
                result = StepResult(name=name, title=title, returncode=1, output=f"{exc}\n")
            _log_gate_result(result, time.monotonic() - submit_times.get(future, time.monotonic()), tag)
            _emit_step_result(result)
            results[result.name] = result

    stop.set()
    return results


def _stash_section_md():
    """How to pair the source tarball with the plugin-stash asset.

    These are two separate downloads that have to be brought together by hand,
    and nothing on the release page says so -- the instructions lived only in
    docs/INSTALLATION.md and the deployment runbook, i.e. findable only by
    someone who already knew to look. Putting it in the notes puts it next to
    the assets it is about.
    """
    return "\n".join(
        [
            f"## Installing (and the `{STASH_ASSET_NAME}` asset)",
            "",
            "The Neovim plugin stash ships as a **separate release asset**, not inside the",
            "source tarball -- it is ~328 MB of bz2'd git packfiles, so committing it would",
            "grow every clone permanently. Download it alongside the tarball and pair them:",
            "",
            "```sh",
            "tar xzf engineering-loadout-*.tar.gz",
            "cd engineering-loadout-*/",
            "",
            "# online: fetches + verifies the stash from this release",
            "./tools/fetch-stash",
            "",
            "# air-gapped: stash + sha256sums.txt downloaded elsewhere and copied over",
            f"./tools/fetch-stash --from-file /path/to/{STASH_ASSET_NAME} \\",
            f"              --sums     /path/to/{SHA256SUMS_NAME}",
            "",
            "./loadout install @shared-all      # bundled tools",
            "./loadout install @envs-all        # per-user shell configs",
            "```",
            "",
            "Run `fetch-stash` **from inside the extracted directory**; it places the stash at",
            f"`{STASH_REL}` and records it in `.content-manifest.fetched`.",
            "",
            f"`--sums` is required with `--from-file`: without the `{SHA256SUMS_NAME}` from this",
            "same release there is nothing to verify against, and a stash that fails its hash is",
            "deleted rather than left on disk. Do **not** copy the asset into place by hand --",
            "`.content-manifest` is a strict allowlist and the installer refuses any payload file",
            "with no manifest entry, so a hand-placed stash is rejected, not silently trusted.",
            "",
            "Without the stash, Neovim still installs and starts; the plugin step is skipped with",
            "a warning naming `fetch-stash`.",
        ]
    )


def _verify_section_md(tag, signing):
    """Copy-paste verification steps for the release notes."""
    steps = [
        "## Verifying this release",
        "",
        "```sh",
        "# from a checkout of the tag (or an extracted source archive):",
        "sha256sum -c sha256sums.txt     # pins the integrity-critical files above",
        "./loadout doctor --verify       # re-hashes every payload file vs .content-manifest",
    ]
    if signing:
        steps.append(f"git tag -v {tag}                # verify the SSH-signed tag")
    steps.append("```")
    return "\n".join(steps)


def _push_release_branch():
    """Push the branch the release commit sits on, BEFORE tagging/publishing.

    v2026.08.09 published a release whose commit was on no remote branch: this
    script pushed the tag and nothing else, so `origin/main` still pointed at the
    previous release while the release advertised the new tree. Anyone pulling
    `main` got the pre-release tree. Every check in docs/RELEASE.md section 9
    passes while that is true -- the tag, its signature and all three assets are
    correct -- so nothing caught it.

    Ordering is deliberate: branch first, then tag/publish. A branch pushed
    without a release is benign (an ordinary commit); a release published without
    the branch is the broken state. Failing here therefore blocks the release
    instead of leaving a half-published one.

    Re-reads the remote ref afterwards rather than trusting the push exit code.
    """
    head = subprocess.run(["git", "symbolic-ref", "--quiet", "--short", "HEAD"], capture_output=True, text=True)
    if head.returncode != 0:
        print(
            "Release blocked: HEAD is detached, so the release commit would be\n"
            "reachable only through the tag. Check out the release branch first.",
            file=sys.stderr,
        )
        sys.exit(1)
    branch = head.stdout.strip()

    local = subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
    print(f"  pushing branch {branch} ({local[:7]}) ...")
    if run(["git", "push", "origin", branch]).returncode != 0:
        print(
            f"Release blocked: `git push origin {branch}` failed. The release commit\n"
            "must be on a remote branch before the release advertises it.",
            file=sys.stderr,
        )
        sys.exit(1)

    ls = subprocess.run(["git", "ls-remote", "origin", f"refs/heads/{branch}"], capture_output=True, text=True)
    remote = ls.stdout.split()[0] if ls.returncode == 0 and ls.stdout.split() else ""
    if remote != local:
        print(
            f"Release blocked: origin/{branch} is {remote or '<missing>'}, expected {local}.\n"
            "The push reported success but the remote ref does not match.",
            file=sys.stderr,
        )
        sys.exit(1)
    print(f"  origin/{branch} verified at {local[:7]}")


def _collect_tags():
    """Local + remote tag names, unioned.

    The remote list is mandatory: a stale clone (or one that never fetched this
    month's tags) must not lower the counter and mint a tag that already exists.
    Aborts when `git ls-remote` fails -- an unreadable remote is not proof the
    counter is free.
    """
    tags = set()
    local = subprocess.run(["git", "tag", "--list"], capture_output=True, text=True)
    if local.returncode == 0:
        tags.update(local.stdout.split())
    remote = subprocess.run(["git", "ls-remote", "--tags", "origin"], capture_output=True, text=True)
    if remote.returncode != 0:
        lines = (remote.stderr or remote.stdout).strip().splitlines()
        detail = lines[-1] if lines else "git ls-remote failed"
        print(f"Release blocked: cannot read remote tags ({detail}).", file=sys.stderr)
        sys.exit(1)
    for line in remote.stdout.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1].startswith("refs/tags/"):
            name = parts[1][len("refs/tags/") :]
            if not name.endswith("^{}"):
                tags.add(name)
    return tags


def _month_counter(tags, today):
    """Highest N among `YYYY.M.N` tags for TODAY's month, or None.

    Legacy `v<YYYY.MM.DD>` names, other months, zero-padded segments and the
    zero counter are ignored: the scheme is unpadded (canonical PEP 440) and
    1-based, so `2026.9.01` / `2026.9.0` are not ours to count.
    """
    prefix = f"{today.year}.{today.month}"
    pat = re.compile(rf"^{re.escape(prefix)}\.([1-9][0-9]*)$")
    numbers = [int(m.group(1)) for tag in tags if (m := pat.match(tag))]
    return max(numbers) if numbers else None


def _plan_next_tag(today, latest, latest_published):
    """The bump rule: (next_tag, None), or (None, refusal message).

    Bump only when the month's latest tag has a fully published release. A tag
    with no release, a draft, or an unconfirmable state is a half-finished
    release; bumping past it would strand it, so the refusal names the exact
    `--tag` repair instead.
    """
    prefix = f"{today.year}.{today.month}"
    if latest is None:
        return f"{prefix}.1", None
    if not latest_published:
        return None, (
            f"the latest tag {prefix}.{latest} is not a fully published release; "
            f"repair it with `./build/release --tag {prefix}.{latest}` "
            "or delete the tag before cutting the next release."
        )
    return f"{prefix}.{latest + 1}", None


def _release_published(tag):
    """(published, detail) for TAG's GitHub release.

    True only on positive proof: `gh release view` succeeded and the release is
    not a draft. Any unreadable state counts as not published -- the bump rule
    requires evidence the previous release finished, not an absence of evidence.
    """
    r = subprocess.run(["gh", "release", "view", tag, "--json", "isDraft"], capture_output=True, text=True)
    if r.returncode != 0:
        lines = (r.stderr or r.stdout).strip().splitlines()
        return False, (lines[-1] if lines else "gh release view failed")
    try:
        if json.loads(r.stdout).get("isDraft"):
            return False, "release is still a DRAFT (invisible to /releases/latest)"
    except ValueError, AttributeError:
        return False, "gh release view returned unreadable JSON"
    return True, ""


def _derive_next_tag():
    """Derive the next `YYYY.M.N` tag for the current month.

    Runs after the preflight (it needs the authenticated `gh` for the release
    state check), before the gates, so a busy counter or a half-finished
    previous release surfaces at kickoff rather than after the scan and smoke
    test. Explicit --tag bypasses this entirely (the overwrite/repair path).
    """
    today = datetime.date.today()
    latest = _month_counter(_collect_tags(), today)
    published, detail = (True, "") if latest is None else _release_published(f"{today.year}.{today.month}.{latest}")
    tag, refusal = _plan_next_tag(today, latest, published)
    if refusal is not None:
        print(f"\nRelease blocked: {refusal}", file=sys.stderr)
        if detail:
            print(f"  ({detail})", file=sys.stderr)
        sys.exit(1)
    return tag


def _replace_existing_release(tag):
    """Replace TAG's GitHub release and tag ref with the current tree.

    This is the explicit-`--tag` overwrite/repair path: the operator named the
    exact release, so a deliberate replacement cannot be confused with the bare
    run's append-only bump. Policy (docs/RELEASE.md section 8): overwrite only a
    release that has not earned trust yet; once trusted, cut the next N instead.
    Prints the old release's publication time so a stale overwrite is visible.
    Tears down the GitHub release (and its assets) and the remote+local tag; a
    no-op for a brand-new tag."""
    view = subprocess.run(
        ["gh", "release", "view", tag, "--json", "isDraft,publishedAt"], capture_output=True, text=True
    )
    if view.returncode == 0:
        try:
            published_at = json.loads(view.stdout).get("publishedAt") or "unknown time"
        except ValueError, AttributeError:
            published_at = "unknown time"
        print(f"  replacing existing GitHub release {tag} (published {published_at}) ...")
        subprocess.run(["gh", "release", "delete", tag, "--yes"])
    _delete_tag(tag)


def _delete_tag(tag):
    """Remove the remote then local tag; ignore absence (fresh tag, or a release
    that exists without a pushed tag). Used both to tear a release down fully and
    to move the tag under a KEPT release (stash-reuse path)."""
    subprocess.run(["git", "push", "origin", "--delete", tag], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["git", "tag", "-d", tag], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _remote_release_exists(tag):
    return subprocess.run(["gh", "release", "view", tag], capture_output=True, text=True).returncode == 0


def _remote_stash_asset(tag):
    """(present, size) for the plugin-stash asset on the existing release TAG."""
    r = subprocess.run(["gh", "release", "view", tag, "--json", "assets"], capture_output=True, text=True)
    if r.returncode != 0:
        return (False, 0)
    try:
        assets = json.loads(r.stdout).get("assets", [])
    except ValueError, AttributeError:
        return (False, 0)
    for a in assets:
        if a.get("name") == STASH_ASSET_NAME:
            return (True, a.get("size", 0))
    return (False, 0)


def _remote_stash_sha(tag):
    """SHA-256 recorded for the plugin stash in the EXISTING release's
    sha256sums.txt, or None if there is no release / no sums asset / no stash
    line. Downloading the tiny sums file is how we compare stash CONTENT without
    the GitHub asset API (which does not expose a content digest). The temp file
    lives OUTSIDE the repo -- the pre-commit hook runs `git add -A`, so a stray
    file in the tree would risk being committed."""
    fd, tmp = tempfile.mkstemp(prefix="release-prev-sums.", suffix=".txt")
    os.close(fd)
    r = subprocess.run(
        ["gh", "release", "download", tag, "-p", SHA256SUMS_NAME, "-O", tmp, "--clobber"],
        capture_output=True,
        text=True,
    )
    sha = None
    if r.returncode == 0 and os.path.isfile(tmp):
        try:
            with open(tmp) as fh:
                for line in fh:
                    parts = line.split()
                    if len(parts) == 2 and parts[1] == STASH_REL:
                        sha = parts[0]
                        break
        except OSError:
            sha = None
    try:
        os.remove(tmp)
    except OSError:
        pass
    return sha


def _can_reuse_stash(tag, stash_path, local_stash_sha):
    """True when the existing release already carries a byte-identical stash
    asset, so the 328 MB upload can be skipped. Requires an existing release, a
    present stash asset whose size matches the local file, AND a matching SHA-256
    in the previous release's sha256sums.txt -- size alone is not proof."""
    if not (os.path.isfile(stash_path) and local_stash_sha and _remote_release_exists(tag)):
        return False
    present, remote_size = _remote_stash_asset(tag)
    if not present or remote_size != os.path.getsize(stash_path):
        return False
    return _remote_stash_sha(tag) == local_stash_sha


def _verify_published_stash(tag, stash_path):
    """(ok, detail): confirm the release is PUBLISHED (not a draft -- a draft is
    invisible to /releases/latest, which is what ./tools/fetch-stash resolves) and
    still carries the stash asset at the right size. Never trust an upload/edit
    exit code; re-read the release and check -- the 2026-07-22 lesson."""
    r = subprocess.run(["gh", "release", "view", tag, "--json", "isDraft,assets"], capture_output=True, text=True)
    if r.returncode != 0:
        return (False, "cannot read the release after publish")
    try:
        d = json.loads(r.stdout)
    except ValueError, AttributeError:
        return (False, "release JSON unparseable after publish")
    if d.get("isDraft"):
        return (False, "release is still a DRAFT (invisible to /releases/latest)")
    want = os.path.getsize(stash_path)
    for a in d.get("assets", []):
        if a.get("name") == STASH_ASSET_NAME:
            if a.get("size") == want:
                return (True, "published; stash asset present, size matches")
            return (False, f"stash asset size {a.get('size')} != local {want}")
    return (False, "stash asset missing from published release")


def _record_skip_scan_justification(script_dir, tag):
    """--skip-scan bypasses the malware gate; record that it happened so the
    ledger has an audit trail rather than a silent skip."""
    log = os.path.join(script_dir, "assurance", "downloads.log")
    try:
        os.makedirs(os.path.dirname(log), exist_ok=True)
        with open(log, "a") as fh:
            date = datetime.datetime.now(datetime.UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
            fh.write(f"{date}\tRELEASE-SKIP-SCAN\ttag={tag or '(auto)'} -- malware scan bypassed via --skip-scan\n")
    except OSError:
        pass


@click.command(
    name="release",
    context_settings={"help_option_names": ["-h", "--help"]},
)
@click.option(
    "--tag",
    default=None,
    metavar="TAG",
    help="Exact release tag (default: next YYYY.M.N counter for this month).",
)
@click.option(
    "--dry-run",
    "dry_run",
    is_flag=True,
    help="Run pre-release gates only; skip tagging and GitHub release.",
)
@click.option(
    "--skip-scan",
    "skip_scan",
    is_flag=True,
    help="Skip the YARA malware scan (NOT recommended; only for a known false positive).",
)
@click.option(
    "--allow-unsigned",
    "allow_unsigned",
    is_flag=True,
    help="Release even when the tag cannot be signed (breaks the trust chain; NOT recommended).",
)
@click.option(
    "--no-cache",
    "no_cache",
    is_flag=True,
    help="Force fresh gates: re-run the binary smoke test and malware scan even if a cached pass matches.",
)
@click.option(
    "--clear-cache",
    "clear_cache",
    is_flag=True,
    help="Delete cached smoke/scan results before running (implies a fresh run).",
)
def main(tag, dry_run, skip_scan, allow_unsigned, no_cache, clear_cache):
    """Run pre-release gates, then create a GitHub release.

    Authentication is settled in a preflight step BEFORE any gate runs, because
    the gates are slow and the operator is only reliably at the keyboard at
    kickoff. The malware scan, binary smoke test, version table, and checksum
    generation are independent and run in parallel. The tag/release step waits
    for them and aborts when a mandatory gate fails.

    The malware scan and the ~4.5 min binary smoke test are content-cached: a
    routine re-release whose payload, installer and probe script are byte-for-byte
    unchanged reuses the recorded pass instead of re-running. --no-cache / --clear
    -cache force a fresh run.

    Requires: gh (GitHub CLI) authenticated, git repo with remote set.
    """
    script_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))  # repo root; this script lives in build/
    smoke_test = os.path.join(script_dir, "tests", "prebuilt-binaries")
    farm_versions = os.path.join(script_dir, "build", "farm-versions")
    malware_scan = os.path.join(script_dir, "build/scan-for-malware")

    if clear_cache:
        shutil.rmtree(_smoke_cache_dir(), ignore_errors=True)
    use_smoke_cache = not (no_cache or clear_cache)
    # Forward the same intent to scan-for-malware, which owns its own clean-cache.
    scan_flags = []
    if clear_cache:
        scan_flags.append("--clear-cache")
    if no_cache or clear_cache:
        scan_flags.append("--no-cache")

    signing = _preflight(dry_run, allow_unsigned)

    # Tag derivation needs the authenticated gh (release state) and the network
    # (remote tags). Settling it here means a counter collision or a
    # half-finished previous release blocks at kickoff, before the slow gates.
    if tag is None:
        tag = _derive_next_tag()
        print(f"  release tag   : {tag} (auto: next YYYY.M.N counter for this month)", flush=True)

    release_t0 = time.monotonic()
    results = _run_parallel_pre_release_steps(
        script_dir, smoke_test, farm_versions, malware_scan, tag, skip_scan, use_smoke_cache, scan_flags
    )

    scan_result = results["malware scan"]
    if scan_result.returncode != 0:
        print("\nRelease blocked: malware scan reported detections (or failed).", file=sys.stderr)
        print("Investigate every hit before releasing. Override with --skip-scan only", file=sys.stderr)
        print("if you have confirmed it is a YARA false positive.", file=sys.stderr)
        sys.exit(1)

    smoke_result = results["binary smoke test"]
    if smoke_result.returncode != 0:
        print("\nRelease blocked: binary smoke test failed.", file=sys.stderr)
        print("Fix failing binaries before releasing.", file=sys.stderr)
        sys.exit(1)

    checksum_result = results["checksums"]
    if checksum_result.returncode != 0:
        print("\nRelease blocked: checksum/SBOM generation failed.", file=sys.stderr)
        sys.exit(1)

    manifest_result = results["manifest export"]
    if manifest_result.returncode != 0:
        print("\nRelease blocked: .content-manifest does not match the git export.", file=sys.stderr)
        print("The tag would publish a manifest that cannot be verified from a clean", file=sys.stderr)
        print("checkout. Regenerate it with build/gen-content-manifest and commit.", file=sys.stderr)
        sys.exit(1)

    secret_result = results["secret scan"]
    if secret_result.returncode != 0:
        print("\nRelease blocked: secret scan found committed secrets.", file=sys.stderr)
        print("Rotate the credential, then allowlist only reviewed false positives in", file=sys.stderr)
        print("build/gitleaks/loadout.toml.", file=sys.stderr)
        sys.exit(1)

    vuln_result = results["vulnerability scan"]
    if vuln_result.returncode != 0:
        print("\nRelease blocked: vulnerability scan has unbaselined findings.", file=sys.stderr)
        print("Refresh the affected wheel or add a reviewed entry to assurance/vuln-baseline.json", file=sys.stderr)
        print("(./build/vuln-scan explains both paths).", file=sys.stderr)
        sys.exit(1)

    if dry_run:
        print("\nDry run -- pre-release gates passed. Skipping tag and GitHub release.")
        _log_runtime("release", "total", time.monotonic() - release_t0, "PASS", f"{tag} dry-run")
        return

    version_table = results["version table"].data or ""
    pairs = checksum_result.data["pairs"]
    sums_path = checksum_result.data["sums_path"]

    # `signing` comes from the preflight, which proved the signer actually
    # produces a signature non-interactively. It is deliberately NOT re-derived
    # from `git config` here: a bare config lookup says a key is *named*, not
    # that signing works, and that gap is exactly how the 2026-07-22 release
    # shipped an unsigned tag. Uploading the key is a one-time owner step --
    # see docs/SECURITY.md section 6.
    notes = "\n\n".join(
        section
        for section in (
            "All pre-built binaries passed smoke test.",
            _stash_section_md(),
            _checksum_table_md(pairs),
            _sbom_section_md(),
            _verify_section_md(tag, signing),
            version_table.strip(),
        )
        if section
    )

    # The nvim plugin stash rides as an ASSET, not a git payload: it is ~328 MB of bz2'd
    # git packfiles, so committing it added ~328 MB to history on EVERY refresh,
    # permanently. Its sha256 is in sha256sums.txt above, which this signed tag covers --
    # that is the chain ./tools/fetch-stash verifies before the installer will touch the bytes.
    stash = os.path.join(script_dir, STASH_REL)
    local_stash_sha = dict(pairs).get(STASH_REL)

    # Reuse the existing release's stash asset when its bytes are unchanged, so a
    # routine re-release does not re-upload 328 MB. Requires a signed tag: a
    # reused asset is only as trustworthy as the tag that (re)binds sha256sums.txt.
    reuse_stash = bool(signing) and _can_reuse_stash(tag, stash, local_stash_sha)

    # Assets: the sums file plus the content manifest itself, so a downloader can
    # verify the full payload tree without cloning the multi-GB source archive.
    # The stash joins them only when NOT reusing the remote copy.
    assets = [sums_path]
    content_manifest = os.path.join(script_dir, ".content-manifest")
    if os.path.isfile(content_manifest):
        assets.append(content_manifest)
    sbom_path = os.path.join(script_dir, "sbom.cdx.json")
    if os.path.isfile(sbom_path):
        assets.append(sbom_path)
    if os.path.isfile(stash):
        if reuse_stash:
            print(
                f"  reusing the existing release's stash asset "
                f"({os.path.getsize(stash) // 1048576} MB, sha256 unchanged) -- not re-uploading"
            )
        else:
            assets.append(stash)
            print(f"  attaching nvim plugin stash ({os.path.getsize(stash) // 1048576} MB)")
    else:
        print("  NOTE: no nvim-plugin-stash.tar.bz2 -- releasing without it.")
        print("        Users will get nvim with no plugins. Build it with")
        print("        build/build-nvim-plugin-stash if that is not what you want.")

    print()
    _print_heading(f"Step 6: Creating tag and GitHub release: {tag}")

    # The branch goes first: a release whose commit is on no remote branch passes
    # every post-publish check while advertising a tree nobody can pull.
    _push_release_branch()

    # Explicit --tag targets exactly that release: replace it. A bare run only
    # reaches here after deriving the next counter off a fully published
    # previous release, so an existing release for THIS tag means the operator
    # named it deliberately. When reusing the stash we must KEEP the release
    # object (it holds the 328 MB asset), so only the tag is moved; otherwise
    # the whole release is torn down and recreated.
    if reuse_stash:
        _delete_tag(tag)
    else:
        _replace_existing_release(tag)

    tag_cmd = ["git", "tag", "-s" if signing else "-a", tag, "-m", tag]
    if not signing:
        print("  WARNING: creating an UNSIGNED annotated tag (--allow-unsigned).")
        print("  The content-manifest trust chain is NOT tamper-evident (docs/SECURITY.md).")
    result = run(tag_cmd)
    if result.returncode != 0:
        print("git tag failed.", file=sys.stderr)
        sys.exit(1)

    # Never take the signer's exit status as proof. Confirm the object really
    # carries a signature before anything downstream claims it does.
    if signing:
        obj = subprocess.run(["git", "cat-file", "-p", tag], capture_output=True, text=True)
        if "BEGIN SSH SIGNATURE" not in obj.stdout and "BEGIN PGP SIGNATURE" not in obj.stdout:
            print("Release blocked: tag was created WITHOUT a signature.", file=sys.stderr)
            subprocess.run(["git", "tag", "-d", tag], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            sys.exit(1)

    result = run(["git", "push", "origin", tag])
    if result.returncode != 0:
        print("git push tag failed.", file=sys.stderr)
        sys.exit(1)

    if reuse_stash:
        # Deleting the tag drafts the kept release (GitHub drafts a release whose
        # tag vanished, and recreating the tag does NOT auto-republish). Undraft
        # it, refresh the notes, and clobber only the small assets -- the stash
        # asset is left in place. Then VERIFY the release is published and still
        # carries the stash; on any doubt self-heal with a full stash upload
        # rather than ship an invisible or asset-less release.
        run(["gh", "release", "edit", tag, "--draft=false", "--notes", notes])
        small = [a for a in assets if a != stash]
        if small:
            result = run(["gh", "release", "upload", tag, *small, "--clobber"])
            if result.returncode != 0:
                print("gh release upload failed.", file=sys.stderr)
                sys.exit(1)
        ok, detail = _verify_published_stash(tag, stash)
        if not ok:
            print(f"  reuse verification failed ({detail}); self-healing with a full stash upload.", file=sys.stderr)
            run(["gh", "release", "upload", tag, stash, "--clobber"])
            run(["gh", "release", "edit", tag, "--draft=false"])
            ok, detail = _verify_published_stash(tag, stash)
            if not ok:
                print(f"Release blocked: {detail}", file=sys.stderr)
                sys.exit(1)
        print(f"  reuse verified: {detail}")
    else:
        result = run(["gh", "release", "create", tag, "--title", tag, "--notes", notes, *assets])
        if result.returncode != 0:
            print("gh release create failed.", file=sys.stderr)
            sys.exit(1)
        # Re-read: confirm the freshly-uploaded stash actually landed (never trust
        # the create exit code alone).
        if os.path.isfile(stash):
            ok, detail = _verify_published_stash(tag, stash)
            if not ok:
                print(f"Release blocked: {detail}", file=sys.stderr)
                sys.exit(1)

    print(f"\nRelease {tag} created" + (" (signed tag)." if signing else " (UNSIGNED tag)."))
    _log_runtime("release", "total", time.monotonic() - release_t0, "PASS", tag)


if __name__ == "__main__":
    main()
