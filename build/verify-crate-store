#!/usr/bin/env python3
"""verify-crate-store -- integrity-check the offline Cargo crate store.

The store (payload/crate-store/crate-store.tar.bz2.part-*) is a `cargo
local-registry`: a flat set of `<name>-<vers>.crate` files plus an `index/`
whose JSON-lines each carry the upstream crates.io SHA-256 (`cksum`). This tool
re-hashes every `.crate` against that `cksum` -- any mismatch means the vendored
store no longer matches what crates.io published (tampering or corruption).

It also emits/checks `assurance/crate-store.lock`: the committed
`name version cksum` closure. Because the lock lives in git and the release tag
is SSH-signed, altering a shipped crate requires rewriting BOTH the store and
the signed-tag'd lock -- not just a file drop. See docs/SECURITY.md.

Runs under any python3 (stdlib only); no 3.14-only syntax so it works in the
clean almalinux:8.10 container's system python too.

Usage:
    build/verify-crate-store              # re-hash all crates vs the index
    build/verify-crate-store --emit-lock  # (re)write assurance/crate-store.lock
    build/verify-crate-store --check-lock # fail if the committed lock drifted
"""

import argparse
import glob
import hashlib
import json
import os
import sys
import tarfile
import tempfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
STORE_BASE = os.path.join(REPO, "payload", "crate-store", "crate-store.tar.bz2")
LOCK = os.path.join(REPO, "assurance", "crate-store.lock")
COVERAGE = os.path.join(REPO, "assurance", "crate-store-tools.tsv")


def _sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def _extract_store(tmp):
    """Rejoin the chunked archive and extract it into tmp; return the store dir."""
    parts = sorted(glob.glob(STORE_BASE + ".part-*")) or ([STORE_BASE] if os.path.exists(STORE_BASE) else [])
    if not parts:
        sys.exit("crate-store archive not found under payload/crate-store/")
    joined = os.path.join(tmp, "crate-store.tar.bz2")
    with open(joined, "wb") as out:
        for p in parts:
            with open(p, "rb") as inp:
                while True:
                    b = inp.read(1 << 20)
                    if not b:
                        break
                    out.write(b)
    dest = os.path.join(tmp, "store")
    os.makedirs(dest)
    with tarfile.open(joined, "r:bz2") as tf:
        try:
            tf.extractall(dest, filter="data")  # py3.12+ path-safe filter
        except TypeError:
            tf.extractall(dest)
    # The archive may wrap the registry in a single top dir; find the dir holding index/.
    if os.path.isdir(os.path.join(dest, "index")):
        return dest
    for root, dirs, _ in os.walk(dest):
        if "index" in dirs:
            return root
    sys.exit("no index/ directory found in the crate store")


def _index_checksums(store_dir):
    """Map (name, vers) -> cksum by reading the cargo registry index JSON-lines."""
    cks = {}
    idx = os.path.join(store_dir, "index")
    for root, _, files in os.walk(idx):
        for fn in files:
            if fn.startswith("."):
                continue
            with open(os.path.join(root, fn), encoding="utf-8") as fh:
                for line in fh:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        e = json.loads(line)
                    except ValueError:
                        continue
                    if "name" in e and "vers" in e and "cksum" in e:
                        cks[(e["name"], e["vers"])] = e["cksum"]
    return cks


TOOL_LOCKS = os.path.join(REPO, "build", "rust-tool-locks.txt")
REGISTRY = os.path.join(REPO, "payload", "packages.json")

# rust-tool-locks.txt name -> packages.json name, where they differ.
_TOOL_ALIASES = {"ripgrep": "rg"}


def _tool_refs():
    """[(name, ref)] from build/rust-tool-locks.txt, skipping HEAD-tracked repos."""
    out = []
    with open(TOOL_LOCKS, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split()
            if len(parts) < 3 or parts[2] == "HEAD":
                continue
            out.append((parts[0], parts[2]))
    return out


def check_policy():
    """Assert build/rust-tool-locks.txt still matches what packages.json ships.

    The SHIPPED store is the superset built by build-tool-crate-store.sh: the
    user seed closure UNION every bundled rust tool's Cargo.lock closure. Those
    tool locks are harvested at the refs pinned in build/rust-tool-locks.txt,
    and that file says "Refs track the versions bundled in packages.json. Bump
    here when the bundled binary is bumped." Nothing enforced it.

    So the refs silently rotted -- fish sat at 4.7.1 while the loadout shipped
    4.8.1, which is exactly why the store lacked fish's Fluent crates and the
    4.8.1 build died with "no matching package named `unic-langid` found". Same
    for numr 0.5.5 vs 0.8.0 and nine others. --check-lock never noticed, because
    it only compares the store to its own committed lock, never to the inputs
    that are supposed to produce it.

    Deliberately does NOT check the aws-lc ban: build-crate-store.sh bans it for
    the lean user-only store, but the superset builder downgrades that to a
    warning because a bundled tool's lock may legitimately pin it (numr's does,
    via reqwest -> rustls).
    """
    with open(REGISTRY, encoding="utf-8") as fh:
        packages = json.load(fh)["packages"]

    drifted, unknown = [], []
    refs = _tool_refs()
    for name, ref in refs:
        pkg = packages.get(_TOOL_ALIASES.get(name, name))
        if pkg is None:
            unknown.append(name)
            continue
        want = str(pkg.get("version", ""))
        if want and want != ref:
            drifted.append((name, ref, want))

    if drifted or unknown:
        if drifted:
            print(
                "build/rust-tool-locks.txt refs disagree with payload/packages.json.",
                file=sys.stderr,
            )
            print(
                "The shipped crate store is built from these refs, so a stale one means "
                "the store cannot rebuild that tool offline:",
                file=sys.stderr,
            )
            for name, ref, want in drifted:
                print(f"  {name}: locks say {ref}, registry ships {want}", file=sys.stderr)
        if unknown:
            print("Tools listed in rust-tool-locks.txt with no packages.json entry:", file=sys.stderr)
            for name in unknown:
                print("  " + name, file=sys.stderr)
        print("  Re-pin the refs, then rebuild: build/build-tool-crate-store.sh", file=sys.stderr)
        sys.exit(1)

    check_coverage(refs)
    print(f"crate-store policy OK ({len(refs)} pinned tool refs match packages.json)")


def check_coverage(refs=None):
    """Assert every pinned tool actually CONTRIBUTED crates to the shipped store.

    Ref-consistency is not coverage, and conflating the two hid a real hole for
    the entire life of this store. build-tool-crate-store.sh skips a tool it
    cannot harvest -- no Cargo.lock, clone failure, sync failure -- with a WARN
    on stderr, and still exits 0. check_policy() then compared refs to
    packages.json, found them equal, and printed OK.

    `ty` was absent from EVERY store ever built on exactly that path:
    astral-sh/ty is a thin distribution repo whose Rust source is a `ruff` git
    submodule, so it has no root Cargo.lock and generate-lockfile fails. The
    store therefore could not rebuild ty offline while the gate said it could,
    and a ty bump was repeatedly deferred on the false premise that the store
    was the blocker. `surfer` was silently missing the same way.

    Reads assurance/crate-store-tools.tsv, which the builder writes last on an
    otherwise successful run. HEAD-tracked first-party repos are already
    excluded by _tool_refs(), so a rolling repo that needs clone auth cannot
    fail this.
    """
    if refs is None:
        refs = _tool_refs()

    if not os.path.exists(COVERAGE):
        print(f"{COVERAGE} missing -- cannot prove the store covers the pinned tools.", file=sys.stderr)
        print("  Rebuild with: build/build-tool-crate-store.sh", file=sys.stderr)
        sys.exit(1)

    counts = {}
    with open(COVERAGE, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split("\t")
            if len(parts) != 2:
                continue
            try:
                counts[parts[0]] = int(parts[1])
            except ValueError:
                continue

    absent = [name for name, _ref in refs if counts.get(name, 0) <= 0]
    if absent:
        print(
            "Pinned rust tools contribute NO crates to the shipped store, so it cannot rebuild them offline:",
            file=sys.stderr,
        )
        for name in absent:
            why = "not recorded by the builder" if name not in counts else "recorded with 0 crates"
            print(f"  {name}: {why}", file=sys.stderr)
        print(
            "  The builder WARNs and exits 0 on a skip -- read its log for 'WARN:.*skipping'.",
            file=sys.stderr,
        )
        sys.exit(1)


def main():
    ap = argparse.ArgumentParser(description="Integrity-check the offline Cargo crate store.")
    ap.add_argument("--emit-lock", action="store_true", help="(re)write assurance/crate-store.lock")
    ap.add_argument("--check-lock", action="store_true", help="fail if the committed lock differs from computed")
    ap.add_argument(
        "--check-policy",
        action="store_true",
        help="fail if the store violates the seed list or the ban list (reads the lock; no extraction)",
    )
    ap.add_argument(
        "--check-coverage",
        action="store_true",
        help="fail if any pinned rust tool contributed no crates to the store (implied by --check-policy)",
    )
    args = ap.parse_args()

    if args.check_coverage and not (args.check_policy or args.emit_lock or args.check_lock):
        check_coverage()
        print("crate-store coverage OK")
        return

    if args.check_policy and not (args.emit_lock or args.check_lock):
        check_policy()
        return

    with tempfile.TemporaryDirectory(prefix="verify-crate-store-") as tmp:
        store = _extract_store(tmp)
        cks = _index_checksums(store)
        if not cks:
            sys.exit("no index checksums found -- is this a cargo local-registry?")

        mismatch = []
        missing = []
        ok = 0
        lock_lines = []
        for (name, vers), cksum in sorted(cks.items()):
            crate = os.path.join(store, f"{name}-{vers}.crate")
            if not os.path.isfile(crate):
                missing.append(f"{name}-{vers}")
                continue
            actual = _sha256(crate)
            if actual != cksum:
                mismatch.append((f"{name}-{vers}", cksum, actual))
            else:
                ok += 1
                lock_lines.append(f"{name} {vers} {cksum}")

        crate_files = {os.path.basename(p) for p in glob.glob(os.path.join(store, "*.crate"))}
        indexed = {f"{n}-{v}.crate" for (n, v) in cks}
        orphans = sorted(crate_files - indexed)

        print(
            f"crate-store: {ok} verified, {len(mismatch)} MISMATCH, {len(missing)} missing (index entries: {len(cks)})"
        )
        for n, exp, act in mismatch[:20]:
            print(f"  MISMATCH {n}\n    index : {exp}\n    actual: {act}")
        for n in missing[:20]:
            print(f"  MISSING .crate for index entry {n}")
        if orphans:
            print(f"  WARNING: {len(orphans)} .crate file(s) not in index (orphan): {orphans[:5]}")

        lock_text = "".join(line + "\n" for line in sorted(lock_lines))
        if args.emit_lock:
            os.makedirs(os.path.dirname(LOCK), exist_ok=True)
            with open(LOCK, "w", encoding="utf-8") as fh:
                fh.write(lock_text)
            print(f"  wrote {LOCK} ({len(lock_lines)} crates)")
        if args.check_lock:
            if not os.path.exists(LOCK):
                sys.exit("assurance/crate-store.lock missing -- run: build/verify-crate-store --emit-lock")
            if open(LOCK, encoding="utf-8").read() != lock_text:
                print("  crate-store.lock DIFFERS from the computed closure", file=sys.stderr)
                sys.exit(1)
            print("  crate-store.lock matches the computed closure")

        if mismatch or missing:
            print("\nCRATE STORE INTEGRITY FAILURE", file=sys.stderr)
            sys.exit(1)
        print("crate store OK")


if __name__ == "__main__":
    main()
