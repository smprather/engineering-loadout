#!/usr/bin/env python3
"""
import-portable-python: package a portable Python build directory into the
loadout payload tree.

Usage:
    ./import-portable-python <portable-dir> [--platform PLATFORM] [--dry-run]

<portable-dir> is a directory containing install.sh, README.md, and local/.
Example: portable-python-3.14.4-el8-clang23

The output archive is placed at:
    <repo>/payload/<platform>/<basename>.tar.bz2

Platform auto-detection (used when --platform is not given):
  - arch: uname -m
  - glibc version: getconf GNU_LIBC_VERSION or ldd --version
  - OS family: /etc/os-release PLATFORM_ID / ID + ID_LIKE
  Produces a platform string like "el8.x86_64.glibc2p28".

Python version is read from <portable-dir>/local/bin/python3.x --version, or
parsed from the directory name as a fallback.
"""

import os
import re
import subprocess
import sys
import tarfile

_d = os.path.dirname(os.path.abspath(__file__))
while _d not in ("", "/") and not os.path.isdir(os.path.join(_d, "installer_vendor")):
    _d = os.path.dirname(_d)
if os.path.isdir(os.path.join(_d, "installer_vendor")):
    sys.path.insert(0, os.path.join(_d, "installer_vendor"))

import rich_click as click  # noqa: E402


def eprint(*args):
    print(*args, file=sys.stderr)


def die(msg):
    eprint(f"error: {msg}")
    sys.exit(1)


# ---------------------------------------------------------------------------
# Platform detection (mirrors logic in the loadout installer)
# ---------------------------------------------------------------------------


def _find_tool(*candidates):
    for path in candidates:
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return None


_UNAME = _find_tool("/usr/bin/uname", "/bin/uname")
_LDD = _find_tool("/usr/bin/ldd", "/lib64/ld-linux-x86-64.so.2")
_GETCONF = _find_tool("/usr/bin/getconf")


def _run_output(*cmd):
    proc = subprocess.run(list(cmd), capture_output=True)
    return proc.stdout.decode("utf-8", "replace").strip()


def detect_arch():
    if not _UNAME:
        die("uname not found")
    return _run_output(_UNAME, "-m")


def detect_glibc_version():
    if _GETCONF:
        text = _run_output(_GETCONF, "GNU_LIBC_VERSION")
        parts = text.split()
        if len(parts) >= 2:
            return parts[1]
    if _LDD:
        proc = subprocess.run([_LDD, "--version"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        m = re.search(rb"[0-9]+\.[0-9]+", proc.stdout)
        if m:
            return m.group(0).decode("ascii")
    return ""


def ldd_is_musl():
    if not _LDD:
        return False
    proc = subprocess.run([_LDD, "--version"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    return b"musl" in proc.stdout.lower()


def read_os_release():
    data = {}
    try:
        with open("/etc/os-release") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                data[key] = value.strip().strip('"')
    except OSError:
        pass
    return data


def detect_platform():
    arch = detect_arch()

    if ldd_is_musl():
        return f"linux.{arch}.musl"

    glibc_ver = detect_glibc_version()
    glibc_id = "glibc{}".format(glibc_ver.replace(".", "p")) if glibc_ver else "glibc"

    osr = read_os_release()
    distro_id = osr.get("ID", "")
    id_like = osr.get("ID_LIKE", "")
    version_id = osr.get("VERSION_ID", "")
    platform_id = osr.get("PLATFORM_ID", "")
    el_id = ""

    if platform_id.startswith("platform:el"):
        el_id = platform_id[len("platform:") :]
    elif any(
        x in (" " + distro_id + " " + id_like + " ") for x in (" rhel ", " centos ", " almalinux ", " rocky ", " ol ")
    ):
        el_id = "el{}".format(version_id.split(".", 1)[0])

    if el_id:
        return f"{el_id}.{arch}.{glibc_id}"
    return f"linux.{arch}.{glibc_id}"


# ---------------------------------------------------------------------------
# Python version detection
# ---------------------------------------------------------------------------


def detect_python_version(portable_dir):
    """Run python3.x from local/bin to get the version string."""
    bin_dir = os.path.join(portable_dir, "local", "bin")
    if os.path.isdir(bin_dir):
        for name in sorted(os.listdir(bin_dir)):
            if re.match(r"^python3(\.\d+)?$", name):
                binary = os.path.join(bin_dir, name)
                if os.access(binary, os.X_OK):
                    out = _run_output(binary, "--version")
                    m = re.search(r"Python\s+([0-9]+\.[0-9]+\.[0-9]+)", out)
                    if m:
                        return m.group(1)
    # Fallback: parse from directory basename
    basename = os.path.basename(os.path.abspath(portable_dir))
    m = re.search(r"portable-python-([0-9]+\.[0-9]+\.[0-9]+)", basename)
    if m:
        return m.group(1)
    return None


# ---------------------------------------------------------------------------
# Archive construction
# ---------------------------------------------------------------------------


def make_archive(portable_dir, dest_path, dry_run):
    basename = os.path.basename(os.path.abspath(portable_dir))

    print(f"source dir : {portable_dir}")
    print(f"archive    : {dest_path}")

    if dry_run:
        print(f"[dry-run] would create {dest_path}")
        return

    dest_dir = os.path.dirname(dest_path)
    if dest_dir:
        os.makedirs(dest_dir, exist_ok=True)

    tmp_path = dest_path + ".tmp"
    try:
        with tarfile.open(tmp_path, "w:bz2") as tf:
            tf.add(portable_dir, arcname=basename)
        os.rename(tmp_path, dest_path)
        tmp_path = None
    finally:
        if tmp_path and os.path.exists(tmp_path):
            os.unlink(tmp_path)

    size_mb = os.path.getsize(dest_path) / 1024 / 1024
    print(f"created    : {dest_path} ({size_mb:.1f} MB)")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


@click.command(
    name="import-portable-python",
    context_settings={"help_option_names": ["-h", "--help"]},
)
@click.argument("portable_dir", metavar="PORTABLE_DIR", type=click.Path())
@click.option(
    "--platform",
    "platform_override",
    default=None,
    metavar="PLATFORM",
    help="Override platform string (default: auto-detect).",
)
@click.option(
    "--output",
    default=None,
    metavar="PATH",
    help="Write archive to this path instead of the default repo location.",
)
@click.option("--dry-run", "dry_run", is_flag=True, help="Print what would be done without creating the archive.")
def main(portable_dir, platform_override, output, dry_run):
    """Package a portable Python build directory into the loadout payload tree.

    PORTABLE_DIR is a directory containing install.sh, README.md, and local/.
    Example: portable-python-3.14.4-el8-clang23
    """
    portable_dir = os.path.abspath(portable_dir)
    if not os.path.isdir(portable_dir):
        die(f"not a directory: {portable_dir}")
    if not os.path.isfile(os.path.join(portable_dir, "install.sh")):
        die(f"no install.sh in {portable_dir}: does not look like a portable-python directory")

    # Python version
    py_version = detect_python_version(portable_dir)
    if py_version:
        print(f"python     : {py_version}")
    else:
        eprint("warning: could not determine Python version; using directory name")

    # Platform
    platform = platform_override or detect_platform()
    print(f"platform   : {platform}")

    # Output path
    if output:
        dest_path = os.path.abspath(output)
    else:
        script_dir = os.path.dirname(os.path.abspath(__file__))
        repo_dir = os.path.dirname(script_dir)  # repo root
        basename = os.path.basename(portable_dir)
        dest_path = os.path.join(repo_dir, "payload", platform, f"{basename}.tar.bz2")

    make_archive(portable_dir, dest_path, dry_run)

    if not dry_run:
        print()
        print("Next steps:")
        print("  cd <repo>")
        print("  ./build/strip-all-elf-binaries   # skips BOLT-optimized portable-python archives")
        print("  git add payload/{}/{}".format(platform, os.path.basename(portable_dir) + ".tar.bz2"))
        print("  git commit")


if __name__ == "__main__":
    main()
