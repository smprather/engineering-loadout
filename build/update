#!/usr/bin/env python3
"""update -- per-package updater for loadout.

Usage:
  ./build/update                        run all automated packages (no commit)
  ./build/update nodejs yara-rules      run specific automated packages
  ./build/update liberty-tools          rebuild a rolling-git wheel from fresh source
  ./build/update liberty-tools --rebuild  force rebuild even if commit is unchanged
  ./build/update nvim bat rg            show update guidance for those packages
  ./build/update --list                 table: package | kind | version | latest
  ./build/update --list-outdated        same table, only packages where latest > version
  ./build/update --commit               stage + commit automated output
  ./build/update --dry-run              print commands without executing
  ./build/update --tag vX.Y.Z          version hint for nodejs and yara-rules

Update cadence (see the "update cadence" section below):
  ./build/update --currency             table: package | interval | last | due
  ./build/update --set-interval P 1y    throttle one package to once a year
  ./build/update --set-interval P never never auto-update P (manual only)
  ./build/update --ignore-cadence       run the whole sweep regardless of interval

The no-argument sweep honours each package's interval (default 6mo). Naming a
package explicitly ALWAYS updates it -- cadence never blocks a manual run.
"""

