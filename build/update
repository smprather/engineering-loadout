# -- packages.json helpers -----------------------------------------------------


def _load_packages():
    path = os.path.join(REPO, "payload", "packages.json")
    if not os.path.isfile(path):
        return {}
    with open(path) as f:
        return json.load(f).get("packages", {})


PACKAGES = _load_packages()

# Pinned `python-tool` packages: bundled as a wheel closure, refreshed by hand.
# Excludes the rolling-git ones, which ./build/update builds from source instead.
PYPI_WHEEL = {
    n
    for n, p in PACKAGES.items()
    if not n.startswith("@") and p.get("kind") == "python-tool" and not p.get("rolling_git")
}

# Rolling-git packages: built fresh from source on every ./build/update.  Tagged in
# packages.json with "rolling_git": "<clone-url>".  The wheel is rebuilt only
# when the source commit differs from the recorded version; the version stamped
# back into packages.json is `git describe --tags --always --dirty` of HEAD.
ROLLING_GIT = {
    name: info["rolling_git"] for name, info in PACKAGES.items() if isinstance(info, dict) and info.get("rolling_git")
}


def _pkg_version(name):
    # Dev-artifact versions live outside packages.json.
    if name == "yara-rules":
        tag_file = os.path.join(REPO, "payload", "yara", "release-tag.txt")
        if os.path.isfile(tag_file):
            with open(tag_file) as fh:
                return fh.read().strip()
        return ""
    return PACKAGES.get(name, {}).get("version", "")


def _pkg_desc(name):
    # Prefer inline desc for pseudo-packages not in packages.json.
    inline = AUTOMATED.get(name, {}).get("desc") or IMPORT_SCRIPTS.get(name, {}).get("desc")
    if inline:
        return inline
    return PACKAGES.get(name, {}).get("description", "")


def _classify(name):
    if name in ROLLING_GIT:
        return "rolling"
    if name in AUTOMATED:
        return "automated"
    if name in BUILD_SCRIPTS:
        return "build"
    if name in IMPORT_SCRIPTS:
        return "import"
    if name in DOWNLOAD_ONLY:
        return "download"
    if name in PACKAGES and PACKAGES[name].get("kind") == "bin":
        return "download"
    if name in PYPI_WHEEL:
        return "pypi-wheel"
    return None


# -- update cadence ------------------------------------------------------------
#
# Bare `./build/update` is the AUTOMATIC sweep, and "rebuild everything from
# upstream whenever someone runs it" is the wrong default for a farm-facing
# bundle. Every bump drags the full verification burden behind it -- Tier 3
# container run, malware scan, provenance re-check, release notes -- so a tool
# that churns every few weeks costs far more than the churn is worth. Cadence
# lets a package say "no more than once a year" without opting out of updates.
#
# Two deliberate splits:
#
#   POLICY is declarative and reviewable: `auto_update_interval` on the package
#   in payload/packages.json, so it sits next to `pin_reason` and shows up in
#   review. For the handful of dev artifacts with no registry entry
#   (yara-rules, tmux-plugins, taplo-schemas) the same key works on their
#   AUTOMATED entry below.
#
#   STATE is bookkeeping and stays OUT of the shipped registry, in
#   build/currency-state.json. packages.json is hashed into .content-manifest,
#   so recording a timestamp there would dirty the payload manifest on every
#   sweep for something that changes no shipped byte. build/ is export-ignore,
#   so this file never reaches a user.
#
# Naming a package explicitly ALWAYS updates it, cadence or not -- that is the
# manual override, and it needs no special case because main() already
# distinguishes "named packages" from "no-argument sweep".

DEFAULT_AUTO_UPDATE_INTERVAL = "6mo"
_CURRENCY_STATE = os.path.join(BUILD, "currency-state.json")

# Nominal months/years (30 / 365 days). This gates how often a BUILD runs, not
# a billing cycle; calendar exactness would buy nothing here.
_INTERVAL_UNITS = {"d": 1, "w": 7, "mo": 30, "y": 365}
_INTERVAL_RE = re.compile(r"^(\d+)\s*(d|w|mo|y)$")


def _parse_interval(spec):
    """'6mo' -> timedelta(days=180); 'never' -> None. Raises ValueError on junk."""
    s = str(spec).strip().lower()
    if s in ("never", "manual", "off"):
        return None
    m = _INTERVAL_RE.match(s)
    if not m:
        raise ValueError(f"bad interval {spec!r}: use <N>d/<N>w/<N>mo/<N>y or 'never' (e.g. 6mo, 1y, 90d)")
    return datetime.timedelta(days=int(m.group(1)) * _INTERVAL_UNITS[m.group(2)])


def _interval_spec(name):
    """Declared cadence for a package, else the global default."""
    for table in (PACKAGES, AUTOMATED):
        info = table.get(name)
        if isinstance(info, dict) and info.get("auto_update_interval"):
            return info["auto_update_interval"]
    return DEFAULT_AUTO_UPDATE_INTERVAL


def _load_currency_state():
    try:
        with open(_CURRENCY_STATE) as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as exc:
        # Unreadable state must not silently freeze every package forever;
        # fail OPEN (everything due) and say so.
        print(f"WARNING: {_CURRENCY_STATE} unreadable ({exc}); treating every package as due")
        return {}
    return data.get("packages") or {}


def _save_currency_state(pkgs):
    payload = {
        "_comment": (
            "Bookkeeping for ./build/update cadence: WHEN each package last ran. "
            "Policy (how often) is auto_update_interval in payload/packages.json. "
            "Dev-only -- build/ is export-ignore, so this never ships."
        ),
        "packages": dict(sorted(pkgs.items())),
    }
    tmp = _CURRENCY_STATE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(payload, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, _CURRENCY_STATE)


def _last_auto_update(name, state):
    raw = (state.get(name) or {}).get("last_auto_update")
    if not raw:
        return None
    try:
        return datetime.date.fromisoformat(raw)
    except ValueError:
        print(f"WARNING: {name}: unparseable last_auto_update {raw!r}; treating as never updated")
        return None


def _currency_status(name, state, today=None):
    """(due, detail). Never raises: a bad interval means DUE, loudly."""
    today = today or datetime.date.today()
    spec = _interval_spec(name)
    try:
        interval = _parse_interval(spec)
    except ValueError as exc:
        print(f"WARNING: {name}: {exc}; treating as due")
        return True, "bad interval -- fix auto_update_interval"
    last = _last_auto_update(name, state)
    if interval is None:
        return False, f"interval '{spec}': manual only"
    if last is None:
        return True, f"never auto-updated (interval {spec})"
    age = (today - last).days
    remaining = interval.days - age
    if remaining > 0:
        return False, f"updated {age}d ago; next due in {remaining}d (interval {spec})"
    return True, f"last updated {age}d ago (interval {spec})"


def _record_auto_update(names, dry_run=False):
    """Stamp today's date for packages that actually ran.

    A MANUAL run stamps too. "No more than once a year" is about how often the
    package gets rebuilt, not about which command did it -- and stamping stops
    the next sweep from redoing work a human just did by hand.
    """
    if dry_run or not names:
        return
    state = _load_currency_state()
    today = datetime.date.today().isoformat()
    for n in names:
        state.setdefault(n, {})["last_auto_update"] = today
    _save_currency_state(state)


def _set_pkg_interval(name, spec):
    """Write auto_update_interval into one package block (minimal diff)."""
    _parse_interval(spec)  # validate BEFORE touching the registry
    path = os.path.join(REPO, "payload", "packages.json")
    with open(path) as fh:
        txt = fh.read()
    i = txt.find(f'"{name}": {{')
    if i < 0:
        raise KeyError(name)
    depth = 0
    j = txt.index("{", i)
    while j < len(txt):
        if txt[j] == "{":
            depth += 1
        elif txt[j] == "}":
            depth -= 1
            if depth == 0:
                j += 1
                break
        j += 1
    block = txt[i:j]
    if '"auto_update_interval"' in block:
        new_block, n = re.subn(
            r'("auto_update_interval"\s*:\s*")([^"]*)(")',
            lambda m: m.group(1) + spec + m.group(3),
            block,
            count=1,
        )
    else:
        # Insert after "kind", which every entry carries, so diffs stay tidy.
        new_block, n = re.subn(
            r'("kind"\s*:\s*"[^"]*",\n)(\s*)',
            lambda m: f'{m.group(1)}{m.group(2)}"auto_update_interval": "{spec}",\n{m.group(2)}',
            block,
            count=1,
        )
    if n != 1:
        raise KeyError(f"could not set auto_update_interval for {name}")
    with open(path, "w") as fh:
        fh.write(txt[:i] + new_block + txt[j:])


def cmd_currency():
    state = _load_currency_state()
    today = datetime.date.today()
    names = list(AUTOMATED) + sorted(ROLLING_GIT)
    rows = []
    for name in names:
        due, detail = _currency_status(name, state, today)
        last = _last_auto_update(name, state)
        rows.append((name, _interval_spec(name), last.isoformat() if last else "-", "DUE" if due else "held", detail))
    w = max([len(r[0]) for r in rows] + [7])
    print(f"{'package'.ljust(w)}  {'interval':8}  {'last':10}  {'state':5}  detail")
    print(f"{'-' * w}  {'-' * 8}  {'-' * 10}  {'-' * 5}  {'-' * 40}")
    for r in rows:
        print(f"{r[0].ljust(w)}  {r[1]:8}  {r[2]:10}  {r[3]:5}  {r[4]}")
    print(f"\nDefault interval: {DEFAULT_AUTO_UPDATE_INTERVAL}.")
    print("Naming a package explicitly always updates it; --ignore-cadence does it for the whole sweep.")


# -- output helpers ------------------------------------------------------------


def _sep(title="", width=72):
    if title:
        pad = max(0, width - len(title) - 4)
        print("\n-- {} {}".format(title, "-" * pad))
    else:
        print("-" * width)


def _run(cmd, dry_run=False):
    display = " ".join(cmd) if isinstance(cmd, (list, tuple)) else cmd
    print(f"$ {display}")
    if dry_run:
        return 0
    return subprocess.call(cmd, cwd=REPO)


def _run_payload_manifests(dry_run=False):
    """Re-pin the two committed payload maps, in the order that matters.

    payload/installed-sizes.json lives UNDER payload/, so .content-manifest
    hashes it. Regenerating the sizes map second therefore leaves the manifest
    pinning the PREVIOUS sizes file, and Tier 1's gen-content-manifest --check
    goes red on a tree that is otherwise correct. Sizes first, manifest second.
    """
    rc = _run([os.path.join(BUILD, "gen-installed-sizes")], dry_run)
    if rc != 0:
        return rc
    return _run([os.path.join(BUILD, "gen-content-manifest")], dry_run)


# -- automated runners ---------------------------------------------------------


def _fetch_json(url):
    req = Request(url, headers={"User-Agent": "loadout-update/1.0", "Accept": "application/vnd.github+json"})
    with urlopen(req, timeout=60) as r:
        return json.loads(r.read())


_DOWNLOADS_LOG = os.path.join(REPO, "assurance", "downloads.log")


def _record_download(url, sha256):
    """Append (date, url, sha256) to the append-only supply-chain download log."""
    try:
        os.makedirs(os.path.dirname(_DOWNLOADS_LOG), exist_ok=True)
        with open(_DOWNLOADS_LOG, "a") as fh:
            date = datetime.datetime.now(datetime.UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
            fh.write(f"{date}\t{url}\t{sha256}\n")
    except OSError as exc:
        print(f"  WARN: could not record download in {_DOWNLOADS_LOG}: {exc}")


def _download_file(url, dest, expected_sha256=None):
    """Download url -> dest, hashing the bytes. If expected_sha256 is given and
    does not match, raise (a supply-chain integrity failure). Every download is
    recorded in assurance/downloads.log with its sha256 (TOFU provenance)."""
    print(f"  GET {url}")
    req = Request(url, headers={"User-Agent": "loadout-update/1.0"})
    h = hashlib.sha256()
    with urlopen(req, timeout=120) as r:
        with open(dest, "wb") as f:
            while True:
                chunk = r.read(65536)
                if not chunk:
                    break
                h.update(chunk)
                f.write(chunk)
    digest = h.hexdigest()
    if expected_sha256 and digest != expected_sha256:
        raise RuntimeError(f"sha256 mismatch for {url}: expected {expected_sha256}, got {digest}")
    _record_download(url, digest)
    return digest


def _run_yara_rules(dry_run=False, tag=None):
    if tag:
        resolved_tag = tag
    else:
        print("Fetching latest YARA-Forge release...")
        meta = _fetch_json(_YARA_API_LATEST)
        resolved_tag = meta["tag_name"]
        print(f"  Latest: {resolved_tag}")

    current_tag = ""
    if os.path.exists(_YARA_TAG_FILE):
        with open(_YARA_TAG_FILE) as f:
            current_tag = f.read().strip()
    if current_tag == resolved_tag:
        print(f"Already at {resolved_tag} -- nothing to do.")
        return True

    zip_url = _YARA_ZIP_URL.format(tag=resolved_tag)
    if dry_run:
        print(f"$ [download {zip_url} -> payload/yara/]")
        _run_payload_manifests(dry_run=True)
        return True

    with tempfile.TemporaryDirectory(prefix="yara-forge-") as tmp:
        zip_path = os.path.join(tmp, "rules-full.zip")
        print(f"Downloading {resolved_tag} rules...")
        _download_file(zip_url, zip_path)

        print(f"  Extracting {_YARA_ZIP_MEMBER}...")
        with zipfile.ZipFile(zip_path) as zf:
            raw = zf.read(_YARA_ZIP_MEMBER)

        print(f"  Rules size: {len(raw) // 1024 // 1024} MB uncompressed")

        os.makedirs(_YARA_DIR, exist_ok=True)
        bz2_tmp = _YARA_RULES_BZ2 + ".tmp"
        with bz2.open(bz2_tmp, "wb", compresslevel=9) as f:
            f.write(raw)
        os.replace(bz2_tmp, _YARA_RULES_BZ2)

        with open(_YARA_TAG_FILE, "w") as f:
            f.write(resolved_tag + "\n")

    compressed_kb = os.path.getsize(_YARA_RULES_BZ2) // 1024
    print(f"  Compressed: {compressed_kb} KB")
    rc = _run_payload_manifests(dry_run=False)
    if rc != 0:
        print(f"WARNING: payload manifest chain exited rc={rc}")
        return False
    return True


# tldr pages for offensive-security tools whose documented example commands
# trip the YARA-Forge malware ruleset (mimikatz credential dumping, certutil
# -decode/-urlcache LOLBin download, msfvenom payload generation). A
# chip-design toolchain has no reason to ship them; pruning the whole family
# (not just the individual pages that happened to trip a rule) keeps the
# release scan clean and is audit-defensible. Glob patterns, matched under
# every locale dir (pages*, pages.en, ...) in the tldr-pages/ cache root.
_TLDR_OFFENSIVE_GLOBS = [
    "pages*/*/mimikatz*.md",
    "pages*/*/certutil.md",
    "pages*/*/msfvenom.md",
]


def _prune_tldr_offensive_pages(pages_dir):
    removed = []
    for pat in _TLDR_OFFENSIVE_GLOBS:
        for p in glob.glob(os.path.join(pages_dir, pat)):
            os.remove(p)
            removed.append(os.path.relpath(p, pages_dir))
    if removed:
        print(f"Pruned {len(removed)} offensive-security tldr page(s):")
        for r in sorted(removed):
            print(f"  - {r}")


def _run_tldr_data(dry_run=False):
    cache_home = os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache"))
    cache_dir = os.path.join(cache_home, "tealdeer")
    pages_dir = os.path.join(cache_dir, "tldr-pages")
    output = os.path.join(REPO, "payload", "tldr", "tldr-pages.tar.bz2")

    if dry_run:
        print("$ tldr --update")
        print("$ (prune offensive-security tool pages from cache)")
        print(f"$ tar cjf {output} -C {cache_dir} tldr-pages/")
        _run_payload_manifests(dry_run=True)
        return True

    rc = subprocess.call(["tldr", "--update"])
    if rc != 0:
        print(f"ERROR: tldr --update failed rc={rc}")
        return False

    if not os.path.isdir(pages_dir):
        print(f"ERROR: tldr-pages not found at {pages_dir} after update")
        return False

    _prune_tldr_offensive_pages(pages_dir)

    os.makedirs(os.path.join(REPO, "payload", "tldr"), exist_ok=True)
    old_gz = os.path.join(REPO, "payload", "tldr", "tldr-pages.tar.gz")
    if os.path.exists(old_gz):
        os.remove(old_gz)

    print(f"Bundling {pages_dir} -> {output}")
    rc = subprocess.call(["tar", "cjf", output, "-C", cache_dir, "tldr-pages/"])
    if rc != 0:
        print(f"ERROR: tar failed rc={rc}")
        return False

    size_mb = os.path.getsize(output) // 1024 // 1024
    print(f"Done: {size_mb}M written to {output}")
    rc = _run_payload_manifests(dry_run=False)
    if rc != 0:
        print(f"WARNING: payload manifest chain exited rc={rc}")
        return False
    return True


_TMUX_PLUGINS_LOCK = os.path.join(REPO, "envs", "tmux", "vendor", "plugins.lock")


def _load_tmux_lock():
    """Return {owner/repo: commit} from the committed tmux plugins lockfile."""
    pins = {}
    if os.path.isfile(_TMUX_PLUGINS_LOCK):
        for line in open(_TMUX_PLUGINS_LOCK):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split()
            if len(parts) == 2:
                pins[parts[0]] = parts[1]
    return pins


def _run_taplo_schemas(dry_run=False):
    """Refresh taplo's offline JSON Schema catalog from SchemaStore.

    The archive is a payload artifact, so it needs the same post-payload chain
    every other payload change does: strip-all-elf-binaries normalises the tar
    (pinned mtime/ownership, so identical content yields identical bytes and
    the assurance ledger stays reproducible), then gen-installed-sizes and
    gen-content-manifest record the new size and hash -- without the latter the
    installer refuses the file outright as "payload file not in
    .content-manifest".
    """
    fetch = os.path.join(BUILD, "taplo", "fetch-schemas.py")
    if dry_run:
        print(f"$ {fetch}")
        print("$ ./build/strip-all-elf-binaries")
        _run_payload_manifests(dry_run=True)
        return True

    rc = _run([sys.executable, fetch], dry_run)
    if rc != 0:
        print(f"ERROR: fetch-schemas exited rc={rc}")
        return False
    rc = _run([os.path.join(REPO, "build/strip-all-elf-binaries")], dry_run)
    if rc != 0:
        print(f"WARNING: strip-all-elf-binaries exited rc={rc}")
    rc = _run_payload_manifests(dry_run=False)
    if rc != 0:
        print(f"WARNING: payload manifest chain exited rc={rc}")
        return False
    return True


def _run_tmux_plugins(dry_run=False):
    tmux_conf = os.path.join(REPO, "envs", "tmux", "tmux.conf")
    plugin_dir = os.path.join(REPO, "envs", "tmux", "vendor", "plugins")

    plugins = []
    with open(tmux_conf) as f:
        for line in f:
            m = re.match(r"\s*set -g @plugin '([^']+)'", line)
            if m:
                plugins.append(m.group(1))

    if not plugins:
        print("No @plugin entries found in tmux.conf")
        return True

    pins = _load_tmux_lock()
    os.makedirs(plugin_dir, exist_ok=True)
    ok = True
    new_pins = {}
    for plugin in plugins:
        name = os.path.basename(plugin)
        dest = os.path.join(plugin_dir, name)
        url = f"https://github.com/{plugin}.git"
        pin = pins.get(plugin)
        print(f"Updating {plugin}..." + (f" (pinned {pin[:12]})" if pin else " (no pin -> HEAD, will record)"))
        if dry_run:
            print(f"$ git clone {url} {dest}" + (f" && git checkout {pin}" if pin else ""))
            continue
        shutil.rmtree(dest, ignore_errors=True)
        # Full clone (not --depth 1) so a pinned commit can be checked out.
        rc = subprocess.call(["git", "clone", url, dest])
        if rc != 0:
            print(f"ERROR: git clone failed for {plugin}")
            ok = False
            continue
        if pin:
            rc = subprocess.call(["git", "-C", dest, "checkout", "--quiet", pin])
            if rc != 0:
                print(f"ERROR: pinned commit {pin} not found for {plugin}")
                ok = False
                continue
        commit = subprocess.check_output(["git", "-C", dest, "rev-parse", "HEAD"], text=True).strip()
        new_pins[plugin] = commit
        shutil.rmtree(os.path.join(dest, ".git"), ignore_errors=True)

    # Write/refresh the lockfile so the exact commits are pinned + reviewable.
    if not dry_run and new_pins:
        with open(_TMUX_PLUGINS_LOCK, "w") as fh:
            fh.write("# tmux plugin pins: owner/repo  commit -- git-tracked, reviewed before commit\n")
            for repo in sorted(new_pins):
                fh.write(f"{repo}  {new_pins[repo]}\n")
        print(f"Recorded {len(new_pins)} tmux plugin pin(s) in {_TMUX_PLUGINS_LOCK}")

    if not ok:
        return False

    rc = _run_payload_manifests(dry_run=dry_run)
    if rc != 0:
        print(f"WARNING: payload manifest chain exited rc={rc}")
        return False

    return True


def _run_env_nvim(dry_run=False):
    """Rebuild the offline plugin stash from upstream, via the real builder.

    The stash is 79 FULL BARE MIRRORS (`<org>/<plugin>.git`, `git clone
    --mirror`, all refs including tags), because init.lua points lazy's
    `git.url_format` at it and lazy clones/fetches from it offline.

    This used to run `nvim --headless +Lazy! update` against THIS BOX's
    ~/.local/share/nvim and tar the resulting lazy/ tree over the stash. That
    is a different thing in every respect: it produced flat plugin directories
    with .git subdirs instead of bare mirrors, and only the ~24 active plugins
    instead of all 79, shrinking the archive from ~328 MB to ~47 MB and giving
    offline users a stash lazy cannot clone from. Nothing caught it -- the
    stash is deliberately excluded from .content-manifest and gitignored, so
    there was no local baseline to diff and no gate went red. Recovery needed
    `./tools/fetch-stash` against a published release.

    Delegate to build/build-nvim-plugin-stash, which is the documented builder
    and verifies every pinned commit is reachable in the mirror it produced.
    """
    builder = os.path.join(REPO, "build", "build-nvim-plugin-stash")
    catalog_archive = os.path.join(REPO, "envs", "nvim", "vendor", "plugins", "nvim-plugin-stash.tar.bz2")

    if not os.path.isfile(builder) or not os.access(builder, os.X_OK):
        print(f"ERROR: stash builder not found at {builder}")
        return False

    print(f"Rebuilding plugin stash via {os.path.relpath(builder, REPO)} ...")
    if dry_run:
        print(f"$ {builder}")
        print("$ ./build/strip-all-elf-binaries")
        return True

    rc = subprocess.call([builder], cwd=REPO)
    if rc != 0:
        print(f"ERROR: {os.path.relpath(builder, REPO)} exited rc={rc}")
        return False

    if not os.path.isfile(catalog_archive):
        print(f"ERROR: builder did not produce {catalog_archive}")
        return False

    # Guard the failure this function used to cause. A lazy/-tree repack is
    # flat (./plugin/...); a real stash is ./<org>/<plugin>.git/... Check the
    # shape rather than a size threshold, which would drift with the catalog.
    try:
        with tarfile.open(catalog_archive, "r:bz2") as tf:
            mirrors = {
                m.name.split("/")[1] + "/" + m.name.split("/")[2]
                for m in tf
                if len(m.name.split("/")) > 2 and m.name.split("/")[2].endswith(".git")
            }
    except (OSError, tarfile.TarError) as exc:
        print(f"ERROR: cannot read {catalog_archive}: {exc}")
        return False

    if not mirrors:
        print(f"ERROR: {catalog_archive} contains no <org>/<plugin>.git bare mirrors.")
        print("  That is the lazy/-tree-repack shape; lazy cannot clone from it.")
        return False

    size_mb = os.path.getsize(catalog_archive) // 1024 // 1024
    print(f"  {size_mb}M, {len(mirrors)} bare mirrors -> {catalog_archive}")

    # Step 3: strip ELF payloads inside the archive
    rc = subprocess.call([os.path.join(REPO, "build/strip-all-elf-binaries")], cwd=REPO)
    if rc != 0:
        print(f"WARNING: strip-all-elf-binaries exited rc={rc}")

    return True


