def download(url, dest):
    req = Request(url, headers={"User-Agent": "loadout-update-prebuilt/1.0"})
    with urlopen(req, timeout=180) as resp, open(dest, "wb") as f:
        shutil.copyfileobj(resp, f)
    log_download(url, dest)


def log_download(url, dest):
    """Append to the assurance ledger's append-only fetch log."""
    h = hashlib.sha256()
    with open(dest, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    stamp = datetime.datetime.now(datetime.UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    with open(os.path.join(REPO, "assurance", "downloads.log"), "a", encoding="utf-8") as f:
        f.write(f"{stamp}\t{url}\t{h.hexdigest()}\n")


def extract(archive, want, destdir):
    """Extract archive member `want` to destdir/<basename(want)>.

    `want` may be a bare name (matched anywhere in the archive) or a path
    suffix.  Suffix matching disambiguates multi-arch bundles: broot's zip
    carries ten builds, and `x86_64-unknown-linux-musl/broot` is the only one
    that runs on a stock EL8 node -- the bare name would pick whichever the
    archive lists first (aarch64-apple-darwin, alphabetically).
    """
    dest = os.path.join(destdir, os.path.basename(want))

    def member_matches(name):
        if want == os.path.basename(want):
            return os.path.basename(name) == want
        return name.replace("\\", "/").endswith("/" + want) or name == want

    if tarfile.is_tarfile(archive):
        with tarfile.open(archive, "r:*") as tf:
            hit = next((m for m in tf.getmembers() if m.isfile() and member_matches(m.name)), None)
            if hit is None:
                raise ValueError(f"{want} not in tar: {[m.name for m in tf.getmembers()][:8]}")
            hit.name = os.path.basename(want)
            tf.extract(hit, destdir)
    elif zipfile.is_zipfile(archive):
        with zipfile.ZipFile(archive) as zf:
            hit = next((n for n in zf.namelist() if member_matches(n)), None)
            if hit is None:
                raise ValueError(f"{want} not in zip: {zf.namelist()[:8]}")
            with open(dest, "wb") as f:
                f.write(zf.read(hit))
    else:
        raise ValueError(f"unknown archive type: {archive}")
    os.chmod(dest, stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP | stat.S_IROTH | stat.S_IXOTH)
    return dest


def is_dynamic(path):
    r = subprocess.run(["file", "-b", path], capture_output=True, text=True)
    return "dynamically linked" in r.stdout


def stamp(reg_path, tool, ver):
    """Write one tool's version into packages.json, immediately.

    Per-tool stamping, not batch-at-end: a mid-batch failure must never leave
    a bumped binary next to a stale registry entry.  That happened on
    2026-09-13 -- fzf and lazygit were written to payload/, yq then failed to
    extract, and the single end-of-run dump never ran, so the shipped
    binaries self-reported 0.74.4/0.65.1 while the registry said
    0.74.2/0.64.0.  Nothing caught it; only a manual version probe did.

    ensure_ascii=False + utf-8: the registry carries em dashes and arrows in
    its descriptions, and the default escaping rewrites every string in the
    file on each bump.
    """
    with open(reg_path, encoding="utf-8") as f:
        registry = json.load(f)
    before = registry["packages"].get(tool, {}).get("version")
    registry["packages"][tool]["version"] = ver
    with open(reg_path, "w", encoding="utf-8") as f:
        json.dump(registry, f, indent=2, ensure_ascii=False)
        f.write("\n")
    print(f"   registry: {tool} {before} -> {ver}")


def main():
    updates = []
    for arg in sys.argv[1:]:
        tool, _, ver = arg.partition("=")
        if not ver or tool not in TOOLS:
            sys.exit(f"bad arg or unknown tool: {arg} (known: {', '.join(TOOLS)})")
        updates.append((tool, ver))

    reg_path = os.path.join(REPO, "payload", "packages.json")

    with tempfile.TemporaryDirectory(prefix="loadout-update.") as tmp:
        for tool, ver in updates:
            entry = TOOLS[tool]
            url_tpl, member = entry[0], entry[1]
            kind = entry[2] if len(entry) > 2 else ""
            # Output stem defaults to the archive member's basename; tools
            # whose member differs from the installed binary name (yq's
            # yq_linux_amd64 -> yq) provide a fourth element.
            stem = entry[3] if len(entry) > 3 else os.path.basename(member)
            url = url_tpl.format(ver=ver)
            print(f"== {tool} -> {ver}")
            archive = os.path.join(tmp, tool + ".archive")
            if kind == "raw":
                download(url, archive)
                binpath = os.path.join(tmp, stem)
                shutil.copyfile(archive, binpath)
                os.chmod(binpath, stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP | stat.S_IROTH | stat.S_IXOTH)
            else:
                download(url, archive)
                # extract() always lands the file at tmp/<basename(member)>.
                binpath = extract(archive, member, tmp)
            subprocess.run(["/usr/bin/strip", binpath], capture_output=True)
            if is_dynamic(binpath):
                r = subprocess.run([PATCHELF, "--set-rpath", RPATH, binpath], capture_output=True)
                if r.returncode != 0:
                    sys.exit(f"patchelf failed for {tool}: {r.stderr.decode()}")
                print("   patchelf RPATH applied (dynamic ELF)")
            else:
                print("   static ELF, no patchelf")
            # Version echo: catching a mis-resolved asset at build time beats
            # discovering it on a farm node.  Not a hard assertion because a
            # few tools print no parseable version from -V.
            probe = subprocess.run([binpath, "--version"], capture_output=True, text=True, timeout=30)
            first = (probe.stdout or probe.stderr).splitlines()
            if first:
                print(f"   runs: {first[0][:70]}")
            with open(binpath, "rb") as f:
                data = f.read()
            out = os.path.join(BIN_DIR, stem + ".bz2")
            with open(out, "wb") as f:
                f.write(bz2.compress(data, 9))
            print(f"   wrote {out} ({os.path.getsize(out)} bytes)")
            stamp(reg_path, tool, ver)


if __name__ == "__main__":
    main()
