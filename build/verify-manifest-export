#!/usr/bin/env python3.14
"""
verify-manifest-export -- prove the COMMITTED .content-manifest covers exactly
what `git archive HEAD` ships.

WHY THIS EXISTS. The manifest is a content allowlist for the shipped tree, and
it used to be generated by walking the release host's working directory. Files
that .gitignore excludes but that happened to exist on that host -- a vendored
plugin's .agents/, .codex/ and .claude/ trees -- were hashed into the COMMITTED
manifest. `gen-content-manifest --check` passed on that host (every listed file
was right there) while a clean clone or `git archive` export failed with 158
MISSING entries and build/export refused to publish. A signed tag does not
catch this: the tag signs the commit, and the commit's manifest listed files
the commit does not contain.

WHAT IT CHECKS. The subject is HEAD, not the working directory:

  * every regular file under the manifest roots in `git archive HEAD` must be
    in HEAD:.content-manifest, with a matching sha256
  * every entry in HEAD:.content-manifest must be such a file

Symlinks are skipped: git archives them as symlinks and the manifest hashes
regular files only (which is also why generation skips them). The Neovim
plugin stash is a release ASSET, not a git payload, so it is absent from both
the export and the manifest -- the separately verified exception (signed tag ->
sha256sums.txt -> .content-manifest.fetched) is preserved by construction; this
gate neither requires nor blesses it.

Exit 0 when the two agree; 1 with a drift list; 2 when the check cannot run.

Usage: build/verify-manifest-export
"""

import hashlib
import importlib.machinery
import importlib.util
import os
import subprocess
import sys
import tarfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
GEN_PATH = os.path.join(REPO, "build", "gen-content-manifest")
MANIFEST_REL = ".content-manifest"


def _load_gen():
    """Import build/gen-content-manifest for ROOTS and the manifest parser."""
    loader = importlib.machinery.SourceFileLoader("gen_content_manifest", GEN_PATH)
    spec = importlib.util.spec_from_loader("gen_content_manifest", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def _sha256_stream(fh):
    h = hashlib.sha256()
    for chunk in iter(lambda: fh.read(1024 * 1024), b""):
        h.update(chunk)
    return h.hexdigest()


def _under(rel, roots):
    return any(rel == root or rel.startswith(root + "/") for root in roots)


def committed_manifest(gen):
    proc = subprocess.run(["git", "-C", REPO, "show", f"HEAD:{MANIFEST_REL}"], capture_output=True, text=True)
    if proc.returncode != 0:
        raise RuntimeError(f"could not read {MANIFEST_REL} from HEAD: {proc.stderr.strip()}")
    entries = gen.parse_manifest(proc.stdout)
    if not entries:
        raise RuntimeError(f"HEAD:{MANIFEST_REL} is missing or has no entries")
    return entries


def exported(gen):
    """{repo-relative path: sha256} for every regular file `git archive HEAD` ships
    under the manifest roots. Streamed through a tar reader -- no extraction."""
    proc = subprocess.Popen(["git", "-C", REPO, "archive", "--format=tar", "HEAD"], stdout=subprocess.PIPE)
    found = {}
    try:
        try:
            with tarfile.open(fileobj=proc.stdout, mode="r|") as tf:
                for member in tf:
                    if not member.isfile():
                        continue
                    rel = member.name[2:] if member.name.startswith("./") else member.name
                    if not _under(rel, gen.ROOTS):
                        continue
                    fh = tf.extractfile(member)
                    found[rel] = _sha256_stream(fh) if fh is not None else ""
        except (tarfile.TarError, OSError) as exc:
            raise RuntimeError(f"could not read the git archive stream: {exc}") from exc
    finally:
        if proc.stdout is not None:
            proc.stdout.close()
        rc = proc.wait()
    if rc != 0:
        raise RuntimeError(f"git archive HEAD failed (exit {rc})")
    return found


def main():
    gen = _load_gen()
    try:
        manifest = committed_manifest(gen)
        files = exported(gen)
    except RuntimeError as exc:
        print(f"verify-manifest-export: ERROR: {exc}", file=sys.stderr)
        return 2
    problems = []
    for rel in sorted(manifest):
        if rel not in files:
            problems.append(f"MISSING-FROM-EXPORT {rel}")
        elif files[rel] != manifest[rel]:
            problems.append(f"MISMATCH {rel}")
    for rel in sorted(files):
        if rel not in manifest:
            problems.append(f"UNLISTED {rel}")
    if problems:
        print(
            f"verify-manifest-export: {MANIFEST_REL} at HEAD does not match the git export ({len(problems)}):",
            file=sys.stderr,
        )
        for p in problems:
            print(f"  {p}", file=sys.stderr)
        print("", file=sys.stderr)
        print(
            "The committed manifest lists files the export does not contain (or misses files it does).", file=sys.stderr
        )
        print("Regenerate it from the shipped tree and commit:", file=sys.stderr)
        print("  python3.14 build/gen-content-manifest && git add .content-manifest", file=sys.stderr)
        return 1
    print(f"verify-manifest-export: OK ({len(files)} files match {MANIFEST_REL} at HEAD)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
