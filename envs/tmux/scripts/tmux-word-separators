#!/bin/bash
#
# GENERATOR for tmux's word-separator list.  This does NOT run at tmux start-up
# -- it writes the config fragment that does, so reloads cost nothing and depend
# on no interpreter:
#
#     ~/.config/tmux/word-separators.conf
#
# Re-run it after changing the RANGES below:
#
#     ~/.config/tmux/scripts/tmux-word-separators            # default output
#     ~/.config/tmux/scripts/tmux-word-separators <path>      # explicit output
#
# WHY RANGES EXIST AT ALL: tmux takes a LITERAL list of separator characters --
# not a Unicode class, not a regex -- and it cannot loop or expand ranges.  So
# ranges can only live in one place, and something has to expand them: either at
# every reload (a run-shell script) or once, ahead of time (this).  The generated
# fragment takes the second route.
#
# WHY THE LIST MATTERS: anything absent from it counts as word material, so
# prompt icons, TUI rules and status glyphs get swallowed by double-click word
# selection.  Keep the result in step with wezterm's
# SelectTextAtMouseCursor("Word") separators -- the two are a pair.
#
# Hard-pinned to /bin/bash (not `env`) so the same interpreter runs for every
# user regardless of PATH.  Needs bash >= 4.2 for printf '\Uxxxxxxxx'.

set -eu

out=${1:-$HOME/.config/tmux/word-separators.conf}

# The readable ASCII separators. $'...' so the TAB before the final colon is a
# real TAB; the backtick and $ are literal inside it.
base=$' \'",=[]$*{}<>()^#!`;\t:'

# Ranges to append, "start:end" hex, inclusive.
ranges=(
  1f000:1faff   # symbols, pictographs, emoticons, transport
  2600:27bf     # miscellaneous symbols, dingbats
  2b00:2bff     # miscellaneous symbols and arrows
  2500:257f     # box drawing: rules, borders, corners, tees, crosses
  2580:259f     # block elements: shading and bar fills
  25a0:25ff     # geometric shapes: bullets, triangles, circles
)

# Singles not covered by any range above.
extras=(
  00a9  # copyright sign
  00ae  # registered sign
  203c  # double exclamation mark
  2049  # exclamation question mark
  20e3  # combining enclosing keycap
  2122  # trade mark sign
  2139  # information source
  3030  # wavy dash
  303d  # part alternation mark
  3297  # circled ideograph congratulation
  3299  # circled ideograph secret
  200d  # zero width joiner
  fe0e  # text presentation selector
  fe0f  # emoji presentation selector
)

list=$base
for range in "${ranges[@]}"; do
  start=$((16#${range%%:*}))
  end=$((16#${range##*:}))
  for (( codepoint = start; codepoint <= end; codepoint++ )); do
    printf -v escaped '\\U%08X' "$codepoint"
    printf -v char '%b' "$escaped"
    list+=$char
  done
done
for hex in "${extras[@]}"; do
  printf -v escaped '\\U%08X' "$((16#$hex))"
  printf -v char '%b' "$escaped"
  list+=$char
done

# Escape for a tmux double-quoted string: backslash first, then double quote.
escaped=${list//\\/\\\\}
escaped=${escaped//\"/\\\"}

{
  printf '# GENERATED by scripts/tmux-word-separators -- do NOT edit by hand.\n'
  printf '# Regenerate:  ~/.config/tmux/scripts/tmux-word-separators\n'
  printf '# %s characters, %s bytes.\n' "${#list}" "$(printf '%s' "$list" | wc -c)"
  printf 'set -g word-separators "%s"\n' "$escaped"
} > "$out"

printf 'wrote %s (%s characters)\n' "$out" "${#list}"
