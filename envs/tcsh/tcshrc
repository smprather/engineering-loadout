# Loadout tcsh entry point.  ~/.tcshrc and ~/.cshrc link here.
#
# This environment TRACKS envs/bash/ (and envs/zsh/). A bash-env change is not
# finished until the tcsh form lands -- see envs/tcsh/README.md.
#
# csh has no functions. That selects the IMPLEMENTATION, not whether a feature
# ships: one-line wrappers are aliases (they take args -- \!:1, \!*, \!:2-),
# anything needing loops/locals goes in a POSIX-sh helper under global/helpers/
# and is aliased, and anything that must mutate this shell's cwd/PATH/env is a
# helper that PRINTS the command, run through `eval \`helper\``.
#
# Layers are sourced lowest-first: global -> corp -> site -> team -> project -> user.
# Every source is guarded: a missing layer is normal, not an error, and must stay
# silent.

set _loadout_tcsh_dir = "$HOME/.config/tcsh"

# Pass 1: LOADOUT_CFG_* preferences for every layer.
foreach _loadout_layer (global corp site team project user)
    if ( -r "${_loadout_tcsh_dir}/${_loadout_layer}/config.csh" ) then
        source "${_loadout_tcsh_dir}/${_loadout_layer}/config.csh"
    endif
end

# Pass 2: the shell config itself (PATH, aliases, prompt).
foreach _loadout_layer (global corp site team project user)
    if ( -r "${_loadout_tcsh_dir}/${_loadout_layer}/tcshrc" ) then
        source "${_loadout_tcsh_dir}/${_loadout_layer}/tcshrc"
    endif
end

unset _loadout_layer
unset _loadout_tcsh_dir
