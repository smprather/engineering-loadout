# Loadout tcsh entry point.  ~/.tcshrc links here (the retired ~/.cshrc is pruned).
#
# This environment TRACKS envs/bash/ (and envs/zsh/). A bash-env change is not
# finished until the tcsh form lands -- see envs/tcsh/README.md.
#
# csh has no functions. That selects the IMPLEMENTATION, not whether a feature
# ships: one-line wrappers are aliases (they take args -- \!:1, \!*, \!:2-),
# anything needing loops/locals goes in a POSIX-sh helper under global/helpers/
# and is aliased, and anything that must mutate this shell's cwd/PATH/env is a
# helper that PRINTS the command, run through `eval \`helper\``.
#
# Layers are sourced lowest-first: global -> corp -> site -> team -> project -> user.
# Every source is guarded: a missing layer is normal, not an error, and must stay
# silent. TCSH_CONFIG_ROOT_DIR mirrors BASH_CONFIG_ROOT_DIR/ZSH_CONFIG_ROOT_DIR:
# it may point at a shared config tree, while home-local override layers under
# ~/.config/tcsh/{corp,site,team,project,user} still apply afterwards.

if ( ! $?USER ) then
    setenv USER "`/bin/whoami`"
else if ( "$USER" == "" ) then
    setenv USER "`/bin/whoami`"
endif

# Do NOT `unalias *` here. The system csh rc (/etc/csh.cshrc and
# /etc/profile.d/*.csh) runs BEFORE ~/.tcshrc, and Environment Modules plus
# site tooling define `module`/`_module_raw`/`ml` and other aliases there.
# A blanket unalias deletes them before the loadout layers run -- bash preserves
# the equivalent module functions via LOADOUT_CFG_PRESERVE_FUNCTIONS. Aliases
# are not inherited by a new tcsh (exec tcsh re-runs the system rc, then this
# file), so the only cost of keeping them is that a loadout alias deleted from
# global/ can linger until the shell exits after a manual re-source. Loadout
# aliases later in the chain still override site aliases of the same name.

set _loadout_tcsh_home_dir = "$HOME/.config/tcsh"
if ( ! $?TCSH_CONFIG_ROOT_DIR ) then
    setenv TCSH_CONFIG_ROOT_DIR "$_loadout_tcsh_home_dir"
else if ( "$TCSH_CONFIG_ROOT_DIR" == "" ) then
    setenv TCSH_CONFIG_ROOT_DIR "$_loadout_tcsh_home_dir"
endif
set _loadout_tcsh_dir = "$TCSH_CONFIG_ROOT_DIR"

# Pass 1: LOADOUT_CFG_* preferences for every layer.
foreach _loadout_layer (global corp site team project user)
    if ( -r "${_loadout_tcsh_dir}/${_loadout_layer}/config.csh" ) then
        source "${_loadout_tcsh_dir}/${_loadout_layer}/config.csh"
    endif
end
if ( "$_loadout_tcsh_dir" != "$_loadout_tcsh_home_dir" ) then
    foreach _loadout_layer (corp site team project user)
        if ( -r "${_loadout_tcsh_home_dir}/${_loadout_layer}/config.csh" ) then
            source "${_loadout_tcsh_home_dir}/${_loadout_layer}/config.csh"
        endif
    end
endif

# Pass 2: the shell config itself (PATH, aliases, prompt).
foreach _loadout_layer (global corp site team project user)
    if ( -r "${_loadout_tcsh_dir}/${_loadout_layer}/tcshrc" ) then
        source "${_loadout_tcsh_dir}/${_loadout_layer}/tcshrc"
    endif
end
if ( "$_loadout_tcsh_dir" != "$_loadout_tcsh_home_dir" ) then
    foreach _loadout_layer (corp site team project user)
        if ( -r "${_loadout_tcsh_home_dir}/${_loadout_layer}/tcshrc" ) then
            source "${_loadout_tcsh_home_dir}/${_loadout_layer}/tcshrc"
        endif
    end
endif

unset _loadout_layer
unset _loadout_tcsh_dir
unset _loadout_tcsh_home_dir
