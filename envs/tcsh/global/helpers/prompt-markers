#!/bin/sh
# Post-process starship's prompt for tcsh: zero-width markers + the path colour.
#
# TWO jobs, both because starship cannot express them for tcsh:
#
# 1. MARKERS. Starship renders zero-width markers for the shell named by
#    $STARSHIP_SHELL: readline's `\[ ... \]` for bash, `%{ ... %}` for
#    zsh/tcsh, NONE for sh. The tcsh env pins STARSHIP_SHELL=sh -- `tcsh`
#    would make every module's `when`/`command` re-enter ~/.tcshrc (measured
#    at seconds per prompt), and `bash` emits markers tcsh prints literally.
#
#    With `sh` starship emits NO markers, and tcsh then CARET-ESCAPES every
#    unmarked control character in the prompt: a raw ESC[1;33m is DISPLAYED
#    as the five characters `^[[1;33m`. Verified:
#
#        set prompt = "RAW:\033[1;31mX\033[0m> "      -> shows  RAW:^[[1;31mX^[[0m>
#        set prompt = "MARKED:%{\033[1;31m%}X%{\033[0m%}> " -> shows MARKED:X (coloured)
#
#    So wrapping the SGR sequences in `%{ ... %}` is REQUIRED, not cosmetic:
#    it is what makes the prompt readable at all, and it is also what lets
#    tcsh exclude those bytes from the prompt width.
#
# 2. THE PATH COLOUR. All three envs use ONE starship config
#    (envs/starship/starship.toml). Starship has no config-time env-var
#    substitution -- `style = "$VAR"` is emitted verbatim -- so the per-shell
#    path colour cannot be a config parameter; it is applied here instead.
#    The shared config's `[directory] style` is `bold cyan`, which starship
#    renders as ESC[1;36m; this rewrites it to `bold yellow` (ESC[1;33m) so a
#    glance at the prompt says which shell you are in.
#
#    The mapping is not magic: `tests/env-tcsh-starship` parses
#    `[directory] style` out of the config, maps it to its SGR sequence, and
#    asserts this file carries that exact `s/<from>/<to>/` pair. Change the
#    directory style and the gate tells you to update the sed here.
#
# Input: the prompt text on STDIN (the precmd pipes `starship prompt` into
# this script). Output: the converted prompt on stdout.
#
# printf '%s' (not echo) because csh's echo interprets backslash escapes, and
# the very markers this helper is here to convert would be consumed by it.

# 3. THE PYTHON SYMBOL. `$python`'s symbol is U+1F40D (4 bytes). tcsh DROPS
#    astral characters when rendering a prompt in a UTF-8 locale -- verified
#    with two different astral characters, with the rc file's bytes confirmed
#    by `od`, and with `%{ %}`, a variable and a command substitution all
#    tried. Only a non-UTF-8 locale preserves them, which would break i18n.
#    So the snake cannot be kept: substitute a BMP label, or the prompt shows a
#    bare `vX.Y.Z` that says nothing. bash/zsh keep the real emoji -- this is
#    tcsh-only, which is why it belongs here and not in the shared config.
#    tests/env-tcsh-starship ties this to `[python] symbol` in the config.
#
# 4. NEWLINES. Starship renders up to three lines (status, path, character).
#    tcsh cannot take them in $prompt: csh collapses newlines in a quoted
#    command substitution, and tcsh's own `\n` prompt escape is drawn by
#    PADDING the row until the terminal autowraps -- a SOFT wrap. tmux zoom
#    and resize (and every terminal that reflows on resize: WezTerm, kitty,
#    VTE, Windows Terminal) re-wrap soft-wrapped rows, so the prompt lines
#    merged into one row and scrambled. So the prompt is split:
#      - every line but the LAST is printed here, on STDERR, as real output
#        with real newlines (raw SGR, no %{ %} -- they are not in $prompt).
#        The precmd's command substitution captures stdout only, so stderr
#        reaches the terminal just before tcsh draws the prompt;
#      - those lines are also cached in $LOADOUT_TCSH_PROMPT_CACHE (a file in
#        the private runtime dir, set by global/tcshrc), which the Ctrl-L
#        binding reprints after clearing -- tcsh redraws only $prompt;
#      - only the LAST line goes to stdout, i.e. into $prompt.
#    The cache is emptied first, so a one-line prompt cannot leave stale lines;
#    if it cannot be written, caching is skipped and the prompt still renders.
# Reads STDIN: the precmd pipes `starship prompt` straight into this script.
# A pipe inside the backticks keeps the line structure for the split below.

cache=${LOADOUT_TCSH_PROMPT_CACHE:-}
if [ -n "$cache" ] && ! { : >"$cache"; } 2>/dev/null; then
    cache=
fi

sed \
    -e 's/\x1b\[1;36m/\x1b[1;33m/g' \
    -e 's/\xf0\x9f\x90\x8d/python /g' \
    | awk -v cache="$cache" '
        { line[NR] = $0 }
        END {
            for (i = 1; i < NR; i++) {
                l = line[i]
                gsub(/\\\[|\\\]/, "", l)
                print l > "/dev/stderr"
                if (cache != "") print l >> cache
            }
            if (NR > 0) printf "%s", line[NR]
        }' \
    | sed \
        -e 's/\\\[/%{/g' \
        -e 's/\\\]/%}/g' \
        -e 's/\x1b\[[0-9;]*m/%{&%}/g'
