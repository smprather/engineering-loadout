#!/bin/sh
# Print the most recently modified regular file under $1 (default .).
# Backs the `vii` alias; mirrors vii() in envs/bash/global/aliases.sh.

root=${1:-.}

target=$(
    find "$root" -mindepth 1 -maxdepth 1 -type f -printf '%T@ %p\n' 2>/dev/null |
        sort -n |
        tail -n 1 |
        cut -d' ' -f2-
)

[ -n "$target" ] || exit 1
printf '%s\n' "$target"
