#!/bin/sh
# Exit 0 when the terminal supports extended keys, 1 otherwise.
#
# Port of check_extended_keys() in envs/bash/functions.sh: cheap TERM/TMUX
# answers first, then a Secondary Device Attributes query. tmux answers with
# vendor id 84 when extended-keys is on; a plain xterm does not.
#
# This wrapper is POSIX sh (see README). The PROBE is not: a non-consuming
# readiness test (`read -t 0`) and a timed delimited read (`read -d c -t 0.1`)
# have no POSIX equivalent. It is therefore confined to a `bash -c` child.
# bash is present on every supported EL/Suse target (and is what /bin/sh is
# there); when it is absent this exits 1 WITHOUT probing, so type-ahead is
# never eaten.

case ${TERM:-} in
    *kitty*|*alacritty*) exit 0 ;;
esac

if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
    if tmux show-options -s extended-keys 2>/dev/null | grep -q 'on'; then
        exit 0
    fi
fi

[ -t 0 ] && [ -t 1 ] || exit 1
command -v bash >/dev/null 2>&1 || exit 1

probe=$(cat <<'BASH'
read -t 0 2>/dev/null
rc=$?
[ "$rc" -eq 0 ] && exit 1
[ "$rc" -gt 1 ] && exit 1

old=$(stty -g 2>/dev/null) || exit 1
trap 'stty "$old" 2>/dev/null' EXIT HUP INT TERM
stty -echo 2>/dev/null || exit 1

printf '\033[>c'
response=
read -r -d c -t 0.1 response 2>/dev/null

stty "$old" 2>/dev/null
trap - EXIT HUP INT TERM

case $response in
    *'>84;'*) exit 0 ;;
    *) exit 1 ;;
esac
BASH
)
exec bash -c "$probe"

