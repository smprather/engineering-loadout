#!/bin/sh
# List the 10 most recently modified files under $1 (default .), newest first.
# Backs the `rlrt` alias; mirrors rlrt() in envs/bash/global/aliases.sh.

root=${1:-.}

find "$root" -type f -print0 2>/dev/null |
    xargs -0 stat --format '%Y :%y %n' 2>/dev/null |
    sort -nr |
    cut -d: -f2- |
    head
