# Loadout tcsh: PATH, environment, shell options, prompt, integrations.
#
# TRACKS envs/bash/global/bashrc. See envs/tcsh/README.md.
#
# Three csh rules this file obeys, all easy to get wrong:
#   * NEVER `exit` from here. tcsh sources ~/.tcshrc for NON-interactive shells too,
#     so an early `exit` would kill every tcsh script the user runs. Interactive-only
#     work goes inside `if ( $?prompt ) then ... endif`.
#   * NEVER use `!` unquoted (e.g. `!~`). In an interactive shell it triggers history
#     expansion. Membership tests below are written as explicit loops for that reason.
#   * `set` is shell-local, `setenv` is exported. Anything a helper script under
#     global/helpers/ must see has to be `setenv` -- helpers are separate processes.
#
# Everything is guarded: on a machine with no loadout install, this file sets nothing
# and prints nothing. Startup silence is a hard requirement.

if ( $?TCSH_CONFIG_ROOT_DIR ) then
    set _loadout_global = "${TCSH_CONFIG_ROOT_DIR}/global"
else
    set _loadout_global = "$HOME/.config/tcsh/global"
endif
set _loadout_helpers = "${_loadout_global}/helpers"

# ---- re-exec into a preferred tcsh, if one is configured and different --------
# Mirrors LOADOUT_CFG_PREFERRED_BASH. Guarded against a re-exec loop by comparing
# against the shell actually running.
if ( $?LOADOUT_CFG_PREFERRED_TCSH && $?prompt ) then
    if ( "$LOADOUT_CFG_PREFERRED_TCSH" != "" && -x "$LOADOUT_CFG_PREFERRED_TCSH" ) then
        if ( "$LOADOUT_CFG_PREFERRED_TCSH" != "$shell" ) then
            # Capture the target BEFORE clearing the variable: clearing it is what
            # stops the replacement shell from re-execing again forever, but the
            # exec still needs the value, so the order matters.
            set _loadout_target_shell = "$LOADOUT_CFG_PREFERRED_TCSH"
            setenv LOADOUT_CFG_PREFERRED_TCSH ""
            exec "$_loadout_target_shell"
        endif
    endif
endif

# ---- resolve the local root (shared tree if configured, else the XDG root) ---
set _loadout_prefix = "$HOME/.local/share/loadout"
if ( $?LOADOUT_CFG_SHARED_PREFIX ) then
    if ( "$LOADOUT_CFG_SHARED_PREFIX" != "" ) then
        set _loadout_prefix = "$LOADOUT_CFG_SHARED_PREFIX"
    endif
endif

# ---- PATH: prepend the dirs that exist, without duplicating -------------------
# Resolve NVM's node bin first. nvm.sh is a bash-only script csh cannot source,
# so a direct tcsh login used to get no node/npm at all. A parent bash exports
# NVM_BIN; otherwise helpers/nvm-bin resolves nvm's default (or newest) version.
set _loadout_nvm_bin = ""
if ( $?NVM_BIN ) then
    if ( -d "$NVM_BIN" ) set _loadout_nvm_bin = "$NVM_BIN"
endif
if ( -d "$HOME/.nvm" ) then
    setenv NVM_DIR "$HOME/.nvm"
    if ( "$_loadout_nvm_bin" == "" && -x "${_loadout_helpers}/nvm-bin" ) then
        set _loadout_nvm_bin = "`"${_loadout_helpers}/nvm-bin"`"
    endif
endif
if ( "$_loadout_nvm_bin" != "" ) setenv NVM_BIN "$_loadout_nvm_bin"

# Same list and same order as envs/bash/global/bashrc. Reversed relative to that
# file because each iteration prepends, and the bash loop prepends too -- so the
# LAST entry here ends up first on PATH, matching bash's final ordering. bash
# sources nvm.sh BEFORE its loop and does not reorder an entry already present,
# which leaves NVM_BIN after /usr/local/bin; listing it first reproduces that
# (visible: ~/.local/bin ... ~/.cargo/bin /usr/local/bin $NVM_BIN).
foreach _loadout_dir ( "$_loadout_nvm_bin" /usr/local/bin "$HOME/.cargo/bin" "$HOME/.venv/bin" "$HOME/.opencode/bin" "$HOME/node_modules/.bin" "$HOME/go/bin" "$HOME/.local/bin" )
    if ( -d "$_loadout_dir" ) then
        set _loadout_seen = 0
        foreach _loadout_p ( $path:q )
            if ( "$_loadout_p" == "$_loadout_dir" ) set _loadout_seen = 1
        end
        if ( $_loadout_seen == 0 ) set path = ( "$_loadout_dir" $path:q )
        unset _loadout_seen
        unset _loadout_p
    endif
end
unset _loadout_dir
unset _loadout_nvm_bin

# EL's own tree: prefer/ shims are PREPENDED (the explicit per-tool exception),
# the shared bin is APPENDED so a system copy keeps priority.
foreach _loadout_dir ( "${_loadout_prefix}/prefer" "${_loadout_prefix}/bin" )
    if ( -d "$_loadout_dir" ) then
        set _loadout_seen = 0
        foreach _loadout_p ( $path:q )
            if ( "$_loadout_p" == "$_loadout_dir" ) set _loadout_seen = 1
        end
        if ( $_loadout_seen == 0 ) then
            if ( "$_loadout_dir" == "${_loadout_prefix}/prefer" ) then
                set path = ( "$_loadout_dir" $path:q )
            else
                set path = ( $path:q "$_loadout_dir" )
            endif
        endif
        unset _loadout_seen
        unset _loadout_p
    endif
end
unset _loadout_dir

# ---- terminfo: ncurses does not search ~/.local/share/terminfo by default -----
# Prepended in bash's order: each iteration prepends, so prefix ends up first.
foreach _loadout_ti ( "$HOME/.local/share/terminfo" "${_loadout_prefix}/share/terminfo" )
    if ( -d "$_loadout_ti" ) then
        if ( $?TERMINFO_DIRS ) then
            setenv TERMINFO_DIRS "${_loadout_ti}:${TERMINFO_DIRS}"
        else
            setenv TERMINFO_DIRS "${_loadout_ti}"
        endif
    endif
end
unset _loadout_ti

# ---- GUI / runtime helpers (only when actually present) -----------------------
if ( -d "${_loadout_prefix}/lib/girepository-1.0" ) then
    if ( $?GI_TYPELIB_PATH ) then
        setenv GI_TYPELIB_PATH "${_loadout_prefix}/lib/girepository-1.0:${GI_TYPELIB_PATH}"
    else
        setenv GI_TYPELIB_PATH "${_loadout_prefix}/lib/girepository-1.0"
    endif
endif
if ( -f "${_loadout_prefix}/lib64/libqxcb.so" ) then
    setenv QT_QPA_PLATFORM_PLUGIN_PATH "${_loadout_prefix}/lib64"
endif
if ( -d "${_loadout_prefix}/share/nvim-qt/runtime" ) then
    setenv NVIM_QT_RUNTIME_PATH "${_loadout_prefix}/share/nvim-qt/runtime"
endif

# ---- shared fonts: the tree may carry a generated fontconfig config -----------
# Written when the fonts were installed once with the tools instead of into every
# user's $HOME. It re-includes /etc/fonts/fonts.conf, so the system dirs and the
# user's own ~/.config/fontconfig/fonts.conf keep working. Caller-set var wins.
if ( ! $?FONTCONFIG_FILE ) then
    if ( -f "${_loadout_prefix}/etc/fonts/loadout-fonts.conf" ) then
        setenv FONTCONFIG_FILE "${_loadout_prefix}/etc/fonts/loadout-fonts.conf"
    endif
endif
# gnuplot's x11 terminal spawns a separate gnuplot_x11 helper; point gnuplot at
# the bundled one so it does not look for the build-time libexec path.
if ( -x "${_loadout_prefix}/libexec/gnuplot/6.0/gnuplot_x11" ) then
    setenv GNUPLOT_DRIVER_DIR "${_loadout_prefix}/libexec/gnuplot/6.0"
endif

# ---- environment shared by interactive and non-interactive shells -------------
# These are exported in the bash env BEFORE its non-interactive early return, so
# scripts see them. Same here.
setenv PIP_REQUIRE_VIRTUALENV 1
setenv PYTHON_KEYRING_BACKEND keyring.backends.null.Keyring
# Bytecode cache in the fast scratch root, but only in a dir private to us:
# whoever owns the prefix can plant .pyc files every Python run imports.
set _loadout_shm = /dev/shm
if ( $?LOADOUT_CFG_SHM_DIR ) set _loadout_shm = "$LOADOUT_CFG_SHM_DIR"
sh "${_loadout_helpers}/private-dir" "${_loadout_shm}/${USER}" >& /dev/null
if ( $status == 0 ) then
    setenv PYTHONPYCACHEPREFIX "${_loadout_shm}/${USER}/pycache"
else
    unsetenv PYTHONPYCACHEPREFIX
endif
# Silence Mesa EGL loader "failed to get driver name" warnings -- harmless noise
# on headless nodes, X-forwarded sessions, and WSL2 without GPU passthrough.
setenv EGL_LOG_LEVEL fatal

# ---- everything below is interactive-only ------------------------------------
if ( $?prompt ) then

    # ---- preferred editor -----------------------------------------------------
    # bash exports EDITOR/VISUAL/GIT_EDITOR only in its interactive block, so a
    # non-interactive tcsh must not hand scripts a different environment.
    # Fall back when the preferred editor is not installed, so every `vi`/`vim`/
    # `new` alias below points at something real.
    if ( $?LOADOUT_CFG_PREFERRED_VI ) then
        if ( ! -X "$LOADOUT_CFG_PREFERRED_VI" ) then
            if ( -X nvim ) then
                setenv LOADOUT_CFG_PREFERRED_VI nvim
            else if ( -X vim ) then
                setenv LOADOUT_CFG_PREFERRED_VI vim
            else
                setenv LOADOUT_CFG_PREFERRED_VI vi
            endif
        endif
        setenv EDITOR   "$LOADOUT_CFG_PREFERRED_VI"
        setenv VISUAL   "$LOADOUT_CFG_PREFERRED_VI"
        setenv GIT_EDITOR "$LOADOUT_CFG_PREFERRED_VI"
    endif

    # eza (the default) or ls. Any other value -- a retired `lsd`, a typo --
    # means eza; then fall back to plain ls when eza is not installed.
    if ( ! $?LOADOUT_CFG_PREFERRED_LS ) setenv LOADOUT_CFG_PREFERRED_LS eza
    if ( "$LOADOUT_CFG_PREFERRED_LS" != "ls" ) setenv LOADOUT_CFG_PREFERRED_LS eza
    if ( ! -X "$LOADOUT_CFG_PREFERRED_LS" ) setenv LOADOUT_CFG_PREFERRED_LS ls

    set autolist                    # list completions on ambiguous TAB
    set autoexpand                  # expand history/completions in place
    set nobeep
    set color
    set colorcat
    set complete = enhance          # case-insensitive, treats - and _ alike
    set listjobs = long
    set notify                      # report job completion immediately
    set rmstar                      # confirm before `rm *`
    set implicitcd                  # a bare directory name cd's to it.
                                    # This is csh's NATIVE answer to the ERR trap
                                    # envs/bash/global/bashrc uses for the same
                                    # thing -- prefer it, it cannot misfire on a
                                    # failed command the way a trap can.
    set histdup = erase             # matches bash HISTCONTROL=...:erasedups
    set savedirs
    unset autologout                # never time out an idle interactive shell

    # ---- history --------------------------------------------------------------
    # Per-PID history with parent inheritance, mirroring the bash env: a child
    # shell (or `exec tcsh`) continues the parent's history instead of starting
    # blank, and a fresh login picks up the most recently used one.
    set history = 10000
    set savehist = ( 10000 merge )
    # NOTE: only $$ is passed. tcsh has NO $PPID -- that is a bash variable, and
    # naming it here makes every interactive shell print
    # "PPID: Undefined variable." on startup. The helper reads the parent pid
    # from /proc itself.
    if ( -x "${_loadout_helpers}/seed-history" ) then
        set _loadout_hf = "`${_loadout_helpers}/seed-history $$`"
        if ( "$_loadout_hf" != "" ) set histfile = "$_loadout_hf"
        unset _loadout_hf
    endif
    # Flush history to $histfile without waiting for exit, so a kill -9 or a
    # dropped connection does not take the session's history with it. tcsh runs
    # `periodic` before a prompt once $tperiod minutes have elapsed.
    #
    # NOT on precmd, unlike the bash env's loadout_save_history: tcsh has no
    # incremental append, so `history -S` rewrites all 10k lines where bash's
    # `history -a` writes only what is new. Per prompt that is a full rewrite per
    # command on an NFS farm home. The alias itself lives in aliases.csh (which
    # is sourced further down) because that is the file tests/env-shell-parity
    # reads; alias bodies resolve at run time, so the forward reference is fine.
    set tperiod = 5
    alias periodic loadout_save_history

    # ---- terminal -------------------------------------------------------------
    setenv COLORTERM truecolor
    # tmux reads EXTENDED_KEYS_SUPPORTED (envs/tmux/tmux-global.conf). Port the
    # full bash/zsh check_extended_keys: cheap TERM/TMUX answers, then the
    # Secondary-DA probe for a bare xterm login. The helper refuses the probe
    # when type-ahead is already pending, and exports 0 when it cannot tell --
    # the same value bash exports, so tmux behaves identically.
    if ( -x "${_loadout_helpers}/check-extended-keys" ) then
        if ( { "${_loadout_helpers}/check-extended-keys" } ) then
            setenv EXTENDED_KEYS_SUPPORTED 1
        else
            setenv EXTENDED_KEYS_SUPPORTED 0
        endif
    endif
    # Disable ctrl-s terminal pausing; leave the tty in a known-good state.
    /bin/stty sane >& /dev/null
    /bin/stty -ixon >& /dev/null

    # Fallback runtime dir: private or not at all (helpers/private-dir), the
    # same rule helpers/seed-history applies to the history it keeps there.
    # Nested, not `else if`: csh substitutes variables on an `else if` line even
    # while skipping it, so naming the unset variable there prints
    # "XDG_RUNTIME_DIR: Undefined variable." on every fresh login.
    set _loadout_rt
    if ( $?XDG_RUNTIME_DIR ) then
        if ( -r "$XDG_RUNTIME_DIR" ) unset _loadout_rt
    endif
    if ( $?_loadout_rt ) then
        setenv XDG_RUNTIME_DIR "${_loadout_shm}/`id -u`"
        sh "${_loadout_helpers}/private-dir" "$XDG_RUNTIME_DIR" >& /dev/null
        if ( $status != 0 ) then
            setenv XDG_RUNTIME_DIR "${HOME}/.cache/loadout/runtime"
            sh "${_loadout_helpers}/private-dir" "$XDG_RUNTIME_DIR" >& /dev/null
        endif
        unset _loadout_rt
    endif

    # ---- pager / man ----------------------------------------------------------
    setenv PAGER 'less --incsearch --use-color --no-init --ignore-case --mouse'
    setenv MANPAGER /usr/bin/less
    setenv MANROFFOPT -c
    # `setenv` does NOT interpret backslash escapes (csh has no $'...'), and
    # less does NOT process escapes in LESS_TERMCAP_*: the bytes must be real
    # ESC. Capture the single ESC byte once -- seven /usr/bin/printf forks on
    # every interactive startup bought nothing.
    set _loadout_esc = "`/usr/bin/printf '\033'`"
    setenv LESS_TERMCAP_mb "${_loadout_esc}[1;32m"
    setenv LESS_TERMCAP_md "${_loadout_esc}[1;32m"
    setenv LESS_TERMCAP_me "${_loadout_esc}[0m"
    setenv LESS_TERMCAP_se "${_loadout_esc}[0m"
    setenv LESS_TERMCAP_so "${_loadout_esc}[01;33m"
    setenv LESS_TERMCAP_ue "${_loadout_esc}[0m"
    setenv LESS_TERMCAP_us "${_loadout_esc}[1;4;31m"
    unset _loadout_esc
    if ( -X bat ) then
        setenv BAT_PAGER "$PAGER -RF"
    else if ( -X batcat ) then
        setenv BAT_PAGER "$PAGER -RF"
    endif

    # ---- listing arg sets (consumed by the ls aliases) ------------------------
    # Same variable names and same values as envs/bash/global/bashrc, so both
    # shells list identically and a user override applies to both.
    setenv EZA_ARGS "--classify=always --color=always --icons=always --long --sort date --time modified --time-style relative"

    # ---- online connectivity detection ---------------------------------------
    # Sets LOADOUT_ONLINE=1/0 once per login; inherited by child shells and tmux
    # panes. Mirrors the bash env, including the auto/1/0 tri-state.
    if ( ! $?LOADOUT_ONLINE ) then
        set _loadout_mode = "auto"
        if ( $?LOADOUT_CFG_ENABLE_ONLINE_UPDATES ) set _loadout_mode = "$LOADOUT_CFG_ENABLE_ONLINE_UPDATES"
        switch ( "$_loadout_mode" )
            case 0:
            case false:
            case no:
            case off:
            case disabled:
                setenv LOADOUT_ONLINE 0
                breaksw
            case 1:
            case true:
            case yes:
            case on:
            case enabled:
                setenv LOADOUT_ONLINE 1
                breaksw
            default:
                if ( -x "${_loadout_helpers}/detect-online" ) then
                    if ( { "${_loadout_helpers}/detect-online" } ) then
                        setenv LOADOUT_ONLINE 1
                    else
                        setenv LOADOUT_ONLINE 0
                    endif
                else
                    setenv LOADOUT_ONLINE 0
                endif
                breaksw
        endsw
        unset _loadout_mode
    endif

    # ---- linelight -------------------------------------------------------------
    # Colour for commands that print plain tables (df, diff, dig, free, lsblk,
    # ping, ps, sensors, ss), as in bash/zsh. `linelight init tcsh` aliases only
    # profiled commands on path, skips names already aliased, and honors
    # LINELIGHT_INIT=0 and ~/.config/linelight/adapters.toml; `linelight run`
    # colours only a terminal. The adapter is SOURCED from a private file:
    # upstream's documented eval "`linelight init tcsh`" defines nothing,
    # because csh joins a quoted substitution into one line and the adapter's
    # if/endif blocks fall apart. XDG_RUNTIME_DIR is private by here (above).
    # aliases.csh's df (--block-size=G) keeps the colour only when df was
    # wrapped, so every opt-out reaches it too.
    if ( $?LOADOUT_CFG_ENABLE_LINELIGHT && $?XDG_RUNTIME_DIR ) then
        if ( { "${_loadout_helpers}/is-truthy" "$LOADOUT_CFG_ENABLE_LINELIGHT" } && -X linelight ) then
            set _loadout_ll_init = "${XDG_RUNTIME_DIR}/loadout-linelight-init.$$.csh"
            ( linelight init tcsh >! "$_loadout_ll_init" ) >& /dev/null
            if ( -s "$_loadout_ll_init" ) source "$_loadout_ll_init"
            \rm -f "$_loadout_ll_init"
            unset _loadout_ll_init
            set _loadout_ll_df = "`alias df`"
            if ( "$_loadout_ll_df" =~ *linelight* ) set _loadout_linelight_df
            unset _loadout_ll_df
        endif
    endif

    # ---- tmux-path-store ------------------------------------------------------
    # Per-tmux-window directory/file bookmarks. Upstream gained --csh/--tcsh in
    # v1.1.0; before that it emitted --bash only and this was a recorded gap.
    #
    # The EXECUTABLE is kebab-case; the CONFIG VARIABLE stays
    # LOADOUT_CFG_ENABLE_TMUX_PATH_STORE -- a shell variable name cannot take a
    # dash (see the warning in envs/bash/global/bashrc, where spelling it the
    # other way silently disabled the toggle and bash never complained).
    #
    # The emitted aliases contain `\!*` for argument insertion; csh stores that
    # as a literal `!` rather than expanding history, which is why upstream
    # escapes it and why this must NOT be re-quoted here.
    #
    # Evaluated BEFORE aliases.csh is sourced, matching the bash env's ordering,
    # so the loadout's own alias wins on a name collision in every shell.
    if ( $?LOADOUT_CFG_ENABLE_TMUX_PATH_STORE ) then
        if ( { "${_loadout_helpers}/is-truthy" "$LOADOUT_CFG_ENABLE_TMUX_PATH_STORE" } && -X tmux-path-store ) then
            eval `tmux-path-store --csh`
        endif
    endif

    # ---- Environment Modules --------------------------------------------------
    if ( $?LOADOUT_CFG_USE_LOADOUT_MODULES ) then
        if ( { "${_loadout_helpers}/is-truthy" "$LOADOUT_CFG_USE_LOADOUT_MODULES" } ) then
            if ( -r "${_loadout_global}/modules-init.csh" ) source "${_loadout_global}/modules-init.csh"
        endif
    endif

    # ---- aliases, key bindings, completions -----------------------------------
    if ( -r "${_loadout_global}/aliases.csh" )     source "${_loadout_global}/aliases.csh"
    if ( -r "${_loadout_global}/keybinds.csh" )    source "${_loadout_global}/keybinds.csh"
    if ( -r "${_loadout_global}/completions.csh" ) source "${_loadout_global}/completions.csh"

    # ---- every directory change lists -----------------------------------------
    # csh's NATIVE hook for this. It fires for cd, pushd, popd, implicitcd and any
    # alias that changes directory -- so unlike the bash env, which needs a cd()
    # wrapper and has to route zoxide and `latest` back through it, there is no
    # call site here that can forget to list.
    #
    # It also carries OSC 7 (report cwd to the terminal), which is the one piece
    # of the WezTerm shell integration csh can do: OSC 7 is tied to cwd changes,
    # which is exactly what this hook is. OSC 133 semantic zones need per-command
    # hooks csh does not expose, and are not attempted.
    alias cwdcmd 'ls ; printf "\033]7;file://%s%s\033\\" "$HOST" "$cwd"'

    # ---- prompt ---------------------------------------------------------------
    # Starship drives the prompt, exactly like the bash env -- same modules,
    # same glyphs, same git branch, same LSF/user handling. The one deliberate
    # difference is the PATH COLOUR: tcsh renders it yellow (the tcsh-specific
    # config next to this file), bash keeps the shared config's cyan, so a
    # glance at the prompt says which shell you are in.
    #
    # This used to be hand-rolled because "starship has no tcsh support" -- that
    # was true when this env was written, and it stopped being true: the
    # shipped starship (1.26.0) has a tcsh target
    # (`starship init tcsh`), and it chains its own precmd/postcmd to the
    # USER_PRECMD/USER_POSTCMD aliases, so it composes with the rest of this
    # file instead of replacing it.
    #
    # The hand-rolled prompt below stays as the FALLBACK for a host with no
    # starship: it needs no external binary and keeps the shell usable.
    #
    # precmd runs before EVERY prompt, so it must stay cheap: git is resolved once
    # here, and the branch lookup is a single fork whose stderr is discarded.
    if ( $?prompt ) then
        set _loadout_starship_ok = 0
        if ( $?LOADOUT_CFG_ENABLE_STARSHIP ) then
            if ( { "${_loadout_helpers}/is-truthy" "$LOADOUT_CFG_ENABLE_STARSHIP" } ) set _loadout_starship_ok = 1
        endif
        if ( $_loadout_starship_ok == 1 ) then
            # csh has no `command -v` (it prints "command: Command not found." and
            # carries on) -- `which` is the csh/tcsh spelling. Test with -X FIRST:
            # `which` writes its not-found message to STDOUT, so capturing it
            # makes the variable non-empty and sends a garbage line to eval.
            if ( -X starship ) then
                set _loadout_starship_bin = "`which starship`"
            # ONE starship config, shared with the bash and zsh envs.
            # Starship has no config-time env-var substitution (verified:
            # `style = "$VAR"` is emitted verbatim), so the per-shell path
            # colour cannot live IN the config. It is applied afterwards,
            # by helpers/prompt-markers below, which recolours the directory
            # segment. See docs/STARSHIP.md.
            setenv STARSHIP_CONFIG "${TCSH_CONFIG_ROOT_DIR}/../starship/starship.toml"
            # The marker conversion must be a `precmd` ALIAS defined BEFORE
            # starship's init: the init captures the current precmd alias into
            # USER_PRECMD and then defines `alias precmd
            # "$STARSHIP_PRECMD;$USER_PRECMD"` -- and BOTH are expanded when
            # that alias is DEFINED, so anything set afterwards (a USER_PRECMD
            # variable, say) never runs.
            #
            # The helper path uses $TCSH_CONFIG_ROOT_DIR (an ENVIRONMENT
            # variable, exported by the entry point) rather than
            # ${_loadout_helpers} (a shell-local one): csh validates an
            # alias body when the alias is defined, and a body naming a
            # shell-local variable that is not yet set is rejected as a
            # "Faulty alias". $TCSH_CONFIG_ROOT_DIR is set before this file
            # runs and is correct for both layouts -- the shared config root
            # and the home-local one.
            # The prompt is rendered HERE and piped straight into the helper,
            # NOT taken from `$prompt`: starship's own precmd already did
            # `set prompt = "`starship prompt`"`, and csh collapses newlines
            # inside a command substitution -- so by the time `$prompt` exists
            # the line structure is gone and the path ends up on the branch's
            # line. A PIPE inside the backticks preserves it.
            # $STARSHIP_PATH / $STARSHIP_CMD_STATUS / $STARSHIP_DURATION are
            # set by the stock STARSHIP_PRECMD, which runs just before this.
            alias precmd 'set prompt = "`$STARSHIP_PATH prompt --status $STARSHIP_CMD_STATUS --cmd-duration $STARSHIP_DURATION | $TCSH_CONFIG_ROOT_DIR/global/helpers/prompt-markers`"'
            # starship's tcsh init defines precmd/postcmd aliases that chain to
            # the precmd alias above (captured as USER_PRECMD), so starship
            # renders the prompt and the alias converts its markers.
            eval "`"$_loadout_starship_bin" init tcsh --print-full-init`"
            # Only claim the prompt after the init actually installed its
            # aliases. A starship that runs but prints nothing (or fails) must
            # leave the hand-rolled fallback below in charge. The init does NOT
            # define $STARSHIP_PATH itself -- it is assigned inside the precmd
            # alias -- so detect the installed alias, not the variable.
            set _lo_starship_status = $status
            set _lo_starship_alias = "`alias precmd`"
            if ( $_lo_starship_status == 0 && "$_lo_starship_alias" =~ *STARSHIP_PATH* ) then
                # STARSHIP_SHELL=sh, and it must be set HERE -- after the init
                # above, which exports STARSHIP_SHELL=tcsh itself.
                #
                # It controls two things, and tcsh needs a value that is right
                # for both:
                #
                #   1. the shell each module's `when` runs under. `sh` is POSIX,
                #      which every expression in the shared config is. `tcsh`
                #      cannot parse custom.username's `for u in $VAR; do ... done`
                #      at all, so that module silently never appears.
                #   2. the zero-width marker syntax starship emits. `sh` emits
                #      NONE. `bash` emits readline's `\[ \]` -- which tcsh prints
                #      literally, because tcsh has no readline -- and `tcsh`
                #      emits zsh's `%{ %}`, which tcsh happens to understand but
                #      which is not what the helper below expects.
                #
                # So `sh` is the one value that both renders cleanly and keeps
                # every module. This env used to pin `bash`, which is what made
                # helpers/prompt-markers necessary in the first place.
                setenv STARSHIP_SHELL sh
                # The flag the hand-rolled prompt below checks: with starship
                # driving, that path must not touch `prompt` or `precmd`.
                set loadout_prompt_starship = 1
                # The upper prompt lines are printed by helpers/prompt-markers,
                # not held in $prompt (tcsh's `\n` is a soft wrap that tmux zoom
                # and resize reflow), so tcsh's own redraws show only the last
                # line. The helper caches the upper lines here -- one file per
                # terminal, in the private runtime dir -- and Ctrl-L clears and
                # reprints them before tcsh redraws the prompt and typed input.
                if ( $?XDG_RUNTIME_DIR ) then
                    if ( "$tty" != "" ) then
                        setenv LOADOUT_TCSH_PROMPT_CACHE "${XDG_RUNTIME_DIR}/loadout-tcsh-prompt.$tty:gs#/#-#"
                    else
                        setenv LOADOUT_TCSH_PROMPT_CACHE "${XDG_RUNTIME_DIR}/loadout-tcsh-prompt.$$"
                    endif
                endif
                bindkey -c ^L "${_loadout_helpers}/prompt-redraw"
            endif
            unset _lo_starship_status _lo_starship_alias
        endif
    endif
    endif
    unset _loadout_starship_ok

    set _loadout_host = ""
    if ( $?LOADOUT_CFG_PROMPT_INCLUDE_HOST ) then
        # No trailing colon: the LSF branch below prepends "LSF:", which is
        # the only separator the prompt needs ('LSF:host' / 'host').
        if ( "$LOADOUT_CFG_PROMPT_INCLUDE_HOST" == "1" ) set _loadout_host = "%m"
    endif

    # Show the username when it is in the highlight list, or when the effective
    # user differs from $USER (a sudo/su session) -- the same two cases the bash
    # env's get_prompt_uid covers.
    set _loadout_uid = ""
    set _loadout_whoami = "`/bin/whoami`"
    if ( "$_loadout_whoami" != "${USER}" ) set _loadout_uid = "${_loadout_whoami} "
    if ( $?LOADOUT_CFG_STARSHIP_USERIDS_TO_HIGHLIGHT ) then
        foreach _loadout_u ( $LOADOUT_CFG_STARSHIP_USERIDS_TO_HIGHLIGHT )
            if ( "$_loadout_u" == "$_loadout_whoami" ) set _loadout_uid = "${_loadout_whoami} "
        end
        unset _loadout_u
    endif
    unset _loadout_whoami

    # An LSF job turns the prompt red so an expensive farm shell is never mistaken
    # for a local one.
    #
    # The colour value goes through helpers/prompt-color, which is NOT cosmetic:
    # LOADOUT_CFG_PROMPT_COLOR_* is shared with the bash env and is EXPORTED
    # there, so a tcsh started from a loadout bash shell inherits bash's value --
    # which is wrapped in readline's `\[` / `\]` zero-width markers. tcsh has no
    # idea what those are and prints them literally, giving a prompt that starts
    # `\[<esc>[38;2;255;255;0m\]`. The helper strips them and turns a literal
    # `\033`/`\e` into a real ESC byte; `%{...%}` below is tcsh's own zero-width
    # wrapper and replaces what `\[`/`\]` were doing for bash.
    set _loadout_raw_color = ""
    if ( $?LOADOUT_CFG_PROMPT_COLOR_NORMAL ) set _loadout_raw_color = "$LOADOUT_CFG_PROMPT_COLOR_NORMAL"
    if ( $?LSB_JOBID ) then
        set _loadout_host = "LSF:${_loadout_host}"
        if ( $?LOADOUT_CFG_PROMPT_COLOR_FARM ) set _loadout_raw_color = "$LOADOUT_CFG_PROMPT_COLOR_FARM"
    endif
    set _loadout_color = ""
    if ( "$_loadout_raw_color" != "" && -x "${_loadout_helpers}/prompt-color" ) then
        set _loadout_color = "`${_loadout_helpers}/prompt-color '$_loadout_raw_color'`"
    endif
    unset _loadout_raw_color

    # loadout_prompt_lead / _tail deliberately SURVIVE this file (no unset): the
    # precmd alias below reads them on every prompt, and `sp1` / `sp2` in
    # aliases.csh toggle the hostname by reassigning the lead. The bash env gets
    # the same effect by re-running its set_prompt function; csh has no
    # functions, so the pieces have to stay addressable as variables.
    set loadout_prompt_lead = "%{${_loadout_color}%}${_loadout_uid}${_loadout_host}"
    set loadout_prompt_lead_nohost = "%{${_loadout_color}%}${_loadout_uid}"
    set loadout_prompt_lead_host = "%{${_loadout_color}%}${_loadout_uid}%m:"
    set loadout_prompt_tail = "%{\033[0m%} "
    set _loadout_gitbranch = "${_loadout_global}/git-branch.sh"

    # git-branch.sh does the stderr suppression csh cannot do itself (csh has no
    # `2>/dev/null`; an inline `|&` merges git's error text into the prompt -- an
    # unborn HEAD then prints git's "Use '--' to separate paths" hint at you).
    #
    # ONLY when starship is not driving the prompt. Starship owns `prompt` and
    # the `precmd` alias; setting either here would fight it (the hand-rolled
    # precmd would overwrite starship's, and its prompt would overwrite
    # starship's). The hand-rolled path is the no-starship fallback.
    if ( ! $?loadout_prompt_starship ) then
        if ( -X git && -x "$_loadout_gitbranch" ) then
            set prompt = "${loadout_prompt_lead}%B%~%b %#${loadout_prompt_tail}"
            alias precmd 'set _lb = "`'"$_loadout_gitbranch"'`" ; if ( "$_lb" != "" ) set prompt = "${loadout_prompt_lead}%B%~%b (${_lb}) %#${loadout_prompt_tail}" ; if ( "$_lb" == "" ) set prompt = "${loadout_prompt_lead}%B%~%b %#${loadout_prompt_tail}"'
        else
            set prompt = "${loadout_prompt_lead}%B%~%b %#${loadout_prompt_tail}"
        endif
    endif
    unset _loadout_host
    unset _loadout_uid
    unset _loadout_color
    unset _loadout_gitbranch

    # ---- fixed-socket ssh-agent -----------------------------------------------
    # Mirrors the block in envs/bash/global/bashrc (the switch
    # LOADOUT_CFG_ENABLE_SSH_AGENT is defined in envs/tcsh/global/config.csh --
    # this env does not depend on env-bash, so it carries its own copy; see the
    # bash copy for the full rationale). csh specifics:
    #   * `ssh-add -l` runs with stderr suppressed csh-style (`>& /dev/null` --
    #     csh has no 2>/dev/null); its status lands in $status, and exit 2 means
    #     no agent is listening at the socket (dead or never started), which is
    #     the only case that starts one. Exit 0/1 (identities / reachable but
    #     empty) both mean a live agent is already there -- restarting it would
    #     drop any already-loaded identity.
    #   * ~/.ssh is created first (mode 700): ssh-agent -a cannot bind a socket
    #     in a missing directory, and on a fresh HOME that failure is silent.
    #   * Does NOT run ssh-add: a passphrase-protected key would prompt on every
    #     new shell. Load it once per agent lifetime yourself.
    #   * Runs BEFORE tmux auto-attach so tmux panes inherit SSH_AUTH_SOCK.
    if ( $?LOADOUT_CFG_ENABLE_SSH_AGENT ) then
        if ( { "${_loadout_helpers}/is-truthy" "$LOADOUT_CFG_ENABLE_SSH_AGENT" } ) then
            setenv SSH_AUTH_SOCK "$HOME/.ssh/loadout-agent.sock"
            ssh-add -l >& /dev/null
            if ( $status == 2 ) then
                mkdir -p "$HOME/.ssh" >& /dev/null
                chmod 700 "$HOME/.ssh"
                rm -f "$SSH_AUTH_SOCK" >& /dev/null
                ssh-agent -a "$SSH_AUTH_SOCK" >& /dev/null
            endif
        endif
    endif

    # ---- tmux auto-attach (last, so a failure cannot skip prompt setup) -------
    if ( $?LOADOUT_CFG_ATTACH_TO_TMUX && ! $?TMUX ) then
        if ( { "${_loadout_helpers}/is-truthy" "$LOADOUT_CFG_ATTACH_TO_TMUX" } && -X tmux ) then
            set _loadout_detach = ""
            if ( $?LOADOUT_CFG_ATTACH_TO_TMUX_WITH_DETACH_OTHERS ) then
                if ( { "${_loadout_helpers}/is-truthy" "$LOADOUT_CFG_ATTACH_TO_TMUX_WITH_DETACH_OTHERS" } ) set _loadout_detach = "-d"
            endif
            tmux attach $_loadout_detach >& /dev/null || tmux
            unset _loadout_detach
        endif
    endif

endif

unset _loadout_prefix
unset _loadout_helpers
unset _loadout_shm
unset _loadout_global
