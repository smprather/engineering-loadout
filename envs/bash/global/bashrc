### Prompt ###
/bin/stty sane
# Disable ctrl-s terminal pausing
/bin/stty -ixon

# Re-enable terminal echo if a foreground program was killed (e.g. ctrl-c at a
# password prompt) and left -echo on, so typed input stays visible again. Run
# from PROMPT_COMMAND, but only calls stty (tcsetattr) when echo is ACTUALLY off
# -- the old approach ran `stty <full-snapshot>` on every prompt, whose
# unconditional tcsetattr swallowed the Enter of any type-ahead entered while a
# long command was still running. Preserves $? so a following starship precmd
# still sees the real command exit status.
loadout_restore_echo() {
    local _rc=$?
    case $- in
    *i*) ;;
    *) return "$_rc" ;;
    esac
    local _stty=" $(stty -a 2>/dev/null | tr '\n' ' ') "
    [[ $_stty == *" -echo "* ]] && stty echo 2>/dev/null
    return "$_rc"
}

set_prompt() {
    local include_host=${LOADOUT_CFG_PROMPT_INCLUDE_HOST}
    local prompt_color=${LOADOUT_CFG_PROMPT_COLOR_NORMAL}
    local prompt_joined=""
    local prompt_parts=()

    if [[ -n $LSB_JOBID ]]; then
        prompt_parts+=('LSF')
        prompt_color="${LOADOUT_CFG_PROMPT_COLOR_FARM}"
    fi

    prompt_joined=$(join_by : "${prompt_parts[@]}")

    [[ $include_host == "1" ]] && prompt_joined+=":$(hostname)"

    get_prompt_uid() {
        local whoiam=$(/bin/whoami)
        if [[ "$whoiam" != "$USER" ]]; then
            printf "$whoiam "
        else
            printf ""
        fi
    }

    PS1="${PROMPT_YELLOW}\$(get_prompt_uid)${prompt_color}\$ ${PROMPT_WHITE}"
}

# Reset any preexec-framework state to a clean baseline. A login shell may have
# sourced a *system* wezterm/vte integration via /etc/profile, which loads
# bash-preexec and registers precmd_functions plus a PROMPT_COMMAND install
# stub. The clean-slate `unset -f` during startup already deleted that
# framework's functions, leaving dangling references (PROMPT_COMMAND -> missing
# __bp_install; precmd_functions -> missing __wezterm_*). Clear it so we can
# (re)install our own loadout-owned copy from user-writable space below.
unset precmd_functions preexec_functions __bp_imported bash_preexec_imported
unset PROMPT_COMMAND

# wezterm shell integration is sourced from a loadout-owned copy -- never /etc.
# In real WezTerm sessions (raw or tmux-in-wezterm) it registers OSC 133 zones,
# OSC 7 cwd, and user vars. Outside WezTerm, source the same script with all
# WezTerm output hooks disabled so we still get its bundled bash-preexec driver
# for Starship/loadout_restore_echo without printing raw OSC escapes in e.g.
# GNOME Terminal or blocking in `wezterm set-working-directory`.
if is_truthy "${LOADOUT_CFG_ENABLE_WEZTERM_SHELL_INTEGRATION}"; then
    _wezterm_sh=$(loadout_find_wezterm_shell_integration)
    if [[ -n $_wezterm_sh ]]; then
        _loadout_real_wezterm=0
        [[ $TERM_PROGRAM == WezTerm || -n ${WEZTERM_PANE:-} ]] && _loadout_real_wezterm=1
        if [[ $_loadout_real_wezterm == 0 ]]; then
            _loadout_had_wz_semantic=${WEZTERM_SHELL_SKIP_SEMANTIC_ZONES+x}
            _loadout_had_wz_user_vars=${WEZTERM_SHELL_SKIP_USER_VARS+x}
            _loadout_had_wz_cwd=${WEZTERM_SHELL_SKIP_CWD+x}
            _loadout_saved_wz_semantic=${WEZTERM_SHELL_SKIP_SEMANTIC_ZONES-}
            _loadout_saved_wz_user_vars=${WEZTERM_SHELL_SKIP_USER_VARS-}
            _loadout_saved_wz_cwd=${WEZTERM_SHELL_SKIP_CWD-}
            WEZTERM_SHELL_SKIP_SEMANTIC_ZONES=1
            WEZTERM_SHELL_SKIP_USER_VARS=1
            WEZTERM_SHELL_SKIP_CWD=1
        fi
        source "$_wezterm_sh"
        if [[ ${_loadout_real_wezterm:-0} == 0 ]]; then
            [[ -n $_loadout_had_wz_semantic ]] && WEZTERM_SHELL_SKIP_SEMANTIC_ZONES=$_loadout_saved_wz_semantic || unset WEZTERM_SHELL_SKIP_SEMANTIC_ZONES
            [[ -n $_loadout_had_wz_user_vars ]] && WEZTERM_SHELL_SKIP_USER_VARS=$_loadout_saved_wz_user_vars || unset WEZTERM_SHELL_SKIP_USER_VARS
            [[ -n $_loadout_had_wz_cwd ]] && WEZTERM_SHELL_SKIP_CWD=$_loadout_saved_wz_cwd || unset WEZTERM_SHELL_SKIP_CWD
        fi
    fi
fi

