### Online connectivity detection ###
# Sets LOADOUT_ONLINE=1/0 once per login session; inherited by child shells / tmux panes.
# LOADOUT_CFG_ENABLE_ONLINE_UPDATES: auto (parallel TCP probe) | 1 (force online) | 0 (force offline)
# Override hosts in user/config.sh: LOADOUT_CFG_ONLINE_DETECT_HOSTS="nexus.corp:443 ..."
# The auto probe is cached once per day on disk (loadout_detect_online_cached),
# so only the first login of the day pays for network probes -- every later
# shell starts instantly regardless of network state.
if [[ -z "${LOADOUT_ONLINE+x}" ]]; then
    case "${LOADOUT_CFG_ENABLE_ONLINE_UPDATES:-auto}" in
    0 | false | no | off | disabled) LOADOUT_ONLINE=0 ;;
    1 | true | yes | on | enabled) LOADOUT_ONLINE=1 ;;
    *) loadout_detect_online_cached && LOADOUT_ONLINE=1 || LOADOUT_ONLINE=0 ;;
    esac
    export LOADOUT_ONLINE
fi

### History ###
# Don't save to history if command line starts with a space char
# Erasedups causes all previous lines matching the current line to be removed from the history list before that line is saved.
export HISTCONTROL=ignorespace:erasedups
shopt -s histappend
# Save history accross shell re-boots (ie, exec bash)
export HISTFILE="$XDG_RUNTIME_DIR/bash_history.$$"
export HISTSIZE=10000
export HISTFILESIZE=10000
# If a history file with the PID already exists, that means an exec bash just happened.
if [[ ! -f "$HISTFILE" ]]; then
    # If not, then do this...
    if ps -f $PPID | grep -q bash; then
        # If this is a child bash, then inherit the history from the parent.
        [[ -f "$XDG_RUNTIME_DIR/bash_history.$PPID" ]] && cp "$XDG_RUNTIME_DIR/bash_history.$PPID" "$HISTFILE"
    else
        # Else, start the shell history with the contents of the most recently modified history.
        if ls "$XDG_RUNTIME_DIR"/bash_history.* >&/dev/null; then
            cp "$(/bin/ls -rt1 "$XDG_RUNTIME_DIR"/bash_history.* | tail -n 1)" "$HISTFILE"
        fi
    fi
fi
loadout_save_history() {
    local _rc=$?
    case $- in
    *i*) builtin history -a 2>/dev/null || true ;;
    esac
    return "$_rc"
}

