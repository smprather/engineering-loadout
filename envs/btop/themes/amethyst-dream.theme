theme[free_end]="#9B8BF7"

theme[used_start]="#BEB3FF"
theme[used_mid]="#FFC480"
theme[used_end]="#FF9580"

theme[download_start]="#9B8BF7" # Palette 10: Bright Mint Green
theme[download_mid]="#BEB3FF"   # Palette 9: Bright Coral Red
theme[download_end]="#b46440"   # Palette 9: Bright Coral Red

theme[upload_start]="#4B8FFF"   # Palette 11: Bright Yellow
