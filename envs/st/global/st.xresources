!   st.font: SauceCodePro Nerd Font Mono:size=12      (SourceCodePro.zip)
!   st.font: SauceCodePro Nerd Font Propo:size=12     (SourceCodePro.zip)
!   st.font: UbuntuMono Nerd Font:size=12
!   st.font: UbuntuMono Nerd Font Mono:size=12
!   st.font: UbuntuMono Nerd Font Propo:size=12
! END generated font list
!
! Suffixes: plain "Nerd Font" = icons keep their natural width; "Nerd Font Mono"
! = icons squeezed into one cell (safest in a terminal -- nothing overlaps);
! "Nerd Font Propo" = proportional icons. Pick Mono if a glyph ever clips.
!
! Syntax: <family>:size=<pt>[:style=Bold][:antialias=true][:autohint=false]
! Check what X actually resolves:  fc-match 'JetBrainsMono Nerd Font'
! List every installed family:     fc-list : family | sort -u

st.font: JetBrainsMono Nerd Font:size=12

! ---- Colors: tokyonight (matches the nvim colorscheme and starship) ----
! Accepts #rrggbb or an X color name.
st.background:  #1a1b26
st.foreground:  #c0caf5
st.cursorColor: #c0caf5

st.color0:  #15161e
st.color1:  #f7768e
st.color2:  #9ece6a
st.color3:  #e0af68
st.color4:  #7aa2f7
st.color5:  #bb9af7
st.color6:  #7dcfff
st.color7:  #a9b1d6
st.color8:  #414868
st.color9:  #f7768e
st.color10: #9ece6a
st.color11: #e0af68
st.color12: #7aa2f7
st.color13: #bb9af7
st.color14: #7dcfff
st.color15: #c0caf5

! ---- Behavior ----
st.cursorshape: 2
! Mute the audible bell. st's compiled default is already 0, but state it
! explicitly so a user who wants a bell knows the knob exists.
st.bellvolume: 0
