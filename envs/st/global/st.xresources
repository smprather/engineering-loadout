!   st.font: JetBrainsMono Nerd Font Mono:size=12
!   st.font: JetBrainsMono Nerd Font Propo:size=12
!   st.font: JetBrainsMonoNL Nerd Font:size=12
!   st.font: JetBrainsMonoNL Nerd Font Mono:size=12
!   st.font: JetBrainsMonoNL Nerd Font Propo:size=12
!   st.font: MesloLGL Nerd Font:size=12
!   st.font: MesloLGL Nerd Font Mono:size=12
!   st.font: MesloLGL Nerd Font Propo:size=12
!   st.font: MesloLGLDZ Nerd Font:size=12
!   st.font: MesloLGLDZ Nerd Font Mono:size=12
!   st.font: MesloLGLDZ Nerd Font Propo:size=12
