!   st.font: MesloLGS Nerd Font Mono:size=12
!   st.font: MesloLGS Nerd Font Propo:size=12
!   st.font: MesloLGSDZ Nerd Font:size=12
!   st.font: MesloLGSDZ Nerd Font Mono:size=12
!   st.font: MesloLGSDZ Nerd Font Propo:size=12
