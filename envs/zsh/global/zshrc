# Loadout zsh: PATH, environment, shell options, prompt, integrations.
#
# TRACKS envs/bash/global/bashrc. See envs/zsh/README.md.
#
# This is a ZSH file. Do NOT run `bash -n` or shellcheck against it -- validate
# by running zsh. The shared files it sources (functions.sh, aliases.sh) ARE
# bash-checked, because they must parse under both.
#
# Non-interactive shells return early, after PATH and the exported environment,
# exactly as the bash env does -- scripts need those and nothing below.

# --- re-exec into a preferred zsh, if one is configured and different ---------
if [[ -n ${LOADOUT_CFG_PREFERRED_ZSH:-} && -x ${LOADOUT_CFG_PREFERRED_ZSH} \
      && ${LOADOUT_CFG_PREFERRED_ZSH} != ${SHELL:-} && -o interactive ]]; then
    # Clear it first so the replacement shell does not re-exec forever; capture
    # the target before clearing, since the exec still needs the value.
    _loadout_target_shell=$LOADOUT_CFG_PREFERRED_ZSH
    export LOADOUT_CFG_PREFERRED_ZSH=""
    exec "$_loadout_target_shell"
fi

# --- NVM ----------------------------------------------------------------------
# nvm.sh hangs under zsh via its auto-use path, so the shell function is loaded
# in bash only. The toolchain on PATH is the part that matters for running
# node/npm, and that needs no shell support.
if [[ -n ${BASH_VERSION:-} && -r "$HOME/.nvm/nvm.sh" ]]; then
    export NVM_DIR="$HOME/.nvm"
    source "$NVM_DIR/nvm.sh"
elif [[ -d "$HOME/.nvm" ]]; then
    export NVM_DIR="$HOME/.nvm"
fi

# --- PATH ---------------------------------------------------------------------
# Same list and order as envs/bash/global/bashrc. path_prepend_if_dir is in the
# shared functions.sh and is verified to behave identically in both shells.
for _bin_dir in \
    /usr/local/bin \
    $NVM_BIN \
    ~/.cargo/bin \
    ~/.venv/bin \
    ~/.opencode/bin \
    ~/node_modules/.bin \
    ~/go/bin \
    "${LOADOUT_CFG_SHARED_PREFIX:+$LOADOUT_CFG_SHARED_PREFIX/bin}" \
    ~/.local/bin; do
    path_prepend_if_dir "$_bin_dir"
done

# --- terminfo -----------------------------------------------------------------
# ncurses does not search ~/.local/share/terminfo by default, and a
# non-interactive login shell returns below before the interactive block.
#
# This uses the SHARED path_prepend, which it could not before 2026-08-08: the
# two-arg named-variable form died under zsh with "bad substitution" because
# path_modify used bash's ${!var}. It was worked around here with a hand-rolled
# loop; the shared function is fixed now, so the workaround is gone.
typeset -gx TERMINFO_DIRS
path_prepend TERMINFO_DIRS "$HOME/.local/share/terminfo"
if [[ -n "${LOADOUT_CFG_SHARED_PREFIX:-}" ]]; then
    path_prepend TERMINFO_DIRS "$LOADOUT_CFG_SHARED_PREFIX/share/terminfo"
fi

# --- GUI / runtime helpers (only when actually present) -----------------------
_loadout_local_prefix="${LOADOUT_CFG_SHARED_PREFIX:-$HOME/.local}"
if [[ -f $_loadout_local_prefix/lib64/libqxcb.so ]]; then
    export QT_QPA_PLATFORM_PLUGIN_PATH=$_loadout_local_prefix/lib64
fi
if [[ -d $_loadout_local_prefix/share/nvim-qt/runtime ]]; then
    export NVIM_QT_RUNTIME_PATH=$_loadout_local_prefix/share/nvim-qt/runtime
fi
if [[ -d $_loadout_local_prefix/lib/girepository-1.0 ]]; then
    export GI_TYPELIB_PATH=$_loadout_local_prefix/lib/girepository-1.0${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}
fi
# gnuplot's x11 terminal spawns a separate gnuplot_x11 helper; point gnuplot at
# the bundled one so it does not look for the build-time libexec path.
if [[ -x $_loadout_local_prefix/libexec/gnuplot/6.0/gnuplot_x11 ]]; then
    export GNUPLOT_DRIVER_DIR=$_loadout_local_prefix/libexec/gnuplot/6.0
fi

# --- environment shared by interactive and non-interactive shells -------------
export PIP_REQUIRE_VIRTUALENV=1
export PYTHON_KEYRING_BACKEND=keyring.backends.null.Keyring
export PYTHONPYCACHEPREFIX=/dev/shm/$USER/pycache
# Silence Mesa EGL loader "failed to get driver name" warnings -- harmless noise
# on headless nodes, X-forwarded sessions, and WSL2 without GPU passthrough.
export EGL_LOG_LEVEL=fatal

# Non-interactive shells need everything above and nothing below.
[[ -o interactive ]] || return 0

