cd() {
    if [[ "$1" == "cd" ]]; then
        shift
    fi

    local target="$1"
    local response=""
    local create_base=""

    if [[ -d "$1" ]]; then
        target=$1
    elif [[ -z "$1" ]]; then
        target=$HOME
    elif [[ "$1" == "-" ]]; then
        target="-"
    elif [[ -L "$1" || -e "$1" ]]; then
        target=$(dirname -- "$1")
    elif [[ -n "$target" ]]; then
        create_base=$target
        while [[ $create_base != "/" && $create_base != "." && ! -e "$create_base" ]]; do
            create_base=$(dirname -- "$create_base")
        done

        if [[ -d "$create_base" && -w "$create_base" ]]; then
            read -r "response?$target does not exist. Create it with parent directories? [y]/n "
            if [[ -z "$response" || $response == [Yy] ]]; then
                mkdir -p -- "$target" || return
            else
                return
            fi
        fi
    fi

    builtin cd "$target"
}

# Every directory change lists. zsh's chpwd hook fires for cd, pushd, popd and
# AUTO_CD alike, so -- unlike the bash env, which needs the listing inside cd()
# and therefore has to route zoxide and `latest` back through that function --
# there is no call site here that can forget. (csh's cwdcmd is the same idea.)
loadout_chpwd_ls() {
    human_readable=0 ls
}
loadout_add_zsh_hook chpwd loadout_chpwd_ls

extract_rpm() {
    rpm2cpio "$1" | cpio -idmv
}

zhead() {
    zcat "${@[-1]}" | head "${@[1,-2]}"
}

# If this terminal supports extended keys, set the var ~/.tmux.conf queries.
if check_extended_keys; then
    export EXTENDED_KEYS_SUPPORTED=1
else
    export EXTENDED_KEYS_SUPPORTED=0
fi

# Auto-attach to tmux if configured (shared implementation).
if is_truthy "${LOADOUT_CFG_ATTACH_TO_TMUX}"; then
    auto_attach_to_tmux
fi

unset _bin_dir _loadout_local_prefix _loadout_newest_hist _loadout_target_shell

