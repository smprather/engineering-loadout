# Loadout zsh entry point. ~/.zshrc and ~/.zprofile link here.
#
# This environment TRACKS envs/bash/. A bash-env change is not finished until
# the zsh form lands -- see envs/zsh/README.md and docs/HANDOFF.md.
#
# The strategy differs from the tcsh port, and deliberately so. csh has no
# functions, so envs/tcsh/ must REIMPLEMENT everything. zsh has functions,
# arrays and `local`, so it REUSES the bash env's shared library and alias file
# directly:
#
#     envs/bash/functions.sh        -> sourced as-is
#     envs/bash/global/config.sh    -> sourced as-is (one home for the defaults)
#     envs/bash/global/aliases.sh   -> sourced as-is
#
# That is what makes the alias surface track automatically instead of by
# discipline. Those three files are therefore SHARED code, not bash-private: a
# bashism added to any of them breaks zsh, which is why the path_* family uses
# eval indirection and `pl` lower-cases with `tr` rather than ${var,,}.
# tests/env-shell-parity enforces the rest.
#
# Layers are sourced lowest-first: global -> corp -> site -> team -> project ->
# user, in two passes (config, then rc), the same shape as bash and tcsh. Every
# source is guarded: a layer you have not created is normal, not an error.

# ~/.zshenv, ~/.zshrc and ~/.zprofile all link here, which is deliberate and
# needs the guard below.
#
# zsh splits its startup files by shell TYPE, unlike bash:
#     .zshenv    every zsh, including a non-interactive `zsh script.zsh`
#     .zprofile  login shells
#     .zshrc     INTERACTIVE shells only
#
# Linking only .zshrc/.zprofile -- which is what this package used to do -- left
# scripts with no PATH and none of the exported environment, because a script
# reads .zshenv and nothing else. Linking .zshenv fixes that, but then an
# interactive shell sources this file twice (.zshenv, then .zshrc). The guard
# makes the second pass a no-op. It is deliberately NOT exported: a child zsh
# must run the config itself.
if [[ -n ${_LOADOUT_ZSH_SOURCED:-} ]]; then
    return 0
fi
_LOADOUT_ZSH_SOURCED=1

ZSH_CONFIG_ROOT_DIR="${ZSH_CONFIG_ROOT_DIR:-$HOME/.config/zsh}"
BASH_CONFIG_ROOT_DIR="${BASH_CONFIG_ROOT_DIR:-$HOME/.config/bash}"

# INTERACTIVE_COMMENTS: allow `#` comments interactively, as bash does.
# Do NOT enable SH_WORD_SPLIT globally -- it breaks zsh's own completion system
# (compinit/compdump loops). The shared bash files that need it set it locally.
setopt INTERACTIVE_COMMENTS 2>/dev/null

# --- shared function library (must come first; everything below uses it) ------
[[ -r "$BASH_CONFIG_ROOT_DIR/functions.sh" ]] && source "$BASH_CONFIG_ROOT_DIR/functions.sh"

# --- Pass 1a: shared LOADOUT_CFG_* defaults, from the BASH layers -------------
# Deliberately the bash files: the defaults live in exactly one place so a value
# a user sets for bash also applies to zsh. zsh-only settings go in pass 1b.
if typeset -f source_if_exists >/dev/null 2>&1; then
    source_if_exists "$BASH_CONFIG_ROOT_DIR/global/config.sh"
    for _layer in corp site team project user; do
        source_if_exists "$BASH_CONFIG_ROOT_DIR/$_layer/config.sh"
    done

    # --- Pass 1b: zsh-specific config, every layer ----------------------------
    for _layer in global corp site team project user; do
        source_if_exists "$ZSH_CONFIG_ROOT_DIR/$_layer/config.zsh"
    done

    # --- Pass 2: the shell config itself, every layer -------------------------
    for _layer in global corp site team project user; do
        source_if_exists "$ZSH_CONFIG_ROOT_DIR/$_layer/zshrc"
    done
fi

unset _layer
